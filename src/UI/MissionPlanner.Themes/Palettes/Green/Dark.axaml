<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compile-time merging gives every static control alias this palette scope. -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="../../Tokens/Base/Dark.axaml" />
        <MergeResourceInclude Source="../../Tokens/Accent.axaml" />
        <MergeResourceInclude Source="../../Themes/Dark/_index.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <StaticResource x:Key="PaletteNormalColor" ResourceKey="SemiGreen5Color" />
    <StaticResource x:Key="PaletteHoverColor" ResourceKey="SemiGreen6Color" />
    <StaticResource x:Key="PalettePressedColor" ResourceKey="SemiGreen4Color" />
    <StaticResource x:Key="PaletteDisabledColor" ResourceKey="SemiGreen2Color" />
    <StaticResource x:Key="PaletteSubtleColor" ResourceKey="SemiGreen0Color" />
    <StaticResource x:Key="PaletteSubtleHoverColor" ResourceKey="SemiGreen1Color" />
    <StaticResource x:Key="PaletteSubtlePressedColor" ResourceKey="SemiGreen1Color" />
    <StaticResource x:Key="PaletteTextColor" ResourceKey="SemiGreen8Color" />
    <Color x:Key="PaletteSelectionTextColor">#FFFFFF</Color>
</ResourceDictionary>
