<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compile-time merging gives every static control alias this palette scope. -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="../../Tokens/Base/Dark.axaml" />
        <MergeResourceInclude Source="../../Tokens/Accent.axaml" />
        <MergeResourceInclude Source="../../Themes/Dark/_index.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <StaticResource x:Key="PaletteNormalColor" ResourceKey="SemiYellow5Color" />
    <StaticResource x:Key="PaletteHoverColor" ResourceKey="SemiYellow6Color" />
    <StaticResource x:Key="PalettePressedColor" ResourceKey="SemiYellow4Color" />
    <StaticResource x:Key="PaletteDisabledColor" ResourceKey="SemiYellow2Color" />
    <StaticResource x:Key="PaletteSubtleColor" ResourceKey="SemiYellow0Color" />
    <StaticResource x:Key="PaletteSubtleHoverColor" ResourceKey="SemiYellow1Color" />
    <StaticResource x:Key="PaletteSubtlePressedColor" ResourceKey="SemiYellow1Color" />
    <StaticResource x:Key="PaletteTextColor" ResourceKey="SemiYellow8Color" />
    <Color x:Key="PaletteSelectionTextColor">#FFFFFF</Color>
</ResourceDictionary>
