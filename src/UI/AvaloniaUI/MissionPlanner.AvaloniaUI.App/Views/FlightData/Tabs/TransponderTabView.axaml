<utilities:TabItemViewBase x:TypeArguments="tabs:TransponderTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.TransponderTabItemView"
                           x:DataType="tabs:TransponderTabViewModel">
    <Grid Margin="16" RowDefinitions="Auto,*,*" RowSpacing="10">
        <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="Bold"/>

        <!-- TODO: Restore both VirtualizedDataGrid controls after an Avalonia equivalent is selected. -->

        <GroupBox Grid.Row="1" Header="Transponder components">
            <ListBox ItemsSource="{Binding Components}"/>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Nearby ADS-B traffic">
            <ListBox ItemsSource="{Binding Traffic}"/>
        </GroupBox>
    </Grid>
</utilities:TabItemViewBase>
