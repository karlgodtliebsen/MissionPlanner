<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <RootNamespace>MissionPlanner</RootNamespace>
    <TargetFramework>net11.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Avalonia/Skia require native WebAssembly linking. -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- Shared services currently use reflection-based discovery and JSON binding. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
      <ProjectReference Include="..\..\UI\MissionPlanner.App\MissionPlanner.App.csproj" />
      <ProjectReference Include="..\..\UI\MissionPlanner.Library.Browser\MissionPlanner.Library.Browser.csproj" />
      <Content Remove="appsettings.json" />
      <!-- Explicitly include the generated asset even on the first clean build. -->
      <Content Remove="wwwroot\browser-platform.js" />
      <Content Include="wwwroot\browser-platform.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" LogicalName="MissionPlanner.Browser.appsettings.json" />
  </ItemGroup>

  <!-- Onigwrap currently ships up to Emscripten 3.1.56.
       Its targets require a library matching the SDK's exact version.
       Only replace the missing reference; prefer an SDK-matched asset when the package adds one. -->
  <Target Name="ResolveOnigwrapWasmLibrary" BeforeTargets="PrepareForBuild"
          Condition="'$(TargetFramework)' == 'net11.0-browser' and '$(OnigwrapWasmLibraryPath)' != '' and '$(EmscriptenVersion)' != ''">
    <PropertyGroup>
      <_OnigwrapThreading Condition="'$(WasmEnableThreads)' == 'true'">mt</_OnigwrapThreading>
      <_OnigwrapThreading Condition="'$(WasmEnableThreads)' != 'true'">st</_OnigwrapThreading>
      <_OnigwrapSdkLibrary>$(OnigwrapWasmLibraryPath)/$(EmscriptenVersion.Trim())/$(_OnigwrapThreading)/libonigwrap.a</_OnigwrapSdkLibrary>
      <_OnigwrapPackagedLibrary>$(OnigwrapWasmLibraryPath)/3.1.56/$(_OnigwrapThreading)/libonigwrap.a</_OnigwrapPackagedLibrary>
    </PropertyGroup>
    <ItemGroup Condition="!Exists('$(_OnigwrapSdkLibrary)') and Exists('$(_OnigwrapPackagedLibrary)')">
      <NativeFileReference Remove="$(_OnigwrapSdkLibrary)" />
      <NativeFileReference Include="$(_OnigwrapPackagedLibrary)" />
    </ItemGroup>
  </Target>

  <!-- Avalonia 12.1 also adds the old 3.1.56 graphics archives. Keep only the
       .NET 11 archives selected by the newer native-asset packages above. -->
  <Target Name="RemoveLegacyAvaloniaWasmLibraries" BeforeTargets="PrepareForBuild"
          Condition="'$(TargetFramework)' == 'net11.0-browser'">
    <ItemGroup>
      <NativeFileReference Remove="$(SkiaSharpStaticLibraryPath)/3.1.56/**/*.a" />
      <NativeFileReference Remove="$(HarfBuzzSharpStaticLibraryPath)/3.1.56/**/*.a" />
    </ItemGroup>
  </Target>

  <!-- Linked external content gets the host's wwwroot as its development content root.
       Materialize the file there before discovery so development and publish agree. -->
  <Target Name="CopyBrowserPlatformModule" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\UI\MissionPlanner.Library.Browser\Interop\browser-platform.js" DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\browser-platform.js" SkipUnchangedFiles="true" />
  </Target>
</Project>
