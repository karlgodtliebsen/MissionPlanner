<utilities:TabItemViewBase x:TypeArguments="tabs:TelemetryLogsTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                           xmlns:controls="clr-namespace:MissionPlanner.AvaloniaUI.App.Controls"
                           xmlns:vehicles="clr-namespace:MissionPlanner.Core.Vehicles.Models;assembly=MissionPlanner.Core"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.TelemetryLogsTabItemView"
                           x:DataType="tabs:TelemetryLogsTabViewModel">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <Border Padding="12" Classes="SectionCard">
            <StackPanel>
                <TextBlock Text="{Binding SourceModeLabel}" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Replay is read-only and cannot send vehicle commands." TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Content="Load .tlog" Command="{Binding LoadCommand}"/>
            <Button Grid.Column="1" Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}"/>
            <Button Grid.Column="2" Content="Close replay" Command="{Binding CloseReplayCommand}"/>
            <StackPanel Grid.Column="3">
                <TextBlock Text="{Binding SourceName}" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StackPanel>
            <ProgressBar Grid.Column="4" Width="40" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,90,Auto" ColumnSpacing="8">
            <Slider Maximum="{Binding DurationSeconds}" Value="{Binding SeekSeconds}"/>
            <Button Grid.Column="1" Content="Seek" Command="{Binding SeekCommand}"/>
            <NumericUpDown Grid.Column="2" Value="{Binding PlaybackSpeed}" Increment="0.1"/>
            <Button Grid.Column="3" Content="Apply speed ×" Command="{Binding ApplySpeedCommand}"/>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <ProgressBar Maximum="1" Value="{Binding Progress}"/>
            <TextBlock Grid.Column="1" Text="{Binding ReplayTimeText}"/>
        </Grid>
        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock Text="Replay vehicles" FontWeight="Bold" />
            <controls:VirtualizedItemsGrid
                Grid.Row="1"
                ItemsSource="{Binding ReplayVehicles}"
                ColumnWidths="*,*"
                ColumnSpacing="6"
                RowMinHeight="34"
                ShowHeader="True"
                ShowSearchBar="False"
                ShowPagination="False"
                SelectionMode="None">
                <controls:VirtualizedItemsGrid.EmptyView>
                    <TextBlock Text="No vehicle heartbeat has been decoded at this replay position."
                               FontSize="12"
                               Opacity="0.6"
                               Margin="0,20"
                               HorizontalAlignment="Center" />
                </controls:VirtualizedItemsGrid.EmptyView>
                <controls:VirtualizedItemsGrid.HeaderTemplate>
                    <DataTemplate>
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Grid.Column="0" Text="Display name" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="1" Text="Vehicle ID" Classes="DataGridColumn" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.HeaderTemplate>
                <controls:VirtualizedItemsGrid.RowTemplate>
                    <DataTemplate x:DataType="vehicles:VehicleState">
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextWrapping="Wrap" Classes="DataGridRow" />
                            <TextBlock Grid.Column="1" Text="{Binding VehicleId}" TextWrapping="Wrap" Classes="DataGridRow" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.RowTemplate>
            </controls:VirtualizedItemsGrid>
        </Grid>
    </Grid>
</utilities:TabItemViewBase>
