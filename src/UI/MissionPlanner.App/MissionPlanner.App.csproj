<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>MissionPlanner.App</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>

        <AvaloniaResource Include="Introduction\**" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" />

		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
		<PackageReference Include="LiveMarkdown.Avalonia" />

		<PackageReference Include="Material.Icons.Avalonia" />
		<PackageReference Include="CommunityToolkit.Mvvm" />

        <PackageReference Include="Irihi.Ursa" />
		<PackageReference Include="Irihi.Ursa.Themes.Semi" />
		<PackageReference Include="ScottPlot.Avalonia" />

        <PackageReference Include="Semi.Avalonia" />
		<PackageReference Include="Semi.Avalonia.AvaloniaEdit" />
		<PackageReference Include="Semi.Avalonia.ColorPicker" />
		<PackageReference Include="Semi.Avalonia.DataGrid" />
		<PackageReference Include="Semi.Avalonia.Dock" />

		<PackageReference Include="Mapsui" />
        <PackageReference Include="Mapsui.Avalonia12" />
        <PackageReference Include="Mapsui.Tiling" />

		<PackageReference Include="AsyncAwaitBestPractices.MVVM" />
		<PackageReference Include="Riok.Mapperly" />

		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Enrichers.Environment" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<PackageReference Include="Serilog.Settings.AppSettings" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.Trace" />

        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />

	</ItemGroup>

	<ItemGroup>
      <ProjectReference Include="..\..\Core\MissionPlanner.Shared.Models\MissionPlanner.Shared.Models.csproj" />
      <ProjectReference Include="..\..\Core\MissionPlanner.Simulation\MissionPlanner.Simulation.csproj" />
      <ProjectReference Include="..\..\Libraries\MissionPlanner.Library\MissionPlanner.Library.csproj" />
      <ProjectReference Include="..\..\Core\MissionPlanner.Core\MissionPlanner.Core.csproj" />
      <ProjectReference Include="..\..\Core\MissionPlanner.Maps\MissionPlanner.Maps.csproj" />
      <ProjectReference Include="..\MissionPlanner.Themes\MissionPlanner.Themes.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Introduction\Content\Introduction.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <AvaloniaXaml Update="Views\Common\TopBarView.axaml">
	    <Generator>MSBuild:Compile</Generator>
	  </AvaloniaXaml>
	  <AvaloniaXaml Update="Views\Missions\MissionItemListView.axaml">
	    <Generator></Generator>
	  </AvaloniaXaml>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\ConfigTuning\Sections\ParametersEditor\ParametersEditorTabView.axaml.cs">
	    <DependentUpon>ParametersEditorTabView.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\InitSetup\InstallFirmware\InstallFirmwarePage.axaml.cs">
	    <DependentUpon>InstallFirmwarePage.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\InitSetup\InstallFirmware\SubViews\ConfirmDfuTargetView.axaml.cs">
	    <DependentUpon>ConfirmDfuTargetView.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\InitSetup\MandatoryHardware\Sections\HardwareIdView.axaml.cs">
	    <DependentUpon>HardwareIdView.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>

</Project>
