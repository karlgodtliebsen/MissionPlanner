<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <ControlTheme x:Key="{x:Type controls:VirtualizedItemsGrid}"
                  TargetType="controls:VirtualizedItemsGrid">

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- Search -->
                    <Border Grid.Row="0" 
                            IsVisible="{TemplateBinding ShowSearchBar}" 
                            Margin="5,5,5,5">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                     PlaceholderText="{TemplateBinding SearchWatermark}"
                                     HorizontalAlignment="Stretch" />
                               <Button x:Name="PART_ClearSearchButton"
                                    Grid.Column="1"
                                    ToolTip.Tip="Clear search filters"
                                    Padding="8,2"
                                    VerticalAlignment="Center"  >
                                <avalonia:MaterialIcon Kind="ClearCircleOutline" Width="30" Height="30" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="5"  HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Label  HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Content="{Binding FilteredItemCount,StringFormat=Matching: {0},RelativeSource={RelativeSource TemplatedParent}}" ></Label>
                                <Label  HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Content="{Binding TotalItemCount,StringFormat=Total: {0},RelativeSource={RelativeSource TemplatedParent}}" ></Label>
                            </StackPanel>


                        </Grid>
                    </Border>
                    <!-- Sticky horizontally synchronized header -->
                    <Border Grid.Row="1"
                            Classes="SectionCard"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsVisible="{TemplateBinding ShowHeader}">

                        <ScrollViewer x:Name="PART_HeaderScrollViewer"

                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      >
                            <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Left"
                                  >
                                <!-- Keep the selection slot identical to the body. Extra
                                horizontal margin feeds back into viewport-based star sizing. -->
                                <Border Grid.Column="0"
                                        Width="{TemplateBinding SelectionColumnWidth}"
                                        IsVisible="{Binding IsSelectionEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                                    <CheckBox x:Name="PART_SelectAllCheckBox"
                                              IsThreeState="True"
                                              Margin="0"

                                              HorizontalContentAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding IsMultiSelectionEnabled, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Content="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="Left" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <!-- Virtualized body. Padding is deliberately zero so the
                    body geometry stays exactly aligned with the header. -->
                    <Border Grid.Row="2"
                            Classes="SectionCard"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ScrollViewer x:Name="PART_BodyScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <ItemsRepeater x:Name="PART_Repeater">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="0" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                                <ContentPresenter Content="{TemplateBinding EmptyView}"
                                                  IsVisible="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Top"
                                                  Margin="20" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Row="3"
                            Classes="SectionCard"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsVisible="{TemplateBinding ShowPagination}">
                        <!-- Pagination -->
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              >

                            <Button x:Name="PART_FirstPageButton" Grid.Column="0" ToolTip.Tip="First page" Padding="8,3" AutomationProperties.Name="First page">
                                <avalonia:MaterialIcon Kind="PageFirst" Classes="ActionIcon" Width="20" Height="20" />
                            </Button>
                            <Button x:Name="PART_PreviousPageButton" Grid.Column="1" ToolTip.Tip="Previous page" Padding="8,3" AutomationProperties.Name="Previous page">
                                <avalonia:MaterialIcon Kind="ChevronLeft" Classes="ActionIcon" Width="20" Height="20" />
                            </Button>

                            <TextBlock Grid.Column="2" Text="Page" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding CurrentPage, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="of" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Text="{Binding PageCount, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />

                            <Button x:Name="PART_NextPageButton" Grid.Column="6" ToolTip.Tip="Next page" Padding="8,3" AutomationProperties.Name="Next page">
                                <avalonia:MaterialIcon Kind="ChevronRight" Classes="ActionIcon" Width="20" Height="20" />
                            </Button>
                            <Button x:Name="PART_LastPageButton" Grid.Column="7" ToolTip.Tip="Last page" Padding="8,3" AutomationProperties.Name="Last page">
                                <avalonia:MaterialIcon Kind="PageLast" Classes="ActionIcon" Width="20" Height="20" />
                            </Button>

                            <TextBlock Grid.Column="8"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"
                                       Text="{Binding FilteredItemCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} items'}" />
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
