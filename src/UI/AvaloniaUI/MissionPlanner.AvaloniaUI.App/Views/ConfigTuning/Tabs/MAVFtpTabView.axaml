<utilities:UserControlViewBase x:TypeArguments="tabs:MavFtpTabViewModel"
                      xmlns="https://github.com/avaloniaui"
                      xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs"
                      xmlns:navigation="clr-namespace:MissionPlanner.AvaloniaUI.App.Navigation"
                      x:Name="RootPage"
                      x:Class="MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs.MAVFtpTabView"
                      x:DataType="tabs:MavFtpTabViewModel">

    <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Content="↑" Command="{Binding NavigateUpCommand}" IsEnabled="{Binding CanNavigateUp}" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Refresh"  IsVisible="{Binding HasConnection}" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="3" Content="Open" IsVisible="{Binding HasEntries}" Command="{Binding OpenSelectedCommand}" />
            <Button Grid.Column="4" Content="Reset sessions"  IsVisible="{Binding HasConnection}" Command="{Binding ResetSessionsCommand}" />
        </Grid>
        <Grid Grid.Row="1"  HorizontalAlignment="Stretch" >
            <!-- TODO: Replace auto-generated columns with native Avalonia column templates after the FullParametersList virtualization test establishes the final grid strategy. -->
            <DataGrid AutoGenerateColumns="True" 
                ItemsSource="{Binding Entries}" 
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                SelectionMode="Single"

                
                HorizontalAlignment="Center" 
                VerticalAlignment="Stretch" 
                Background="Transparent">
                
                
            </DataGrid>
        </Grid>
        <StackPanel Orientation="Vertical" Grid.Row="2" Spacing="6">
            <TextBlock Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
            <ProgressBar Value="{Binding TransferProgress}" />
            <TextBlock Text="{Binding TransferDetails}" FontSize="12" />
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Download selected" Command="{Binding DownloadSelectedCommand}"  IsVisible="{Binding HasEntries}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</utilities:UserControlViewBase>
