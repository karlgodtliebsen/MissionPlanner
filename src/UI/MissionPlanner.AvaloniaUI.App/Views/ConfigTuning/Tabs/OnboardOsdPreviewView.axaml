<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs.OnboardOsdPreviewView"
             x:CompileBindings="False">

    <Border Padding="10" Classes="SectionCard">
        <local:OsdPreviewCanvas
            x:Name="PreviewCanvas"
            ViewModel="{Binding}"
            MinHeight="480" />
    </Border>
</UserControl>
