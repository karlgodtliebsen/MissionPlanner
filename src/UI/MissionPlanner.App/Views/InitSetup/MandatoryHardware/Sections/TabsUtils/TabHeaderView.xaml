<?xml version="1.0" encoding="utf-8" ?>
<tabViews:ExtendedTabHeaderView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
    xmlns:models="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.Models"
    x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.TabsUtils.TabHeaderView"
    x:DataType="models:SetupWorkflowItemViewModel"
    Margin="10,0,0,0"
    BorderStyleClass="SurfaceContainer,Rounded,Elevation1"
    >
            <Grid ColumnDefinitions="4,*" >
                <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                         Opacity="0.2"
                         IsVisible="False">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView"
                                     Binding="{Binding Source={RelativeSource Self}, Path=(tabViews:ExtendedTabView.IsHeaderSelected)}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
                <Grid Grid.Column="1" Margin="10,0,0,0"
                      RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto" RowSpacing="5">
                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                    <Label Grid.Column="1" Text="{Binding StateDisplay}" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" LineBreakMode="WordWrap" />
                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StatusText}" Opacity="0.72" LineBreakMode="WordWrap" />
                </Grid>
            </Grid>
</tabViews:ExtendedTabHeaderView>
