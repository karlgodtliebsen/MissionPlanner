<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections"
    xmlns:osd="clr-namespace:MissionPlanner.Core.ConfigTuning.Osd;assembly=MissionPlanner.Core"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.OsdTuningSlotsView"
    x:TypeArguments="sections:OsdTuningSlotsViewModel" x:DataType="sections:OsdTuningSlotsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="12">
            <TextBlock Text="OSD adjustable-parameter screens" FontWeight="Bold" />
            <TextBlock Text="Read OSD screen 5 or 6, select one of its nine slots, and review a parameter assignment. These slots let the transmitter adjust the selected parameter while disarmed. Layout and screen enable settings remain in the layout editor." TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8">
                <TextBlock Text="Screen" VerticalAlignment="Center" />
                <NumericUpDown Minimum="5" Maximum="6" Value="{Binding Screen}" Width="100" />
                <Button Classes="ToolbarIconButton" Command="{Binding ReadCommand}" ToolTip.Tip="Read tuning slots" AutomationProperties.Name="Read tuning slots"><mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" /></Button>
                <Button Classes="ToolbarIconButton" Command="{Binding ApplyCommand}" ToolTip.Tip="Apply selected slot" AutomationProperties.Name="Apply selected slot"><mdi:MaterialIcon Kind="ContentSave" Classes="ActionIcon" /></Button>
                <Button Classes="ToolbarIconButton" Command="{Binding ReadCancelCommand}" ToolTip.Tip="Cancel reading" AutomationProperties.Name="Cancel reading"><mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon" /></Button>
            </WrapPanel>
            <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="osd:OsdTuningSlot">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Index, StringFormat='Slot {0}'}" /><TextBlock Text="{Binding Parameter}" /></StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Assigned reported parameter" />
            <AutoCompleteBox ItemsSource="{Binding ParameterNames}" Text="{Binding ParameterName}" FilterMode="Contains" MinimumPrefixLength="1" />
            <TextBlock Text="Type: 0 custom numeric; 1 serial protocol; 2 servo function; 3 RC auxiliary; 4 flight mode; 5–7 firmware failsafe actions." TextWrapping="Wrap" />
            <NumericUpDown Value="{Binding SlotType}" Minimum="0" Maximum="7" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <StackPanel><TextBlock Text="Minimum" /><NumericUpDown Value="{Binding Minimum}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Maximum" /><NumericUpDown Value="{Binding Maximum}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Increment" /><NumericUpDown Value="{Binding Increment}" Increment="0.01" /></StackPanel>
            </Grid>
            <TextBlock Text="Enumeration types use firmware-defined ranges. Type 0 requires a finite range and positive increment." TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>
