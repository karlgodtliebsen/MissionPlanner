<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Bootstrap active palette. ThemeManager overwrites every semantic key atomically. -->
    <Color x:Key="Primary">#A8EAC0</Color>
    <Color x:Key="OnPrimary">#1C783D</Color>
    <Color x:Key="PrimaryContainer">#1A6C37</Color>
    <Color x:Key="OnPrimaryContainer">#BAEFCD</Color>
    <Color x:Key="Secondary">#DAFFBE</Color>
    <Color x:Key="OnSecondary">#245900</Color>
    <Color x:Key="SecondaryContainer">#193900</Color>
    <Color x:Key="OnSecondaryContainer">#E1FFCB</Color>
    <Color x:Key="Tertiary">#FEED9D</Color>
    <Color x:Key="OnTertiary">#564500</Color>
    <Color x:Key="TertiaryContainer">#8B7301</Color>
    <Color x:Key="OnTertiaryContainer">#FEF1B0</Color>
    <Color x:Key="Surface">#2C3639</Color>
    <Color x:Key="OnSurface">#F6F4E6</Color>
    <Color x:Key="SurfaceVariant">#49454F</Color>
    <Color x:Key="OnSurfaceVariant">#DCD7C9</Color>
    <Color x:Key="SurfaceContainerLow">#252D30</Color>
    <Color x:Key="SurfaceContainer">#323D40</Color>
    <Color x:Key="SurfaceContainerHigh">#3B474A</Color>
    <Color x:Key="Background">#1C1B1F</Color>
    <Color x:Key="OnBackground">#E6E1E5</Color>
    <Color x:Key="Success">#A8EAC0</Color>
    <Color x:Key="OnSuccess">#123C22</Color>
    <Color x:Key="SuccessContainer">#1A6C37</Color>
    <Color x:Key="OnSuccessContainer">#BAEFCD</Color>
    <Color x:Key="Warning">#FFB95C</Color>
    <Color x:Key="OnWarning">#482900</Color>
    <Color x:Key="WarningContainer">#693C00</Color>
    <Color x:Key="OnWarningContainer">#FFDCB0</Color>
    <Color x:Key="Info">#9DCCF0</Color>
    <Color x:Key="OnInfo">#00344E</Color>
    <Color x:Key="InfoContainer">#174D68</Color>
    <Color x:Key="OnInfoContainer">#C9E6FF</Color>
    <Color x:Key="Error">#F2B8B5</Color>
    <Color x:Key="OnError">#601410</Color>
    <Color x:Key="ErrorContainer">#8C1D18</Color>
    <Color x:Key="OnErrorContainer">#F9DEDC</Color>
    <Color x:Key="Outline">#938F99</Color>
    <Color x:Key="OutlineVariant">#444746</Color>
    <Color x:Key="Shadow">#000000</Color>
    <Color x:Key="Scrim">#000000</Color>
    <Color x:Key="InverseSurface">#E6E1E5</Color>
    <Color x:Key="InverseOnSurface">#313033</Color>
    <Color x:Key="InversePrimary">#6750A4</Color>
    <Color x:Key="DisabledText">#BA919191</Color>
    <Color x:Key="DisabledBackground">#80919191</Color>

    <Color x:Key="Transparent">Transparent</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{DynamicResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
    <Color x:Key="Yellow100Accent">#F7B548</Color>
    <Color x:Key="Yellow200Accent">#FFD590</Color>
    <Color x:Key="Yellow300Accent">#FFE5B9</Color>
    <Color x:Key="Cyan100Accent">#28C2D1</Color>
    <Color x:Key="Cyan200Accent">#7BDDEF</Color>
    <Color x:Key="Cyan300Accent">#C3F2F4</Color>
    <Color x:Key="Blue100Accent">#3E8EED</Color>
    <Color x:Key="Blue200Accent">#72ACF1</Color>
    <Color x:Key="Blue300Accent">#A7CBF6</Color>
</ResourceDictionary>
