<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:FftSetupViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections" 
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                                  x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.FftSetupView" 
                                  x:DataType="sections:FftSetupViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="25" HorizontalOptions="Center">
            <Label Text="FFT Setup and Analysis" FontSize="24" FontAttributes="Bold"/>
            <Label Text="FFT/log settings are available only when INS_LOG_BAT or FFT parameters are reported. Log acquisition remains owned by DataFlash Logs."/>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}"/>
            <Label Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}"/>

            <controls:NumericField Title="Sample rate Hz" Text="{Binding SampleRateHz}" 
                                   Min="0"     
                                   NumberFormat="F0"
                                   HorizontalTextAlignment="End"
                                   Keyboard="Numeric"/>
            
            <Editor Placeholder="Paste comma/newline-separated samples from an existing log artifact" Text="{Binding SamplesText}" HeightRequest="180"/>
            
            <Button Text="Analyze samples" Command="{Binding AnalyzeCommand}" HorizontalOptions="Start"/>
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
