<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent
    x:TypeArguments="sections:AdsbViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
    xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.AdsbView"
    x:DataType="sections:AdsbViewModel"
    >

    <ScrollView VerticalScrollBarVisibility="Always">
        <VerticalStackLayout Padding="16" Spacing="25" HorizontalOptions="Center">
            <Label Text="ADSB" FontSize="18" FontAttributes="Bold" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" LineBreakMode="TailTruncation" />
            <uranium:SelectableLabel Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}"/>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Guidance}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" TextColor="{DynamicResource Warning}" LineBreakMode="WordWrap" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Settings}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sections:PeripheralSettingViewModel">
                        <Border StyleClass="SurfaceContainer,Rounded" Padding="12">
                            <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout>
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                    <Label Text="{Binding Name}" FontSize="11" Opacity="0.7" />
                                </VerticalStackLayout>
                                <material:SelectField Grid.Column="1" Title="Value" IsVisible="{Binding HasOptions}"
                                    ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" ItemDisplayBinding="{Binding Name}" />
                                <material:TextField Grid.Column="1" Title="Value" IsVisible="{Binding IsNumeric}" Text="{Binding NumericValue}" />
                                <Button Grid.Column="2" Text="Apply" Command="{Binding ApplyCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Refresh" Command="{Binding RefreshCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
