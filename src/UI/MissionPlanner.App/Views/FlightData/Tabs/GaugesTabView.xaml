<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="tabs:GaugesTabViewModel"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
 xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
 xmlns:controls="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
 xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
 x:Class="MissionPlanner.App.Views.FlightData.Tabs.GaugesTabView" x:DataType="tabs:GaugesTabViewModel">
 <Grid Padding="16" RowDefinitions="Auto,*">
  <Label Text="Flight gauges" FontSize="20" FontAttributes="Bold" />

        <controls:VirtualizedDataGrid Grid.Row="1" 
                                      ItemsSource="{Binding Tiles}" 
                                      ItemSizingStrategy= "MeasureFirstItem"
                                      ShowSearchBar="False"
                                      HorizontalOptions="Fill" 
                                      VerticalOptions="Fill" 
                                      BackgroundColor="Transparent"
        >
            <controls:VirtualizedDataGrid.EmptyView>
                <Label HorizontalOptions="Center" Text="No Rows could be found"
                       FontSize="12" Opacity="0.6" Margin="0,20" />
            </controls:VirtualizedDataGrid.EmptyView>

            <controls:VirtualizedDataGrid.Columns>

                <material:DataGridColumn Width="*" Title="Label">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:GaugeTileViewModel">
                            <Label Text="{Binding Label}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
                <material:DataGridColumn Width="*" Title="Value">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:GaugeTileViewModel">
                            <Label Text="{Binding Value}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
                <material:DataGridColumn Width="*" Title="Unit">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:GaugeTileViewModel">
                            <Label Text="{Binding Unit}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
                <material:DataGridColumn Width="*" Title="Freshness">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:GaugeTileViewModel">
                            <Label Text="{Binding Freshness}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
            </controls:VirtualizedDataGrid.Columns>
        </controls:VirtualizedDataGrid>

