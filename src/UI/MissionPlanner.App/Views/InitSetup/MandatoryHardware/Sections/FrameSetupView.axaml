<utilities:UserControlViewBase x:TypeArguments="sections:FrameSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FrameSetupView"
                               x:DataType="sections:FrameSetupViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
            <TextBlock Text="Supported frame configuration" FontSize="18" FontWeight="Bold" />
            <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" />
            <TextBlock Text="{Binding FirmwareFamily, StringFormat='Firmware family: {0}'}" />
            <TextBlock Text="Only values advertised by the connected firmware metadata are shown. Current values remain unchanged until Write and verify is confirmed." />
            <ItemsControl ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sections:FrameParameterSettingViewModel">
                        <Border Padding="10" Classes="SectionCard">
                            <Grid ColumnDefinitions="180,*,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentDisplay, StringFormat='Current: {0}'}" />
                                <ComboBox Grid.Column="2" ToolTip.Tip="Pending value" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberBinding="{Binding Label}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding PendingDisplay, StringFormat='Pending: {0}'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock IsVisible="{Binding HasRecommendations}" Text="Optional initial recommendations" FontSize="18" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding Recommendations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sections:FrameRecommendationViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Content="{Binding Description}" IsChecked="{Binding IsSelected}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Refresh vehicle values" Command="{Binding RefreshCommand}" />
                <Button Content="Write and verify" Command="{Binding ApplyCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontStyle="Italic" TextTrimming="CharacterEllipsis" />
<TextBlock IsVisible="{Binding RebootRequired}" Text="Vehicle Reboot required. Reconnect, then use Refresh vehicle values to confirm the persisted configuration." Classes="Warning" FontWeight="Bold" />
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>
