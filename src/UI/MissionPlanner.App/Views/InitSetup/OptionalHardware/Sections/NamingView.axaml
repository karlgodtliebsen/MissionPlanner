<utilities:UserControlViewBase x:TypeArguments="sections:NamingViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.NamingView"
                               x:DataType="sections:NamingViewModel"
                               >
    <Grid RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Grid.Row="0" HorizontalAlignment="Center" Padding="12" Classes="SourceBorder" x:Name="SourceBorder"  >
            <StackPanel Spacing="10">
                <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="Vehicle Naming" Classes="H2" />
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,10,0,10" Spacing="12" HorizontalAlignment="Center">
                    <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                         IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                    <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                         IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                <Button Classes="IsToolbarButton" Width="100" ToolTip.Tip="Apply changed identifiers" AutomationProperties.Name="Apply changed identifiers"
                        Command="{Binding ApplyCommand}" >
                    <avalonia:MaterialIcon Kind="CheckCircleOutline" Width="30" Height="30" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Reconnect to the previous vehicle connection"
                        Command="{Binding ReconnectCommand}" AutomationProperties.Name="Reconnect vehicle">
                    <avalonia:MaterialIcon Kind="Refresh" Width="30" Height="30" />
                </Button>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" HorizontalAlignment="Stretch" Padding="25" Classes="SectionCard" MaxWidth="450"
                Width="{Binding #SourceBorder.Bounds.Width}"
                IsEnabled="{Binding CanEdit}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,130" RowSpacing="10" ColumnSpacing="10" HorizontalAlignment="Center">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mav System ID" Classes="H4" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MavSystemId, Mode=TwoWay}" Classes="H4" HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Board Serial Number" Classes="H4" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BoardSerialNumber, Mode=TwoWay}" Classes="H4" HorizontalContentAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>

</utilities:UserControlViewBase>
