<?xml version="1.0" encoding="UTF-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="local:InstallFirmwareViewModel"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.InstallFirmwareView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
    x:DataType="local:InstallFirmwareViewModel"
    Title="Install Firmware">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="20" MaximumWidthRequest="1100" HorizontalOptions="Center">
            <Label Text="Firmware" FontSize="30" FontAttributes="Bold" />

            <Border IsVisible="{Binding IsConnectedMode}" Padding="24" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="14">
                    <Label Text="A vehicle is connected" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Application firmware cannot be installed while Mission Planner owns the active connection. Disconnect the vehicle first to browse or install firmware." />
                    <Label Text="Embedded bootloader update is available only for a supported, disarmed ArduPilot vehicle. Keep power connected and reboot after an accepted update." />
                    <Button Text="Update Bootloader" Command="{Binding UpdateBootloaderCommand}" IsEnabled="{Binding CanUpdateBootloader}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding IsDisconnectedMode}" Spacing="16">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Release:" VerticalOptions="Center" />
                    <Picker ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" WidthRequest="180" />
                    <Button Text="Refresh catalogue" Command="{Binding RefreshCatalogCommand}" />
                    <Button Text="All Options" Command="{Binding ShowAllOptionsCommand}" />
                    <Button Text="Load Custom Firmware" Command="{Binding LoadCustomFirmwareCommand}" />
                </HorizontalStackLayout>

                <Entry Text="{Binding TargetSearchText}" Placeholder="Search platform, manufacturer, brand, or board ID" />

                <CollectionView ItemsSource="{Binding FirmwareChoices}" SelectionMode="None" EmptyView="No releases are available for this channel.">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                            <Border Padding="18" StrokeShape="RoundRectangle 10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:InstallFirmwareViewModel}}, Path=SelectFirmwareCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding VehicleType}" FontSize="20" FontAttributes="Bold" />
                                    <Label Text="{Binding Version}" />
                                    <Label Text="{Binding Platform}" FontSize="12" />
                                    <Label Text="{Binding Manufacturer}" FontSize="12" />
                                    <Label Text="{Binding BoardId, StringFormat='Board ID {0}'}" FontSize="12" />
                                    <Label Text="{Binding MatchReason}" FontSize="12" FontAttributes="Italic" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border IsVisible="{Binding HasCustomFirmware}" Padding="16" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Custom firmware" FontAttributes="Bold" />
                        <Label Text="{Binding CustomFirmwareName}" />
                        <Label Text="{Binding CustomFirmwareDescription}" />
                        <Label Text="{Binding CustomFirmwarePlatform, StringFormat='Platform: {0}'}" />
                        <Label Text="{Binding CustomFirmwareBoardId, StringFormat='Board ID: {0}'}" />
                        <Label Text="{Binding CustomFirmwareImageSize, StringFormat='Image size: {0:N0} bytes'}" />
                        <Label Text="{Binding CustomFirmwareBuild, StringFormat='Build: {0}'}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Label Text="Selected firmware" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding SelectedFirmware.Platform, StringFormat='Platform: {0}'}" />
                        <Label Grid.Row="2" Text="{Binding SelectedFirmware.BoardId, StringFormat='Firmware board ID: {0}'}" />
                        <Label Grid.Row="3" Text="{Binding SelectedFirmware.Version, StringFormat='Version: {0}'}" />
                        <Label Grid.Row="4" Text="{Binding SelectedFirmware.Channel, StringFormat='Channel: {0}'}" />
                        <Label Grid.Row="5" Text="{Binding SelectedFirmware.VehicleType, StringFormat='Vehicle: {0}'}" />
                        <Label Grid.Row="6" Text="{Binding SelectedFirmware.Manufacturer, StringFormat='Manufacturer: {0}'}" />
                        <Label Grid.Row="7" Text="{Binding SelectedFirmware.GitSha, StringFormat='Git SHA: {0}'}" />
                        <Label Grid.Row="8" Text="{Binding SelectedFirmware.Format, StringFormat='Format: {0}'}" />
                        <Label Grid.Row="9" Text="{Binding SelectedFirmware.ArtifactUrl, StringFormat='Source: {0}'}" LineBreakMode="CharacterWrap" />
                        <Label Grid.Row="10" Text="{Binding SelectedFirmware.UsbIdentifiers, StringFormat='USB IDs: {0}'}" />
                        <Label Grid.Row="11" Text="{Binding SelectedFirmware.BootloaderAliases, StringFormat='Bootloader aliases: {0}'}" />
                        <VerticalStackLayout Grid.Column="1" Grid.RowSpan="12" VerticalOptions="Center" Spacing="6">
                            <Button Text="Download &amp; Validate" Command="{Binding DownloadAndValidateCommand}" />
                            <Button Text="Install Validated Firmware" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
                            <Button Text="Copy Download URL" Command="{Binding CopyDownloadUrlCommand}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border IsVisible="{Binding HasPreparedFirmware}" Padding="12" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="Validated package" FontAttributes="Bold" />
                        <Label Text="{Binding PreparedFirmware.PackageBoardId, StringFormat='Package board ID: {0}'}" />
                        <Label Text="{Binding PreparedFirmware.Package.Description, StringFormat='Description: {0}'}" />
                        <Label Text="{Binding PreparedFirmware.Package.Summary, StringFormat='Platform summary: {0}'}" />
                        <Label Text="{Binding PreparedFirmware.Package.Version, StringFormat='Package version: {0}'}" />
                        <Label Text="{Binding PreparedFirmware.Package.GitIdentity, StringFormat='Package build: {0}'}" />
                        <Label Text="{Binding PreparedFirmware.InternalImageSize, StringFormat='Internal image: {0:N0} bytes'}" />
                        <Label Text="{Binding PreparedFirmware.ExternalImageSize, StringFormat='External image: {0:N0} bytes'}" />
                        <Label Text="{Binding PreparedFirmware.Sha256, StringFormat='SHA-256: {0}'}" />
                        <Label Text="{Binding PreparedFirmware.ArtifactMetadata.Size, StringFormat='Downloaded bytes: {0:N0}'}" />
                        <Label Text="{Binding PreparedFirmware.ArtifactMetadata.DownloadedAt, StringFormat='Downloaded at: {0:u}'}" />
                        <Label Text="{Binding PreparedFirmware.ArtifactMetadata.SourceUri, StringFormat='Source: {0}'}" LineBreakMode="CharacterWrap" />
                        <Label Text="{Binding PreparedFirmware.CacheIdentity, StringFormat='Cache ID: {0}'}" LineBreakMode="CharacterWrap" />
                        <Label Text="{Binding PreparedFirmware.WasCacheHit, StringFormat='Cache hit: {0}'}" />
                        <CollectionView ItemsSource="{Binding PreparedFirmware.Warnings}" EmptyView="No validation warnings.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding ., StringFormat='Warning: {0}'}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Detected device" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding DetectedDevices}" SelectedItem="{Binding SelectedDevice}" Title="Select flight controller" />
                <Label Text="{Binding DeviceStatus}" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding IsUnsupportedMode}" Padding="24" StrokeShape="RoundRectangle 10">
                <Label Text="Direct firmware installation is not available on this platform." />
            </Border>

            <Border IsVisible="{Binding IsOperationInProgress}" Padding="20" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding OperationProgress.Stage}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding OperationProgress.TechnicalDetail}" />
                    <ProgressBar Progress="{Binding OperationProgress.Progress}" IsVisible="{Binding OperationProgress.HasPercentage}" />
                    <Label Text="Do not disconnect power while flash memory is being changed." TextColor="OrangeRed" IsVisible="{Binding OperationProgress.IsPowerCritical}" />
                    <Button Text="Cancel" Command="{Binding CancelCommand}" HorizontalOptions="Start" />
                    <Label Text="Cancellation is deferred until verification and reboot reach a safe boundary. Keep power connected."
                           TextColor="OrangeRed" IsVisible="{Binding IsCancellationDeferred}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsCatalogRefreshRunning}" HorizontalOptions="Start" />
            <Label Text="{Binding StatusMessage}" />
            <Border Padding="14" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding ContextHelp.Title}" FontAttributes="Bold" />
                    <Label Text="{Binding ContextHelp.Content}" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout IsVisible="{Binding HasDiagnosticReport}" Spacing="6">
                <Label Text="Diagnostic report" FontAttributes="Bold" />
                <Editor Text="{Binding LastDiagnosticReport}" IsReadOnly="True" AutoSize="TextChanges" />
                <Button Text="Copy diagnostic report" Command="{Binding CopyDiagnosticReportCommand}" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <Button Text="Help &amp; Support" Command="{Binding ToggleHelpCommand}" HorizontalOptions="Start"
                    SemanticProperties.Hint="Show offline firmware selection, installation, DFU, driver, and recovery guidance" />
            <Border IsVisible="{Binding IsHelpVisible}" Padding="20" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Firmware Help &amp; Support" FontSize="24" FontAttributes="Bold" />
                    <Label Text="These essential instructions are embedded and remain available offline. External links provide additional official detail." />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupportSections}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FirmwareSupportSection">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding Content}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Official documentation and tools" FontSize="20" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupportLinks}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FirmwareSupportLink">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Text="{Binding Description}" />
                                    <Button Grid.Column="1" Grid.RowSpan="2" Text="Open"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:InstallFirmwareViewModel}}, Path=OpenSupportLinkCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Open Windows Device Manager" Command="{Binding OpenDeviceManagerCommand}"
                            IsVisible="{Binding CanOpenDeviceManager}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</navigation:ExtendedContentPage>
