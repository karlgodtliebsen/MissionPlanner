<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="450"
             xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
             xmlns:documents="clr-namespace:MissionPlanner.App.Presentation.Documents"
             xmlns:parametersEditor="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections.ParametersEditor"
             x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.ParametersEditor.ParametersEditorView"
             x:DataType="parametersEditor:ParametersEditorViewModel"
             >

        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >

            <Grid RowDefinitions="Auto,*" RowSpacing="20" >
                <controls:InformationDocumentView
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    >
                    <controls:InformationDocumentView.Document>
                        <MultiBinding Converter="{x:Static documents:ParameterEditorDocumentConverter.Instance}">
                            <Binding Path="StatusMessage" />
                            <Binding Path="WriteProgress" />
                            <Binding Path="ErrorMessage" />
                            <Binding Path="FeedbackReport" />
                        </MultiBinding>
                    </controls:InformationDocumentView.Document>
                </controls:InformationDocumentView>

                <Border Grid.Row="1" CornerRadius="10" >
                    <Grid
                        RowDefinitions="Auto,Auto,*"
                        RowSpacing="5"
                        >
                        <StackPanel x:Name="StandaloneQuickEditorToolbar"
                                    Grid.Row="0" Orientation="Horizontal" Spacing="10"
                                    IsVisible="{Binding ShowToolbar}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Classes="ToolbarIconButton"
                                    ToolTip.Tip="Clear text; pending edits are retained"
                                    AutomationProperties.Name="Clear Quick Editor"
                                    IsEnabled="{Binding !ApplyModifiedCommand.IsRunning}"
                                    Command="{Binding ClearCommand}">
                                <avalonia:MaterialIcon Kind="ClearCircleOutline" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton"
                                    ToolTip.Tip="Apply Quick Editor values"
                                    AutomationProperties.Name="Apply Quick Editor values"
                                    Command="{Binding ApplyModifiedCommand}">
                                <avalonia:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Grid.Column="0"
                              ColumnSpacing="10"
                              ColumnDefinitions="Auto,*,Auto"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding !ApplyModifiedCommand.IsRunning}">
                            <avalonia:MaterialIcon
                                Grid.Column="0"
                                Kind="Magnify"  Classes="ActionIcon" />
                            <AutoCompleteBox
                                Grid.Column="1"
                                Classes="ClearButton "
                                ItemsSource="{Binding ParameterNames}"
                                Text="{Binding SearchText, Mode=TwoWay}"
                                FilterMode="Contains" MinimumPrefixLength="1"
                                PlaceholderText="Search vehicle parameters"
                                AutomationProperties.Name="Search vehicle parameters" />

                            <Button Grid.Row="0" Grid.Column="2"
                                    Command="{Binding AddParameterCommand}"
                                    Classes="EmbeddedIconButton"
                                    ToolTip.Tip="Add selected parameter with its pending value"
                                    AutomationProperties.Name="Add selected parameter">
                                <avalonia:MaterialIcon Kind="Plus" Classes="ActionIcon"  />
                            </Button>
                        </Grid>
                        
                        <ScrollViewer  Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,20"
                                       x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <Grid RowSpacing="25" RowDefinitions="*,Auto">
                                <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="10">
                                    <TextBlock Text="Pending parameter values:" Classes="H4" />
                                    <TextBox  Grid.Row="1" Grid.Column="0"
                                              x:Name="ParameterTextEditor"
                                              AcceptsReturn="True"
                                              Focusable="True"
                                              Padding="10"
                                              IsReadOnly="{Binding ApplyModifiedCommand.IsRunning}"
                                              Text="{Binding Text, Mode=TwoWay}"
                                              FontSize="11"
                                              MaxLines="2000"
                                              MinHeight="200"
                                              VerticalContentAlignment="Top"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="10">
                                    <TextBlock Text="Current vehicle values:" Classes="H4" />
                                    <TextBox x:Name="CurrentParameterValues" Grid.Row="1" Padding="10" FontSize="11"
                                             MaxLines="2000"
                                             MinHeight="100"
                                             Text="{Binding UsedParametersText}"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Top"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             AutomationProperties.Name="Current values of entered parameters"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             />
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>


</UserControl>


