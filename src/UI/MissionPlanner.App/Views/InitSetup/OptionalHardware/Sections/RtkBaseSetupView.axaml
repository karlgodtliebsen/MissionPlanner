<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities" xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
 xmlns:core="clr-namespace:MissionPlanner.Core.Setup.OptionalHardware;assembly=MissionPlanner.Core"
 xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
 x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.RtkBaseSetupView" x:TypeArguments="sections:RtkBaseSetupViewModel" x:DataType="sections:RtkBaseSetupViewModel">
 <Grid RowDefinitions="Auto,*" Margin="12">
  <StackPanel Spacing="6">
   <TextBlock Text="u-blox base receiver" Classes="H3"/>
   <TextBlock Text="{Binding ReceiverIdentity}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"/>
   <WrapPanel ItemSpacing="8"><Button Command="{Binding MonitorCancelCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Disconnect base monitor" AutomationProperties.Name="Disconnect base monitor"><mdi:MaterialIcon Kind="LanDisconnect" Classes="ActionIcon"/></Button><Button Command="{Binding SurveyCancelCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Cancel survey configuration" AutomationProperties.Name="Cancel survey configuration"><mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon"/></Button><Button Command="{Binding FixedCancelCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Cancel fixed-position write" AutomationProperties.Name="Cancel fixed-position write"><mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon"/></Button><Button Command="{Binding CorrectionsCancelCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Cancel RTCM configuration" AutomationProperties.Name="Cancel RTCM configuration"><mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon"/></Button><Button Command="{Binding DisableCancelCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Cancel time-mode disable" AutomationProperties.Name="Cancel time-mode disable"><mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon"/></Button></WrapPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1"><StackPanel Spacing="12">
   <TextBlock Text="Supports receivers that answer the legacy UBX TMODE3 interface, including compatible M8P/F9P firmware. Stop forwarding before monitoring the same serial port; disconnect monitoring before restarting forwarding. No baud scan, reset, persistent save or vehicle command is performed. Disconnecting leaves receiver configuration active." TextWrapping="Wrap"/>
   <WrapPanel ItemSpacing="12" IsEnabled="{Binding !MonitorCommand.IsRunning}"><StackPanel><TextBlock Text="Receiver serial port"/><TextBox Text="{Binding Port}" Width="170" PlaceholderText="COM or /dev/..." AutomationProperties.Name="Base receiver port"/></StackPanel>
    <StackPanel Spacing="4"><TextBlock Text="Current baud"/><NumericUpDown Value="{Binding Baud}" Minimum="9600" Maximum="1000000" Increment="1" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Current baud"/></StackPanel><Button Command="{Binding MonitorCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Connect receiver and monitor" AutomationProperties.Name="Connect receiver and monitor"><mdi:MaterialIcon Kind="LanConnect" Classes="ActionIcon"/></Button></WrapPanel>
   <TextBlock Text="{Binding SurveyStatus}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding FixStatus}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding StreamStatus}" TextWrapping="Wrap"/>
   <Expander Header="Constellations and satellites" HorizontalAlignment="Stretch"><TextBlock Text="{Binding SatelliteStatus}" TextWrapping="Wrap"/></Expander>
   <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="12">
    <TextBlock Text="Survey-in thresholds" Classes="H4"/>
    <TextBlock Text="Keep the antenna stationary at its final reference point. Completion requires both duration and accuracy; a receiver's estimated accuracy is not proof of a surveyed absolute location." TextWrapping="Wrap"/>
    <WrapPanel ItemSpacing="12"><StackPanel Spacing="4"><TextBlock Text="Minimum seconds"/><NumericUpDown Value="{Binding SurveySeconds}" Minimum="60" Maximum="604800" Increment="1" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Minimum seconds"/></StackPanel><StackPanel Spacing="4"><TextBlock Text="Accuracy limit (m)"/><NumericUpDown Value="{Binding SurveyAccuracy}" Minimum="0.01" Maximum="100" Increment="0.01" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Accuracy limit (m)"/></StackPanel><Button Command="{Binding SurveyCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Start a new survey" AutomationProperties.Name="Start a new survey"><mdi:MaterialIcon Kind="Play" Classes="ActionIcon"/></Button><Button Command="{Binding UseSurveyCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Copy completed survey to local editors" AutomationProperties.Name="Copy completed survey to local editors"><mdi:MaterialIcon Kind="ContentCopy" Classes="ActionIcon"/></Button></WrapPanel>
    <TextBlock Text="Fixed position and local presets" Classes="H4"/>
    <ComboBox ItemsSource="{Binding SavedPositions}" SelectedItem="{Binding SelectedPosition}" PlaceholderText="Select a saved base position" HorizontalAlignment="Stretch" AutomationProperties.Name="Saved RTK base position">
     <ComboBox.ItemTemplate><DataTemplate x:DataType="core:RtkBasePosition"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBox Text="{Binding PositionName}" PlaceholderText="Position name" AutomationProperties.Name="Base position name"/>
    <WrapPanel ItemSpacing="12" LineSpacing="8"><StackPanel Spacing="4"><TextBlock Text="WGS84 latitude (°)"/><NumericUpDown Value="{Binding Latitude}" Minimum="-90" Maximum="90" Increment="0.000000001" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="WGS84 latitude (°)"/></StackPanel><StackPanel Spacing="4"><TextBlock Text="WGS84 longitude (°)"/><NumericUpDown Value="{Binding Longitude}" Minimum="-180" Maximum="180" Increment="0.000000001" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="WGS84 longitude (°)"/></StackPanel><StackPanel Spacing="4"><TextBlock Text="Ellipsoid height (m)"/><NumericUpDown Value="{Binding EllipsoidHeight}" Minimum="-1000" Maximum="20000" Increment="0.0001" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Ellipsoid height (m)"/></StackPanel><StackPanel Spacing="4"><TextBlock Text="Declared accuracy (m)"/><NumericUpDown Value="{Binding PositionAccuracy}" Minimum="0.0001" Maximum="100" Increment="0.0001" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Declared accuracy (m)"/></StackPanel></WrapPanel>
    <TextBlock Text="Height is WGS84 ellipsoid height at the antenna reference point, not MSL altitude. Verify the height datum. Incorrect fixed base coordinates shift rover positions. Selecting, saving or copying a preset only changes local data." TextWrapping="Wrap"/>
    <WrapPanel ItemSpacing="8"><Button Command="{Binding SavePositionCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Save local base position" AutomationProperties.Name="Save local base position"><mdi:MaterialIcon Kind="ContentSave" Classes="ActionIcon"/></Button><Button Command="{Binding DeletePositionCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Remove selected saved position" AutomationProperties.Name="Remove selected saved position"><mdi:MaterialIcon Kind="Delete" Classes="ActionIcon"/></Button><Button Command="{Binding FixedCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Apply fixed base position" AutomationProperties.Name="Apply fixed base position"><mdi:MaterialIcon Kind="Check" Classes="ActionIcon"/></Button><Button Command="{Binding DisableCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Disable base time mode" AutomationProperties.Name="Disable base time mode"><mdi:MaterialIcon Kind="Stop" Classes="ActionIcon"/></Button></WrapPanel>
    <TextBlock Text="RTCM output" Classes="H4"/>
    <TextBlock Text="Enable 1005, GPS 1074, GLONASS 1084 and 1230 on the current receiver port. Optional constellation messages require firmware support. Existing message rates on this and other ports are preserved. These are RAM settings. A valid base solution is still required before useful corrections appear." TextWrapping="Wrap"/>
    <WrapPanel ItemSpacing="12"><CheckBox Content="Also Galileo 1094" IsChecked="{Binding Galileo}"/><CheckBox Content="Also BeiDou 1124" IsChecked="{Binding BeiDou}"/><Button Command="{Binding CorrectionsCommand}" Classes="ToolbarIconButton" ToolTip.Tip="Enable reviewed RTCM output messages" AutomationProperties.Name="Enable reviewed RTCM output messages"><mdi:MaterialIcon Kind="Check" Classes="ActionIcon"/></Button></WrapPanel>
   </StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</utilities:UserControlViewBase>
