<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MissionPlanner.App.App"
             xmlns:local="using:AvaloniaApplication2"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="clr-namespace:MissionPlanner.App.Converters"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Geometries/Geometry.axaml" />
                <ResourceInclude Source="/Resources/Styles/VirtualizedItemsGrid.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BoolToObjectConverter x:Key="BoolToYesNoConverter" TrueObject="Yes" FalseObject="No" />
            <converters:IntegerDoubleConverter x:Key="IntegerDoubleConverter" />
            <converters:ByteDoubleConverter x:Key="ByteDoubleConverter" />
            <converters:StringDoubleConverter x:Key="StringDoubleConverter" />
            <converters:StringIntegerConverter x:Key="StringIntegerConverter" />
        </ResourceDictionary>
        <CornerRadius x:Key="ButtonCornerRadius">16</CornerRadius>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />
        <semi:UrsaSemiTheme Locale="en-US" />
        <semi:SemiPopupAnimations />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="/Resources/Styles/SharedStyles.axaml" />
        <StyleInclude Source="/Resources/Styles/VirtualizedItemsGridStyles.axaml" />
    </Application.Styles>
</Application>
