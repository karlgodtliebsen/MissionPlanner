<utilities:NavigationViewBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                xmlns:help="clr-namespace:MissionPlanner.App.Views.Help"
                xmlns:introduction="clr-namespace:MissionPlanner.App.Views.Introduction"
                x:TypeArguments="help:HelpViewModel"
                x:DataType="help:HelpViewModel"
                x:Class="MissionPlanner.App.Views.Help.HelpPage">
    <ContentPage Header="Help">
        <Grid ColumnDefinitions="220,*" ColumnSpacing="16" Margin="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Help topics" Classes="H3" />
                <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="help:HelpTopic">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <ContentControl Grid.Column="1" Content="{Binding SelectedTopic}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="help:HelpTopic">
                        <Grid>
                            <Grid IsVisible="{Binding IsTutorial}">
                                <introduction:TutorialView />
                            </Grid>
                            <Grid IsVisible="{Binding !IsTutorial}">
                                <help:HelpArticleView DataContext="{Binding Article}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
