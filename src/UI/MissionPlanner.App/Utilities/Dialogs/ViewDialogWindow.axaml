<ursa:UrsaWindow
    x:Class="MissionPlanner.App.Utilities.Dialogs.ViewDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ursa="https://irihi.tech/ursa"
    xmlns:vm="using:MissionPlanner.App.Utilities.Dialogs"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:DataType="vm:ViewDialogViewModel"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Label Content="{Binding Title}" FontSize="22" HorizontalAlignment="Center" Margin="25"></Label>
        <ContentControl
            Grid.Row="1"
            Margin="16"
            Content="{Binding Content}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"/>

        <Border
            Classes="SectionCard"
            Grid.Row="2"
            Padding="16,10">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">

                <Button
                    Classes="Secondary"
                    MinWidth="90"
                    ToolTip.Tip="{Binding CloseText}"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding ShowCloseButton}"
                >
                    <avalonia:MaterialIcon Kind="Cancel" Width="30" Height="30" />
                </Button>
                <Button
                    Classes="Primary"
                    MinWidth="90"
                    ToolTip.Tip="{Binding OkText}"
                    Command="{Binding OkCommand}"
                    IsVisible="{Binding ShowOkButton}"
                >
                    <avalonia:MaterialIcon Kind="CheckMultiple" Width="30" Height="30" />
                </Button>
            </StackPanel>

        </Border>

    </Grid>
</ursa:UrsaWindow>