<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia">
    <!-- Scoped to InformationDocumentView; package defaults remain separate. -->
    <Style Selector="md|MarkdownTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SemiColorBackground0}" />
    </Style>
</Styles>
