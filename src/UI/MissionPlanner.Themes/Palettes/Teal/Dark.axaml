<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compile-time merging gives every static control alias this palette scope. -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="../../Tokens/Base/Dark.axaml" />
        <MergeResourceInclude Source="../../Tokens/Accent.axaml" />
        <MergeResourceInclude Source="../../Themes/Dark/_index.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <StaticResource x:Key="PaletteNormalColor" ResourceKey="SemiTeal5Color" />
    <StaticResource x:Key="PaletteHoverColor" ResourceKey="SemiTeal6Color" />
    <StaticResource x:Key="PalettePressedColor" ResourceKey="SemiTeal4Color" />
    <StaticResource x:Key="PaletteDisabledColor" ResourceKey="SemiTeal2Color" />
    <StaticResource x:Key="PaletteSubtleColor" ResourceKey="SemiTeal0Color" />
    <StaticResource x:Key="PaletteSubtleHoverColor" ResourceKey="SemiTeal1Color" />
    <StaticResource x:Key="PaletteSubtlePressedColor" ResourceKey="SemiTeal1Color" />
    <StaticResource x:Key="PaletteTextColor" ResourceKey="SemiTeal8Color" />
    <Color x:Key="PaletteOnAccentColor">#16161A</Color>
    <Color x:Key="PaletteOnAccentHoverColor">#16161A</Color>
    <Color x:Key="PaletteOnAccentPressedColor">#16161A</Color>
    <Color x:Key="PaletteSelectionTextColor">#FFFFFF</Color>
</ResourceDictionary>
