<utilities:UserControlViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.Diagnostics"
    xmlns:diagnostics="clr-namespace:MissionPlanner.Core.Diagnostics;assembly=MissionPlanner.Core"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
    x:Class="MissionPlanner.App.Views.Diagnostics.LiveTelemetryInspectorView"
    x:TypeArguments="local:LiveTelemetryInspectorViewModel"
    x:DataType="local:LiveTelemetryInspectorViewModel"
    x:CompileBindings="True">
    <Grid
        RowDefinitions="Auto,Auto,*"
        Margin="12">
        <Grid
            ColumnDefinitions="*,Auto">
            <StackPanel
                Spacing="4">
                <TextBlock
                    Text="{Binding Header}"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding FlightSummary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding SelectionSummary}"
                    TextWrapping="Wrap"
                    FontWeight="Bold" />
                <TextBlock
                    Text="{Binding LiveLabel}"
                    TextWrapping="Wrap" />
                <Expander
                    Header="Vehicle and technical details"
                    HorizontalAlignment="Stretch">
                    <StackPanel
                        Spacing="5">
                        <ComboBox
                            ItemsSource="{Binding Vehicles}"
                            SelectedItem="{Binding SelectedVehicle}"
                            HorizontalAlignment="Stretch" />
                        <CheckBox
                            Content="Pin inspected vehicle"
                            IsChecked="{Binding IsVehiclePinned}" />
                        <Button
                            Content="Follow active vehicle"
                            Command="{Binding FollowActiveVehicleCommand}" />
                        <SelectableTextBlock
                            Text="{Binding TechnicalDetails}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding ExportTarget}"
                            TextWrapping="Wrap" />
                        <Slider
                            Minimum="360"
                            Maximum="760"
                            Value="{Binding DrawerWidth}"
                            ToolTip.Tip="Diagnostics panel width"
                            AutomationProperties.Name="Diagnostics panel width" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Top" IsVisible="{Binding !IsDetached}">
                <Button x:Name="DetachDiagnosticsButton"
                        Command="{Binding DetachCommand}"
                        IsVisible="{Binding CanDetach}"
                        ToolTip.Tip="Detach diagnostics"
                        AutomationProperties.Name="Detach diagnostics"
                        Width="32" Height="32" Padding="4"
                        Theme="{DynamicResource BorderlessIconButton}">
                    <mdi:MaterialIcon Kind="OpenInNew" Width="24" Height="24" />
                </Button>
                <Button
                    Command="{Binding CloseCommand}"
                    ToolTip.Tip="Close diagnostics"
                    AutomationProperties.Name="Close diagnostics"
                    Name="{x:Static u:DrawerControlBase.PART_CloseButton}"
                    Width="32"
                    Height="32"
                    Padding="4"
                    VerticalAlignment="Top"
                    Theme="{DynamicResource OverlayCloseButton}">
                    <mdi:MaterialIcon
                        Kind="Close"
                        Width="24"
                        Height="24" />
                </Button>
            </StackPanel>
        </Grid>
        <ComboBox
            Grid.Row="1"
            ItemsSource="{Binding Destinations}"
            SelectedItem="{Binding Destination}"
            HorizontalAlignment="Stretch"
            Margin="0,8" />
        <Grid
            Grid.Row="2">
            <local:ReadinessView
                IsVisible="{Binding ShowReadiness}" />
            <Grid
                IsVisible="{Binding ShowMessages}"
                RowDefinitions="Auto,*,Auto,*">
                <Button
                    Content="Mark current warnings read"
                    Command="{Binding MarkMessagesReadCommand}" />
                <tabs:MessagesTabItemView
                    Grid.Row="1" />
                <TextBlock
                    Grid.Row="2"
                    Text="Mode changes and command outcomes — reading messages does not resolve blockers."
                    TextWrapping="Wrap" />
                <ListBox
                    Grid.Row="3"
                    ItemsSource="{Binding Events}">
                    <ListBox.ItemTemplate>
                        <DataTemplate
                            x:DataType="diagnostics:VehicleDiagnosticEvent">
                            <StackPanel
                                Spacing="4"
                                Margin="0,4">
                                <TextBlock
                                    Text="{Binding At, Converter={x:Static local:DiagnosticTimeConverter.Instance}}" />
                                <TextBlock
                                    Text="{Binding Category}"
                                    FontWeight="SemiBold" />
                                <SelectableTextBlock
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid
                IsVisible="{Binding ShowInspector}"
                RowDefinitions="Auto,Auto,*,Auto,*">
                <WrapPanel
                    HorizontalAlignment="Center"
                    Grid.Row="0"
                    ItemSpacing="5">
                    <Button
                        Classes="ToolbarButton"
                        Command="{Binding FreezeCommand}"
                        ToolTip.Tip="Freeze / resume presentation">
                        <mdi:MaterialIcon
                            Kind="Pause"
                            Width="30"
                            Height="30" />
                    </Button>
                    <Button
                        Classes="ToolbarButton"
                        Command="{Binding ClearEventsCommand}"
                        ToolTip.Tip="Clear diagnostic events">
                        <mdi:MaterialIcon
                            Kind="Delete"
                            Width="30"
                            Height="30" />
                    </Button>
                    <Button
                        Classes="ToolbarButton"
                        Command="{Binding CopyEventsCommand}"
                        ToolTip.Tip="Copy diagnostic events">
                        <mdi:MaterialIcon
                            Kind="ContentCopy"
                            Width="30"
                            Height="30" />
                    </Button>
                </WrapPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,8"
                    Spacing="4">
                    <ComboBox
                        ItemsSource="{Binding Panels}"
                        SelectedItem="{Binding SelectedPanel}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <Grid
                    Grid.Row="2"
                    RowDefinitions="*,*"
                    ClipToBounds="True">
                    <Grid
                        Grid.Row="1"
                        IsVisible="{Binding ShowStatus}">
                        <tabs:StatusTabItemView />
                    </Grid>
                    <ListBox
                        x:Name="InspectorDetailsList"
                        Grid.RowSpan="{Binding DetailsRowSpan}"
                        ItemsSource="{Binding Details}"
                        ClipToBounds="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate
                                x:DataType="x:String">
                                <SelectableTextBlock
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Channels}"
                        IsVisible="{Binding ShowRc}">
                        <ListBox.ItemTemplate>
                            <DataTemplate
                                x:DataType="diagnostics:VehicleDiagnosticChannel">
                                <StackPanel
                                    Opacity="{Binding Opacity}"
                                    Margin="0,4"
                                    Spacing="3">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontWeight="SemiBold" />
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding Position}"
                                        Height="8" />
                                    <TextBlock
                                        Text="{Binding Calibration}"
                                        FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid
                        Grid.Row="1"
                        RowDefinitions="Auto,*"
                        IsVisible="{Binding ShowRaw}">
                        <StackPanel
                            Spacing="4">
                            <TextBox
                                Text="{Binding RawFilter}"
                                PlaceholderText="Message name / ID" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBox
                                    Text="{Binding RawSystem}"
                                    PlaceholderText="SysID"
                                    Width="90" />
                                <TextBox
                                    Text="{Binding RawComponent}"
                                    PlaceholderText="CompID"
                                    Width="90" />
                                <CheckBox
                                    IsChecked="{Binding FollowRaw}"
                                    VerticalAlignment="Center"
                                    Content="Follow / uncheck to pause" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox
                            Grid.Row="1"
                            ItemsSource="{Binding Raw}">
                            <ListBox.ItemTemplate>
                                <DataTemplate
                                    x:DataType="diagnostics:VehicleRawDiagnostic">
                                    <StackPanel
                                        Margin="0,4">
                                        <TextBlock
                                            Text="{Binding At, Converter={x:Static local:DiagnosticTimeConverter.Instance}}" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBlock
                                                Text="{Binding SystemId, StringFormat='Sys {0}'}" />
                                            <TextBlock
                                                Text="{Binding ComponentId, StringFormat='Comp {0}'}" />
                                            <TextBlock
                                                Text="{Binding MessageId}" />
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="Bold" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding Summary}" />
                                        <Expander
                                            Header="Complete wire payload (hex)">
                                            <SelectableTextBlock
                                                Text="{Binding Payload}"
                                                TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
                <Grid
                    Grid.Row="3"
                    ColumnDefinitions="*,Auto"
                    Margin="0,8"
                    ColumnSpacing="5">
                    <TextBox
                        x:Name="InspectorMarkerText"
                        Text="{Binding MarkerText}"
                        PlaceholderText="Optional marker text"
                        MaxLength="256" />
                    <Button
                        Classes="EmbeddedIconButton"
                        Grid.Column="1"
                        Command="{Binding AddMarkerCommand}"
                        ToolTip.Tip="Add marker">
                        <mdi:MaterialIcon
                            Kind="Flag"
                            Width="30"
                            Height="30" />
                    </Button>
                </Grid>
                <ListBox
                    Grid.Row="4"
                    ItemsSource="{Binding Events}">
                    <ListBox.ItemTemplate>
                        <DataTemplate
                            x:DataType="diagnostics:VehicleDiagnosticEvent">
                            <StackPanel
                                Margin="0,4">
                                <TextBlock
                                    Text="{Binding At, Converter={x:Static local:DiagnosticTimeConverter.Instance}}"
                                    Opacity="0.7" />
                                <TextBlock
                                    Text="{Binding Category}"
                                    FontWeight="SemiBold" />
                                <SelectableTextBlock
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</utilities:UserControlViewBase>
