<utilities:UserControlViewBase
                xmlns="https://github.com/avaloniaui"
                xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                xmlns:models="clr-namespace:MissionPlanner.App.Models"
                xmlns:u="https://irihi.tech/ursa"
                xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                x:TypeArguments="sections:SerialPortsViewModel"
                x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.SerialPortsView"
                x:DataType="sections:SerialPortsViewModel">

    <utilities:UserControlViewBase.Resources>
        <DataTemplate x:Key="SerialEditor" x:DataType="models:ParameterItemViewModel">
            <StackPanel Spacing="4">

                <TextBlock Text="{Binding Name}" Classes="H4" Opacity="0.7" />

                <ComboBox ItemsSource="{Binding ValuesData}"
                          SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                          IsVisible="{Binding HasValuesData}" HorizontalAlignment="Stretch" />

                <NumericUpDown Value="{Binding Value, Mode=TwoWay}"
                               IsVisible="{Binding !HasValuesData}" IsReadOnly="{Binding IsReadOnly}"
                               FormatString="0" Increment="1" />

                <u:MultiComboBox ItemsSource="{Binding BitmaskOptions}"
                                 SelectedItems="{Binding SelectedBitmaskItems, Mode=TwoWay}"
                                 IsVisible="{Binding HasBitmask}" ToolTip.Tip="Serial options" />

                <TextBlock Text="{Binding LiveValue, StringFormat='Readback: {0}'}" Classes="H5"
                           IsVisible="{Binding LiveValue, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <TextBlock Text="{Binding ValidationError}" Classes="Danger H5" TextWrapping="Wrap"
                           IsVisible="{Binding ValidationError, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <TextBlock Text="{Binding WriteMessage}" Classes="H5" TextWrapping="Wrap"
                           IsVisible="{Binding WriteMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
            </StackPanel>
        </DataTemplate>
    </utilities:UserControlViewBase.Resources>

    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <Border HorizontalAlignment="Stretch" Padding="12"  >
            <StackPanel Spacing="10">
                <TextBlock Text="Serial Ports" Classes="H2" />
                <TextBlock Text="Configure the flight controller's serial parameters. SERIAL indexes do not establish physical UART wiring. Unreported settings remain blank."
                           TextWrapping="Wrap" />
                <TextBlock Text="Speed is the configured baud setting; RC protocols may choose a different runtime baud rate."
                           TextWrapping="Wrap" />
                <TextBlock Text="Changes to serial port settings may not take effect until the flight controller is rebooted."
                           Classes="Warning" TextWrapping="Wrap" />
                <TextBlock Text="Confirmed changes require a flight-controller reboot." IsVisible="{Binding RebootRequired}"
                           Classes="Warning" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Theme="{DynamicResource ProgressRing}" />
                <TextBlock Text="{Binding Diagnostic}" IsVisible="{Binding Diagnostic, Converter={StaticResource StringNotNullEmptyConverter}}"  Classes="Warning" TextWrapping="Wrap" />
                <TextBlock Text="Receiver diagnostics include pending edits. No settings are written until Apply changes."
                           Classes="H5" TextWrapping="Wrap" />

            </StackPanel>
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Reload reported parameters"
                                IsEnabled="{Binding !IsBusy}"
                                AutomationProperties.Name="Reload reported parameters">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Full Parameters" AutomationProperties.Name="Open Full Parameters">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <controls:SetupInformationView Grid.Row="1"  Topic="SerialPorts"
                                                   WorkflowStatus="{Binding StatusMessage}"
                                                   WorkflowError="{Binding ErrorMessage}" />
                </Grid>
            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                            <Button Classes="ToolbarIconButton" Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="Reload reported parameters"
                                    IsEnabled="{Binding !IsBusy}"
                                    AutomationProperties.Name="Reload reported parameters">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Full Parameters" AutomationProperties.Name="Open Full Parameters">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Apply changes" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Apply changes">
                                <mdi:MaterialIcon Kind="Check" Classes="ActionIcon"/>
                            </Button>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="1" Margin="16"  HorizontalScrollBarVisibility="Disabled">
                        <Border Classes="SectionCard" Padding="12">
                            <ItemsControl ItemsSource="{Binding Ports}" IsEnabled="{Binding CanEdit}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sections:SerialPortRowViewModel">
                                        <StackPanel Spacing="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                            <u:Divider Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="5,10"></u:Divider>
                                            <StackPanel Spacing="8"  HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Classes="H3" />
                                                <WrapPanel ItemSpacing="15"  >
                                                    <StackPanel Width="180"  Spacing="4">
                                                        <TextBlock Text="Speed:" Classes="H4" />
                                                        <ContentControl Content="{Binding Speed}" ContentTemplate="{StaticResource SerialEditor}"
                                                                        IsEnabled="{Binding CanEditSpeed}" />
                                                    </StackPanel>
                                                    <StackPanel Width="210"  Spacing="4">
                                                        <TextBlock Text="Protocol:"  Classes="H4" />
                                                        <ContentControl Content="{Binding Protocol}" ContentTemplate="{StaticResource SerialEditor}"
                                                                        IsEnabled="{Binding CanEditProtocol}" />
                                                    </StackPanel>
                                                    <StackPanel Width="240"  Spacing="4">
                                                        <TextBlock Text="Options:"  Classes="H4" />
                                                        <ContentControl Content="{Binding Options}" ContentTemplate="{StaticResource SerialEditor}"
                                                                        IsEnabled="{Binding CanEditOptions}" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
