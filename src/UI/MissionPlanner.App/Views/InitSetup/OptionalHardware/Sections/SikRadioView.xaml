<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:SikRadioViewModel" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                                  x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.SikRadioView" x:DataType="sections:SikRadioViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="25" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="SiK / RFD Radio" FontSize="20" FontAttributes="Bold" />
            <Label Text="Direct serial configuration. Disconnect any vehicle using the selected port." TextColor="Orange" />
            <HorizontalStackLayout Spacing="50"  HorizontalOptions="Fill" HeightRequest="75" VerticalOptions="End">
                <Picker Title="Serial device" 
                        VerticalOptions="End"
                        ItemsSource="{Binding Ports}" 
                        SelectedItem="{Binding SelectedPort}" 
                        WidthRequest="180"/>
   
                <controls:NumericField
                    Title="BaudRate"
                    NumberFormat="F0"
                    VerticalOptions="End"
                    HorizontalOptions="End"
                    HorizontalTextAlignment="End"
                    Min="0"
                    Value="{Binding BaudRate, Mode=TwoWay}" 
                    WidthRequest="110"
                    />
             </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="25" HorizontalOptions="Fill" >
                <Button Text="Refresh ports" Command="{Binding RefreshPortsCommand}" HorizontalOptions="Start"/>
                <Button Text="Connect / Read" Command="{Binding ConnectCommand}" HorizontalOptions="End"/>
            </HorizontalStackLayout>


            <Label Text="{Binding Identity}" FontAttributes="Bold"/>
            <Label Text="{Binding Status}"/>

            <Editor Text="{Binding SettingsText}" HeightRequest="260" Placeholder="S0=value, one setting per line"/>

            <Button Text="Apply, save and reboot" Command="{Binding ApplyCommand}" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
