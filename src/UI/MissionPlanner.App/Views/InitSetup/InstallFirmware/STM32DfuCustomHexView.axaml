<view:UserControlViewBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:MissionPlanner.App.Utilities" xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.STM32DfuCustomHexView"
    x:TypeArguments="local:STM32BootloaderViewModel" x:DataType="local:STM32BootloaderViewModel">
    <StackPanel Spacing="20" Margin="25" IsEnabled="{Binding !InstallationRunning}">
        <Border Padding="20" Classes="SectionCard">
            <StackPanel Spacing="12">
                <TextBlock Text="Custom combined HEX" Classes="H3" />
                <TextBlock Text="This combined application-and-bootloader image replaces the current firmware. Select a local *_with_bl.hex file." Classes="Warning" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="12">
                    <Button Content="Load combined HEX" ToolTip.Tip="Load combined HEX" Command="{Binding LoadCustomBlWithFirmwareCommand}" />
                    <Button Content="Clear" ToolTip.Tip="Clear" Command="{Binding ClearLocalDfuFirmwareCommand}" />
                </WrapPanel>
                <SelectableTextBlock Text="{Binding LocalDfuFirmwareName}" />
                <SelectableTextBlock Text="{Binding LocalDfuFirmwarePath}" TextWrapping="Wrap" />
                <TextBlock Text="Intel HEX does not contain APJ board metadata. Enter the exact ArduPilot platform used to build this file; MCU type alone is insufficient." Classes="Warning" TextWrapping="Wrap" />
                <TextBox Text="{Binding LocalDfuPlatform}" PlaceholderText="Exact ArduPilot platform" MinWidth="250" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <local:STM32DfuArtifactView />
    </StackPanel>
</view:UserControlViewBase>
