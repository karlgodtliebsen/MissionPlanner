<utilities:TabItemViewBase x:TypeArguments="tabs:ServoRelayTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                           xmlns:controls="clr-namespace:MissionPlanner.AvaloniaUI.App.Controls"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.ServoRelayTabItemView"
                           x:DataType="tabs:ServoRelayTabViewModel">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
        <TextBlock Text="Observed servo outputs" FontSize="18" FontWeight="Bold"/>
        <controls:VirtualizedItemsGrid
            Grid.Row="1"
            ItemsSource="{Binding ServoOutputs}"
            ColumnWidths="*"
            RowMinHeight="34"
            ShowHeader="False"
            ShowSearchBar="False"
            ShowPagination="False"
            SelectionMode="None">
            <controls:VirtualizedItemsGrid.EmptyView>
                <TextBlock Text="No rows could be found."
                           FontSize="12"
                           Opacity="0.6"
                           Margin="0,20"
                           HorizontalAlignment="Center" />
            </controls:VirtualizedItemsGrid.EmptyView>
            <controls:VirtualizedItemsGrid.RowTemplate>
                <DataTemplate x:DataType="x:String">
                    <controls:VirtualizedItemsGridRow>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Classes="DataGridRow" />
                    </controls:VirtualizedItemsGridRow>
                </DataTemplate>
            </controls:VirtualizedItemsGrid.RowTemplate>
        </controls:VirtualizedItemsGrid>
        <Grid Grid.Row="2" ColumnDefinitions="100,120,Auto,*" ColumnSpacing="8">
            <NumericUpDown Value="{Binding Channel}" Minimum="1"/>
            <NumericUpDown Grid.Column="1" Value="{Binding Pwm}"/>
            <CheckBox Grid.Column="2" Content="Confirm disarmed test" IsChecked="{Binding IsConfirmed}"/>
            <Button Grid.Column="3" Content="Set servo" Command="{Binding SetServoCommand}"/>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Result}"/>
    </Grid>
</utilities:TabItemViewBase>
