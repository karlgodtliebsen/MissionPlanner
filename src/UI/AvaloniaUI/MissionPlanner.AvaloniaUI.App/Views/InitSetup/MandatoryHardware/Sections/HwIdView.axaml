<utilities:UserControlViewBase x:TypeArguments="sections:HwIdViewModel" xmlns="https://github.com/avaloniaui" xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hardware="clr-namespace:MissionPlanner.Core.Setup.MandatoryHardware;assembly=MissionPlanner.Core" xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.MandatoryHardware.Sections" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui" x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.MandatoryHardware.Sections.HwIdView" x:DataType="sections:HwIdViewModel">
<ScrollViewer VerticalScrollBarVisibility="Visible">
<StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
<TextBlock Text="HW ID" FontSize="18" FontWeight="Bold" />
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
<TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
<TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
<Border Classes="SectionCard" Padding="12">
<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="140,*" RowSpacing="6">
<TextBlock Text="Autopilot board" FontWeight="Bold" />
<TextBlock Grid.Column="1" Text="{Binding Board}" />
<TextBlock Grid.Row="1" Text="Firmware" FontWeight="Bold" />
<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Firmware}" />
</Grid>
</Border>
<ItemsControl ItemsSource="{Binding Items}">
<ItemsControl.ItemTemplate>
<DataTemplate x:DataType="hardware:HwIdItem">
<Grid ColumnDefinitions="220,*" ColumnSpacing="10" Margin="8">
<TextBlock Text="{Binding Name}" FontWeight="Bold" />
<TextBlock Grid.Column="1" Text="{Binding Description}" />
</Grid>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<Button Content="Refresh hardware IDs" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
</StackPanel>
</ScrollViewer>
</utilities:UserControlViewBase>