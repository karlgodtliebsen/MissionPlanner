<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Output"
                               x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Output.MirrorPage"
                               x:TypeArguments="local:MirrorViewModel"
                               x:DataType="local:MirrorViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa">

    <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="600" MaxWidth="900"  RowSpacing="20">
        <u:Banner ShowIcon="False"  Classes="Bordered" Header="MAVLink mirror" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>

            </StackPanel>
        </u:Banner>
        <WrapPanel Grid.Row="1" >
            <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" IsEnabled="{Binding !Running}" MinWidth="150" Margin="0,0,12,8" AutomationProperties.Name="Mirror direction" />
            <Button Classes="ToolbarIconButton" ToolTip.Tip="Start mirror" Command="{Binding StartCommand}" IsEnabled="{Binding !Running}" Margin="0,0,12,8" AutomationProperties.Name="Start mirror">
                <mdi:MaterialIcon Kind="PlayOutline" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarIconButton" ToolTip.Tip="Stop mirror" Command="{Binding StopCommand}" IsEnabled="{Binding Running}" Margin="0,0,12,8" AutomationProperties.Name="Stop mirror">
                <mdi:MaterialIcon Kind="StopCircleOutline" Classes="ActionIcon" />
            </Button>
        </WrapPanel>
        <TabControl Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Output endpoint" Margin="0,20"><local:OutputEndpointView DataContext="{Binding Endpoint}" /></TabItem>
            <TabItem Header="Output status" Margin="0,20"><local:OutputStatusView DataContext="{Binding Status}" /></TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
