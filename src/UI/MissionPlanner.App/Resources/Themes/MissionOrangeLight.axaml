<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App-owned semantic brushes. All selection surfaces are opaque. -->
    <SolidColorBrush x:Key="SemiColorPrimary" Color="#984B00" />
    <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#854000" />
    <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#713500" />
    <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#C9B7A5" />
    <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#FFF0DF" />
    <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#FFE1BD" />
    <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#FFD3A3" />
    <SolidColorBrush x:Key="SemiColorFocusBorder" Color="#984B00" />
    <SolidColorBrush x:Key="SemiColorLink" Color="#853E00" />
    <SolidColorBrush x:Key="SemiColorLinkPointerover" Color="#713500" />
    <SolidColorBrush x:Key="SemiColorLinkActive" Color="#592900" />
    <SolidColorBrush x:Key="SemiColorLinkVisited" Color="#853E00" />
    <SolidColorBrush x:Key="MissionAccentText" Color="#853E00" />
    <SolidColorBrush x:Key="MissionOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MissionOnAccentHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MissionOnAccentPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MissionSelectionText" Color="#16161A" />
    <!-- Control aliases audited against Semi 12.1.0.1 / Ursa 2.2.0; see docs/MISSION_ORANGE.md. -->
