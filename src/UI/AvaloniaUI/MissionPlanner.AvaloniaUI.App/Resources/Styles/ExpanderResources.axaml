<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Neutral header surface (idle/hover/pressed) -->
  <StaticResource x:Key="ToolbarGroupHeaderBg"           ResourceKey="SemiColorBackground1"/>
  <StaticResource x:Key="ToolbarGroupHeaderBgHover"      ResourceKey="SemiColorFill1"/>
  <StaticResource x:Key="ToolbarGroupHeaderBgPressed"    ResourceKey="SemiColorFill2"/>

  <!-- Checked/active tint (subtle brand) -->
  <StaticResource x:Key="ToolbarGroupHeaderBgChecked"    ResourceKey="SemiColorPrimaryLight"/>

  <!-- Hairline/dividers and focus -->
  <StaticResource x:Key="ToolbarGroupHeaderStroke"       ResourceKey="SemiColorBorder"/>
  <StaticResource x:Key="ToolbarGroupHeaderFocus"        ResourceKey="SemiColorFocusBorder"/>

  <!-- Icons/text in headers -->
  <StaticResource x:Key="ToolbarIconBrush"               ResourceKey="SemiColorText1"/>

  <Geometry x:Key="ChevronRightGeom">M 6 4 L 10 8 L 6 12</Geometry>
  <Geometry x:Key="ChevronDownGeom">M 4 6 L 8 10 L 12 6</Geometry>
</ResourceDictionary>

