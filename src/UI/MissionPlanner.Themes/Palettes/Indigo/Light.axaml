<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compile-time merging gives every static control alias this palette scope. -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="../../Tokens/Base/Light.axaml" />
        <MergeResourceInclude Source="../../Tokens/Accent.axaml" />
        <MergeResourceInclude Source="../../Themes/Light/_index.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <StaticResource x:Key="PaletteNormalColor" ResourceKey="SemiIndigo5Color" />
    <StaticResource x:Key="PaletteHoverColor" ResourceKey="SemiIndigo6Color" />
    <StaticResource x:Key="PalettePressedColor" ResourceKey="SemiIndigo7Color" />
    <StaticResource x:Key="PaletteDisabledColor" ResourceKey="SemiIndigo2Color" />
    <StaticResource x:Key="PaletteSubtleColor" ResourceKey="SemiIndigo0Color" />
    <StaticResource x:Key="PaletteSubtleHoverColor" ResourceKey="SemiIndigo1Color" />
    <StaticResource x:Key="PaletteSubtlePressedColor" ResourceKey="SemiIndigo1Color" />
    <StaticResource x:Key="PaletteTextColor" ResourceKey="SemiIndigo8Color" />
    <Color x:Key="PaletteSelectionTextColor">#16161A</Color>
</ResourceDictionary>
