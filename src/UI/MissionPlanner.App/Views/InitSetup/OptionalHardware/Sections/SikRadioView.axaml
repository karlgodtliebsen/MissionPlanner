<utilities:UserControlViewBase x:TypeArguments="sections:SikRadioViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.SikRadioView"
                               x:DataType="sections:SikRadioViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Grid.Row="0" HorizontalAlignment="Center" Padding="12" Classes="SourceBorder" x:Name="SourceBorder"  >
            <StackPanel Spacing="10">
                <TextBlock Text="SiK / RFD Radio" Classes="H2" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <TextBlock Text="Direct serial configuration. Disconnect any vehicle using the selected port." Classes="Warning" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                <Button Classes="IsToolbarButton" ToolTip.Tip="Refresh ports" Command="{Binding RefreshPortsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Refresh ports">
                    <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Connect / Read" Command="{Binding ConnectCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Connect / Read">
                    <mdi:MaterialIcon Kind="DownloadOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Apply, save and reboot" Command="{Binding ApplyCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Apply, save and reboot">
                    <mdi:MaterialIcon Kind="ContentSaveCheckOutline" Classes="ActionIcon" />
                </Button>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" HorizontalAlignment="Center" Padding="12"  Width="{Binding #SourceBorder.Bounds.Width}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="50" HorizontalAlignment="Stretch" Height="75" VerticalAlignment="Stretch">
                    <ComboBox ToolTip.Tip="Serial device" VerticalAlignment="Bottom" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Width="180" />
                    <NumericUpDown PlaceholderText="BaudRate" FormatString="F0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Minimum="0" Value="{Binding BaudRate, Mode=TwoWay}" Width="110" />
                </StackPanel>
                <TextBlock Text="{Binding Identity}" FontWeight="Bold" />
                <TextBox AcceptsReturn="True" Text="{Binding SettingsText}" Height="260" PlaceholderText="S0=value, one setting per line" />
            </StackPanel>
        </Border>

    </Grid>
</utilities:UserControlViewBase>
