<utilities:UserControlViewBase x:TypeArguments="sections:EscMotorSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.EscMotorSetupView"
                               x:DataType="sections:EscMotorSetupViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">

            <Border Classes="SectionCard" HorizontalAlignment="Center" >
                <StackPanel Orientation="Vertical" Spacing="12" HorizontalAlignment="Stretch" x:Name="PanelWidth">
                    <TextBlock Text="ESC calibration and motor test" Classes="H3" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"  Theme="{DynamicResource ProgressRing}" />
                    <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <SelectableTextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" />
                    <TextBlock Text="Remove ALL propellers before any actuator test. Motors will spin." Classes="Warning" FontWeight="Bold" />
                    <TextBlock Text="{Binding EscExplanation}" />
                    <ItemsControl IsVisible="{Binding EscCalibrationApplicable}" ItemsSource="{Binding EscSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="SectionCard" HorizontalAlignment="Center" >
                <StackPanel Orientation="Vertical" IsVisible="{Binding SupportsMotorTest}" Spacing="12"
                            Width="{Binding #PanelWidth.Bounds.Width}"
                            HorizontalAlignment="Stretch" >

                    <TextBlock Text="Motor test" Classes="SectionTitle" />

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="200,Auto" HorizontalAlignment="Center" RowSpacing="15">
                        <TextBlock Grid.Column="0" Text="Motor / count" Classes="H4" />
                        <NumericUpDown  Grid.Column="1" Grid.Row="0" Margin="10,0" PlaceholderText="Motor / count" Value="{Binding MotorIndex, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" HorizontalAlignment="Stretch" />
                        <TextBlock   Grid.Column="0" Grid.Row="1" Text="Throttle %" Classes="H4" />
                        <NumericUpDown  Grid.Column="1" Grid.Row="1" Margin="10,0" PlaceholderText="Throttle %" Value="{Binding ThrottlePercent, Mode=TwoWay}" FormatString="F1" HorizontalAlignment="Stretch" />
                        <TextBlock  Grid.Column="0" Grid.Row="2" Text="Duration (s)" Classes="H4" />
                        <NumericUpDown  Grid.Column="1" Grid.Row="2" Margin="10,0" PlaceholderText="Duration (s)" Value="{Binding DurationSeconds, Mode=TwoWay}" FormatString="F1" HorizontalAlignment="Stretch" />
                    </Grid>

                    
                    <TextBlock Margin="0,10" Text="{Binding Instruction}" Classes="H4" />

                    <StackPanel Orientation="Horizontal" Margin="0,10" Spacing="20" HorizontalAlignment="Right">
                        <Button Content="Test motor" ToolTip.Tip="Test motor" Command="{Binding TestMotorCommand}" />
                        <Button Content="Test sequence" ToolTip.Tip="Test sequence" Command="{Binding TestSequenceCommand}" />
                        <Button Foreground="{DynamicResource Warning}" FontWeight="Bold" Content="STOP" ToolTip.Tip="STOP" Command="{Binding StopCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="SectionCard" HorizontalAlignment="Center" >
                <StackPanel Orientation="Vertical" IsVisible="{Binding SupportsMotorTest}" Spacing="12"
                            Width="{Binding #PanelWidth.Bounds.Width}"
                            HorizontalAlignment="Stretch" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Margin="0,10" Text="Operation log:" FontWeight="Bold" />
                        <Border MinHeight="100">
                            <ItemsControl ItemsSource="{Binding Log}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding .}" FontSize="12" Opacity="0.8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>


    </ScrollViewer>
</utilities:UserControlViewBase>
