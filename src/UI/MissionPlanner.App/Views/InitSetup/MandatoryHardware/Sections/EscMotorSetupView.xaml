<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:EscMotorSetupViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                                  x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.EscMotorSetupView"
                                  x:DataType="sections:EscMotorSetupViewModel"
                                  >
    <ScrollView VerticalScrollBarVisibility="Always">
        <VerticalStackLayout Padding="16"  Spacing="25" HorizontalOptions="Center">
            <Label Text="ESC calibration and motor test" FontSize="18" FontAttributes="Bold" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" LineBreakMode="TailTruncation" />
            <uranium:SelectableLabel Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}"/>
            <Label Text="Remove ALL propellers before any actuator test. Motors will spin."
                   TextColor="{DynamicResource Warning}"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />
            <Label Text="{Binding EscExplanation}" LineBreakMode="WordWrap" />
            <VerticalStackLayout IsVisible="{Binding EscCalibrationApplicable}"
                             BindableLayout.ItemsSource="{Binding EscSteps}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" LineBreakMode="WordWrap" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding SupportsMotorTest}" Spacing="12">
                <Label Text="Motor test" FontSize="16" FontAttributes="Bold" />
                <FlexLayout Direction="Row" HorizontalOptions="Fill" >
                    <controls:NumericField
                        Margin="0,0,10,0"
                        Title="Motor / count"
                        Value="{Binding MotorIndex, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                        NumberFormat="F0"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />

                    <controls:NumericField
                        Margin="10,0"
                        Title="Throttle %"
                        Value="{Binding ThrottlePercent, Mode=TwoWay}"
                        NumberFormat="F1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />
                    <controls:NumericField
                        Margin="10,0"
                        Title="Duration (s)"
                        Value="{Binding DurationSeconds, Mode=TwoWay}"
                        NumberFormat="F1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />

                </FlexLayout>
                <Label Margin="0,10" Text="{Binding Instruction}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                <HorizontalStackLayout  Margin="0,10" Spacing="20" HorizontalOptions="Fill">
                    <Button Text="Test motor" Command="{Binding TestMotorCommand}" />
                    <Button Text="Test sequence" Command="{Binding TestSequenceCommand}" />
                    <Button TextColor="{DynamicResource Warning}" FontAttributes="Bold" Text="STOP" Command="{Binding StopCommand}" />
                </HorizontalStackLayout>

                <VerticalStackLayout>
                    <Label  Margin="0,10" Text="Operation log:" FontAttributes="Bold" />
                    <Border MinimumHeightRequest="100">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Log}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="12" Opacity="0.8" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>


            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
