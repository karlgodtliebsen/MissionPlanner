<utilities:UserControlViewBase
                x:TypeArguments="sections:Esp8266SetupViewModel"
                xmlns="https://github.com/avaloniaui"
                xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections.Esp8266SetupView"
                x:DataType="sections:Esp8266SetupViewModel">
    <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
        <TextBlock Text="ESP8266 MAVLink Bridge" FontSize="24" FontWeight="Bold" />
            <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" />
        <TextBlock Text="{Binding Target}" />
        <TextBox PlaceholderText="Access-point SSID" Text="{Binding Ssid}" />
        <TextBox PlaceholderText="Access-point password" Text="{Binding Password}" PasswordChar="●" />
        <TextBox PlaceholderText="Station SSID" Text="{Binding StationSsid}" />
        <TextBox PlaceholderText="Station password" Text="{Binding StationPassword}" PasswordChar="●" />
        <Button Content="Validate settings" Command="{Binding ValidateCommand}" HorizontalAlignment="Center" />
    </StackPanel>
</utilities:UserControlViewBase>
