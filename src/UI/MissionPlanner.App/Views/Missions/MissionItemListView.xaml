<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
                    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:missions="clr-namespace:MissionPlanner.App.Views.Missions"
                    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                    xmlns:controls="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
                    xmlns:extended="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                    x:Class="MissionPlanner.App.Views.Missions.MissionItemListView"
                    x:DataType="missions:MissionMapViewModel"
                    BackgroundColor="{DynamicResource Surface}"
                    x:Name="Root">

    <Grid RowDefinitions="Auto,*" Margin="10"
          RowSpacing="6" BackgroundColor="Transparent"  HorizontalOptions="Center"   VerticalOptions="Fill">

        <Border StyleClass="SurfaceContainer,Rounded,Elevation1" HorizontalOptions="Center"  >
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="10"
                  RowSpacing="6" BackgroundColor="Transparent"   HorizontalOptions="Fill"   VerticalOptions="Fill">
                <!-- Title + mode switch BackgroundColor="#252526" -->
                <Label Grid.Row="1"  Text="Mission" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="2" Text="{Binding HomePosition, StringFormat='Home: {0}'}" FontSize="12" Opacity="0.8" />

                <!-- Complete-mode header: info + editor settings -->
                <Label Grid.Row="3" Text="{Binding MissionSummary}" FontSize="12" FontAttributes="Bold" />

                <Grid Grid.Row="4" 
                      Width="400"
                      HorizontalOptions="Start"  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalOptions="Center" ColumnSpacing="6"
                        IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                    <Label Grid.Column="0" Text="WP Radius (m):" FontSize="11" VerticalOptions="Center"  />
                    <extended:NumericField
                        Grid.Column="1"   FontSize="11" WidthRequest="25"
                        Text="{Binding WaypointRadiusMeters,Mode=TwoWay}"
                        NumberFormat="F1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />

                    <Label Grid.Column="2" Text="Loiter Radius (m):" FontSize="11" VerticalOptions="Center"  />
                    <extended:NumericField
                        Grid.Column="3"   FontSize="11" WidthRequest="25"
                        Text="{Binding LoiterRadiusMeters,Mode=TwoWay}"
                        NumberFormat="F1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />

                    <Label Grid.Column="4" Text="Default Alt (m):" FontSize="11" VerticalOptions="Center" />
                    <extended:NumericField
                        Grid.Column="5"  FontSize="11" WidthRequest="25"
                        Text="{Binding DefaultAltitudeMeters,Mode=TwoWay}"
                        NumberFormat="F1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />
                    <Label Grid.Column="6" Text="Alt Warn (m):" FontSize="11" VerticalOptions="Center"  />
                    <extended:NumericField
                        Grid.Column="7" FontSize="11" WidthRequest="25"
                        Text="{Binding AltWarnMeters,Mode=TwoWay}"
                        NumberFormat="F1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />

                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="Fill" >

            <controls:VirtualizedDataGrid 
                ItemsSource="{Binding MissionItems}" 
                ItemSizingStrategy= "MeasureFirstItem"
                ShowSearchBar="False"
                HorizontalOptions="Center" 
                VerticalOptions="Fill" 
                BackgroundColor="Transparent"
            >
                <controls:VirtualizedDataGrid.EmptyView>
                    <Label HorizontalOptions="Center" Text="No mission items. Right-click the map to add waypoints."
                       FontSize="12" Opacity="0.6" Margin="0,20" />
                </controls:VirtualizedDataGrid.EmptyView>

                <controls:VirtualizedDataGrid.Columns>

                        <material:DataGridColumn Width="75" Title="#" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                            <material:DataGridColumn.CellItemTemplate>
                                <DataTemplate x:DataType="missions:MissionItemRow">
                                    <Label Text="{Binding Number}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"  />
                                </DataTemplate>
                            </material:DataGridColumn.CellItemTemplate>
                        </material:DataGridColumn>

                    <material:DataGridColumn Width="200" Title="Command" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <material:SelectField ItemsSource="{Binding CommandOptions, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                        SelectedItem="{Binding SelectedCommand}"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Param1"  IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <extended:NumericField
                                    Value="{Binding Param1, Mode=TwoWay}"
                                    NumberFormat="F1"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Param2"  IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <extended:NumericField
                                    Value="{Binding Param2, Mode=TwoWay}"
                                    NumberFormat="F1"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Param3" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <extended:NumericField
                                    Value="{Binding Param3, Mode=TwoWay}"
                                    NumberFormat="F1"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Param4" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <extended:NumericField
                                    Value="{Binding Param4, Mode=TwoWay}"
                                    NumberFormat="F1"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="120" Title="Latitude">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <extended:NumericField
                                    Value="{Binding Latitude, Mode=TwoWay}"
                                    NumberFormat="F7"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />

                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="120" Title="Longitude">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <extended:NumericField
                                    Value="{Binding Longitude, Mode=TwoWay}"
                                    NumberFormat="F7"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Alt (m)">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <extended:NumericField
                                    Value="{Binding Altitude, Mode=TwoWay}"
                                    NumberFormat="F1"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="125" Title="Frame" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <material:SelectField ItemsSource="{Binding FrameOptions, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                    SelectedItem="{Binding SelectedFrame}" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Distance" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label  Text="{Binding Distance, StringFormat='{0:F1}'}" VerticalOptions="Center" HorizontalOptions="Center" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Azimuth" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label  Text="{Binding Azimuth, StringFormat='{0:F0}'}"  VerticalOptions="Center" HorizontalOptions="Center" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Gradient" IsVisible="{Binding Source={x:Reference Root},Path=ShowAllRows}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label  Text="{Binding Gradient, StringFormat='{0:F1}'}"  VerticalOptions="Center" HorizontalOptions="Center" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="130" Title="Commands">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Button Text="▲" FontSize="10" Padding="4,2" HeightRequest="26" WidthRequest="26"
                                      Command="{Binding MoveItemUpCommand, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                      CommandParameter="{Binding .}" />
                                    <Button Text="▼" FontSize="10" Padding="4,2" HeightRequest="26" WidthRequest="26"
                                      Command="{Binding MoveItemDownCommand, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                      CommandParameter="{Binding .}" />
                                    <Button Text="✕" FontSize="10" Padding="4,2" HeightRequest="26" WidthRequest="26"
                                      Command="{Binding RemoveItemCommand, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                      CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                </controls:VirtualizedDataGrid.Columns>
            </controls:VirtualizedDataGrid>
        </Grid>
    </Grid>
</ContentView>
