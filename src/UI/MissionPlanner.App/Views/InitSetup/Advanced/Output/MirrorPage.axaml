<utilities:NavigationViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Output"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Output.MirrorPage"
    x:TypeArguments="local:MirrorViewModel" x:DataType="local:MirrorViewModel"
                            xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <ContentPage Header="MAVLink Output / Mirror">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" Margin="24">
            <StackPanel Spacing="8">
                <TextBlock Text="MAVLink mirror" Classes="Title" />
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Row="1">
                <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" IsEnabled="{Binding !Running}" MinWidth="150" Margin="0,0,12,8" AutomationProperties.Name="Mirror direction" />
                <Button ToolTip.Tip="Start mirror" Command="{Binding StartCommand}" IsEnabled="{Binding !Running}" Margin="0,0,12,8" AutomationProperties.Name="Start mirror">
                    <mdi:MaterialIcon Kind="PlayOutline" Classes="ActionIcon" />
                </Button>
                <Button ToolTip.Tip="Stop mirror" Command="{Binding StopCommand}" IsEnabled="{Binding Running}" Margin="0,0,12,8" AutomationProperties.Name="Stop mirror">
                    <mdi:MaterialIcon Kind="StopCircleOutline" Classes="ActionIcon" />
                </Button>
            </WrapPanel>
            <TabControl Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <TabItem Header="Output endpoint"><local:OutputEndpointView DataContext="{Binding Endpoint}" /></TabItem>
                <TabItem Header="Output status"><local:OutputStatusView DataContext="{Binding Status}" /></TabItem>
            </TabControl>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
