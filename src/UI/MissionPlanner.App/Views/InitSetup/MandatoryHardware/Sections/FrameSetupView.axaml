<utilities:UserControlViewBase x:TypeArguments="sections:FrameSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FrameSetupView"
                               x:DataType="sections:FrameSetupViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Grid.Row="0" HorizontalAlignment="Center" Padding="12" Classes="SourceBorder" x:Name="SourceBorder"  >
            <StackPanel Spacing="10">
                <TextBlock Text="Supported frame configuration" Classes="H2" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />

                <TextBlock Text="{Binding StatusMessage}"  TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"
                           />
                <SelectableTextBlock Text="{Binding ErrorMessage}"  Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"
                                     />

                <TextBlock Text="{Binding FirmwareFamily, StringFormat='Firmware family: {0}'}" />
                <TextBlock Text="Only values advertised by the connected firmware metadata are shown. Current values remain unchanged until Write and Verify is confirmed." />

                <TextBlock IsVisible="{Binding RebootRequired}"
                           Text="Vehicle Reboot required. Reconnect, then use Refresh vehicle values to confirm the persisted configuration." Classes="Warning" FontWeight="Bold" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                <Button ToolTip.Tip="Refresh vehicle values"  Classes="ToolbarButton" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh vehicle values">
                    <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
                <Button ToolTip.Tip="Write and verify" Classes="ToolbarButton" Command="{Binding ApplyCommand}" AutomationProperties.Name="Write and verify">
                    <mdi:MaterialIcon Kind="UploadOutline" Classes="ActionIcon" />
                </Button>
            </WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" 
                      Margin="16,0" HorizontalAlignment="Center">
            <Border Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sections:FrameParameterSettingViewModel">
                                <Border Padding="10" Classes="SectionCard">
                                    <Grid ColumnDefinitions="180,*,200" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding DisplayName}" Classes="H5" />
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CurrentDisplay, StringFormat='Current: {0}'}"  Classes="H5"/>
                                        <ComboBox  Grid.Column="2" Grid.Row="0" ToolTip.Tip="Select frame value"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Right"
                                                   ItemsSource="{Binding Options}"
                                                   SelectedItem="{Binding SelectedOption}"
                                                   DisplayMemberBinding="{Binding Label}" />
                                        <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                                                   IsVisible="{Binding HasChange}"
                                                   Text="{Binding PendingDisplay, StringFormat='Pending: {0}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock IsVisible="{Binding HasRecommendations}" Text="Optional initial recommendations" Classes="H3" />
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sections:FrameRecommendationViewModel">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <CheckBox Content="{Binding Description}" IsChecked="{Binding IsSelected}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</utilities:UserControlViewBase>
