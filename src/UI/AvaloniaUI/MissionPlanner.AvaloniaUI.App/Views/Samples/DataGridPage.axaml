<utilities:NavigationViewBase x:TypeArguments="samples:DataGridViewModel" xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                              xmlns:samples="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.Samples"
                              xmlns:controls="clr-namespace:MissionPlanner.AvaloniaUI.App.Controls"
                              xmlns:common="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.Common"
                              xmlns:u="https://irihi.tech/ursa"
                              mc:Ignorable="d" d:DesignWidth="1980" d:DesignHeight="800"
                              x:DataType="samples:DataGridViewModel"
                              x:Class="MissionPlanner.AvaloniaUI.App.Views.Samples.DataGridPage">

    <ContentPage Header="Large DataGrid Sample">

        <Grid RowDefinitions="Auto,*"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Margin="8,0"

              >

            <StackPanel Orientation="Horizontal" Grid.Row="0" MinHeight="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="8,0" Spacing="12" >
                <Button
                    Content="Load sample data from json file"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Command="{Binding LoadFromJsonFileCommand}" >
                </Button>

            </StackPanel>


            <!--
            <controls:VirtualizedItemsGrid.EmptyView>
            <StackPanel Orientation="Vertical"
            Padding="40"
            Spacing="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            --><!--                        <Image
            WidthRequest="40"
            HeightRequest="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static uranium:MaterialOutlined.Backup_table},
            Color={AppThemeBinding Light={StaticResource OnSurface},
            Dark={StaticResource OnSurfaceDark}}}"/>
            --><!--
            <Label
            Content="No parameters match the current filter."
            FontWeight="Bold"
            FontSize="16"
            HorizontalContentAlignment="Center" />
            <Label
            Content="Refresh parameters or clear the search text to display parameters."
            FontSize="13"
            Opacity="0.75"
            HorizontalContentAlignment="Center" />
            </StackPanel>
            </controls:VirtualizedItemsGrid.EmptyView>-->

            <controls:VirtualizedItemsGrid
                Grid.Row="1"

                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"

                ItemsSource="{Binding Parameters}"

                ColumnWidths="160,100,180,100,100,100,100,125,150,*"
                ColumnSpacing="6"
                RowMinHeight="38"

                ShowHeader="True"

                ShowSearchBar="True"
                SearchWatermark="Search by name or description..."
                SearchMemberPaths="Name,DisplayName,Description,Range,Units,MavNumericType,WriteStatus"

                ShowPagination="False"

                SelectionMode="Multiple"
                SelectionColumnWidth="50">

                <!-- ================================================= -->
                <!-- Empty view                                                   -->
                <!-- ================================================= -->

                <controls:VirtualizedItemsGrid.EmptyView >
                    <StackPanel
                        Margin="20"
                        Spacing="6"
                        HorizontalAlignment="Stretch">

                        <TextBlock
                            HorizontalAlignment="Stretch"
                            Text="No parameters found."
                            Classes="H3"
                            Opacity="0.65" />

                    </StackPanel>
                </controls:VirtualizedItemsGrid.EmptyView>


                <!-- Header                                                       -->

                <controls:VirtualizedItemsGrid.HeaderTemplate>
                    <DataTemplate>

                        <controls:VirtualizedItemsGridRow>

                            <TextBlock

                                Grid.Column="0"
                                Text="Param"
                                Classes="DataGridColumn"
                                />

                            <TextBlock
                                Grid.Column="1"
                                Text="Value"
                                Classes="DataGridColumn"
                                />

                            <TextBlock
                                Grid.Column="2"
                                Text="Selections"
                                Classes="DataGridColumn"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="Range"
                                Classes="DataGridColumn"/>

                            <TextBlock
                                Grid.Column="4"
                                Text="StepSize"
                                Classes="DataGridColumn"
                                />

                            <TextBlock
                                Grid.Column="5"
                                Text="Type"
                                Classes="DataGridColumn"
                                />

                            <TextBlock
                                Grid.Column="6"
                                Text="Default"
                                Classes="DataGridColumn"
                                />

                            <TextBlock
                                Grid.Column="7"
                                Text="Units"
                                Classes="DataGridColumn"
                                />

                            <TextBlock
                                Grid.Column="8"
                                Text="Write status"
                                Classes="DataGridColumn"
                                />

                            <TextBlock
                                Grid.Column="9"
                                Text="Description"
                                Classes="DataGridColumn"
                                HorizontalAlignment="Right"
                                Background="Red"
                                />

                        </controls:VirtualizedItemsGridRow>

                    </DataTemplate>
                </controls:VirtualizedItemsGrid.HeaderTemplate>


                <!-- ================================================= -->
                <!-- Rows                                                         -->
                <!-- ================================================= -->

                <controls:VirtualizedItemsGrid.RowTemplate>

                    <DataTemplate x:DataType="common:ParameterItemViewModel">

                        <controls:VirtualizedItemsGridRow>


                            <!-- ================================================= -->
                            <!-- Parameter name                                    -->
                            <!-- ================================================= -->

                            <SelectableTextBlock
                                Grid.Column="0"
                                Text="{Binding Name}"
                                Classes="DataGridRow"
                                />


                            <!-- ================================================= -->
                            <!-- Current value                                     -->
                            <!-- ================================================= -->

                            <NumericUpDown
                                Grid.Column="1"
                                Classes="DataGridRow"
                                Margin="4,2"
                                Minimum="{Binding Min}"
                                Maximum="{Binding Max}"
                                Increment="{Binding StepSize}"
                                Value="{Binding Value, Mode=TwoWay}" />


                            <!-- ================================================= -->
                            <!-- Selection / specialised editor                    -->
                            <!-- ================================================= -->

                            <Grid
                                Grid.Column="2"
                                Margin="4,2"
                                VerticalAlignment="Center">

                                <!-- ================================================= -->
                                <!-- Enumerated parameter   -->
                                <!-- ================================================= -->

                                <ComboBox
                                    IsVisible="{Binding HasValuesData}"
                                    ItemsSource="{Binding ValuesData}"
                                    SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                                    Classes="DataGridRow" />


                                <!-- ================================================= -->
                                <!-- Bitmask parameter                              -->
                                <!-- ================================================= -->

                                <u:MultiComboBox
                                    IsVisible="{Binding HasBitmask}"
                                    ItemsSource="{Binding BitmaskOptions}"
                                    SelectedItems="{Binding SelectedBitmaskItems}"
                                    Classes="DataGridRow">
     <!--                               <Button.Flyout>
                                        <Flyout Placement="Bottom">

                                            <ListBox
                                                MinWidth="200"
                                                MaxHeight="320"

                                                ItemsSource="{Binding BitmaskOptions}"
                                                SelectedItems="{Binding SelectedBitmaskItems}"
                                                SelectionMode="Multiple,Toggle" />
                                        </Flyout>
                                    </Button.Flyout>-->
                                </u:MultiComboBox>

                                <!-- ================================================= -->
                                <!-- Numeric range parameter                        -->
                                <!-- ================================================= -->

                                <NumericUpDown
                                    IsVisible="{Binding HasNumericRangeData}"
                                    Classes="DataGridRow"
                                    Minimum="{Binding Min}"
                                    Maximum="{Binding Max}"
                                    Increment="{Binding StepSize}"
                                    Value="{Binding Value, Mode=TwoWay}" />
                            </Grid>


                            <!-- ================================================= -->
                            <!-- Range                                             -->
                            <!-- ================================================= -->

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding Range}"
                                Classes="DataGridRow"  />


                            <!-- ================================================= -->
                            <!-- Step size                                         -->
                            <!-- ================================================= -->

                            <TextBlock
                                Grid.Column="4"
                                Text="{Binding StepSize}"
                                Classes="DataGridRow" 
                                 />


                            <!-- ================================================= -->
                            <!-- MAV numeric type                                  -->
                            <!-- ================================================= -->

                            <TextBlock
                                Grid.Column="5"
                                Text="{Binding MavNumericType}"
                                Classes="DataGridRow" 
                                />


                            <!-- ================================================= -->
                            <!-- Default                                           -->
                            <!-- ================================================= -->

                            <TextBlock
                                Grid.Column="6"
                                Text="{Binding OriginalValueText}"
                                Classes="DataGridRow"  />


                            <!-- ================================================= -->
                            <!-- Units                                             -->
                            <!-- ================================================= -->

                            <TextBlock
                                Grid.Column="7"
                                Text="{Binding Units}"
                                Classes="DataGridRow" />


                            <!-- ================================================= -->
                            <!-- Write status                                      -->
                            <!-- ================================================= -->

                            <StackPanel
                                Grid.Column="8"
                                Orientation="Vertical"
                                Margin="10,3"
                                Spacing="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="{Binding WriteStatus}"
                                    Classes="DataGridRow"  />

                                <TextBlock
                                    Text="{Binding WriteMessage}"
                                    TextWrapping="Wrap"
                                    Classes="DataGridRow"  />

                            </StackPanel>


                            <!-- ================================================= -->
                            <!-- Description                                       -->
                            <!-- ================================================= -->

                            <StackPanel
                                Grid.Column="9"
                                Orientation="Vertical"
                                Margin="10,6"
                                Spacing="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    TextWrapping="Wrap"
                                    Classes="DataGridRow" />

                                <TextBlock
                                    Text="{Binding Description}"
                                    Classes="DataGridRow" 
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </controls:VirtualizedItemsGridRow>

                    </DataTemplate>

                </controls:VirtualizedItemsGrid.RowTemplate>

            </controls:VirtualizedItemsGrid>


        </Grid>



    </ContentPage>
</utilities:NavigationViewBase>
