<utilities:NavigationViewBase x:TypeArguments="sections:ExtendedTuningTabViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                              xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                              xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              xmlns:sections="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections"
                              xmlns:u="https://irihi.tech/ursa"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.ExtendedTuningTabView"
                              x:DataType="sections:ExtendedTuningTabViewModel">
    <ContentPage Header="Extended Tuning"  >

        <Grid x:Name="ExtendedTuningTabViewLayout" RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="10" Classes.expanded="{Binding IsEditorExpanded}">
            <Grid.Styles>
                <Style Selector="Grid#ExtendedTuningTabViewLayout">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style Selector="Grid#ExtendedTuningTabViewLayout.expanded">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="900" MaxWidth="{Binding EditorColumnMaxWidth}" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ToggleEditorWidthButton"
                Grid.Column="0" Grid.Row="0"
                Classes="Expander"
                Margin="0,0,4,0"
                ToolTip.Tip="{Binding ToggleEditorWidthText}"
                AutomationProperties.Name="{Binding ToggleEditorWidthText}"
                Command="{Binding ToggleEditorWidthCommand}">
                <Grid>
                    <avalonia:MaterialIcon Kind="ChevronLeft" Width="22" Height="22"
                                      IsVisible="{Binding !IsEditorExpanded}" />
                    <avalonia:MaterialIcon Kind="ChevronRight" Width="22" Height="22"
                                      IsVisible="{Binding IsEditorExpanded}" />
                </Grid>
            </Button>

            <u:Banner Grid.Column="1" Classes="Bordered" Header="Extended Tuning"
                      ShowIcon="False"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Grid.Row="0"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="10" >
                    <TextBlock Text="{Binding FirmwareFamilyText, StringFormat='Advanced firmware profile: {0}'}" />
                    <TextBlock Text="Expert page: changes to controllers, estimators, and filters can destabilize a vehicle. Autotune execution is intentionally not available here."
                               Classes="Warning"
                               IsVisible="{Binding HasSupportedProfile}" />
                    <TextBlock Text="This connected firmware has no supported advanced profile."
                               Classes="Warning"
                               IsVisible="{Binding IsUnsupported}" />
                    <SelectableTextBlock Text="{Binding ErrorMessage}"
                                         IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"
                                         Classes="Danger" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </u:Banner>
            
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" Spacing="10" HorizontalAlignment="Stretch">
                <TextBox HorizontalAlignment="Right" PlaceholderText="Search curated advanced parameters"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         IsVisible="{Binding IsConnected}"/>
                <ProgressBar IsIndeterminate="True"  Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
            <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="10" IsVisible="{Binding HasSupportedProfile}">
            
                <u:UrsaGroupBox >
                    <u:UrsaGroupBox.Header >
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource SemiColorSecondary}" Text="{Binding ModifiedCount, StringFormat='Pending advanced changes: {0}'}" />
                    </u:UrsaGroupBox.Header>
                    <StackPanel Margin="12" Spacing="12">
                        <TextBlock Text="{Binding ChangeSummary}"
                                   MaxLines="5"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </u:UrsaGroupBox>

                <u:UrsaGroupBox  Grid.Column="1" >
                    <u:UrsaGroupBox.Header >
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource SemiColorSecondary}" Text="Live controller response (read-only PID_TUNING context)" />
                    </u:UrsaGroupBox.Header>
                    <StackPanel Margin="12" Spacing="12">
                           <controls:VirtualizedItemsGrid
                            ItemsSource="{Binding ResponseMetrics}"
                            ColumnWidths="*,*,*,*"
                            ColumnSpacing="6"
                            RowMinHeight="28"
                            ShowHeader="True"
                            ShowSearchBar="False"
                            ShowPagination="False"
                            SelectionMode="None"
                            Height="54"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <controls:VirtualizedItemsGrid.EmptyView>
                                <TextBlock Text="No PID response telemetry received."
                                           FontSize="12"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </controls:VirtualizedItemsGrid.EmptyView>
                            <controls:VirtualizedItemsGrid.HeaderTemplate>
                                <DataTemplate>
                                    <controls:VirtualizedItemsGridRow>
                                        <TextBlock Grid.Column="0" Text="Axis" Classes="DataGridColumn" />
                                        <TextBlock Grid.Column="1" Text="Desired" Classes="DataGridColumn" />
                                        <TextBlock Grid.Column="2" Text="Achieved" Classes="DataGridColumn" />
                                        <TextBlock Grid.Column="3" Text="Error" Classes="DataGridColumn Danger" />
                                    </controls:VirtualizedItemsGridRow>
                                </DataTemplate>
                            </controls:VirtualizedItemsGrid.HeaderTemplate>
                            <controls:VirtualizedItemsGrid.RowTemplate>
                                <DataTemplate x:DataType="sections:ControlResponseMetricViewModel">
                                    <controls:VirtualizedItemsGridRow>
                                        <TextBlock Grid.Column="0" Text="{Binding Axis}" Classes="DataGridRow" />
                                        <TextBlock Grid.Column="1" Text="{Binding Desired}" Classes="DataGridRow" />
                                        <TextBlock Grid.Column="2" Text="{Binding Achieved}" Classes="DataGridRow" />
                                        <TextBlock Grid.Column="3" Text="{Binding Error}" Classes="DataGridRow Danger" />
                                    </controls:VirtualizedItemsGridRow>
                                </DataTemplate>
                            </controls:VirtualizedItemsGrid.RowTemplate>
                        </controls:VirtualizedItemsGrid>        
                    </StackPanel>
                </u:UrsaGroupBox>
            </Grid>
            <Border Grid.Column="1" Grid.Row="3"  Classes="SectionCard">
            <ListBox Grid.Column="1"
                     ItemsSource="{Binding VisibleGroups}"
                     IsVisible="{Binding HasSupportedProfile}">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sections:ExtendedTuningGroupViewModel">
                        <Border Padding="12" Margin="0,0,0,10">
                            <Expander
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Vertical" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="20" />
                                            <TextBlock Text="{Binding Category}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SupportedFieldCount, StringFormat='{}{0} supported fields'}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ExpertWarning}"
                                                   Classes="Warning"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ValidationMessage}"
                                                   Classes="Warning"
                                                   IsVisible="{Binding HasValidationError}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="This group has pending changes."
                                                   Classes="Warning"
                                                   IsVisible="{Binding IsModified}" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="ToolbarButton"  ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}" >
                                                <avalonia:MaterialIcon Kind="Refresh" Width="30" Height="30" />
                                            </Button>
                                            <Button Classes="ToolbarButton" ToolTip.Tip="Revert group" Command="{Binding RevertCommand}" >
                                                <avalonia:MaterialIcon Kind="FileUndoOutline" Width="30" Height="30" />
                                            </Button>
                                            <Button Classes="ToolbarButton"  ToolTip.Tip="Review &amp; apply group" Command="{Binding ApplyCommand}" >
                                                <avalonia:MaterialIcon Kind="CheckCircleOutline" Width="30" Height="30" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="6" IsVisible="{Binding SupportsAxisCopy}">
                                            <ComboBox ToolTip.Tip="Source axis" Width="110" ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedSourceAxis}" />
                                            <ComboBox ToolTip.Tip="Target axis" Width="110" ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedTargetAxis}" />
                                            <Button Classes="ToolbarButton"  ToolTip.Tip="Preview axis copy" Command="{Binding PreviewCopyCommand}" >
                                                <avalonia:MaterialIcon Kind="EyeOutline" Width="30" Height="30" />
                                            </Button>          
                                        </StackPanel>
                                    </Grid>

                                    <Border Padding="10" IsVisible="{Binding HasCopyPreview}" Classes="SectionCard">
                                        <StackPanel Orientation="Vertical" Spacing="4">
                                            <TextBlock Text="Axis copy preview — no pending values have changed" FontWeight="Bold" />
                                            <ItemsControl ItemsSource="{Binding CopyPreview}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sections:AxisCopyChangeViewModel">
                                                        <Grid ColumnDefinitions="90,*,*,Auto,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding Component}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SourceParameter}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding TargetParameter}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding BeforeValue, StringFormat='{}{0:G} →'}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding AfterValue, StringFormat='{}{0:G}'}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="ToolbarButton"   ToolTip.Tip="Confirm preview into pending values"
                                                      Command="{Binding ApplyCopyCommand}" HorizontalAlignment="Right" >
                                                <avalonia:MaterialIcon Kind="CheckCircleOutline" Width="30" Height="30" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sections:AdvancedTuningFieldViewModel">
                                                <Border Padding="10" BorderThickness="1" Classes="SectionCard">
                                                    <Grid ColumnDefinitions="120,2*,Auto,180" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock Text="{Binding AxisText}"  />
                                                            <TextBlock Text="{Binding InstanceText}"  />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Vertical" Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}"  />
                                                            <TextBlock Text="{Binding ParameterName}"  Opacity="0.7" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Editor.LiveValue, StringFormat='Live {0:G}'}" 
                                                                   VerticalAlignment="Center" />
                                                        <Grid Grid.Column="3">
                                                            <NumericUpDown
                                                                IsReadOnly="{Binding Editor.IsReadOnly}"
                                                                IsVisible="{Binding !Editor.HasValuesData}"
                                                                Value="{Binding Editor.Value, Mode=TwoWay}"
                                                                HorizontalAlignment="Stretch"
                                                                />
                                                            <ComboBox ItemsSource="{Binding Editor.ValuesData}"
                                                                      SelectedItem="{Binding Editor.SelectedValue, Mode=TwoWay}"
                                                                      IsVisible="{Binding Editor.HasValuesData}" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                    />
                                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Units, StringFormat='Units: {0}'}"  />

                                                        <ProgressBar Grid.Row="2" Grid.Column="0"
                                                                     Value="{Binding NormalizedMagnitude}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Normalized magnitude across axes"  />
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                                                   Text="{Binding Editor.ValidationError}"
                                                                   Classes="Warning"
                                                                    />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Border>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
