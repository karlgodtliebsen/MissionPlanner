<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Signing"
                               x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Signing.SigningPage"
                               x:TypeArguments="local:SigningViewModel"
                               x:DataType="local:SigningViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch" RowSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner ShowIcon="False"  Classes="Bordered" Header="MAVLink signing" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Storage}" TextWrapping="Wrap" Classes="Warning" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
            </StackPanel>
        </u:Banner>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <local:SigningKeyView DataContext="{Binding Keys}" />
                <Border Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Vehicle setup" Classes="H4" />
                        <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        <WrapPanel ItemSpacing="10" HorizontalAlignment="Center">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Configure signing…" Command="{Binding ConfigureCommand}" 
                                    IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" AutomationProperties.Name="Configure signing…">
                                <mdi:MaterialIcon Kind="KeyOutline" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding DisableCommand}" IsEnabled="{Binding !IsBusy}"
                                    ToolTip.Tip="Disable vehicle signing" AutomationProperties.Name="Disable vehicle signing" HorizontalAlignment="Left">
                                <mdi:MaterialIcon Kind="KeyRemove" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="Closing this page cancels pending setup. Verified connection signing continues until disconnection. It does not enforce a signed-only policy." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Connection diagnostics" Classes="H4" />
                        <SelectableTextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</utilities:UserControlViewBase>
