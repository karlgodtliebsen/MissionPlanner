<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compile-time merging gives every static control alias this palette scope. -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="../../Tokens/Base/Dark.axaml" />
        <MergeResourceInclude Source="../../Tokens/Accent.axaml" />
        <MergeResourceInclude Source="../../Themes/Dark/_index.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <StaticResource x:Key="PaletteNormalColor" ResourceKey="SemiGrey5Color" />
    <StaticResource x:Key="PaletteHoverColor" ResourceKey="SemiGrey6Color" />
    <StaticResource x:Key="PalettePressedColor" ResourceKey="SemiGrey4Color" />
    <StaticResource x:Key="PaletteDisabledColor" ResourceKey="SemiGrey2Color" />
    <StaticResource x:Key="PaletteSubtleColor" ResourceKey="SemiGrey0Color" />
    <StaticResource x:Key="PaletteSubtleHoverColor" ResourceKey="SemiGrey1Color" />
    <StaticResource x:Key="PaletteSubtlePressedColor" ResourceKey="SemiGrey1Color" />
    <StaticResource x:Key="PaletteTextColor" ResourceKey="SemiGrey8Color" />
    <Color x:Key="PaletteSelectionTextColor">#FFFFFF</Color>
</ResourceDictionary>
