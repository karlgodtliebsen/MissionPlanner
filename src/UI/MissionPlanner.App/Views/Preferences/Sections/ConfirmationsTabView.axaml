<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.ConfirmationsTabView"
             x:DataType="preferences:PreferencesViewModel">

    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button Classes="EmbeddedIconButton" Grid.Column="1" ToolTip.Tip="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Confirmations" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8" Grid.ColumnSpan="2" 
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        
                        <Grid ColumnDefinitions="250,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="15">
                            <TextBlock Text="Confirm vehicle parameter writes" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmParameterWrites}" />
                            <TextBlock Grid.Row="1" Text="Confirm arm/disarm operations" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding ConfirmArmDisarm}" />
                            <TextBlock Grid.Row="2" Text="Confirm firmware changes" VerticalAlignment="Center"  HorizontalAlignment="Left"/>
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding ConfirmFirmwareChanges}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
