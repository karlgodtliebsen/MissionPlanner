<utilities:NavigationViewBase x:TypeArguments="local:InstallFirmwareViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.InstallFirmwarePage"
                              x:DataType="local:InstallFirmwareViewModel">

    <ContentPage Header="Install Firmware" >
        <Grid RowDefinitions="*,32" HorizontalAlignment="Stretch">

            <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="25" RowSpacing="20" HorizontalAlignment="Stretch">

                <Border Grid.Row="0" IsVisible="{Binding IsConnectedMode}" Padding="24" Classes="SectionCard">

                    <WrapPanel Orientation="Horizontal" ItemSpacing="25">
                        <StackPanel Orientation="Vertical" Spacing="14">
                            <TextBlock Text="A vehicle is connected" Classes="Title"  />
                            <TextBlock Text="Application firmware cannot be installed while Mission Planner owns the active connection. Disconnect the vehicle first to browse or install firmware." />
                            <TextBlock Text="Embedded bootloader update is available only for a supported, disarmed ArduPilot vehicle. Keep power connected and reboot after an accepted update." />
                        </StackPanel>
                        <Button
                            VerticalAlignment="Center"
                            ToolTip.Tip="Update Bootloader"
                            Padding="8,2"
                            Command="{Binding UpdateBootloaderCommand}"
                            IsEnabled="{Binding CanUpdateBootloader}"  HorizontalAlignment="Center" >
                            <avalonia:MaterialIcon Kind="Update" Width="30" Height="30" />
                        </Button>
                    </WrapPanel>

                </Border>

                <Border Grid.Row="1" IsVisible="{Binding IsUnsupportedMode}" Padding="24" Classes="SectionCard">
                    <TextBlock Text="Direct firmware installation is not available on this platform." Classes="Title"  />
                </Border>
                <Border Grid.Row="2" Padding="14" Classes="SectionCard">

                    <WrapPanel Orientation="Horizontal" ItemSpacing="25">
                        <StackPanel Orientation="Vertical" Spacing="14">
                            <TextBlock Text="{Binding ContextHelp.Title}" Classes="H3" />
                            <TextBlock Text="{Binding ContextHelp.Content}" Classes="H4 Warning"/>
                        </StackPanel>
                        <Button
                            VerticalAlignment="Center"
                            ToolTip.Tip="Refresh devices"
                            Padding="8,2"
                            Command="{Binding RefreshDevicesCommand}"
                            IsEnabled="{Binding IsDisconnectedMode}" HorizontalAlignment="Center" >
                            <avalonia:MaterialIcon Kind="Refresh" Width="30" Height="30" />
                        </Button>
                    </WrapPanel>
                </Border>

                <TabControl Grid.Row="3" x:Name="MainTabControl"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabItem Header="Firmware">
                        <TabControl TabStripPlacement="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <TabItem Header="Catalogue" IsEnabled="{Binding CanUseSerialFirmware}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <local:FirmwareCatalogueView DataContext="{Binding Catalogue}" IsDetectedDeviceVisible="True" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Custom Firmware" IsEnabled="{Binding CanUseSerialFirmware}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <local:CustomFirmwareView DataContext="{Binding Custom}" />
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="STM32 DFU">
                        <TabControl TabStripPlacement="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <TabItem Header="Device / Enter DFU">
                                <local:STM32DfuDeviceView />
                            </TabItem>
                            <TabItem Header="Catalogue" IsEnabled="{Binding CanUseDfuFirmware}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <local:STM32DfuCatalogueView DataContext="{Binding Catalogue}" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Custom HEX" IsEnabled="{Binding CanUseDfuFirmware}">
                                <TextBlock Text="Use the combined HEX controls in the DFU Catalogue panel while this workflow is being separated."
                                           TextWrapping="Wrap" Margin="25" />
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Help &amp; Support">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <local:HelpView DataContext="{Binding Help}" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

            </Grid>


            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12,6"
                        Spacing="10" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsVisible="{Binding IsCancellationDeferred}">
                    <TextBlock Text="Firmware Operation Status:" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="  •  " FontSize="16"  VerticalAlignment="Center" />
                    <TextBlock Text="Cancellation is deferred until verification and vehicle reboot reach a safe boundary. Keep power connected." Classes="Warning"
                               IsVisible="{Binding IsCancellationDeferred}" />
                </StackPanel>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsVisible="{Binding IsPowerCritical}">
                    <TextBlock Text="Firmware Operation Status:" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="  •  " FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Do not disconnect power while flash memory is being changed." Classes="Warning"
                               IsVisible="{Binding IsPowerCritical}" />
                </StackPanel>
            </StackPanel>

        </Grid>

    </ContentPage>
</utilities:NavigationViewBase>



