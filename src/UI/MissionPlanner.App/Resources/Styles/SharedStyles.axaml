<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="https://irihi.tech/ursa">

    <Style Selector="Border.SectionCard">
        <Setter Property="Background" Value="{DynamicResource SemiColorBgDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Theme" Value="{DynamicResource SolidIconButton}"></Setter>
    </Style>

    <Style Selector="Border">
        <Setter Property="Theme" Value="{DynamicResource SolidIconButton}"></Setter>
    </Style>

    <Style Selector="Button.H5">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="Button.H6">
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="Button.H7">
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBox.H1">
        <Setter Property="FontSize" Value="48"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBox.H2">
        <Setter Property="FontSize" Value="32"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBox.H3">
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBox.H4">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBox.H5">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBox.H6">
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBox.size">
        <Setter Property="Width" Value="250"></Setter>
    </Style>
    <Style Selector="TextBox.small-size">
        <Setter Property="Width" Value="200"></Setter>
    </Style>
    <Style Selector="TextBox.xsmall-size">
        <Setter Property="Width" Value="175"></Setter>
    </Style>
    <Style Selector="ComboBox.small-size">
        <Setter Property="Width" Value="200"></Setter>
    </Style>
    <Style Selector="ComboBox.size">
        <Setter Property="Width" Value="250"></Setter>
    </Style>
    <Style Selector="TextBlock.H1">
        <Setter Property="FontSize" Value="48"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBlock.H2">
        <Setter Property="FontSize" Value="32"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBlock.H3">
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBlock.H4">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBlock.H5">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBlock.H6">
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="TextBlock.size">
        <Setter Property="Width" Value="250"></Setter>
    </Style>
    <Style Selector="Label.H1">
        <Setter Property="FontSize" Value="48"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
    </Style>
    <Style Selector="Label.H2">
        <Setter Property="FontSize" Value="32"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
    </Style>

    <Style Selector="Label.H3">
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <Style Selector="Label.H4">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <Style Selector="Label.H5">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="Label.H6">
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <Style Selector="Label.Title">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="ExtraLight"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style Selector="CheckBox.H5">
        <Setter Property="FontSize" Value="15"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
    </Style>
    <Style Selector="CheckBox.H6">
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
    </Style>

    <Style Selector="Label.size">
        <Setter Property="Width" Value="275"></Setter>
    </Style>
    <Style Selector="DockPanel.size">
        <Setter Property="Width" Value="275"></Setter>
    </Style>
    <Style Selector="ScrollViewer.size">
        <Setter Property="Width" Value="275"></Setter>
    </Style>
    <Style Selector="Border.DefaultBorder">
        <Setter Property="Margin" Value="50"></Setter>
    </Style>
    <Style Selector="Border.Border-double">
        <Setter Property="Margin" Value="50"></Setter>
        <Setter Property="BorderThickness" Value="5"></Setter>
    </Style>

    <Style Selector="Grid.Row">
        <Setter Property="Width" Value="250"></Setter>
        <Setter Property="Margin" Value="0,5,0,0"></Setter>
    </Style>
    <Style Selector="Grid.ExtendedRow">
        <Setter Property="Margin" Value="0,5,0,0"></Setter>
    </Style>

    <Style Selector="TextBox.clearButton, TextBox.ClearButton">
        <Style Selector="^[AcceptsReturn=False][IsReadOnly=False]:focus:not(:empty) /template/ Button#PART_ClearButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[AcceptsReturn=False][IsReadOnly=False]:pointerover:not(:empty) /template/ Button#PART_ClearButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </Style>

</Styles>