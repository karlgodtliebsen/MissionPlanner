<utilities:UserControlViewBase x:TypeArguments="sections:FlightModesSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FlightModesSetupView"
                               x:DataType="sections:FlightModesSetupViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" HorizontalAlignment="Stretch" Padding="12"  >
            <StackPanel Spacing="10">
                <TextBlock Text="Flight-mode assignment" Classes="H2" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <TextBlock Text="{Binding ModeChannelDescription}" FontWeight="Bold" />

            </StackPanel>
        </Border>
        <Border Grid.Row="1" HorizontalAlignment="Stretch" Padding="12">
            <StackPanel Spacing="10">
                <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh flight modes"
                        Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh flight modes">
                    <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" Margin="16,0" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="SectionCard" Padding="12">
                <StackPanel Spacing="10">
                    <ItemsControl IsVisible="{Binding IsSupported}" ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sections:FlightModeSlotViewModel">
                                <Border Padding="10" Classes="SectionCard" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,200,*" ColumnSpacing="8"  HorizontalAlignment="Stretch">
                                        <TextBlock Text="●" Foreground="{DynamicResource Info}"
                                                   IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding BandDescription}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" ToolTip.Tip="Mode"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Right"
                                                  ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedMode}"
                                                  DisplayMemberBinding="{Binding Name}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</utilities:UserControlViewBase>
