<utilities:UserControlViewBase x:TypeArguments="sections:SafetySetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mandatoryHardware="clr-namespace:MissionPlanner.Core.Setup.MandatoryHardware;assembly=MissionPlanner.Core"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.MandatoryHardware.Sections.SafetySetupView"
                               x:DataType="sections:SafetySetupViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
            <TextBlock Text="Safety and arming" FontSize="18" FontWeight="Bold" />
            <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" />
            <ItemsControl IsVisible="{Binding HasWarnings}" ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
<TextBlock Text="{Binding .}" Classes="Warning" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mandatoryHardware:SafetyCheckItem">
                        <Grid ColumnDefinitions="220,120,*" ColumnSpacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Re-assess safety" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>
