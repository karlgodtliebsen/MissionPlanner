<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UraniumUI.Material.Controls.RightDockPanel"
    x:Name="root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

        <Grid  ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="DockColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <ContentPresenter Grid.Column="0" Content="{Binding Source={x:Reference root}, Path=MainContent}" />

            <Grid
                    Grid.Column="1"
                    x:Name="SplitterHost"
                    BackgroundColor="{Binding Source={x:Reference root}, Path=SplitterColor}"
                    IsVisible="{Binding Source={x:Reference root}, Path=IsExpanded}">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSplitterPanUpdated" />
                            <TapGestureRecognizer Tapped="OnSplitterTapped" />
                        </Grid.GestureRecognizers>
            </Grid>

            <Border
                        Grid.Column="2"
                        x:Name="DockBorder"
                        BackgroundColor="{Binding Source={x:Reference root}, Path=DockBackground}"
                        Stroke="{Binding Source={x:Reference root}, Path=DockBorderColor}"
                        StrokeThickness="1"
                        Padding="0"
                        IsVisible="{Binding Source={x:Reference root}, Path=IsExpanded}">
                <Grid RowDefinitions="Auto,*" RowSpacing="0">
                    <Grid Padding="8,6"
                      BackgroundColor="{Binding Source={x:Reference root}, Path=HeaderBackground}"
                      ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                            Text="{Binding Source={x:Reference root}, Path=CollapseGlyph}"
                            WidthRequest="32"
                            HeightRequest="32"
                            Command="{Binding Source={x:Reference root}, Path=ToggleCommand}" />

                        <Label Grid.Column="1"
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           Text="{Binding Source={x:Reference root}, Path=Title}" />

                        <ContentPresenter Grid.Column="2"
                                      Content="{Binding Source={x:Reference root}, Path=HeaderContent}" />
                    </Grid>

                    <ContentPresenter x:Name="DockPresenter"
                                  Grid.Row="1"
                                  Content="{Binding Source={x:Reference root}, Path=DockContent}" />
                </Grid>
            </Border>

            <Button Grid.Column="0" x:Name="EdgeToggleButton" Grid.ColumnSpan="3" HorizontalOptions="End"
                    VerticalOptions="Start" Margin="0,8,8,0" WidthRequest="36" HeightRequest="36"
                    ZIndex="100"
                    Text="{Binding Source={x:Reference root}, Path=ExpandGlyph}"
                    Command="{Binding Source={x:Reference root}, Path=ToggleCommand}" />
        </Grid>

</ContentView>