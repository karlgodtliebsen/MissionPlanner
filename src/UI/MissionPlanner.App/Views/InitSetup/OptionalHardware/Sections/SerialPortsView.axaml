<utilities:UserControlViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
    xmlns:models="clr-namespace:MissionPlanner.App.Models"
    xmlns:u="https://irihi.tech/ursa"
    x:TypeArguments="sections:SerialPortsViewModel"
    x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.SerialPortsView"
    x:DataType="sections:SerialPortsViewModel">
    <utilities:UserControlViewBase.Resources>
        <DataTemplate x:Key="SerialEditor" x:DataType="models:ParameterItemViewModel">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding ValuesData}"
                          SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                          IsVisible="{Binding HasValuesData}" HorizontalAlignment="Stretch" />
                <NumericUpDown Value="{Binding Value, Mode=TwoWay}"
                               IsVisible="{Binding !HasValuesData}" IsReadOnly="{Binding IsReadOnly}"
                               FormatString="0" Increment="1" />
                <u:MultiComboBox ItemsSource="{Binding BitmaskOptions}"
                                SelectedItems="{Binding SelectedBitmaskItems, Mode=TwoWay}"
                                IsVisible="{Binding HasBitmask}" ToolTip.Tip="Serial options" />
                <TextBlock Text="{Binding LiveValue, StringFormat='Readback: {0}'}" FontSize="11" />
                <TextBlock Text="{Binding ValidationError}" Classes="Danger" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WriteMessage}" TextWrapping="Wrap" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </utilities:UserControlViewBase.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="Serial Ports" Classes="SectionTitle" />
            <TextBlock Text="Configure the flight controller's serial parameters. SERIAL indexes do not establish physical UART wiring. Unreported settings remain blank."
                       TextWrapping="Wrap" />
            <TextBlock Text="Speed is the configured baud setting; RC protocols may choose a different runtime baud rate."
                       TextWrapping="Wrap" />
            <TextBlock Text="Changes to serial port settings may not take effect until the flight controller is rebooted."
                       Classes="Warning" TextWrapping="Wrap" />
            <TextBlock Text="Confirmed changes require a flight-controller reboot." IsVisible="{Binding RebootRequired}"
                       Classes="Warning" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Theme="{DynamicResource ProgressRing}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Classes="Danger" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Diagnostic}" Classes="Warning" TextWrapping="Wrap" />
            <TextBlock Text="Receiver diagnostics include pending edits. No settings are written until Apply changes."
                       FontSize="11" TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="Reload reported parameters" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
                <Button Content="Apply changes" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,8" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Ports}" IsEnabled="{Binding CanEdit}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sections:SerialPortRowViewModel">
                        <Border Classes="SectionCard" Padding="12" Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                <WrapPanel>
                                    <StackPanel Width="180" Margin="0,0,12,8" Spacing="4">
                                        <TextBlock Text="Speed" FontWeight="SemiBold" />
                                        <ContentControl Content="{Binding Speed}" ContentTemplate="{StaticResource SerialEditor}"
                                                        IsEnabled="{Binding CanEditSpeed}" />
                                    </StackPanel>
                                    <StackPanel Width="210" Margin="0,0,12,8" Spacing="4">
                                        <TextBlock Text="Protocol" FontWeight="SemiBold" />
                                        <ContentControl Content="{Binding Protocol}" ContentTemplate="{StaticResource SerialEditor}"
                                                        IsEnabled="{Binding CanEditProtocol}" />
                                    </StackPanel>
                                    <StackPanel Width="240" Margin="0,0,0,8" Spacing="4">
                                        <TextBlock Text="Options" FontWeight="SemiBold" />
                                        <ContentControl Content="{Binding Options}" ContentTemplate="{StaticResource SerialEditor}"
                                                        IsEnabled="{Binding CanEditOptions}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>
