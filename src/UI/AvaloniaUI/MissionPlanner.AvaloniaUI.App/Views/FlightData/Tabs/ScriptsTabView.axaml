<utilities:TabItemViewBase x:TypeArguments="tabs:ScriptsTabViewModel" xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.ScriptsTabItemView"
                           x:DataType="tabs:ScriptsTabViewModel">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        <TextBlock Text="Scripts" FontSize="18" FontWeight="Bold"/>
        <TextBox Grid.Row="1" Text="{Binding ScriptJson}" AcceptsReturn="True" MinHeight="100"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Validate" Command="{Binding ValidateCommand}"/>
            <Button Content="Dry run" Command="{Binding DryRunCommand}"/>
            <Button Content="Run" Command="{Binding RunCommand}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            <TextBlock Text="{Binding Status}"/>
        </StackPanel>
        <ListBox Grid.Row="3" ItemsSource="{Binding Output}"/>
    </Grid>
</utilities:TabItemViewBase>
