<?xml version="1.0" encoding="utf-8" ?>
<utilities:UserControlViewBase x:TypeArguments="common:StatusBarViewModel" xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:u="https://irihi.tech/ursa"
                    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                    xmlns:common="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.Common"
                    xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                    x:Class="MissionPlanner.AvaloniaUI.App.Views.Common.StatusBarView"
                    x:DataType="common:StatusBarViewModel"
                    Background="{DynamicResource Surface}"
                    Height="32">

    <Border  Padding="2" VerticalAlignment="Stretch" Height="50" Background="{DynamicResource Surface}">
        <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"   >
 
            <!-- Connection Info (Left) -->
            <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0" Orientation="Horizontal" >
                <Label Content="•" Foreground="{DynamicResource DisabledText}" FontSize="16" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <!--<Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsConnectedStatus}"
                                     Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Success}" />
                        </DataTrigger>
                    </Label.Triggers>-->
                </Label>
  
                <Label Content="{Binding VehicleDisplayName}" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                    
                <Label Content="•" FontSize="16"  VerticalAlignment="Center"/>
                <Label Content="{Binding ConnectionStatus}" VerticalAlignment="Center" VerticalContentAlignment="Center" />

                <Label Content="•" FontSize="16"  VerticalAlignment="Center"/>
                <Label Content="{Binding TelemetryFreshness}" VerticalAlignment="Center" VerticalContentAlignment="Center" />

                <Label Content="•" FontSize="16"  VerticalAlignment="Center" IsVisible="{Binding HasStatusMessage}"/>
                <Label Content="{Binding StatusMessage}" VerticalAlignment="Center" VerticalContentAlignment="Center" 
                       IsVisible="{Binding HasStatusMessage}" />
            </StackPanel>
            
            <!-- Clock (Right) -->
            <Label Grid.Column="2" Content="{Binding CurrentTime}" VerticalAlignment="Center"  VerticalContentAlignment="Center" 
                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"/>
        </Grid>
    </Border>

</utilities:UserControlViewBase>
