<utilities:NavigationViewBase x:TypeArguments="sections:MavFtpTabViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                              xmlns:models="clr-namespace:MissionPlanner.App.Models"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              xmlns:sections="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections"
                              xmlns:u="https://irihi.tech/ursa"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Name="RootPage"
                              x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.MAVFtpTabView"
                              x:DataType="sections:MavFtpTabViewModel">
    <ContentPage Header="Mavlink Ftp" >

        <Grid x:Name="MAVFtpTabViewLayout" RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="12" Classes.expanded="{Binding IsEditorExpanded}">
            <Grid.Styles>
                <Style Selector="Grid#MAVFtpTabViewLayout">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style Selector="Grid#MAVFtpTabViewLayout.expanded">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </Grid.Styles>
           
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="900" MaxWidth="{Binding EditorColumnMaxWidth}" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ToggleEditorWidthButton"
                Grid.Column="0" Grid.Row="0"
                Classes="Expander"
                Margin="0,0,4,0"
                ToolTip.Tip="{Binding ToggleEditorWidthText}"
                AutomationProperties.Name="{Binding ToggleEditorWidthText}"
                Command="{Binding ToggleEditorWidthCommand}">
                <Grid>
                    <avalonia:MaterialIcon Kind="ChevronLeft" Width="22" Height="22"
                                      IsVisible="{Binding !IsEditorExpanded}" />
                    <avalonia:MaterialIcon Kind="ChevronRight" Width="22" Height="22"
                                      IsVisible="{Binding IsEditorExpanded}" />
                </Grid>
            </Button>

            <u:Banner ShowIcon="False" Grid.Column="1" Classes="Bordered" Header="Mavlink Ftp" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Grid.Row="0"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="10" >

                    <SelectableTextBlock Text="{Binding ErrorMessage}"
                                         IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"
                                         Classes="Danger" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </u:Banner>
            
            <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                
                <Button Classes="ToolbarButton" ToolTip.Tip="Upload file to vehicle" Command="{Binding NavigateUpCommand}" IsEnabled="{Binding CanNavigateUp}"  >
                    <avalonia:MaterialIcon Kind="UploadOutline" Width="30" Height="30" />
                </Button>

                <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Classes="ToolbarButton" Grid.Column="2" ToolTip.Tip="Refresh"  IsVisible="{Binding HasConnection}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh">
                    <avalonia:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
                <Button Classes="ToolbarButton" Grid.Column="3" ToolTip.Tip="Open selected remote directory" IsVisible="{Binding HasEntries}" Command="{Binding OpenSelectedCommand}" AutomationProperties.Name="Open">
                    <avalonia:MaterialIcon Kind="FolderOpenOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="ToolbarButton" Grid.Column="4" ToolTip.Tip="Reset sessions"  IsVisible="{Binding HasConnection}" Command="{Binding ResetSessionsCommand}" AutomationProperties.Name="Reset sessions">
                    <avalonia:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                </Button>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="2" RowDefinitions="Auto,*" MinWidth="640">
                <Grid ColumnDefinitions="300,100,100,180" ColumnSpacing="6" Margin="12,0,12,6">
                    <TextBlock Grid.Column="0" Text="Name" Classes="DataGridColumn" />
                    <TextBlock Grid.Column="1" Text="Type" Classes="DataGridColumn" />
                    <TextBlock Grid.Column="2" Text="Size" Classes="DataGridColumn" />
                    <TextBlock Grid.Column="3" Text="Modified (local)" Classes="DataGridColumn" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         SelectionMode="Single"
                         DoubleTapped="OnEntriesDoubleTapped"
                         VerticalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VehicleFileSystemEntryViewModel">
                            <Grid ColumnDefinitions="300,100,100,180" ColumnSpacing="6" MinHeight="38">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="DataGridRow" />
                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" Classes="DataGridRow" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="DataGridRow" />
                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Classes="DataGridRow" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Text="{Binding EmptyText}"
                           IsVisible="{Binding !HasEntries}"
                           FontSize="12"
                           Opacity="0.6"
                           Margin="0,20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Vertical" Grid.Row="3" Spacing="6">
                <ProgressBar Value="{Binding TransferProgress}" />
                <TextBlock Text="{Binding TransferDetails}" FontSize="12" />

                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" 
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ToolbarButton" ToolTip.Tip="Download selected file from vehicle" Command="{Binding DownloadSelectedCommand}"  IsVisible="{Binding HasEntries}" AutomationProperties.Name="Download selected">
                        <avalonia:MaterialIcon Kind="DownloadOutline" Classes="ActionIcon" />
                    </Button>
                    <Button Classes="ToolbarButton" ToolTip.Tip="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" AutomationProperties.Name="Cancel">
                        <avalonia:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
