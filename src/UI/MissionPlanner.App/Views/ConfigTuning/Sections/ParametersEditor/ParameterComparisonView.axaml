<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
    xmlns:controls="clr-namespace:MissionPlanner.Themes.Controls;assembly=MissionPlanner.Themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:parametersEditor="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections.ParametersEditor"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.ParametersEditor.ParameterComparisonView"
    x:DataType="parametersEditor:ParametersEditorTabViewModel"
    >

        <controls:VirtualizedItemsGrid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding Items}"
            ColumnWidths="60,150,100,100,150,90,*"
            ColumnSpacing="6"
            RowMinHeight="38"
            ShowHeader="True"
            ShowSearchBar="True"
            SearchWatermark="Search parameters..."
            SearchMemberPaths="Name,DisplayName,Status,Message"
            ShowPagination="False"
            SelectionMode="None">
            <controls:VirtualizedItemsGrid.EmptyView>
                <StackPanel Margin="40"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="No modified parameters found."
                               Classes="H3"
                               TextAlignment="Center" />
                </StackPanel>
            </controls:VirtualizedItemsGrid.EmptyView>
            <controls:VirtualizedItemsGrid.HeaderTemplate>
                <DataTemplate>
                    <controls:VirtualizedItemsGridRow>
                        <TextBlock Grid.Column="0" Text="Write" HorizontalAlignment="Center" Classes="DataGridColumn" />
                        <TextBlock Grid.Column="1" Text="Parameter" HorizontalAlignment="Center" Classes="DataGridColumn" />
                        <TextBlock Grid.Column="2" Text="Live" HorizontalAlignment="Center" Classes="DataGridColumn" />
                        <TextBlock Grid.Column="3" Text="Pending" HorizontalAlignment="Center" Classes="DataGridColumn" />
                        <TextBlock Grid.Column="4" Text="Difference" HorizontalAlignment="Center" Classes="DataGridColumn" />
                        <TextBlock Grid.Column="5" Text="Status" HorizontalAlignment="Center" Classes="DataGridColumn" />
                        <TextBlock Grid.Column="6" Text="Message" HorizontalAlignment="Center" Classes="DataGridColumn" />
                    </controls:VirtualizedItemsGridRow>
                </DataTemplate>
            </controls:VirtualizedItemsGrid.HeaderTemplate>
            <controls:VirtualizedItemsGrid.RowTemplate>
                <DataTemplate x:DataType="parametersEditor:ParameterComparisonItemViewModel">
                    <controls:VirtualizedItemsGridRow>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding CanWrite}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Select {0} for writing'}"
                                  HorizontalAlignment="Center"
                                  Classes="DataGridRow" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" HorizontalAlignment="Center" Classes="DataGridRow" />
                        <TextBlock Grid.Column="2" Text="{Binding LeftValueText}" HorizontalAlignment="Center" Classes="DataGridRow" />
                        <TextBlock Grid.Column="3" Text="{Binding RightValueText}" HorizontalAlignment="Center" Classes="DataGridRow" />
                        <TextBlock Grid.Column="4" Text="{Binding DifferenceText}" HorizontalAlignment="Center" Classes="DataGridRow" />
                        <TextBlock Grid.Column="5" Text="{Binding Status}" HorizontalAlignment="Center" Classes="DataGridRow" />
                        <TextBlock Grid.Column="6" Text="{Binding Message}" HorizontalAlignment="Center" Classes="DataGridRow" />
                    </controls:VirtualizedItemsGridRow>
                </DataTemplate>
            </controls:VirtualizedItemsGrid.RowTemplate>
        </controls:VirtualizedItemsGrid>
    
</UserControl>
