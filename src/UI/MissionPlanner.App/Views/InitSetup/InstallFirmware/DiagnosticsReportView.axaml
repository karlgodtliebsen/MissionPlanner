<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.DiagnosticsReportView"
             x:DataType="local:InstallFirmwareViewModel">

    <Border Padding="20" Classes="SectionCard" >
        <StackPanel Orientation="Vertical" Spacing="10">
            <Button Content="Copy diagnostic report" Command="{Binding CopyDiagnosticReportCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            <SelectableTextBlock Text="{Binding LastDiagnosticReport}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
