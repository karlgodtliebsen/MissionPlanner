<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prompts="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities.Dialogs.Prompts"
             xmlns:subViews="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities.Dialogs.SubViews"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="subViews:PromptInputDialogViewModel"
             x:Class="MissionPlanner.AvaloniaUI.App.Utilities.Dialogs.SubViews.PromptInputDialogView">
    
    <StackPanel Orientation="Vertical" Spacing="14" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <TextBox Text="{Binding PromptText, Mode=TwoWay}" MinWidth="360" />
    </StackPanel>
</UserControl>
