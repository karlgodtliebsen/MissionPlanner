<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.ConfirmationsTabView"
             x:DataType="preferences:PreferencesViewModel">

    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button Classes="EmbeddedIconButton" Grid.Column="1" ToolTip.Tip="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Confirmations" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8" Grid.ColumnSpan="2" 
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        
                        <u:Form LabelPosition="Left" LabelWidth="250" MinWidth="400" HorizontalAlignment="Center">
                            <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding ConfirmParameterWrites}" u:FormItem.Label="Confirm vehicle parameter writes" />
                            <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding ConfirmArmDisarm}" u:FormItem.Label="Confirm arm/disarm operations" />
                            <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding ConfirmFirmwareChanges}" u:FormItem.Label="Confirm firmware changes" />
                        </u:Form>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
