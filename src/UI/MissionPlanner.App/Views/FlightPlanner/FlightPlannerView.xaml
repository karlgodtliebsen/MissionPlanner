<?xml version="1.0" encoding="utf-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="vm:FlightPlannerViewModel"  
                         xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:vm="clr-namespace:MissionPlanner.App.Views.FlightPlanner"
                         xmlns:missions="clr-namespace:MissionPlanner.App.Views.Missions"
                         xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                         xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                         xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                         xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                         x:Class="MissionPlanner.App.Views.FlightPlanner.FlightPlannerView"
                         x:DataType="vm:FlightPlannerViewModel">

    <navigation:ExtendedContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </navigation:ExtendedContentPage.Resources>

    <controls:RightDockPanel 
        HorizontalOptions="Fill" 
        VerticalOptions="Fill" 
        Title="Quick Editor"
        DockWidth="360"
        MinDockWidth="260"
        MaxDockWidth="520"
        IsExpanded="False"

        AutoSizeToContent="True"
        ShowEdgeToggleWhenExpanded="False"

        DockBackground="{AppThemeBinding Light=White, Dark=#1E1E1E}"
        HeaderBackground="{AppThemeBinding Light=#F3F3F3, Dark=#2A2A2A}"
        DockBorderColor="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
        SplitterColor="{AppThemeBinding Light=#D8D8D8, Dark=#505050}"
        >
        <controls:RightDockPanel.MainContent>
            <Grid RowDefinitions="Auto,*" RowSpacing="4" Padding="5"  HorizontalOptions="Fill" VerticalOptions="Fill">
                <FlexLayout Grid.Row="0" Wrap="Wrap" AlignItems="Center" JustifyContent="Start" Margin="10,10,0,0">

                    <Button Text="Load File" Command="{Binding Map.LoadWpFileCommand}" Margin="0,0,4,4" />
                    <Button Text="Save File"  Command="{Binding Map.SaveWpFileCommand}" Margin="0,0,4,4" />
                    <Button Text="Clear Mission" Command="{Binding Map.ClearMissionCommand}" Margin="0,0,4,4" />

                    <Button Text="Apply" Command="{Binding Map.ApplyRowEditsCommand}" Margin="0,0,4,4" />
                    <Button Text="Revert" Command="{Binding Map.CancelRowEditsCommand}" Margin="0,0,4,4" />

                    <Button Text="Read" Command="{Binding ReadFromVehicleCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Margin="0,0,4,4" />
                    <Button Text="Write" Command="{Binding WriteToVehicleCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Margin="0,0,4,4" />
                    <Button Text="Write Fast" Command="{Binding WriteToVehicleFastCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Margin="0,0,4,4" />
                    <Button Text="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Margin="0,0,4,4" />

                    <Label Text="Map:" VerticalOptions="Center" Margin="0,0,4,4" />
                    <Picker ItemsSource="{Binding Map.AvailableMapTypes}"
                                SelectedItem="{Binding Map.SelectedMapType}"
                                WidthRequest="170"
                                Margin="0,0,4,4" />

                    <Label Text="Default Altitude (m):" VerticalOptions="Center" Margin="0,0,4,4" />
                    <!--<Entry Text="{Binding Map.DefaultAltitudeMeters}"
                               Keyboard="Numeric"
                               WidthRequest="70"
                               Margin="0,0,4,4" />-->

                    <controls:NumericField
                        WidthRequest="70"
                        BorderThickness="0.1"
                        Margin="0,0,4,4" 
                        Value="{Binding Map.DefaultAltitudeMeters, Mode=TwoWay}"
                        NumberFormat="F1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End" />


                    <Grid  ColumnDefinitions="30,Auto" Margin="0,0,4,4"  >
                        <!--<CheckBox IsChecked="{Binding Map.AddWaypointOnMapClick}"  VerticalOptions="Center"  />
                        <Label Grid.Column="1" Text="Click map to add WP" VerticalOptions="Center"  />-->
                        <material:CheckBox Text="Click map to add WP" IsChecked="{Binding Map.AddWaypointOnMapClick}" />
                    </Grid>

                    <Label Text="{Binding TransferStatus}" VerticalOptions="Center" Margin="0,0,8,4" />
                    <Label Text="{Binding Map.StatusMessage}" VerticalOptions="Center" Opacity="0.7" Margin="0,0,0,4" />

                </FlexLayout>
                <missions:MissionMapView Grid.Column="0" Grid.Row="1"  HorizontalOptions="Fill" VerticalOptions="Fill"/>
            </Grid>
        </controls:RightDockPanel.MainContent>

        <controls:RightDockPanel.DockContent>
            <missions:MissionItemListView x:Name="ItemListView" BindingContext="{Binding Map}" HorizontalOptions="Fill"  VerticalOptions="Fill" ShowAllRows="False"></missions:MissionItemListView>
        </controls:RightDockPanel.DockContent>

    </controls:RightDockPanel>


</navigation:ExtendedContentPage>
