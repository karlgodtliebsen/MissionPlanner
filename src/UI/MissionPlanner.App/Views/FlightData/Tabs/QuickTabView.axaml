<utilities:TabItemViewBase x:TypeArguments="tabs:QuickTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                           xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" 
                           d:DesignWidth="800" 
                           d:DesignHeight="450"
                           x:Class="MissionPlanner.App.Views.FlightData.Tabs.QuickTabItemView"
                           x:DataType="tabs:QuickTabViewModel">
    <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*" Margin="5,10"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Grid.Row="0" Grid.Column="0" Classes="SectionCard">
            <Grid RowDefinitions="*,5*">
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="12" Text="Altitude (m)" />
                </Viewbox>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="35" Text="{Binding Altitude, StringFormat='{}{0:F1}'}" />
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Classes="SectionCard">
            <Grid RowDefinitions="*,5*">
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="12" Text="GroundSpeed (m/s)" />
                </Viewbox>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="35" Text="{Binding GroundSpeed, StringFormat='{}{0:F2}'}" />
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Classes="SectionCard">
            <Grid RowDefinitions="*,5*">
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="12" Text="Dist to WP (m)" />
                </Viewbox>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="35" Text="{Binding DistanceToWp, StringFormat='{}{0:F2}'}" />
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="SectionCard">
            <Grid RowDefinitions="*,5*">
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="12" Text="Yaw (°)" />
                </Viewbox>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="35" Text="{Binding Yaw, StringFormat='{}{0:F2}'}" />
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Classes="SectionCard">
            <Grid RowDefinitions="*,5*">
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="12" Text="Vertical Speed (m/s)" />
                </Viewbox>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="35" Text="{Binding VerticalSpeed, StringFormat='{}{0:F2}'}" />
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.Column="1" Classes="SectionCard">
            <Grid RowDefinitions="*,5*">
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="12" Text="Dist to MAV (m)" />
                </Viewbox>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock FontSize="35" Text="{Binding DistanceToMav, StringFormat='{}{0:F2}'}" />
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</utilities:TabItemViewBase>
