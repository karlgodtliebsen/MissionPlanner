<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent   x:TypeArguments="tabs:AuxFunctionTabViewModel" 
                                    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                                    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                                    xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                    x:Class="MissionPlanner.App.Views.FlightData.Tabs.AuxFunctionTabView"
                                    x:DataType="tabs:AuxFunctionTabViewModel">


    <Grid Padding="16" 
          RowSpacing="10"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" 
          ColumnDefinitions="*,Auto" 
          VerticalOptions="Fill" HorizontalOptions="Fill">
        
        <Label Text="Auxiliary functions:" FontSize="20" FontAttributes="Bold" Grid.ColumnSpan="2" />
        
        <material:SelectField Grid.Row="1" Grid.ColumnSpan="2" Title="Function" ItemsSource="{Binding Functions}"
                ItemDisplayBinding="{Binding Name}" 
                SelectedItem="{Binding SelectedFunction}" />
        
        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SelectedFunction.Description}" />

        <material:SelectField Grid.Row="3" Grid.ColumnSpan="2" Title="Switch level" ItemsSource="{Binding Levels}" 
                SelectedItem="{Binding Level}" />

        <HorizontalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" VerticalOptions="Start" HorizontalOptions="Start">
            <material:CheckBox Text="Confirm warning/high-risk action" IsChecked="{Binding IsConfirmed}" />
            <Button Text="Execute" Command="{Binding ExecuteCommand}" />
        </HorizontalStackLayout>


        <Label Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Result}" />
    </Grid>

</tabViews:TabViewLifecycleContent>
