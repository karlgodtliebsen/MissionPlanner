<utilities:TabItemViewBase
    x:TypeArguments="tabs:AuxFunctionTabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
    xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
    x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.AuxFunctionTabItemView"
    x:DataType="tabs:AuxFunctionTabViewModel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <TextBlock Text="Auxiliary functions" FontSize="18" FontWeight="Bold"/>
        <ComboBox Grid.Row="1" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" DisplayMemberBinding="{Binding Name}"/>
        <TextBlock Grid.Row="2" Text="{Binding SelectedFunction.Description}" TextWrapping="Wrap"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <CheckBox Content="Confirm warning/high-risk action" IsChecked="{Binding IsConfirmed}"/>
            <Button Content="Execute" Command="{Binding ExecuteCommand}"/>
        </StackPanel>
        <TextBlock Grid.Row="5" Text="{Binding Result}" TextWrapping="Wrap"/>
    </Grid>
</utilities:TabItemViewBase>
