<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Warnings"
    xmlns:model="clr-namespace:MissionPlanner.Core.Setup.Advanced.Warnings;assembly=MissionPlanner.Core"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Warnings.WarningRuleListView"
    x:TypeArguments="local:WarningRuleListViewModel" x:DataType="local:WarningRuleListViewModel">
    <Border Classes="SectionCard" Padding="16">
        <StackPanel Spacing="10">
            <TextBlock Text="Saved rules" Classes="H4" />
            <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Saved warning rules">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="model:WarningRule">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Severity}" />
                            <TextBlock Text="{Binding Source}" />
                            <TextBlock Text="{Binding Comparison}" />
                            <TextBlock Text="{Binding Threshold}" />
                            <TextBlock Text="{Binding Enabled, StringFormat='Enabled: {0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <WrapPanel>
                <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,8" />
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,8,8" />
                <Button Content="Enable / disable" Command="{Binding ToggleCommand}" Margin="0,0,8,8" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>
    </Border>
</utilities:UserControlViewBase>
