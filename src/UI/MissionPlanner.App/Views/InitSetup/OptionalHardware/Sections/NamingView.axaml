<utilities:UserControlViewBase x:TypeArguments="sections:NamingViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.NamingView"
                               x:DataType="sections:NamingViewModel"
                               >
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalAlignment="Stretch" Margin="25,0">
        <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Stretch" MaxWidth="1000">
            <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="Vehicle Naming" Classes="H2" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,10,0,10" Spacing="12" HorizontalAlignment="Center">
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Width="100" ToolTip.Tip="Apply changed identifiers" AutomationProperties.Name="Apply changed identifiers"
                        Command="{Binding ApplyCommand}" >
                    <avalonia:MaterialIcon Kind="CheckCircleOutline" Width="30" Height="30" />
                </Button>
            </StackPanel>

            <Border HorizontalAlignment="Stretch" Padding="25" Classes="SectionCard" MaxWidth="450" IsEnabled="{Binding CanEdit}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,130" RowSpacing="10" ColumnSpacing="10" HorizontalAlignment="Center">

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mav System ID" Classes="H4" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MavSystemId, Mode=TwoWay}" Classes="H4" HorizontalContentAlignment="Right"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Board Serial Number" Classes="H4" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BoardSerialNumber, Mode=TwoWay}" Classes="H4" HorizontalContentAlignment="Right"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>

</utilities:UserControlViewBase>
