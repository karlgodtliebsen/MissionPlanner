<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compile-time merging gives every static control alias this palette scope. -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="../../Tokens/Base/Dark.axaml" />
        <MergeResourceInclude Source="../../Tokens/Accent.axaml" />
        <MergeResourceInclude Source="../../Themes/Dark/_index.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <StaticResource x:Key="PaletteNormalColor" ResourceKey="SemiPurple6Color" />
    <StaticResource x:Key="PaletteHoverColor" ResourceKey="SemiPurple7Color" />
    <StaticResource x:Key="PalettePressedColor" ResourceKey="SemiPurple4Color" />
    <StaticResource x:Key="PaletteDisabledColor" ResourceKey="SemiPurple2Color" />
    <StaticResource x:Key="PaletteSubtleColor" ResourceKey="SemiPurple0Color" />
    <StaticResource x:Key="PaletteSubtleHoverColor" ResourceKey="SemiPurple1Color" />
    <StaticResource x:Key="PaletteSubtlePressedColor" ResourceKey="SemiPurple1Color" />
    <StaticResource x:Key="PaletteTextColor" ResourceKey="SemiPurple8Color" />
    <Color x:Key="PaletteSelectionTextColor">#FFFFFF</Color>
</ResourceDictionary>
