<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
               xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
               x:Class="MissionPlanner.App.Views.Common.ErrorView"
              x:DataType="common:ErrorViewModel"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              >
        <VerticalStackLayout  Margin="25,50,25,50" Padding="50" HorizontalOptions="Center" VerticalOptions="Center">
        <uranium:SelectableLabel  TextColor="{DynamicResource Error}" HorizontalOptions="Center" VerticalOptions="Center"  FontSize="16" 
                                  Text="{Binding ErrorMessage}"></uranium:SelectableLabel>
        </VerticalStackLayout>
</ContentView>
