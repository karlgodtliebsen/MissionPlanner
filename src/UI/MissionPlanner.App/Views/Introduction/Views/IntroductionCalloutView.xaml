<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MissionPlanner.App.Views.Introduction.Models"
             x:Class="MissionPlanner.App.Views.Introduction.Views.IntroductionCalloutView"
             x:DataType="models:IntroductionCallout">
    <Border Padding="12"
            StyleClass="SurfaceContainer,Rounded,Elevation1">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border
                    StyleClass="SurfaceContainer,Rounded,Elevation1"
                    HeightRequest="32" WidthRequest="32"
                    Padding="0"
                    VerticalOptions="Start">

                <Label Text="{Binding Number}"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3">
                <Label Text="{Binding Title}"
                       FontAttributes="Bold"
                       FontSize="15" />
                <Label Text="{Binding Text}"
                       FontSize="14"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>