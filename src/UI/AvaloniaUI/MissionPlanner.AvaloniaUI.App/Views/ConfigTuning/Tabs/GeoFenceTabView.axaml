<utilities:TabItemViewBase
                    x:TypeArguments="tabs:GeoFenceTabViewModel"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:common="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.Common"
                    xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs"
                    xmlns:config="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning"
                    xmlns:navigation="clr-namespace:MissionPlanner.AvaloniaUI.App.Navigation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:Class="MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs.GeoFenceTabView"
                    x:DataType="tabs:GeoFenceTabViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Download" Command="{Binding DownloadCommand}" />
            <Button Content="Validate &amp; upload" Command="{Binding UploadCommand}" />
            <Button Content="Clear vehicle" Command="{Binding ClearVehicleCommand}" />
            <Button Content="Restore backup" Command="{Binding RestoreBackupCommand}" />
            <Button Content="Refresh parameters" Command="{Binding RefreshParametersCommand}" />
            <Button Content="Revert parameters" Command="{Binding RevertParametersCommand}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <ProgressBar IsIndeterminate="True" Grid.Column="1" IsVisible="{Binding IsBusy}" />
            <ProgressBar Grid.Column="2" Width="180" Value="{Binding TransferPercent}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="380,*" ColumnSpacing="12">
            <ScrollViewer>
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Border Padding="10">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="Fence synchronization" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="{Binding LocalRevisionText}" />
                            <TextBlock Text="{Binding VehicleRevisionText}" />
                            <TextBlock Text="{Binding ReturnPointText}" />
                            <TextBlock Text="Local geometry has unapplied changes"
                                       Foreground="{DynamicResource Warning}"
                                       IsVisible="{Binding IsGeometryDirty}" />
                            <TextBlock Text="Typed geometry is not advertised by this firmware."
                                       Foreground="{DynamicResource Warning}"
                                       IsVisible="{Binding IsTypedGeometryUnsupported}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="10">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Text="Fence parameters" FontWeight="Bold" FontSize="18" />
                            <ItemsControl ItemsSource="{Binding Parameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="common:ParameterItemViewModel">
                                        <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                            <NumericUpDown
                                                Grid.Column="1"
                                                IsReadOnly="{Binding IsReadOnly}"
                                                Value="{Binding Value, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch"
                                                />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                       Text="{Binding ValidationError}"
                                                       Foreground="{DynamicResource Warning}"
                                                       FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="10">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Text="Fence map edit mode" FontWeight="Bold" FontSize="18" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                                <Button Content="Inclusion polygon" Command="{Binding BeginPolygonInclusionCommand}" />
                                <Button Grid.Column="1" Content="Exclusion polygon" Command="{Binding BeginPolygonExclusionCommand}" />
                                <Button Grid.Row="1" Content="Inclusion circle" Command="{Binding BeginCircleInclusionCommand}" />
                                <Button Grid.Row="1" Grid.Column="1" Content="Exclusion circle" Command="{Binding BeginCircleExclusionCommand}" />
                                <Button Grid.Row="2" Content="Set return point" Command="{Binding BeginReturnPointCommand}" />
                                <!--<TextBox Grid.Row="2" Grid.Column="1" PlaceHolderText="Circle radius (m)"
                                Text="{Binding CircleRadiusMeters, Mode=TwoWay}" />-->
                                <NumericUpDown
                                    Grid.Row="2" Grid.Column="1"
                                    Value="{Binding CircleRadiusMeters, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    />

                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsFenceEditMode}">
                                <Button Content="Finish polygon" Command="{Binding FinishPolygonCommand}" />
                                <Button Content="Cancel edit" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="10">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Text="Local geometry" FontWeight="Bold" FontSize="18" />


                            <!-- TODO: Replace auto-generated columns with native Avalonia column templates after the FullParametersList virtualization test establishes the final grid strategy. -->
                            <DataGrid AutoGenerateColumns="True"
                                      ItemsSource="{Binding Areas}"
                                      SelectedItem="{Binding SelectedArea}"
                                      SelectionMode="Single"

                                      Height="180"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent">


                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Remove selected" Command="{Binding RemoveAreaCommand}" CommandParameter="{Binding SelectedArea}" />
                                <Button Content="Remove return" Command="{Binding RemoveReturnPointCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <tabs:GeoFenceMapView x:Name="FenceMapView" Grid.Column="1" />
        </Grid>
    </Grid>
</utilities:TabItemViewBase>
