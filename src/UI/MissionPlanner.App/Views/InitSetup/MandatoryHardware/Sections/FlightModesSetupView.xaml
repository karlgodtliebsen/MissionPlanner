<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:FlightModesSetupViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                  x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FlightModesSetupView"
                                  x:DataType="sections:FlightModesSetupViewModel"
                                  
                                  >
    <ScrollView VerticalScrollBarVisibility="Always">
        <VerticalStackLayout Padding="16" Spacing="25" HorizontalOptions="Center">
            <ProgressBar IsVisible="{Binding IsBusy}" Progress="{Binding Progress}" />
            <Label Text="{Binding Error}" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
            <Label Text="Flight-mode assignment" FontSize="18" FontAttributes="Bold" />
            <Label Text="{Binding ModeChannelDescription}" FontAttributes="Bold" />
            <Label Text="{Binding Status}" FontAttributes="Italic" LineBreakMode="WordWrap" />
            <Button Text="Refresh flight modes"
                Command="{Binding RefreshCommand}"
                HorizontalOptions="Start" />
            <VerticalStackLayout 
                    
                             IsVisible="{Binding IsSupported}"
                             BindableLayout.ItemsSource="{Binding Slots}"
                             Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sections:FlightModeSlotViewModel">
                        <Border Padding="10" StyleClass="SurfaceContainer,Rounded,Elevation1" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="8">
                                <Label Text="●" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" IsVisible="{Binding IsActive}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding BandDescription}" VerticalOptions="Center" />
                                <material:SelectField Grid.Column="2"
                                    Title="Mode"
                                    ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedMode}"
                                    ItemDisplayBinding="{Binding Name}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
