<?xml version="1.0" encoding="UTF-8" ?>
<uranium:UraniumContentPage
                    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                    xmlns:virtualized="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
                    xmlns:selectable="using:UraniumUI.Material.Extensions.Samples.DataGridSamples.Selectable"
                    xmlns:models="using:UraniumUI.Material.Extensions.Samples.DataGridSamples.Models"
                    x:Class="UraniumUI.Material.Extensions.Samples.DataGridSamples.Selectable.SelectableDataGridPage4"
                    x:DataType="selectable:SelectableDataGridPageViewModel4"
                    >


    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*" ColumnSpacing="20"
          RowSpacing="30"
          Margin="50" HorizontalOptions="Fill"  VerticalOptions="Fill">
        <Button Text="Delete Selected" StyleClass="FilledTonalButton" Command="{Binding RemoveMultiSelectedCommand}" 
                    Margin="30" HorizontalOptions="Center" />

        <Label Grid.Row="1" Text="Multi Selections With Row Click" HorizontalOptions="Center" FontSize="22"/>
        <!--
        SelectionColumn
        RowClick
        SelectionColumnAndRowClick
        -->
        <virtualized:VirtualizedDataGrid  
                                    Grid.Row="2"
                                    ItemsSource="{Binding Items}" 
                                    SelectedItems="{Binding SelectedItems}"
                                    SelectionMode="Multiple"
                                    SelectionTrigger="RowClick"
                                    SelectionChangedCommand="{Binding SelectionChangedCommand}"
                                    ItemSizingStrategy= "MeasureFirstItem"
                                    FilterMemberPaths="Name,Id,Age"
                                    ShowSearchBar="True"
                                    HorizontalOptions="Fill" 
                                    VerticalOptions="Fill"
                                >
            <virtualized:VirtualizedDataGrid.EmptyView>
                <VerticalStackLayout Margin="80,20">
                    <Label Text="No data available..." HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </virtualized:VirtualizedDataGrid.EmptyView>

            <virtualized:VirtualizedDataGrid.Columns>
                <material:DataGridColumn Width="*" x:DataType="models:CustomDataGridStudent"  ValueBinding="{Binding Id}" Title="Id" />
                <material:DataGridColumn Width="3*" x:DataType="models:CustomDataGridStudent"  ValueBinding="{Binding Name}" Title="Name" />
                <material:DataGridColumn Width="*" x:DataType="models:CustomDataGridStudent"  ValueBinding="{Binding Age}" Title="Age" />
            </virtualized:VirtualizedDataGrid.Columns>
        </virtualized:VirtualizedDataGrid>

        <Button Grid.Column="1" Text="Delete Selected" StyleClass="FilledTonalButton" 
                Command="{Binding RemoveSingleSelectedCommand}" 
                    Margin="30" HorizontalOptions="Center" />

        <Label Grid.Row="1" Grid.Column="1"  Text="Single Selection With Row Click" HorizontalOptions="Center" FontSize="22"/>

        <virtualized:VirtualizedDataGrid  
                                    Grid.Row="2" Grid.Column="1" 
                                    ItemsSource="{Binding Items}" 
                                    SelectedItem="{Binding SelectedItem}"
                                    SelectionMode="Single"
                                    SelectionTrigger="RowClick"
                                    SelectionChangedCommand="{Binding SelectionChangedCommand}"
                                    ItemSizingStrategy= "MeasureFirstItem"
                                    FilterMemberPaths="Name,Id,Age"
                                    ShowSearchBar="True"
                                    HorizontalOptions="Fill" 
                                    VerticalOptions="Fill"
                                >
            <virtualized:VirtualizedDataGrid.EmptyView>
                <VerticalStackLayout Margin="80,20">
                    <Label Text="No data available..." HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </virtualized:VirtualizedDataGrid.EmptyView>

            <virtualized:VirtualizedDataGrid.Columns>
                <material:DataGridColumn Width="*"  x:DataType="models:CustomDataGridStudent" ValueBinding="{Binding Id}" Title="Id" />
                <material:DataGridColumn Width="3*" x:DataType="models:CustomDataGridStudent"  ValueBinding="{Binding Name}" Title="Name" />
                <material:DataGridColumn Width="*" x:DataType="models:CustomDataGridStudent"  ValueBinding="{Binding Age}" Title="Age" />
            </virtualized:VirtualizedDataGrid.Columns>
        </virtualized:VirtualizedDataGrid>



    </Grid>
</uranium:UraniumContentPage>
