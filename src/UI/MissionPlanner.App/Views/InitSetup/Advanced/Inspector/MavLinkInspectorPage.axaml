<utilities:NavigationViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Inspector"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Inspector.MavLinkInspectorPage"
    x:TypeArguments="local:MavLinkInspectorViewModel" x:DataType="local:MavLinkInspectorViewModel"
                            xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <ContentPage Header="MAVLink Inspector">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" Margin="24">
            <StackPanel Spacing="8">
                <TextBlock Text="Traffic inspection" Classes="Title" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Dropped, StringFormat='Dropped / omitted observations: {0}'}" Classes="Warning" />
            </StackPanel>
            <Button Grid.Row="1" ToolTip.Tip="Export bounded snapshot" Command="{Binding ExportCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Export bounded snapshot">
                <mdi:MaterialIcon Kind="FileExportOutline" Classes="ActionIcon" />
            </Button>
            <TabControl Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <TabItem Header="Messages">
                    <local:InspectorListView DataContext="{Binding List}" />
                </TabItem>
                <TabItem Header="Selected message details">
                    <local:InspectorDetailView DataContext="{Binding Detail}" />
                </TabItem>
            </TabControl>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
