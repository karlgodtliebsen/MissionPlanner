<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.AccessibilityTabView"
             x:DataType="preferences:PreferencesViewModel">
    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button Classes="EmbeddedIconButton" Grid.Column="1" ToolTip.Tip="Reset section" Command="{Binding ResetSectionCommand}"
                                CommandParameter="Accessibility" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8" Grid.ColumnSpan="2"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">

                        <u:Form LabelPosition="Left" LabelWidth="220" MinWidth="400" HorizontalAlignment="Center">
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  u:FormItem.Label="High-contrast telemetry"
                                          IsChecked="{Binding HighContrastTelemetry}" />

                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  u:FormItem.Label="Reduce telemetry motion"
                                          IsChecked="{Binding ReduceMotion}" />
                            <NumericUpDown
                                HorizontalAlignment="Right" HorizontalContentAlignment="Right" 
                                u:FormItem.Label="Text scale (0.8–2.0)"
                                Value="{Binding TextScale, Mode=TwoWay}"
                                FormatString="F1"
                            />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right" u:FormItem.Label="Announce telemetry warnings"
                                          IsChecked="{Binding AnnounceTelemetryWarnings}"
                            />
                        </u:Form>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
