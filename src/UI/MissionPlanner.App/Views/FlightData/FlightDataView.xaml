<?xml version="1.0" encoding="utf-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="flightData:FlightDataViewModel"  
                            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                            xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                            xmlns:flightData="clr-namespace:MissionPlanner.App.Views.FlightData"
                            xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                            xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                            xmlns:hud="clr-namespace:MissionPlanner.App.Views.FlightData.Hud"
                            xmlns:missions="clr-namespace:MissionPlanner.App.Views.Missions"
                            xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                            xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                            xmlns:extended="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                            x:Class="MissionPlanner.App.Views.FlightData.FlightDataView"
                            x:DataType="flightData:FlightDataViewModel"
                    
>

    <Grid  ColumnDefinitions="260,5,*" ColumnSpacing="0" Padding="5,0,0,0" Margin="0,0,0,0">

        <!-- Left column: HUD + action tabs -->
        <Grid Grid.Column="0" RowDefinitions="*,2*" RowSpacing="4" Grid.ColumnDefinitions="*" >

            <hud:HudView  Grid.Row="0" />
            <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Never" HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Padding="0"
            >
                <tabViews:LifecycleTabView x:Name="TabView" TabHeaderItemColumnWidth="*" >

                    <material:TabItem Title="Quick">
                        <tabs:QuickTabView />
                    </material:TabItem>

                    <material:TabItem Title="Actions">
                        <tabs:ActionsTabView />
                    </material:TabItem>
                    <material:TabItem Title="Messages">
                        <tabs:MessagesTabView />
                    </material:TabItem>

                    <material:TabItem Title="PreFlight">
                        <tabs:PreflightTabView />
                    </material:TabItem>
                    <material:TabItem Title="Gauges">
                        <tabs:GaugesTabView />
                    </material:TabItem>
                    <material:TabItem Title="Transponder">
                        <tabs:TransponderTabView />
                    </material:TabItem>
                    <material:TabItem Title="Status">
                        <tabs:StatusTabView />
                    </material:TabItem>

                    <material:TabItem Title="Servo/Relay">
                        <tabs:ServoRelayTabView />
                    </material:TabItem>
                    <material:TabItem Title="Aux Function">
                        <tabs:AuxFunctionTabView />
                    </material:TabItem>

                    <material:TabItem Title="Scripts">
                        <tabs:ScriptsTabView />
                    </material:TabItem>
                    <material:TabItem Title="Payload Control">
                        <tabs:PayloadControlTabView />
                    </material:TabItem>
                    <material:TabItem Title="Telemetry Logs">
                        <tabs:TelemetryLogsTabView />
                    </material:TabItem>
                    <material:TabItem Title="DataFlash Logs">
                        <tabs:DataFlashLogsTabView />
                    </material:TabItem>
                </tabViews:LifecycleTabView>
            </ScrollView>
        </Grid>

        <!-- Vertical Grid Splitter -->

        <extended:GridSplitter
            Grid.Column="1"
            ResizeMode="PreviousAndNext"
            MinPreviousWidth="180"
            MinNextWidth="220"
            Thickness="12"
            SplitterColor="#3e3e42"
            HoverColor="#007acc"
            ResetOnDoubleTap="True"
            ResetPreviousWidth="260" 
        />

        <!-- Right column: telemetry graph + map -->
        <Grid Grid.Column="2" RowDefinitions="*,Auto" RowSpacing="4">

            <missions:MissionMapView  Grid.Row="0" />

            <!-- Bottom status bar (mirrors Controls.Status) -->
            <Grid x:Name="StatusBar"
                  Grid.Row="1"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                  
                  ColumnSpacing="10"
                  BackgroundColor="#2d2d30">

                <Picker 
                        Grid.Column="0"
                        ItemsSource="{Binding MapStyles}"
                        SelectedItem="{Binding SelectedMapStyle}" />
                <Label 
                    Grid.Column="1"
                    Text="{Binding VehicleDisplayName}"
                    VerticalOptions="Center" />

                <Label 
                    Grid.Column="2"
                    Text="{Binding ConnectionStatus}"
                    VerticalOptions="Center" />

                <Label
                    Grid.Column="3"
                    Text="{Binding TelemetryFreshness}"
                    VerticalOptions="Center" />

                <Label
                    Grid.Column="4"
                    Text="{Binding MapFreshness}"
                    VerticalOptions="Center" />
            </Grid>

        </Grid>

    </Grid>

</navigation:ExtendedContentPage>
