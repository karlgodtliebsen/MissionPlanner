<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent 
    x:TypeArguments="sections:RtkGpsInjectViewModel" 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" 
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
    xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.RtkGpsInjectView" 
    x:DataType="sections:RtkGpsInjectViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="25"  HorizontalOptions="Center">
            <Label Text="RTK / GPS Correction Injection" FontSize="20" FontAttributes="Bold"/>
            <Label Text="RTCM3 source → active vehicle via MAVLink GPS_RTCM_DATA" Opacity="0.75"/>
            <Picker Title="Source" ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}"/>

            <Entry Placeholder="Serial port or caster host" Text="{Binding Endpoint}" HorizontalTextAlignment="End"/>
   
            <controls:NumericField Title="Baud or caster port" Text="{Binding PortOrBaud}" 
                                   Min="0"     
                                   NumberFormat="F0"
                                   HorizontalTextAlignment="End"
                                   Keyboard="Numeric"/>

            <Entry Placeholder="NTRIP mount point" Text="{Binding MountPoint}" HorizontalTextAlignment="End"/>
            <Entry Placeholder="NTRIP username" Text="{Binding Username}" HorizontalTextAlignment="End"/>
            <Entry Placeholder="NTRIP password" Text="{Binding Password}" IsPassword="True" HorizontalTextAlignment="End"/>
            
            <HorizontalStackLayout>
                <material:CheckBox IsChecked="{Binding UseTls}" Text="Use TLS" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh serial devices" Command="{Binding RefreshPortsCommand}"/>
                <Button Text="Connect source" Command="{Binding ConnectCommand}"/>
                <Button Text="Disconnect" Command="{Binding DisconnectCommand}"/>
            </HorizontalStackLayout>
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="{DynamicResource Warning}"/>
            <Label Text="{Binding SourceStatus}" FontAttributes="Bold"/>
            <Label Text="{Binding TargetStatus}"/>
            <Label Text="{Binding Statistics}"/>
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
