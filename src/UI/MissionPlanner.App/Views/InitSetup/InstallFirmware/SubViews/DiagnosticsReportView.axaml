<subViews:DiagnosticsReportView
    xmlns:view="clr-namespace:MissionPlanner.App.Utilities"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:subViews="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware.SubViews"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.SubViews.DiagnosticsReportView"
    x:DataType="subViews:DiagnosticsReportViewModel"
    MinHeight="400"
    MinWidth="600"
    >
    <Border Margin="20" Classes="SectionCard"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Orientation="Vertical" Spacing="20">
                <TextBlock Text="{Binding Title}" Classes="H3" HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding StatusMessage}" Classes="H4" HorizontalAlignment="Center"
                           IsVisible="{Binding HasStatusMessage}"/>

                <SelectableTextBlock Text="{Binding LastDiagnosticReport}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding HasDiagnosticReport}"
                                     />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"  HorizontalAlignment="Center">
                <Button ToolTip.Tip="Copy diagnostic report"
                        Width="100"
                        Padding="8,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasDiagnosticReport}"
                        Command="{Binding CopyDiagnosticReportCommand}"
                        >
                    <avalonia:MaterialIcon Kind="ContentCopy" Width="30" Height="30" />
                </Button>
                <!--Content="Copy diagnostic report"-->
                <Button
                    Width="100"
                    Padding="8,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="OK"
                    Command="{Binding OKCommand}"
                    >
                    <avalonia:MaterialIcon Kind="Check" Width="30" Height="30" />
                </Button>
            </StackPanel>
        </Grid>


    </Border>
</subViews:DiagnosticsReportView>
