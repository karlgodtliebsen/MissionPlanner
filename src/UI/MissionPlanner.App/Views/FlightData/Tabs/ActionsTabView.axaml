<utilities:TabItemViewBase x:TypeArguments="tabs:ActionsTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                           x:Class="MissionPlanner.App.Views.FlightData.Tabs.ActionsTabItemView"
                           x:DataType="tabs:ActionsTabViewModel"
                           xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <ScrollViewer>
        <StackPanel Margin="12" Orientation="Vertical" Spacing="10">
            <Label Content="Vehicle Actions" FontSize="18" FontWeight="Bold" />
            <Border Padding="8" BorderBrush="{DynamicResource Warning}" BorderThickness="1">
                <Label Content="{Binding DataSourceMode}" FontWeight="Bold"
                       Foreground="{DynamicResource Warning}"
                       Theme="{DynamicResource Warning}"
                       />
            </Border>
            <TextBlock Text="{Binding ObservedState}"
                       FontSize="11" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Classes="EmbeddedIconButton"  Grid.Row="0" Grid.Column="0" ToolTip.Tip="Arm" Command="{Binding ArmCommand}" IsEnabled="{Binding CanArm}" AutomationProperties.Name="Arm">
                    <mdi:MaterialIcon Kind="ShieldCheck" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
                <Button Classes="EmbeddedIconButton"  Grid.Row="0" Grid.Column="1" ToolTip.Tip="Disarm" Command="{Binding DisarmCommand}" IsEnabled="{Binding CanDisarm}" AutomationProperties.Name="Disarm">
                    <mdi:MaterialIcon Kind="ShieldOff" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
                <Button Classes="EmbeddedIconButton"  Grid.Row="1" Grid.Column="0" ToolTip.Tip="RTL" Command="{Binding ReturnToLaunchCommand}" IsEnabled="{Binding CanReturnToLaunch}" AutomationProperties.Name="RTL">
                    <mdi:MaterialIcon Kind="HomeMapMarker" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
                <Button Classes="EmbeddedIconButton"  Grid.Row="1" Grid.Column="1" ToolTip.Tip="Loiter / Hold" Command="{Binding HoldCommand}" IsEnabled="{Binding CanHoldPosition}" AutomationProperties.Name="Loiter / Hold">
                    <mdi:MaterialIcon Kind="Pause" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
                <Button Classes="EmbeddedIconButton"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ToolTip.Tip="Land" Command="{Binding LandCommand}" IsEnabled="{Binding CanLand}" AutomationProperties.Name="Land">
                    <mdi:MaterialIcon Kind="AirplaneLanding" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
            </Grid>

            <Label Content="Flight mode" FontWeight="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox Grid.Column="0"
                          HorizontalContentAlignment="Right"
                          ItemsSource="{Binding Modes}"
                          SelectedItem="{Binding SelectedMode}"
                          DisplayMemberBinding="{Binding Name}" />
                <Button Classes="EmbeddedIconButton"  Grid.Column="1" ToolTip.Tip="Set Mode" Command="{Binding SetModeCommand}" IsEnabled="{Binding CanTransmit}" AutomationProperties.Name="Set Mode">
                    <mdi:MaterialIcon Kind="Tune" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
            </Grid>

            <Label Content="Takeoff altitude (m)" FontWeight="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                <NumericUpDown
                    Grid.Column="0"
                    HorizontalContentAlignment="Right"
                    Value="{Binding TakeoffAltitudeMeters, Mode=TwoWay}"
                    FormatString="F1"
                    HorizontalAlignment="Stretch" />

                <Button Classes="EmbeddedIconButton"  Grid.Column="1" ToolTip.Tip="Takeoff" Command="{Binding TakeoffCommand}" IsEnabled="{Binding CanTakeoff}" AutomationProperties.Name="Takeoff">
                    <mdi:MaterialIcon Kind="AirplaneTakeoff" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Classes="EmbeddedIconButton"  Grid.Column="0" ToolTip.Tip="Set Home Here" Command="{Binding SetHomeHereCommand}" IsEnabled="{Binding CanSetHome}" AutomationProperties.Name="Set Home Here">
                    <mdi:MaterialIcon Kind="HomeMapMarker" Classes="ActionIcon" />
                </Button>
                <Button Classes="EmbeddedIconButton"  Grid.Column="1" ToolTip.Tip="Reboot Autopilot" Command="{Binding RebootCommand}" IsEnabled="{Binding CanReboot}" AutomationProperties.Name="Reboot Autopilot">
                    <mdi:MaterialIcon Kind="Restart" Classes="ActionIcon" />
                </Button>
                <Button Classes="EmbeddedIconButton" Grid.Row="1" Grid.ColumnSpan="2"
                        Command="{Binding ToggleAltitudeZeroCommand}"
                        IsEnabled="{Binding CanToggleAltitudeZero}"
                        ToolTip.Tip="Sets the current displayed relative altitude to 0. Vehicle HOME is not changed." AutomationProperties.Name="{Binding AltitudeZeroActionText}">
                    <mdi:MaterialIcon Kind="CrosshairsGps" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
            </Grid>

            <Border Padding="10" Classes="SectionCard" >
                <StackPanel Orientation="Vertical" Spacing="7">
                    <TextBlock Text="Mission intervention" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentMissionSequenceText}" FontSize="11" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0"
                                       HorizontalContentAlignment="Right"
                                       Value="{Binding SelectedMissionSequence, Mode=TwoWay}"
                                       FormatString="F0" />


                        <Button Classes="EmbeddedIconButton" Grid.Column="1" ToolTip.Tip="Set Current WP"
                                Command="{Binding SetCurrentMissionItemCommand}"
                                IsEnabled="{Binding CanSetCurrentMissionItem}" AutomationProperties.Name="Set Current WP">
                            <mdi:MaterialIcon Kind="MapMarker" Classes="ActionIcon" Width="20" Height="20" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Classes="EmbeddedIconButton" Grid.Column="0"
                                Command="{Binding RestartMissionCommand}"
                                IsEnabled="{Binding CanRestartMission}"
                                ToolTip.Tip="Resets to the first item and resets mission state/jump counters. Does not arm or change flight mode." AutomationProperties.Name="Restart Mission">
                            <mdi:MaterialIcon Kind="Restart" Classes="ActionIcon" Width="20" Height="20" />
                        </Button>
                        <Button Classes="EmbeddedIconButton" Grid.Column="1"
                                Command="{Binding ResumeMissionCommand}"
                                IsEnabled="{Binding CanResumeMission}"
                                ToolTip.Tip="Continues a paused onboard mission at its current position. Does not rewrite, arm, take off, or change mode." AutomationProperties.Name="Resume Mission">
                            <mdi:MaterialIcon Kind="Play" Classes="ActionIcon" Width="20" Height="20" />
                        </Button>
                    </Grid>
                    <Button Classes="EmbeddedIconButton"
                            IsVisible="{Binding IsAbortLandingVisible}"
                            IsEnabled="{Binding CanAbortLanding}"
                            Command="{Binding AbortLandingCommand}"
                            ToolTip.Tip="{Binding AbortLandingReason}" AutomationProperties.Name="Abort Landing">
                        <mdi:MaterialIcon Kind="AirplaneTakeoff" Classes="ActionIcon" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Border>

            <Border Padding="10" Classes="SectionCard" >
                <StackPanel Orientation="Vertical" Spacing="7">
                    <Label Content="In-flight adjustments" FontWeight="Bold" />
                    <Label Content="Ground speed" FontSize="11" IsVisible="{Binding IsSpeedTypeSelectorVisible, Converter={StaticResource InvertedBoolConverter}}" />
                    <ComboBox ItemsSource="{Binding SpeedTargetTypes}"
                              HorizontalContentAlignment="Right"
                              SelectedItem="{Binding SelectedSpeedTargetType}"
                              IsVisible="{Binding IsSpeedTypeSelectorVisible}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0"                           
                                       HorizontalContentAlignment="Right"
                                       Value="{Binding TargetSpeedMetersPerSecond, Mode=TwoWay}" FormatString="F1" />
                        <Button Classes="EmbeddedIconButton" Grid.Column="1" ToolTip.Tip="Change Speed" Command="{Binding ChangeSpeedCommand}" IsEnabled="{Binding CanChangeSpeed}" AutomationProperties.Name="Change Speed">
                            <mdi:MaterialIcon Kind="Speedometer" Classes="ActionIcon" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0" 
                                       HorizontalContentAlignment="Right"
                                       Value="{Binding TargetAltitudeAboveHomeMeters, Mode=TwoWay}" FormatString="F1" />
                        <Button Classes="EmbeddedIconButton" Grid.Column="1" Command="{Binding ChangeAltitudeCommand}" IsEnabled="{Binding CanChangeAltitude}"
                                ToolTip.Tip="{Binding ChangeAltitudeReason}" AutomationProperties.Name="Change Altitude">
                            <mdi:MaterialIcon Kind="ArrowUpDown" Classes="ActionIcon" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0" 
                                       HorizontalContentAlignment="Right"
                                       Value="{Binding LoiterRadiusMagnitudeMeters, Mode=TwoWay}" FormatString="F1" />
                        <Button Classes="EmbeddedIconButton" Grid.Column="1" Command="{Binding SetLoiterRadiusCommand}" IsEnabled="{Binding CanSetLoiterRadius}"
                                ToolTip.Tip="{Binding LoiterRadiusReason}" AutomationProperties.Name="Set Loiter Radius">
                                <mdi:MaterialIcon Kind="CircleExpand" Classes="ActionIcon" Width="20" Height="20" />
                        </Button>
                    </Grid>
                    <TextBlock Text="Persistent vehicle parameter. Existing loiter direction is preserved." FontSize="10" />
                </StackPanel>
            </Border>

            <Border Padding="10" Classes="SectionCard" >
                <StackPanel Orientation="Vertical" Spacing="5">
                    <TextBlock Text="Command status" FontWeight="Bold" />
                    <TextBlock Text="{Binding PendingCommand, StringFormat='{}Pending: {0}'}" />
                    <TextBlock Text="{Binding AckResult, StringFormat='{}ACK: {0}'}" />
                    <TextBlock Text="{Binding OperationState.Message}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Expert MAV_CMD" VerticalAlignment="Center" FontWeight="Bold" />
                <ToggleSwitch IsChecked="{Binding IsExpertSectionVisible}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" IsVisible="{Binding IsExpertSectionVisible}" Spacing="6">
                <TextBlock Text="Advanced commands can be hazardous. Verify the command ID and all seven parameters." Foreground="{DynamicResource Warning}" />
                <NumericUpDown
                    HorizontalContentAlignment="Right"
                    Value="{Binding ExpertCommandId, Mode=TwoWay}"
                    FormatString="F1"
                    HorizontalAlignment="Stretch" />

                <TextBox 
                    HorizontalContentAlignment="Right"
                    PlaceholderText="Seven invariant parameters, separated by spaces" Text="{Binding ExpertParameters}" />

                <Button Classes="EmbeddedIconButton" ToolTip.Tip="Validate, Confirm, and Send" Command="{Binding ExecuteExpertCommand}" IsEnabled="{Binding CanTransmit}" AutomationProperties.Name="Validate, Confirm, and Send">
                    <mdi:MaterialIcon Kind="SendCheckOutline" Classes="ActionIcon" />
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</utilities:TabItemViewBase>
