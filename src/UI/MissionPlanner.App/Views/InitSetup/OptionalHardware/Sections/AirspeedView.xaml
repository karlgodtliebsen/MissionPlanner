<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:AirspeedViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" 
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                                  xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                                  x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.AirspeedView" 
                                  x:DataType="sections:AirspeedViewModel"
                                  
                                  >
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="25" HorizontalOptions="Center">
            <Label Text="Airspeed" FontSize="20" FontAttributes="Bold"/>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            <Label Text="{Binding Status}"/>
            <Label Text="Reboot required" TextColor="{DynamicResource Error}" IsVisible="{Binding RebootRequired}"/>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Settings}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sections:ParameterSettingViewModel">
                        <Grid ColumnDefinitions="220,*,90">
                            <Label Text="{Binding DisplayName}" VerticalOptions="Center"/>
                            <controls:NumericField
                                Grid.Column="1" 
                                Value="{Binding PendingValue, Mode=TwoWay}"
                                NumberFormat="F1"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End" />
                            <Button Grid.Column="2" Text="Apply" Command="{Binding ApplyCommand}"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
