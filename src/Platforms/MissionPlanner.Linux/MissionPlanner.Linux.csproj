<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MissionPlanner</RootNamespace>
    <AssemblyName>MissionPlanner</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Publish with: dotnet publish -c Release -r linux-x64 (or linux-arm64) -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UI\MissionPlanner.App\MissionPlanner.App.csproj" />
    <ProjectReference Include="..\..\UI\MissionPlanner.Library.Linux\MissionPlanner.Library.Linux.csproj" />
  </ItemGroup>
</Project>
