<utilities:NavigationViewBase x:TypeArguments="sections:CubeLan8PortSwitchTabViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                              xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                              xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.CubeLan8PortSwitchTabView"
                              x:DataType="sections:CubeLan8PortSwitchTabViewModel"
                              xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              xmlns:sections="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections"
                              xmlns:u="https://irihi.tech/ursa">
    <ContentPage Header="CubeLAN 8 Port Switch"  >

        <Grid x:Name="CubeLanEditorLayout" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12"
              Classes.expanded="{Binding IsEditorExpanded}">
            <Grid.Styles>
                <Style Selector="Grid#CubeLanEditorLayout">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style Selector="Grid#CubeLanEditorLayout.expanded">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="900" MaxWidth="{Binding EditorColumnMaxWidth}" />
            </Grid.ColumnDefinitions>

            <u:Banner Classes="Bordered" Header="CubeLAN 8 Port Switch" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Grid.Row="0"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="10" >

                    <SelectableTextBlock Text="{Binding ErrorMessage}"
                                         IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"
                                         Classes="Danger" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Left">
                        <TextBlock Text="Discovery uses only the repository-documented MAVLink DEVICE_OP I²C path at address 0x50." />
                        <TextBlock Text="The editor exposes COS, COS priority, EEE, VLAN tagging, and the 8×8 VLAN membership matrix." />
                        <TextBlock Text="PoE, port enablement, VLAN IDs, modes, authentication, and editable labels are not exposed because no verified protocol definition exists for them." />
                    </StackPanel>
                    <TextBlock Text="{Binding IsDirty, StringFormat='Pending local changes: {0}'}" VerticalAlignment="Center" />
                </StackPanel>
            </u:Banner>
            
            <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"  Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="2" Padding="12">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="10">
                        <Button x:Name="ToggleEditorWidthButton" Classes="ToolbarButton"
                                ToolTip.Tip="{Binding ToggleEditorWidthText}"
                                AutomationProperties.Name="{Binding ToggleEditorWidthText}"
                                Command="{Binding ToggleEditorWidthCommand}" VerticalAlignment="Center">
                            <Grid>
                                <mdi:MaterialIcon Kind="ArrowExpandHorizontal" Classes="ActionIcon"
                                                  IsVisible="{Binding !IsEditorExpanded}" />
                                <mdi:MaterialIcon Kind="ArrowCollapseHorizontal" Classes="ActionIcon"
                                                  IsVisible="{Binding IsEditorExpanded}" />
                            </Grid>
                        </Button>
                        <Button Classes="ToolbarButton" ToolTip.Tip="Discover / read" Command="{Binding RefreshCommand}" VerticalAlignment="Center" AutomationProperties.Name="Discover / read">
                            <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                        </Button>
                        <Button Classes="ToolbarButton" ToolTip.Tip="Export" Command="{Binding ExportCommand}" AutomationProperties.Name="Export">
                            <mdi:MaterialIcon Kind="FileExportOutline" Classes="ActionIcon" />
                        </Button>
                        <Button Classes="ToolbarButton" ToolTip.Tip="Revert" Command="{Binding RevertCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Revert">
                            <mdi:MaterialIcon Kind="FileUndoOutline" Classes="ActionIcon" />
                        </Button>
                        <Button Classes="ToolbarButton" ToolTip.Tip="Apply and verify" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Apply and verify">
                            <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <controls:VirtualizedItemsGrid
                Grid.Row="3"
                ItemsSource="{Binding Ports}"
                ColumnWidths="*,*,*,*,2*"
                ColumnSpacing="6"
                RowMinHeight="40"
                ShowHeader="True"
                ShowSearchBar="False"
                ShowPagination="False"
                SelectionMode="None"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <controls:VirtualizedItemsGrid.EmptyView>
                    <StackPanel Margin="20" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="No editable CubeLAN device is available."
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Unsupported, not discovered, authentication-required, and disconnected states remain explicit and send no undocumented commands."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:VirtualizedItemsGrid.EmptyView>
                <controls:VirtualizedItemsGrid.HeaderTemplate>
                    <DataTemplate>
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Grid.Column="0" Text="Class of service" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="1" Text="COS high priority" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="2" Text="Energy Efficient Ethernet" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="3" Text="VLAN tagged" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="4" Text="VLAN memberships" Classes="DataGridColumn" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.HeaderTemplate>
                <controls:VirtualizedItemsGrid.RowTemplate>
                    <DataTemplate x:DataType="sections:CubeLanPortViewModel">
                        <controls:VirtualizedItemsGridRow>
                            <CheckBox Grid.Column="0" IsChecked="{Binding ClassOfServiceEnabled, Mode=TwoWay}" Classes="DataGridRow" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding ClassOfServiceHighPriority, Mode=TwoWay}" Classes="DataGridRow" />
                            <CheckBox Grid.Column="2" IsChecked="{Binding EnergyEfficientEthernetEnabled, Mode=TwoWay}" Classes="DataGridRow" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding VlanTagged, Mode=TwoWay}" Classes="DataGridRow" />
                            <ItemsControl Grid.Column="4" ItemsSource="{Binding Memberships}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sections:CubeLanMembershipViewModel">
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsMember, Mode=TwoWay}"
                                                  Margin="0,0,12,4"
                                                  Classes="DataGridRow" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.RowTemplate>
            </controls:VirtualizedItemsGrid>

        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
