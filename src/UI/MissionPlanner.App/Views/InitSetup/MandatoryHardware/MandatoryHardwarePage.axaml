<utilities:NavigationViewBase
    x:TypeArguments="mandatory:MandatoryHardwareViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mandatory="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware"
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.MandatoryHardwarePage"
    x:DataType="mandatory:MandatoryHardwareViewModel">

    <ContentPage Header="Mandatory Hardware"  >
        <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="14">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <SelectableTextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" />
                <TextBlock Text="{Binding VehicleHeading}"  Classes="H4" />
            </StackPanel>
            <TabControl TabStripPlacement="Left" Grid.Row="1" >
                <TabItem Header="Frame"><sections:FrameSetupView /></TabItem>
                <TabItem Header="Accel Calibration"><sections:AccelerometerSetupView /></TabItem>
                <TabItem Header="Compass"><sections:CompassSetupView /></TabItem>
                <TabItem Header="Radio Calibration"><sections:RadioSetupView /></TabItem>
                <TabItem Header="Servo Output"><sections:ServoOutputSetupView /></TabItem>
                <TabItem Header="Serial Ports"><sections:SerialPortsView /></TabItem>
                <TabItem Header="ESC Calibration"><sections:EscMotorSetupView /></TabItem>
                <TabItem Header="Flight Modes"><sections:FlightModesSetupView /></TabItem>
                <TabItem Header="Failsafe"><sections:FailSafeView /></TabItem>
                <TabItem Header="Initial Tune Params"><sections:InitTuneParametersView /></TabItem>
                <TabItem Header="HW ID"><sections:HwIdView /></TabItem>
                <TabItem Header="ADSB"><sections:AdsbView /></TabItem>
                <TabItem Header="Safety"><sections:SafetySetupView /></TabItem>
                <TabItem Header="Summary"><sections:SetupSummaryView /></TabItem>
            </TabControl>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
