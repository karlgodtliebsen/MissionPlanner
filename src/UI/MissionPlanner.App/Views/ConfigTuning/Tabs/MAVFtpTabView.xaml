<?xml version="1.0" encoding="utf-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="tabs:MavFtpTabViewModel"
                      xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                      xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                      xmlns:controls="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
                      xmlns:tabs1="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                      xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                      x:Name="RootPage"
                      x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.MAVFtpTabView"
                      Title="Vehicle Files">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Text="↑" Command="{Binding NavigateUpCommand}" IsEnabled="{Binding CanNavigateUp}" />
            <Label Grid.Column="1" Text="{Binding CurrentPath}" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="MiddleTruncation" />
            <Button Grid.Column="2" Text="Refresh"  IsVisible="{Binding HasConnection}" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="3" Text="Open" IsVisible="{Binding HasEntries}" Command="{Binding OpenSelectedCommand}" />
            <Button Grid.Column="4" Text="Reset sessions"  IsVisible="{Binding HasConnection}" Command="{Binding ResetSessionsCommand}" />
        </Grid>
        <Grid Grid.Row="1">
            <!--<CollectionView ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Single" 
                            EmptyView="{Binding EmptyText}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="36,*,120,140">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="2"
                                                      Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenEntryCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Icon}" FontSize="20" />
                            <Label Grid.Column="1" Text="{Binding Name}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="{Binding TypeText}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="{Binding SizeText}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>-->

            <controls:VirtualizedDataGrid 
                ItemsSource="{Binding Entries}" 
                ItemSizingStrategy= "MeasureFirstItem"
                ShowSearchBar="False"
                HorizontalOptions="Fill" 
                VerticalOptions="Fill" 
                BackgroundColor="Transparent">
                <controls:VirtualizedDataGrid.EmptyView>
                    <Label HorizontalOptions="Center" Text="No items." FontSize="12" Opacity="0.6" Margin="0,20" />
                </controls:VirtualizedDataGrid.EmptyView>
                <controls:VirtualizedDataGrid.Columns>
                    <material:DataGridColumn Width="100"  ValueBinding="{Binding Name}" Title="Name" />
                    <material:DataGridColumn Width="100"  ValueBinding="{Binding TypeText}" Title="Type" />
                    <material:DataGridColumn Width="100"  ValueBinding="{Binding SizeText}" Title="Size" />
                </controls:VirtualizedDataGrid.Columns>
            </controls:VirtualizedDataGrid>
            <!--        
          x:DataType="tabs:VehicleFileSystemEntryViewModel"  
          x:DataType="tabs:VehicleFileSystemEntryViewModel" 
          x:DataType="tabs:VehicleFileSystemEntryViewModel" 
            -->

        </Grid>
        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <Label Text="{Binding ErrorText}" TextColor="Red" />
            <ProgressBar Progress="{Binding TransferProgress}" />
            <Label Text="{Binding TransferDetails}" FontSize="12" />
            <Label Text="{Binding StatusText}" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Download selected" Command="{Binding DownloadSelectedCommand}"  IsVisible="{Binding HasEntries}"/>
                <Button Text="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</navigation:ExtendedContentPage>
