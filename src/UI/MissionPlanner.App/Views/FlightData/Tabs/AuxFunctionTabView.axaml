<utilities:TabItemViewBase
    x:TypeArguments="tabs:AuxFunctionTabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="MissionPlanner.App.Views.FlightData.Tabs.AuxFunctionTabItemView"
    x:DataType="tabs:AuxFunctionTabViewModel"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <ScrollViewer>
        <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
            <TextBlock Text="Auxiliary functions" Classes="H3" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Row="1"
                      MinWidth="100"
                      HorizontalContentAlignment="Right"
                      HorizontalAlignment="Stretch" 
                      ItemsSource="{Binding Functions}"
                      SelectedItem="{Binding SelectedFunction}"
                      DisplayMemberBinding="{Binding Name}"/>
            <TextBlock Grid.Row="2" Text="{Binding SelectedFunction.Description}" HorizontalAlignment="Stretch"  TextWrapping="Wrap"/>
            <ComboBox Grid.Row="3"
                      MinWidth="100"
                      HorizontalContentAlignment="Right"
                      HorizontalAlignment="Stretch" 
                      ItemsSource="{Binding Levels}"
                      SelectedItem="{Binding Level}"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Stretch" >
                <CheckBox Content="Confirm warning/high-risk action"  VerticalAlignment="Center"
                          IsChecked="{Binding IsConfirmed}"/>
                <Button Classes="EmbeddedIconButton" ToolTip.Tip="Execute" Command="{Binding ExecuteCommand}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Execute">
                    <mdi:MaterialIcon Kind="PlayOutline" Classes="ActionIcon" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="5" Text="{Binding Result}" TextWrapping="Wrap" HorizontalAlignment="Stretch" />
        </Grid>
    </ScrollViewer>
</utilities:TabItemViewBase>
