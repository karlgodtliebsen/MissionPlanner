<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MissionPlanner</RootNamespace>
    <OutputType>WinExe</OutputType>
    <!--
    If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\UI\MissionPlanner.App\Resources\AppIcon\mpdesktop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also available to shortcuts that launch a script or dotnet run. -->
    <Content Include="..\..\UI\MissionPlanner.App\Resources\AppIcon\mpdesktop.ico"
             Link="mpdesktop.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UI\MissionPlanner.App\MissionPlanner.App.csproj" />
    <ProjectReference Include="..\..\UI\MissionPlanner.Library.Windows\MissionPlanner.Library.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
