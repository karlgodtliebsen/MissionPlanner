<?xml version="1.0" encoding="utf-8" ?>
<pages:UraniumContentPage x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.OptionalHardwareView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:tabs="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware"
    x:DataType="local:OptionalHardwareViewModel" Title="Optional Hardware">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12">
        <VerticalStackLayout><Label Text="Optional Hardware" FontSize="26" FontAttributes="Bold"/><Label Text="{Binding VehicleHeading}"/><Label Text="{Binding AvailabilitySummary}" Opacity="0.75"/></VerticalStackLayout>
        <tabs:ExtendedTabView Grid.Row="1" TabPlacement="Start" HeaderItemsSource="{Binding Tabs}" SelectedHeaderItem="{Binding SelectedTab,Mode=TwoWay}" UseAnimation="False">
            <material:TabView.TabHeaderItemTemplate><DataTemplate x:DataType="local:OptionalHardwareTabItemViewModel"><Border IsVisible="{Binding IsAvailable}" Padding="8"><VerticalStackLayout><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding StateDisplay}" FontSize="11"/></VerticalStackLayout></Border></DataTemplate></material:TabView.TabHeaderItemTemplate>
            <material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem>
            <material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem>
            <material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem>
            <material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem>
            <material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem><material:TabItem><local:OptionalHardwarePlaceholderView/></material:TabItem>
        </tabs:ExtendedTabView>
    </Grid>
</pages:UraniumContentPage>
