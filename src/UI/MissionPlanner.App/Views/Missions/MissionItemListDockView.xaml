<?xml version="1.0" encoding="utf-8"?>

<navigation:ExtendedContentView x:TypeArguments="missions:MissionItemListDockViewModel" 
                                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                xmlns:missions="clr-namespace:MissionPlanner.App.Views.Missions"
                                xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                                x:Class="MissionPlanner.App.Views.Missions.MissionItemListDockView"
                                x:DataType="missions:MissionItemListDockViewModel"
                                WidthRequest="{Binding CalculatedWidth}"
                                >
    <Grid RowDefinitions="Auto,*">
        <Button HorizontalOptions="Start"  MaximumWidthRequest="50" Margin="10,0,0,0" Text="{Binding GuidingText}" Command="{Binding ExpandCommand}" ></Button>
        <missions:MissionItemListView Grid.Row="1" IsVisible="{Binding IsExpanded}"/>
    </Grid>
</navigation:ExtendedContentView>