<utilities:UserControlViewBase x:TypeArguments="sections:CompassSetupViewModel"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
    xmlns:models="clr-namespace:MissionPlanner.Core.Setup.MandatoryHardware;assembly=MissionPlanner.Core"
    x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.CompassSetupView"
    x:DataType="sections:CompassSetupViewModel">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
                <TextBlock Text="Compass" Classes="H2" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" TextWrapping="Wrap" />
                <Border Classes="SectionCard" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Status" Classes="H3" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding YawSourceText, StringFormat='EKF yaw source: {0}'}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding .}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ValidationText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Arming impact" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ArmingImpact}" TextWrapping="Wrap" />
                        <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Refresh values" Command="{Binding RefreshInventoryCommand}" AutomationProperties.Name="Refresh compass values" />
                    </StackPanel>
                </Border>
                <Border Classes="SectionCard" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Configuration" Classes="H3" />
                        <TextBlock Text="Edits remain pending until you review and apply them." TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Settings}" IsEnabled="{Binding CanEdit}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sections:CompassSettingViewModel">
                                    <Border Padding="0,10" IsVisible="{Binding IsVisible}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <CheckBox IsVisible="{Binding IsToggle}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Label}" />
                                            <ComboBox IsVisible="{Binding !IsToggle}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                                                IsEnabled="{Binding CanEdit}" MinWidth="220" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Label}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CompassChoice">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding UnavailableReason}" Opacity="0.75" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ChangeText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ParameterText}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <TextBlock Text="{Binding DefaultText}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Reset to default" Command="{Binding ResetDefaultCommand}" IsEnabled="{Binding CanReset}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Classes="SectionCard" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Calibration / Actions" Classes="H3" />
                        <TextBlock Text="{Binding CalibrationState, StringFormat='Calibration: {0}'}" />
                        <TextBlock Text="{Binding CalibrationAvailability}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding CanCancel}" />
                        <TextBlock Text="{Binding ProgressSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding QualitySummary}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Start calibration" Command="{Binding StartCalibrationCommand}" Margin="0,0,8,8" />
                            <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Accept results" Command="{Binding AcceptCalibrationCommand}" Margin="0,0,8,8" />
                            <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Cancel calibration" Command="{Binding CancelCalibrationCommand}" Margin="0,0,8,8" />
                            <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Reset / retry" Command="{Binding ResetCommand}" IsEnabled="{Binding CanStart}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <StackPanel IsVisible="{Binding RequiresReboot}" Spacing="8">
                            <TextBlock Text="Changes applied. Reboot required." Classes="Warning" TextWrapping="Wrap" />
                            <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Reboot vehicle" Command="{Binding RebootCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Expander Header="Advanced parameters and diagnostics" IsExpanded="False" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding DiagnosticEvidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock Text="{Binding .}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Open Full Parameters" Command="{Binding OpenFullParametersCommand}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Classes="SectionCard" Padding="12" Margin="0,12,0,0" IsVisible="{Binding HasPendingChanges}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding PendingSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="140">
                    <ItemsControl ItemsSource="{Binding PendingChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid ColumnDefinitions="*,Auto">
                    <Button Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Discard" Command="{Binding DiscardCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}" />
                    <Button Grid.Column="1" Classes="IsToolbarButton" Width="NaN" MinWidth="100" Content="Apply" Command="{Binding ApplyCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</utilities:UserControlViewBase>
