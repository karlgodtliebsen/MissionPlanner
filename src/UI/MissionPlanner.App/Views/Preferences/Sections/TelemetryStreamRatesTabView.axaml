<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.TelemetryStreamRatesTabView"
             x:DataType="preferences:PreferencesViewModel">
    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">

                <Grid ColumnDefinitions="*" RowDefinitions="*">

                    <StackPanel  Orientation="Vertical" Spacing="8"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="Requested MAVLink stream rates in hertz." Classes="H4" HorizontalAlignment="Left" />
                        <TextBlock Text="A value of zero disables the stream request." Classes="H4" HorizontalAlignment="Left" />
                        <u:Form LabelPosition="Left" LabelWidth="220" MinWidth="400" HorizontalAlignment="Center">
                            <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding AttitudeRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" u:FormItem.Label="Attitude" />
                            <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding PositionRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" u:FormItem.Label="Position" />
                            <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding StatusRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" u:FormItem.Label="Mode / status" />
                            <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding RcRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" u:FormItem.Label="RC" />
                            <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding SensorRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" u:FormItem.Label="Sensors" />
                        </u:Form>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
