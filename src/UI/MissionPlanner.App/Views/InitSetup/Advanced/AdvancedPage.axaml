<utilities:NavigationViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced"
    x:TypeArguments="local:AdvancedViewModel"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.AdvancedPage"
    x:DataType="local:AdvancedViewModel"
    x:CompileBindings="True">
    <ContentPage Header="Advanced" Background="{DynamicResource Surface}">
        <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Advanced tools" Classes="Title" />
                <TextBlock Text="Inspect telemetry, manage outputs, and analyze recorded data. Review each tool's requirements before starting."
                           TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}"
                                     TextWrapping="Wrap" Classes="Warning" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AdvancedToolCardViewModel">
                            <Border Classes="SectionCard" Padding="20" Margin="0,0,0,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Feature.Category}" Classes="H5" />
                                    <TextBlock Text="{Binding Feature.Title}" Classes="H4" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Feature.Description}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Feature.Help}" Classes="Warning" TextWrapping="Wrap" />
                                    <SelectableTextBlock Text="{Binding Availability.Reason}" TextWrapping="Wrap" />
                                    <Button Content="Open" Command="{Binding LaunchCommand}" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{Binding Feature.Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
