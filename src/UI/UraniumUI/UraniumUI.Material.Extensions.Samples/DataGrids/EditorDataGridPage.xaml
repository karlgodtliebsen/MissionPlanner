<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                    xmlns:plain="clr-namespace:Plainer.Maui.Controls;assembly=Plainer.Maui"
                    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                    xmlns:dataGrids="clr-namespace:UraniumUI.Material.Extensions.Samples.DataGrids"
                    xmlns:virtualized="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
                    xmlns:models="clr-namespace:UraniumUI.Material.Extensions.Samples.DataGrids.Models"
                    x:Class="UraniumUI.Material.Extensions.Samples.DataGrids.EditorDataGridPage"
                    Title="EditorDataGridPage">
    <uranium:UraniumContentPage.BindingContext>
        <dataGrids:EditorDataGridPageViewModel />
    </uranium:UraniumContentPage.BindingContext>
    <ScrollView>

        <VerticalStackLayout>
            <virtualized:VirtualizedDataGrid 
                ItemsSource="{Binding Items}" 
                HorizontalOptions="Center"
                UseAutoColumns="False"
                AutoColumnWidth= "180"
                MinimumStarColumnWidth= "120"
                MinimumWidthRequest="400"
                MinimumHeightRequest="400"
                ItemSizingStrategy= "MeasureFirstItem"
                FilterMemberPaths="Name,Id,Age"
                ShowSearchBar="False"
                >
                <virtualized:VirtualizedDataGrid.Columns>
                    <material:DataGridColumn ValueBinding="{Binding Id}" Title="Id" />
                    <material:DataGridColumn ValueBinding="{Binding Name}" Title="Name" />
                    <material:DataGridColumn ValueBinding="{Binding Age}" Title="Age" >
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="models:EditorStudent">
                                <Border Padding="3" HorizontalOptions="Center" VerticalOptions="Center"
                                        StrokeShape="RoundRectangle 6">
                                    <plain:EntryView HorizontalTextAlignment="End" Text="{Binding Age}" HorizontalOptions="Center"/>
                                </Border>
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                </virtualized:VirtualizedDataGrid.Columns>

                <!--
                <virtualized:VirtualizedDataGrid.CellItemTemplate>
                    <DataTemplate>
                        <plain:EntryView Text="{material:DataGridValueBinding Mode=TwoWay}" BackgroundColor="Transparent"/>
                    </DataTemplate>
                </virtualized:VirtualizedDataGrid.CellItemTemplate>
                -->
           </virtualized:VirtualizedDataGrid>
 
            <!--<BoxView StyleClass="Divider" />
            <Label Text="Actual data in the ViewModel:" HorizontalOptions="Center" FontAttributes="Bold" FontSize="Title"/>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="{Binding Id}" />
                            <Label Text="{Binding Name}" />
                            <Label Text="{Binding Age}" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>-->
        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>