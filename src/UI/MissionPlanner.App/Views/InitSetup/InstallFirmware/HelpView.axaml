<view:UserControlViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:help="clr-namespace:MissionPlanner.App.Views.Help"
    xmlns:models="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware.SubViews.Models"
    x:TypeArguments="models:FirmwareHelpViewModel"
    x:DataType="models:FirmwareHelpViewModel"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.HelpView">
    <help:HelpArticleView DataContext="{Binding Article}" />
</view:UserControlViewBase>
