                                    <DataTrigger TargetType="BoxView"
                                                 Binding="{Binding Source={RelativeSource Self}, Path=(tabViews:ExtendedTabView.IsHeaderSelected)}"
                                                 Value="True">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
