<utilities:TabItemViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:replay="clr-namespace:MissionPlanner.Core.Replay;assembly=MissionPlanner.Core"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:tabs1="clr-namespace:MissionPlanner.App.Views.Logs"
    x:TypeArguments="tabs1:TelemetryLogsTabViewModel"
    x:Class="MissionPlanner.App.Views.Logs.TelemetryLogsTabItemView"
    x:DataType="tabs1:TelemetryLogsTabViewModel"
    x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="8" 
          HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="2048" />
        </Grid.ColumnDefinitions>
        <WrapPanel ItemSpacing="16" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="100,80,10,60,45,10,60,200" HorizontalAlignment="Center">

                <TextBlock Grid.Column="0" Text="PC telemetry:"   FontWeight="Bold" ToolTip.Tip="PC telemetry" />
                <TextBlock Grid.Column="1" Text="{Binding RecordingState}" FontWeight="Bold" ToolTip.Tip="{Binding RecordingPath}" />
                <TextBlock Grid.Column="2" Text="·"  FontWeight="Bold" />

                <TextBlock Grid.Column="3" Text="{Binding RecordingStateBytes}"  FontWeight="Bold" ToolTip.Tip="{Binding RecordingStateBytes}" />
                <TextBlock Grid.Column="4" Text="bytes"  FontWeight="Bold" />

                <TextBlock Grid.Column="5" Text="·"  FontWeight="Bold" />
                <TextBlock Grid.Column="6" Text="started:"  FontWeight="Bold" ToolTip.Tip="{Binding RecordingPath}"
                           IsVisible="{Binding RecordingStateStarted, Converter={StaticResource StringNotNullEmptyConverter}}"
                           />
                <TextBlock Grid.Column="7" Text="{Binding RecordingStateStarted}" FontWeight="Bold" ToolTip.Tip="{Binding RecordingStateStarted}"
                           IsVisible="{Binding RecordingStateStarted, Converter={StaticResource StringNotNullEmptyConverter}}"
                           />

            </Grid>

            <TextBlock Text="{Binding RecordingError}" Classes="Warning"/>
            <TextBlock Text="{Binding OnboardLoggingState, StringFormat='Onboard DataFlash: {0}'}" ToolTip.Tip="{Binding OnboardLoggingDetail}" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" ItemSpacing="8" HorizontalAlignment="Center">
            <Button Classes="ToolbarButton" Command="{Binding RefreshLogsCommand}" ToolTip.Tip="Refresh recordings" AutomationProperties.Name="Refresh recordings" >
                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding OpenStoredCommand}" ToolTip.Tip="View packets" AutomationProperties.Name="View packets" >
                <mdi:MaterialIcon Kind="FileDocumentOutline" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding ReplayStoredCommand}" ToolTip.Tip="Load selected recording for replay" AutomationProperties.Name="Load selected recording for replay" >
                <mdi:MaterialIcon Kind="Play" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding LoadCommand}" ToolTip.Tip="Import .tlog" AutomationProperties.Name="Import .tlog" >
                <mdi:MaterialIcon Kind="FileImportOutline" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding CopySnapshotCommand}" ToolTip.Tip="Copy complete recording snapshot to clipboard" AutomationProperties.Name="Copy complete recording snapshot to clipboard">
                <mdi:MaterialIcon Kind="ContentCopy" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding ExportLogCommand}" ToolTip.Tip="Export selected recording" AutomationProperties.Name="Export selected recording" >
                <mdi:MaterialIcon Kind="FileExportOutline" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding DeleteLogCommand}" ToolTip.Tip="Delete selected recording" AutomationProperties.Name="Delete selected recording" >
                <mdi:MaterialIcon Kind="DeleteOutline" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="Open telemetry folder" AutomationProperties.Name="Open telemetry folder" IsVisible="{Binding CanOpenLogFolder}">
                <mdi:MaterialIcon Kind="FolderOpenOutline" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding ClearPacketSelectionCommand}" ToolTip.Tip="Clear selection" AutomationProperties.Name="Clear selection" >
                <mdi:MaterialIcon Kind="Close" Classes="ActionIcon" />
            </Button>
            <Button Classes="ToolbarButton" Command="{Binding CancelLogOperationCommand}" ToolTip.Tip="Cancel loading" AutomationProperties.Name="Cancel loading" IsVisible="{Binding IsBusy}">
                <mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon" />
            </Button>
        </WrapPanel>
        <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="12" HorizontalAlignment="Center">
            <controls:VirtualizedItemsGrid ItemsSource="{Binding Logs}"
                                           SelectedItem="{Binding SelectedLog, Mode=OneWayToSource}" SelectionMode="Single"
                                           ColumnWidths="*" RowMinHeight="92" ShowSearchBar="False" ShowPagination="False">
                <controls:VirtualizedItemsGrid.HeaderTemplate>
                    <DataTemplate>
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Text="Recordings (newest first)" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.HeaderTemplate>
                <controls:VirtualizedItemsGrid.RowTemplate>
                    <DataTemplate x:DataType="replay:TelemetryStoredLog">
                        <controls:VirtualizedItemsGridRow>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Created, StringFormat='UTC: {0:u}'}" />
                                <WrapPanel ItemSpacing="8">
                                    <TextBlock Text="{Binding Size, StringFormat='{}{0:N0} bytes'}" />
                                    <TextBlock Text="{Binding Duration}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Vehicle, StringFormat='Vehicle: {0}'}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Firmware, StringFormat='Firmware: {0}'}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.RowTemplate>
            </controls:VirtualizedItemsGrid>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" HorizontalAlignment="Stretch">
                <WrapPanel Grid.Row="0" ItemSpacing="8" HorizontalAlignment="Center">
                    <TextBox Width="180" PlaceholderText="Search text / hex" Text="{Binding PacketSearch}" HorizontalContentAlignment="Right"/>
                    <TextBox Width="160" PlaceholderText="Message ID / name" Text="{Binding MessageFilter}" HorizontalContentAlignment="Right"/>
                    <TextBox Width="75" PlaceholderText="System" Text="{Binding SystemFilter}" HorizontalContentAlignment="Right"/>
                    <TextBox Width="105" PlaceholderText="Component" Text="{Binding ComponentFilter}" HorizontalContentAlignment="Right"/>
                    <TextBox Width="150" PlaceholderText="Severity ≤ (0–7)" Text="{Binding SeverityFilter}" HorizontalContentAlignment="Right"/>
                    <Button Classes="EmbeddedIconButton" Command="{Binding FilterPacketsCommand}" ToolTip.Tip="Apply packet filters" AutomationProperties.Name="Apply packet filters" >
                        <mdi:MaterialIcon Kind="FilterOutline" Classes="ActionIcon" />
                    </Button>
                </WrapPanel>
                <WrapPanel Grid.Row="1" ItemSpacing="8" HorizontalAlignment="Center">
                    <TextBox Width="260" PlaceholderText="Jump to UTC timestamp" Text="{Binding JumpTimestamp}" HorizontalContentAlignment="Right"/>
                    <Button Classes="EmbeddedIconButton" Command="{Binding JumpPacketsCommand}" ToolTip.Tip="Jump to timestamp" AutomationProperties.Name="Jump to timestamp" >
                        <mdi:MaterialIcon Kind="TimelineClockOutline" Classes="ActionIcon" />
                    </Button>
                    <Button Classes="EmbeddedIconButton" Command="{Binding PreviousPacketsCommand}" ToolTip.Tip="Previous packet page" AutomationProperties.Name="Previous packet page" >
                        <mdi:MaterialIcon Kind="ChevronLeft" Classes="ActionIcon" />
                    </Button>
                    <Button Classes="EmbeddedIconButton" Command="{Binding NextPacketsCommand}" ToolTip.Tip="Next packet page" AutomationProperties.Name="Next packet page" >
                        <mdi:MaterialIcon Kind="ChevronRight" Classes="ActionIcon" />
                    </Button>
                    <CheckBox Content="Follow replay" IsChecked="{Binding FollowReplay}" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Grid.Row="2" 
                           HorizontalAlignment="Center"
                           Text="{Binding PacketStatus}" TextWrapping="Wrap" />
                
                <controls:VirtualizedItemsGrid Grid.Row="3" ItemsSource="{Binding Packets}"
                                               ColumnWidths="120,80,55,55,70,150,*" ShowSearchBar="False" ShowPagination="False" SelectionMode="Single">
                    <controls:VirtualizedItemsGrid.HeaderTemplate>
                        <DataTemplate>
                            <controls:VirtualizedItemsGridRow>
                                <TextBlock Grid.Column="0" Text="Time (UTC)" />
                                <TextBlock Grid.Column="1" Text="Delta" />
                                <TextBlock Grid.Column="2" Text="System" />
                                <TextBlock Grid.Column="3" Text="Comp" />
                                <TextBlock Grid.Column="4" Text="Msg ID" />
                                <TextBlock Grid.Column="5" Text="Name" />
                                <TextBlock Grid.Column="6" Text="Summary" />
                            </controls:VirtualizedItemsGridRow>
                        </DataTemplate>
                    </controls:VirtualizedItemsGrid.HeaderTemplate>
                    <controls:VirtualizedItemsGrid.RowTemplate>
                        <DataTemplate x:DataType="replay:TelemetryPacketRow">
                            <controls:VirtualizedItemsGridRow>
                                <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat='{}{0:HH:mm:ss.ffffff}'}" />
                                <TextBlock Grid.Column="1" Text="{Binding Delta}" />
                                <TextBlock Grid.Column="2" Text="{Binding SystemId}" />
                                <TextBlock Grid.Column="3" Text="{Binding ComponentId}" />
                                <TextBlock Grid.Column="4" Text="{Binding MessageId}" />
                                <TextBlock Grid.Column="5" Text="{Binding Name}" />
                                <TextBlock Grid.Column="6" Text="{Binding Summary}" 
                                           ToolTip.Tip="{Binding RawHex}" TextTrimming="CharacterEllipsis" />
                            </controls:VirtualizedItemsGridRow>
                        </DataTemplate>
                    </controls:VirtualizedItemsGrid.RowTemplate>
                </controls:VirtualizedItemsGrid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding SourceModeLabel}" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" Classes="Warning" />
            <WrapPanel ItemSpacing="8" VerticalAlignment="Center">
                <Button Classes="EmbeddedIconButton" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play / pause replay" AutomationProperties.Name="Play / pause replay" >
                    <mdi:MaterialIcon Kind="PlayPause" Classes="ActionIcon" />
                </Button>
                <Button Classes="EmbeddedIconButton" Command="{Binding StopReplayCommand}" ToolTip.Tip="Stop replay at beginning" AutomationProperties.Name="Stop replay at beginning" >
                    <mdi:MaterialIcon Kind="Stop" Classes="ActionIcon" />
                </Button>
                <Button Classes="EmbeddedIconButton" Command="{Binding CloseReplayCommand}" ToolTip.Tip="Close replay" AutomationProperties.Name="Close replay" >
                    <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                </Button>
                <Slider Width="260" Maximum="{Binding DurationSeconds}" Value="{Binding SeekSeconds}"  VerticalAlignment="Center"/>
                <Button Classes="EmbeddedIconButton" Command="{Binding SeekCommand}" ToolTip.Tip="Seek replay" AutomationProperties.Name="Seek replay" >
                    <mdi:MaterialIcon Kind="TimelineClockOutline" Classes="ActionIcon" />
                </Button>
                <NumericUpDown Width="110" Minimum="0.1" Maximum="50" 
                               HorizontalContentAlignment="Right"
                               Increment="0.1" Value="{Binding PlaybackSpeed}" />
                <Button Classes="EmbeddedIconButton" Command="{Binding ApplySpeedCommand}" ToolTip.Tip="Apply replay speed" AutomationProperties.Name="Apply replay speed" >
                    <mdi:MaterialIcon Kind="Speedometer" Classes="ActionIcon" />
                </Button>
                <TextBlock Text="{Binding ReplayTimeText}" VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</utilities:TabItemViewBase>
