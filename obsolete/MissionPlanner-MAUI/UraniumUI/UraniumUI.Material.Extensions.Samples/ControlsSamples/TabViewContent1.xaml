<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="controlsSamples:TabViewModel1" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                  xmlns:controlsSamples="clr-namespace:UraniumUI.Material.Extensions.Samples.ControlsSamples"
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  x:Class="UraniumUI.Material.Extensions.Samples.ControlsSamples.TabViewContent1"
                                  x:DataType="controlsSamples:TabViewModel1"
                                  HeightRequest="200"
                                  VerticalOptions="Fill"
                                  BackgroundColor="CadetBlue"
                                  Margin="50"
                                  >
    <Grid Margin="20" MinimumHeightRequest="50" VerticalOptions="Fill" HorizontalOptions="Fill">
        <Label 
            Text="{Binding Name}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </Grid>
</tabViews:TabViewLifecycleContent>
