<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Proximity"
                               xmlns:u="https://irihi.tech/ursa"
                               x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Proximity.ProximityPage"
                               x:TypeArguments="local:ProximityViewModel" 
                               x:DataType="local:ProximityViewModel">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner  Classes="Bordered" Header="Proximity observations" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Text="Display only. Unknown, stale and unsupported readings never indicate clear space. Uses existing telemetry streams." TextWrapping="Wrap" Classes="Warning" />
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Radar"><local:ProximityRadarView DataContext="{Binding Radar}" /></TabItem>
            <TabItem Header="Sensor diagnostics"><local:ProximityDiagnosticsView DataContext="{Binding Diagnostics}" /></TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
