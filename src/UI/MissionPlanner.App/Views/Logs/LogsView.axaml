<utilities:NavigationViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.Logs"
    x:TypeArguments="local:LogsViewModel"
    x:Class="MissionPlanner.App.Views.Logs.LogsView"
    x:DataType="local:LogsViewModel"
    x:CompileBindings="True">
    <ContentPage Header="Logs">
        <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="12">
            <ComboBox 
                ItemsSource="{Binding Sections}" 
                SelectedItem="{Binding SelectedSection}"
                      HorizontalAlignment="Left" MinWidth="220" />
            <ContentControl Grid.Row="1" Content="{Binding Content}" />
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
