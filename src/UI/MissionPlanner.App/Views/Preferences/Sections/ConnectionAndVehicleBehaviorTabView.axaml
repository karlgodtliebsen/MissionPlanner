<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.ConnectionAndVehicleBehaviorTabView"
             x:DataType="preferences:PreferencesViewModel">

    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
       
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">
                <StackPanel  Orientation="Vertical" Spacing="8"  
                            VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <u:Form LabelPosition="Left" LabelWidth="320" MinWidth="500" HorizontalAlignment="Center">
                        <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding ResetOnUsbConnect}" u:FormItem.Label="Reset flight controller on USB connect (toggle DTR)" />
                        <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding DisableEsp32RtsReset}" u:FormItem.Label="Disable RTS reset for ESP32 Serial/JTAG" />
                        <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding LoadWaypointsOnConnect}" u:FormItem.Label="Load waypoints on connect" />
                        <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding DownloadParametersInBackground}" u:FormItem.Label="Download parameters in background" />
                        <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding NoRcReceiver}" u:FormItem.Label="No RC receiver" />
                        <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding SlowComputerMode}" u:FormItem.Label="Slow computer mode" />
                        <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding GcsSystemId, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" u:FormItem.Label="GCS system ID (0–255)" />
                    </u:Form>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
