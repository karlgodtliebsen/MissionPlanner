<utilities:NavigationViewBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                xmlns:help="clr-namespace:MissionPlanner.App.Views.Help"
                xmlns:introduction="clr-namespace:MissionPlanner.App.Views.Introduction"
                x:TypeArguments="help:HelpViewModel"
                x:DataType="help:HelpViewModel"
                x:Class="MissionPlanner.App.Views.Help.HelpPage">
    <ContentPage Header="Help">
        <Grid ColumnDefinitions="260,*" ColumnSpacing="16" Margin="16">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <TextBlock Text="Help topics" Classes="H3" />
                <TextBox Grid.Row="1" PlaceholderText="Search help" Text="{Binding SearchText, Mode=TwoWay}"
                         AutomationProperties.Name="Search help topics" />
                <ListBox Grid.Row="2" ItemsSource="{Binding VisibleTopics}" SelectedItem="{Binding SelectedTopic, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="help:HelpTopic">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <ContentControl Grid.Column="1" Content="{Binding SelectedTopic}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="help:HelpTopic">
                        <Grid>
                            <Grid IsVisible="{Binding IsTutorial}">
                                <introduction:TutorialView />
                            </Grid>
                            <Grid IsVisible="{Binding !IsTutorial}">
                                <help:HelpArticleView DataContext="{Binding Article}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
