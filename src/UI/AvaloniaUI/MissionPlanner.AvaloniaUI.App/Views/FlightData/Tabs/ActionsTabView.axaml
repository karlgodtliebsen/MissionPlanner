<utilities:TabItemViewBase x:TypeArguments="tabs:ActionsTabViewModel"
                            xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                            xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                            x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.ActionsTabItemView"
                            x:DataType="tabs:ActionsTabViewModel">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Margin="12" Spacing="10">
            <Label Content="Vehicle Actions" FontSize="18" FontWeight="Bold" />
            <Border Padding="8" BorderBrush="{DynamicResource Warning}" BorderThickness="1">
                <Label Content="{Binding DataSourceMode}" FontWeight="Bold" 
                       Foreground="{DynamicResource Warning}" />
            </Border>
            <TextBlock Text="{Binding ObservedState}" FontSize="11" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button  Grid.Row="0" Grid.Column="0" Content="Arm" Command="{Binding ArmCommand}" IsEnabled="{Binding CanArm}" />
                <Button  Grid.Row="0" Grid.Column="1" Content="Disarm" Command="{Binding DisarmCommand}" IsEnabled="{Binding CanDisarm}" />
                <Button  Grid.Row="1" Grid.Column="0" Content="RTL" Command="{Binding ReturnToLaunchCommand}" IsEnabled="{Binding CanReturnToLaunch}" />
                <Button  Grid.Row="1" Grid.Column="1" Content="Loiter / Hold" Command="{Binding HoldCommand}" IsEnabled="{Binding CanHoldPosition}" />
                <Button  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Land" Command="{Binding LandCommand}" IsEnabled="{Binding CanLand}" />
            </Grid>

            <Label Content="Flight mode" FontWeight="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox Grid.Column="0"
                        ItemsSource="{Binding Modes}"
                        SelectedItem="{Binding SelectedMode}"
                        DisplayMemberBinding="{Binding Name}" />
                <Button  Grid.Column="1" Content="Set Mode" Command="{Binding SetModeCommand}" IsEnabled="{Binding CanTransmit}" />
            </Grid>

            <Label Content="Takeoff altitude (m)" FontWeight="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                
                <NumericUpDown
                    Grid.Column="0"
                    Value="{Binding TakeoffAltitudeMeters, Mode=TwoWay}"
                    FormatString="F1"
                    HorizontalAlignment="Stretch" />

                <Button  Grid.Column="1" Content="Takeoff" Command="{Binding TakeoffCommand}" IsEnabled="{Binding CanTakeoff}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button  Grid.Column="0" Content="Set Home Here" Command="{Binding SetHomeHereCommand}" IsEnabled="{Binding CanSetHome}" />
                <Button  Grid.Column="1" Content="Reboot Autopilot" Command="{Binding RebootCommand}" IsEnabled="{Binding CanReboot}" />
                <Button Grid.Row="1" Grid.ColumnSpan="2"
                        Content="{Binding AltitudeZeroActionText}"
                        Command="{Binding ToggleAltitudeZeroCommand}"
                        IsEnabled="{Binding CanToggleAltitudeZero}"
                        ToolTip.Tip="Sets the current displayed relative altitude to 0. Vehicle HOME is not changed." />
            </Grid>

            <Border Padding="10" Classes="SurfaceContainer Rounded Elevation1">
                <StackPanel Orientation="Vertical" Spacing="7">
                    <Label Content="Mission intervention" FontWeight="Bold" />
                    <Label Content="{Binding CurrentMissionSequenceText}" FontSize="11" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0"
                                               Value="{Binding SelectedMissionSequence, Mode=TwoWay}"
                                               FormatString="F0" />


                        <Button Grid.Column="1" Content="Set Current WP"
                                Command="{Binding SetCurrentMissionItemCommand}"
                                IsEnabled="{Binding CanSetCurrentMissionItem}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="Restart Mission"
                                Command="{Binding RestartMissionCommand}"
                                IsEnabled="{Binding CanRestartMission}"
                                ToolTip.Tip="Resets to the first item and resets mission state/jump counters. Does not arm or change flight mode." />
                        <Button Grid.Column="1" Content="Resume Mission"
                                Command="{Binding ResumeMissionCommand}"
                                IsEnabled="{Binding CanResumeMission}"
                                ToolTip.Tip="Continues a paused onboard mission at its current position. Does not rewrite, arm, take off, or change mode." />
                    </Grid>
                    <Button Content="Abort Landing"
                            IsVisible="{Binding IsAbortLandingVisible}"
                            IsEnabled="{Binding CanAbortLanding}"
                            Command="{Binding AbortLandingCommand}"
                            ToolTip.Tip="{Binding AbortLandingReason}" />
                </StackPanel>
            </Border>

            <Border Padding="10" Classes="SurfaceContainer Rounded Elevation1">
                <StackPanel Orientation="Vertical" Spacing="7">
                    <Label Content="In-flight adjustments" FontWeight="Bold" />
                    <Label Content="Ground speed" FontSize="11" IsVisible="{Binding IsSpeedTypeSelectorVisible, Converter={StaticResource InvertedBoolConverter}}" />
                    <ComboBox ItemsSource="{Binding SpeedTargetTypes}"
                                          SelectedItem="{Binding SelectedSpeedTargetType}"
                                          IsVisible="{Binding IsSpeedTypeSelectorVisible}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0" Value="{Binding TargetSpeedMetersPerSecond, Mode=TwoWay}" FormatString="F1" />
                        <Button Grid.Column="1" Content="Change Speed" Command="{Binding ChangeSpeedCommand}" IsEnabled="{Binding CanChangeSpeed}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0" Value="{Binding TargetAltitudeAboveHomeMeters, Mode=TwoWay}" FormatString="F1" />
                        <Button Grid.Column="1" Content="Change Altitude" Command="{Binding ChangeAltitudeCommand}" IsEnabled="{Binding CanChangeAltitude}"
                                ToolTip.Tip="{Binding ChangeAltitudeReason}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0" Value="{Binding LoiterRadiusMagnitudeMeters, Mode=TwoWay}" FormatString="F1" />
                        <Button Grid.Column="1" Content="Set Loiter Radius" Command="{Binding SetLoiterRadiusCommand}" IsEnabled="{Binding CanSetLoiterRadius}"
                                ToolTip.Tip="{Binding LoiterRadiusReason}" />
                    </Grid>
                    <Label Content="Persistent vehicle parameter. Existing loiter direction is preserved." FontSize="10" />
                </StackPanel>
            </Border>

            <Border Padding="10" Classes="SurfaceContainer Rounded Elevation1">
                <StackPanel Orientation="Vertical" Spacing="5">
                    <Label Content="Command status" FontWeight="Bold" />
                    <Label Content="{Binding PendingCommand, StringFormat='{}Pending: {0}'}" />
                    <Label Content="{Binding AckResult, StringFormat='{}ACK: {0}'}" />
                    <TextBlock Text="{Binding OperationState.Message}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Label Content="Expert MAV_CMD" VerticalAlignment="Center" FontWeight="Bold" />
                <ToggleSwitch IsChecked="{Binding IsExpertSectionVisible}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" IsVisible="{Binding IsExpertSectionVisible}" Spacing="6">
                <Label Content="Advanced commands can be hazardous. Verify the command ID and all seven parameters." Foreground="{DynamicResource Warning}" />
               
                <NumericUpDown
                    Value="{Binding ExpertCommandId, Mode=TwoWay}"
                    FormatString="F1"
                    HorizontalAlignment="Stretch" />

                <TextBox PlaceholderText="Seven invariant parameters, separated by spaces" Text="{Binding ExpertParameters}" />

                <Button Content="Validate, Confirm, and Send" Command="{Binding ExecuteExpertCommand}" IsEnabled="{Binding CanTransmit}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</utilities:TabItemViewBase>
