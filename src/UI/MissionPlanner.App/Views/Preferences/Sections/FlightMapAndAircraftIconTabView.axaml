<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.FlightMapAndAircraftIconTabView"
             x:DataType="preferences:PreferencesViewModel">
    <Grid RowDefinitions="Auto,*"
          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">

                <Grid ColumnDefinitions="*" RowDefinitions="*">

                    <StackPanel  Orientation="Vertical" Spacing="8"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch">

                        <u:Form LabelPosition="Left" LabelWidth="220" MinWidth="400" HorizontalAlignment="Center">
                            <NumericUpDown HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding TrackLength, Mode=TwoWay}" FormatString="F0" u:FormItem.Label="Track length" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding ShowDistanceToHome}" u:FormItem.Label="Display distance to home" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding RotateMapToHeading}" u:FormItem.Label="Rotate map to follow aircraft" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding DisplayCourseOverGround}" u:FormItem.Label="Display course over ground" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding DisplayHeading}" u:FormItem.Label="Display heading" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding DisplayNavigationBearing}" u:FormItem.Label="Display navigation bearing" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding DisplayTurnRadius}" u:FormItem.Label="Display turn radius" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding DisplayTarget}" u:FormItem.Label="Display target" />
                            <ToggleSwitch HorizontalAlignment="Right" HorizontalContentAlignment="Right"  IsChecked="{Binding DisplayAircraftToolTip}" u:FormItem.Label="Display aircraft tooltip" />
                            <NumericUpDown HorizontalAlignment="Right" HorizontalContentAlignment="Right"  Value="{Binding AircraftLineLength, Mode=TwoWay}" FormatString="F1" u:FormItem.Label="Aircraft line length" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" u:FormItem.Label="Show airports / ADS-B">
                                <ToggleSwitch IsChecked="{Binding ShowAirports}" />
                                <ToggleSwitch IsChecked="{Binding ShowAdsb}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" u:FormItem.Label="Show no-fly zones / TFRs">
                                <ToggleSwitch IsChecked="{Binding ShowNoFlyZones}" />
                                <ToggleSwitch IsChecked="{Binding ShowTemporaryFlightRestrictions}" />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" HorizontalContentAlignment="Right"  ItemsSource="{Binding MapAccessModes}"
                                      SelectedItem="{Binding MapAccessMode}"
                                      u:FormItem.Label="Map access mode" />
                        </u:Form>


                    </StackPanel>
                </Grid>
            </Border>

        </ScrollViewer>
    </Grid>
</UserControl>
