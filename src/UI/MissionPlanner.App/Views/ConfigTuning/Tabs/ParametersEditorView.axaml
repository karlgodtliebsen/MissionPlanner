<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignWidth="700" 
             d:DesignHeight="450"
             xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.ParametersEditorView"
             x:DataType="tabs:ParametersEditorViewModel"
             Margin="25"
             MinWidth="400"
             >
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="10"
        Margin="10">

        <TextBlock Grid.Row="0"
                   Classes="H2" Text="Add a List of Parameters and Values"
                   HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">

            <!--FileDocumentAddOutline-->
            <Button HorizontalAlignment="Right"
                    ToolTip.Tip="Clear" Width="100" Command="{Binding ClearCommand}">
                <avalonia:MaterialIcon Kind="ClearCircleOutline" Classes="ActionIcon" />
            </Button>

<!--            <Button HorizontalAlignment="Right"
                    ToolTip.Tip="Add Parameters" Width="100" Command="{Binding UseParametersCommand}">
                <avalonia:MaterialIcon Kind="PlusBox" Classes="ActionIcon" />
            </Button>-->

<!--          
            <Button
                ToolTip.Tip="Apply modified"
                VerticalAlignment="Center"
                Command="{Binding WriteParametersCommand}"  >
                <avalonia:MaterialIcon Kind="CheckCircleOutline" Width="30" Height="30" />
            </Button>

            <Button HorizontalAlignment="Right"
                    ToolTip.Tip="Close" Width="100" Command="{Binding CancelCommand}">
                <avalonia:MaterialIcon Kind="Check" Classes="ActionIcon" />
            </Button>-->
        </StackPanel>

<!--                    <TextBlock
                        Classes="H4"
                        TextWrapping="Wrap"
                        ToolTip.Tip="Add a List of Parameters and Values in the Editor below"
                        Text="Add to the Editor below"
                        HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>-->

<!--                    <TextBlock  Classes="H5" Text="LineSeparator: &lt;10&gt;&lt;13&gt; or &lt;10&gt;"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>-->


        <Border Grid.Row="2" Margin="10" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="SectionCard">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" Spacing="5">

                    <TextBlock  Classes="H6" 
                                Text="Accepted Formats: name[separator]value"
                                ToolTip.Tip="Accepted Formats: name,value or name,value //comment or name=value or name=value //comment or name:value or name:value //comment"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock  Classes="H6" Text="Separator: = , : ;"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock  Classes="H6" Text="Line Separator: &lt;10&gt;&lt;13&gt; or &lt;10&gt;"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>


                <TextBox Grid.Row="1" AcceptsReturn="True"
                         MinLines="10"
                         MaxLines="1500"
                         VerticalContentAlignment="Top"
                         Text="{Binding Text}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         Margin="10" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
