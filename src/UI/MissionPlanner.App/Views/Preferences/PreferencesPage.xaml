<?xml version="1.0" encoding="utf-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="preferences:PreferencesViewModel" 
                                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                xmlns:mapSettings="clr-namespace:MissionPlanner.Maps.Settings;assembly=MissionPlanner.Maps"
                                xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                                xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
                                xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                                x:Class="MissionPlanner.App.Views.Preferences.PreferencesPage"
                                x:DataType="preferences:PreferencesViewModel"
                                Padding="5">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="1050" HorizontalOptions="Center">
            <Label Text="MissionPlanner preferences" FontSize="24" FontAttributes="Bold" />
            <Label Text="These settings belong to MissionPlanner on this device. They never write flight-controller parameters. Credentials and tokens are stored separately in platform secure storage and are never exported." />


            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Application appearance" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1">
                            <Button Text="Reset appearance" Command="{Binding ResetApplicationCommand}" CommandParameter="Appearance" />
                        </HorizontalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="8">
                        <material:CheckBox Text="Lock Flyout Menu" Type="Regular" IsChecked="{Binding IsFlyoutLocked,Mode=TwoWay}" />
                        <material:CheckBox Text="Show Flyout Menu at Startup" Type="Regular" IsChecked="{Binding IsFlyoutVisibleAtStartup,Mode=TwoWay}" />
                        <material:CheckBox Text="Show Tutorial at Startup" Type="Regular" IsChecked="{Binding IsTutorialVisibleAtStartup,Mode=TwoWay}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Units and appearance" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1">
                            <Button Text="Reset units" Command="{Binding ResetSectionCommand}" CommandParameter="Units" />
                            <Button Text="Reset appearance" Command="{Binding ResetSectionCommand}" CommandParameter="Appearance" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Unit system" VerticalOptions="Center" />
                        <material:SelectField Grid.Column="1" ItemsSource="{Binding UnitSystems}" SelectedItem="{Binding SelectedUnitSystem}" />
                        <Label Grid.Row="1" Text="Theme (live preview)" VerticalOptions="Center" />
                        <material:SelectField Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                        <Label Grid.Row="2" Text="Layout" VerticalOptions="Center" />
                        <material:SelectField Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding LayoutMode}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Map" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button  Grid.Column="1" Text="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Map" />
                    </Grid>
                    <Label Text="Choose by source purpose. Protocol details remain in the source definition; changing source requires restart." FontSize="12" />

                    <Label Text="Offline packs" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding OfflineMapSources}" EmptyView="No offline packs installed"
                                    HeightRequest="58" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <!--x:DataType="mapSettings:MapSettingsSourceItem"-->
                            <DataTemplate >
                                <Button Text="{Binding DisplayName}" Command="{Binding BindingContext.SelectMapSourceCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Self-hosted/custom" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding CustomMapSources}" EmptyView="Add custom sources from the source editor" 
                                    HeightRequest="58" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <!--x:DataType="mapSettings:MapSettingsSourceItem"-->
                            <DataTemplate >
                                <Button Text="{Binding DisplayName}" Command="{Binding BindingContext.SelectMapSourceCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Online providers" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding OnlineMapSources}" HeightRequest="58" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <!--x:DataType="mapSettings:MapSettingsSourceItem"-->
                            <DataTemplate  >
                                <Button Margin="0,10,0,10" Text="{Binding DisplayName}" Command="{Binding BindingContext.SelectMapSourceCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Blank map" FontAttributes="Bold"  />
                    <CollectionView  ItemsSource="{Binding BlankMapSources}" HeightRequest="68" SelectionMode="None" VerticalOptions="Start">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <!--x:DataType="mapSettings:MapSettingsSourceItem"-->
                            <DataTemplate >
                                <Button Text="{Binding DisplayName}" 
                                        VerticalOptions="Center"
                                        Command="{Binding BindingContext.SelectMapSourceCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                        CommandParameter="{Binding .}" />

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Padding="10" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="Selected source" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding SelectedMapSource.DisplayName}" />
                            <Label Grid.Row="1" Text="Provider / product" />
                            <Label Grid.Row="1" Grid.Column="1"  Text="{Binding SelectedMapSource.ProviderAndProduct}" />
                            <Label Grid.Row="2" Text="Access / rendering" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMapSource.Connectivity, StringFormat='{0}'}" />
                            <Label Grid.Row="3" Text="Format" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedMapSource.Rendering}" />
                            <Label Grid.Row="4" Text="Credentials" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding SelectedMapSource.CredentialState}" />
                            <Label Grid.Row="5" Text="Attribution" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding SelectedMapSource.AttributionPreview}" />
                            <Label Grid.Row="6" Text="Cache / packs" />
                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding SelectedMapSource.CacheBehavior}" />
                            <Label Grid.Row="7" Text="Pack availability" />
                            <Label Grid.Row="7" Grid.Column="1" Text="{Binding SelectedMapSource.OfflinePackAvailability}" />
                            <Label Grid.Row="8" Text="Policy reviewed" />
                            <Label Grid.Row="8" Grid.Column="1" Text="{Binding SelectedMapSource.PolicyReviewDate}" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Default zoom (1–22)" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Column="1"
                            Value="{Binding DefaultMapZoom, Mode=TwoWay}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="1" Text="HTTP cache enabled" />
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding MapHttpCacheEnabled}" HorizontalOptions="Start" />
                        <Label Grid.Row="2" Text="HTTP cache limit (MiB)" />
                        <controls:NumericField Grid.Row="2" Grid.Column="1" HorizontalTextAlignment="End"
                                               Value="{Binding MapHttpCacheLimitMiB, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" NumberFormat="F0" />
                    </Grid>
                    <Label Text="Credentials" FontAttributes="Bold" />
                    <Label Text="Secrets are written directly to secure storage and the input is cleared after save." FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <Entry Text="{Binding MapCredentialInput}" IsPassword="True" Placeholder="Credential for selected source" />
                        <Button Grid.Column="1" Text="Set" Command="{Binding SaveMapCredentialCommand}" />
                        <Button Grid.Column="2" Text="Remove" Command="{Binding RemoveMapCredentialCommand}" />
                        <Button Grid.Column="3" Text="Test" Command="{Binding TestMapCredentialCommand}" />
                    </Grid>
                    <Border Padding="10" StrokeThickness="1" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Offline pack manager" FontAttributes="Bold" />
                            <Label Text="Installed packs are validated archives, not HTTP cache entries." FontSize="12" />
                            <material:SelectField ItemsSource="{Binding InstalledMapPacks}" SelectedItem="{Binding SelectedMapPack}" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                <Button Text="Import / install" Command="{Binding ImportMapPackCommand}" />
                                <Button Grid.Column="1" Text="Select" Command="{Binding SelectMapPackCommand}" />
                                <Button Grid.Column="2" Text="Verify" Command="{Binding VerifyMapPackCommand}" />
                                <Button Grid.Column="3" Text="Remove" Command="{Binding RemoveMapPackCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <Label Text="Coverage" />
                                <Label Grid.Column="1" Text="{Binding SelectedMapPack.Manifest.Bounds}" />
                                <Label Grid.Row="1" Text="Zoom" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMapPack.Manifest.MinimumZoom, StringFormat='Minimum {0}'}" />
                                <Label Grid.Row="2" Text="Size" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMapPack.Manifest.SizeBytes, StringFormat='{0} bytes'}" />
                                <Label Grid.Row="3" Text="Version / source" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedMapPack.Manifest.Version}" />
                                <Label Grid.Row="4" Text="Attribution" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding SelectedMapPack.Manifest.Attribution}" />
                                <Label Grid.Row="5" Text="License" />
                                <Label Grid.Row="5" Grid.Column="1" Text="{Binding SelectedMapPack.Manifest.LicenseNotice}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="10" StrokeThickness="1" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="HTTP cache manager" FontAttributes="Bold" />
                            <Label Text="{Binding MapHttpCacheSizeMiB, StringFormat='Current size: {0:F1} MiB'}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Clear selected source" Command="{Binding ClearSelectedMapCacheCommand}" />
                                <Button Text="Clear all HTTP cache" Command="{Binding ClearAllMapCacheCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Telemetry display" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button  Grid.Column="1" Text="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Telemetry" />
                    </Grid>
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Text="Maximum display rate (Hz)" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Column="1" 
                            Value="{Binding TelemetryDisplayRateHz, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />

                        <Label Grid.Row="1" Text="Chart history (seconds)" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Row="1"
                            Grid.Column="1"
                            Value="{Binding ChartHistorySeconds, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Connection defaults" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button  Grid.Column="1" Text="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Connection" />
                    </Grid>
                    <Label Text="Defaults update the connection UI immediately while disconnected; they never interrupt an active connection." FontSize="12" />
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Channel" VerticalOptions="Center" />
                        <material:SelectField Grid.Column="1" ItemsSource="{Binding ConnectionChannels}" SelectedItem="{Binding ConnectionChannel}" />

                        <Label Grid.Row="1" Text="Host" VerticalOptions="Center" />
                        <controls:AlignedEditorField Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionHost}" Title="Use platform default" />
                        <Label Grid.Row="2" Text="Port" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Column="1" 
                            Value="{Binding ConnectionPort, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="3" Text="Serial baud rate" VerticalOptions="Center" />

                        <controls:NumericField
                            Grid.Column="3" 
                            Value="{Binding ConnectionBaudRate, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Parameter cache" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button  Grid.Column="1" Text="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="ParameterCache" />
                    </Grid>
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Text="Policy" VerticalOptions="Center" />
                        <material:SelectField Grid.Column="1" ItemsSource="{Binding ParameterCachePolicies}" SelectedItem="{Binding SelectedParameterCachePolicy}" />
                        <Label Grid.Row="1" Text="Maximum age (minutes)" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Row="1" Grid.Column="1" 
                            Value="{Binding ParameterCacheMaximumAgeMinutes, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Confirmations" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button  Grid.Column="1" Text="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Confirmations" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Confirm vehicle parameter writes" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ConfirmParameterWrites}" />
                        <Label Grid.Row="1" Text="Confirm arm/disarm operations" VerticalOptions="Center" />
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding ConfirmArmDisarm}" />
                        <Label Grid.Row="2" Text="Confirm firmware changes" VerticalOptions="Center" />
                        <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding ConfirmFirmwareChanges}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Logging and updates" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1">
                            <Button  Text="Reset logging" Command="{Binding ResetSectionCommand}" CommandParameter="Logging" />
                            <Button  Text="Reset updates" Command="{Binding ResetSectionCommand}" CommandParameter="Updates" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Label Text="Logging changes and update-channel changes take effect after restart." FontSize="12" />
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Logging level" VerticalOptions="Center" />
                        <material:SelectField Grid.Column="1" ItemsSource="{Binding LoggingLevels}" SelectedItem="{Binding SelectedLoggingLevel}" />
                        <Label Grid.Row="1" Text="Log retention (days)" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Row="1" Grid.Column="1" 
                            Value="{Binding LogRetentionDays, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="2" Text="Automatic update checks" VerticalOptions="Center" />
                        <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding CheckUpdatesAutomatically}" HorizontalOptions="Start" />
                        <Label Grid.Row="3" Text="Check interval (days)" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Row="3" Grid.Column="1"
                            Value="{Binding UpdateCheckIntervalDays, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />

                        <Label Grid.Row="4" Text="Update channel" VerticalOptions="Center" />
                        <material:SelectField Grid.Row="4" Grid.Column="1" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" />
                        <Label Grid.Row="5" Text="Log directory" VerticalOptions="Center" />
                        <controls:AlignedEditorField Grid.Row="5" Grid.Column="1" Text="{Binding LogDirectory}" Title="Use platform default" />

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Accessibility" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button  Grid.Column="1" Text="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Accessibility" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="High-contrast telemetry" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding HighContrastTelemetry}" />
                        <Label Grid.Row="1" Text="Reduce telemetry motion" VerticalOptions="Center" />
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding ReduceMotion}" />
                        <Label Grid.Row="2" Text="Text scale (0.8–2.0)" VerticalOptions="Center" />
                        <controls:NumericField
                            Grid.Row="2" Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding TextScale, Mode=TwoWay}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />

                        <Label Grid.Row="3" Text="Announce telemetry warnings" VerticalOptions="Center" />
                        <Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding AnnounceTelemetryWarnings}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Legacy units and speech" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Legacy" />
                    </Grid>
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Distance units" VerticalOptions="Center" />
                        <material:SelectField Grid.Column="1" ItemsSource="{Binding DistanceUnits}" SelectedItem="{Binding DistanceUnit}" />
                        <Label Grid.Row="1" Text="Altitude units" VerticalOptions="Center" />
                        <material:SelectField Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AltitudeUnits}" SelectedItem="{Binding AltitudeUnit}" />
                        <Label Grid.Row="2" Text="Speed units" VerticalOptions="Center" />
                        <material:SelectField Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SpeedUnits}" SelectedItem="{Binding SpeedUnit}" />
                        <Label Grid.Row="3" Text="Enable speech" VerticalOptions="Center" />
                        <Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding SpeechEnabled}" HorizontalOptions="Start" />
                        <Label Grid.Row="4" Text="Minimum spoken severity" VerticalOptions="Center" />
                        <material:SelectField Grid.Row="4" Grid.Column="1" ItemsSource="{Binding SpeechSeverities}" SelectedItem="{Binding SpeechSeverity}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Telemetry stream rates" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Requested MAVLink stream rates in hertz. A value of zero disables the stream request." FontSize="12" />
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Attitude" />
                        <controls:NumericField
                            Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding AttitudeRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="1" Text="Position" />
                        <controls:NumericField
                            Grid.Row="1" Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding PositionRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="2" Text="Mode / status" />
                        <controls:NumericField
                            Grid.Row="2" Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding StatusRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="3" Text="RC" />
                        <controls:NumericField
                            Grid.Row="3" Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding RcRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="4" Text="Sensors" />
                        <controls:NumericField
                            Grid.Row="4" Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding SensorRateHz, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Connection and vehicle behavior" FontSize="18" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Reset flight controller on USB connect (toggle DTR)" />
                        <Switch Grid.Column="1" IsToggled="{Binding ResetOnUsbConnect}" />
                        <Label Grid.Row="1" Text="Disable RTS reset for ESP32 Serial/JTAG" />
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding DisableEsp32RtsReset}" />
                        <Label Grid.Row="2" Text="Load waypoints on connect" />
                        <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding LoadWaypointsOnConnect}" />
                        <Label Grid.Row="3" Text="Download parameters in background" />
                        <Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding DownloadParametersInBackground}" />
                        <Label Grid.Row="4" Text="No RC receiver" />
                        <Switch Grid.Row="4" Grid.Column="1" IsToggled="{Binding NoRcReceiver}" />
                        <Label Grid.Row="5" Text="Slow computer mode" />
                        <Switch Grid.Row="5" Grid.Column="1" IsToggled="{Binding SlowComputerMode}" />
                        <Label Grid.Row="6" Text="GCS system ID (0–255)" />
                        <controls:NumericField
                            Grid.Row="6" Grid.Column="1" 
                            Value="{Binding GcsSystemId, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F0"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Flight map and aircraft icon" FontSize="18" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Track length" />
                        <!--<Entry Grid.Column="1" WidthRequest="140" Text="{Binding }" Keyboard="Numeric" />-->
                        <controls:NumericField
                            Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding TrackLength, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />
                        <Label Grid.Row="1" Text="Display distance to home" />
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding ShowDistanceToHome}" />
                        <Label Grid.Row="2" Text="Rotate map to follow aircraft" />
                        <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding RotateMapToHeading}" />
                        <Label Grid.Row="3" Text="Display course over ground" />
                        <Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding DisplayCourseOverGround}" />
                        <Label Grid.Row="4" Text="Display heading" />
                        <Switch Grid.Row="4" Grid.Column="1" IsToggled="{Binding DisplayHeading}" />
                        <Label Grid.Row="5" Text="Display navigation bearing" />
                        <Switch Grid.Row="5" Grid.Column="1" IsToggled="{Binding DisplayNavigationBearing}" />
                        <Label Grid.Row="6" Text="Display turn radius" />
                        <Switch Grid.Row="6" Grid.Column="1" IsToggled="{Binding DisplayTurnRadius}" />
                        <Label Grid.Row="7" Text="Display target" />
                        <Switch Grid.Row="7" Grid.Column="1" IsToggled="{Binding DisplayTarget}" />
                        <Label Grid.Row="8" Text="Display aircraft tooltip" />
                        <Switch Grid.Row="8" Grid.Column="1" IsToggled="{Binding DisplayAircraftToolTip}" />
                        <Label Grid.Row="9" Text="Aircraft line length" />
                        <controls:NumericField
                            Grid.Row="9" Grid.Column="1" 
                            WidthRequest="140"
                            Value="{Binding AircraftLineLength, Mode=TwoWay,Converter={StaticResource IntegerDoubleConverter}}"
                            NumberFormat="F1"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="End" />

                        <Label Grid.Row="10" Text="Show airports / ADS-B" />
                        <HorizontalStackLayout Grid.Row="10" Grid.Column="1">
                            <Switch IsToggled="{Binding ShowAirports}" />
                            <Switch IsToggled="{Binding ShowAdsb}" />
                        </HorizontalStackLayout>
                        <Label Grid.Row="11" Text="Show no-fly zones / TFRs" />
                        <HorizontalStackLayout Grid.Row="11" Grid.Column="1">
                            <Switch IsToggled="{Binding ShowNoFlyZones}" />
                            <Switch IsToggled="{Binding ShowTemporaryFlightRestrictions}" />
                        </HorizontalStackLayout>
                        <Label Grid.Row="12" Text="Map access mode" />
                        <material:SelectField Grid.Row="12" Grid.Column="1" WidthRequest="220" ItemsSource="{Binding MapAccessModes}" SelectedItem="{Binding MapAccessMode}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding RestartRequiredMessage}" IsVisible="{Binding RestartRequired}" 
                   TextColor="{DynamicResource Warning}" FontAttributes="Bold" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="End">
                <Button  Text="Import" Command="{Binding ImportCommand}" Margin="4" />
                <Button  Text="Export" Command="{Binding ExportCommand}" Margin="4" />
                <Button  Text="Reset all" Command="{Binding ResetAllCommand}" Margin="4" />
                <Button  Text="Save preferences" Command="{Binding SaveCommand}" Margin="4" />
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</navigation:ExtendedContentPage>
