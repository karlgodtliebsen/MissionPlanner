<?xml version="1.0" encoding="utf-8" ?>
<navigation:ContentPageView x:TypeArguments="tabs:FullParametersListTabViewModel"
                      xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                      xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                      xmlns:configTuning="clr-namespace:MissionPlanner.App.Views.ConfigTuning"
                      xmlns:virtualized="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
                      xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                      xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                      xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                      x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.FullParametersListTabView"
                      x:DataType="tabs:FullParametersListTabViewModel">


    <navigation:ContentPageView.Content>

        <Grid RowDefinitions="Auto,Auto,*"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          Padding="8,0"
          BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
          >

            <HorizontalStackLayout Grid.Row="0" HeightRequest="50" HorizontalOptions="Fill" VerticalOptions="Center" Padding="8,0" Spacing="12" >
                <Button 
                Text="Load from file"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Command="{Binding LoadFromFileCommand}" />

                <Button 
                Text="Save to file"
                FontSize="14"
                Padding="8,4"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                Command="{Binding SaveToFileCommand}" />
                <Button 
                    Text="Load from json file"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Command="{Binding LoadFromJsonFileCommand}" />

                <Button 
                    Text="Save to json file"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Command="{Binding SaveToJsonFileCommand}" />

                <Button 
                Text="Apply modified"
                FontSize="14"
                Padding="8,4"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                Command="{Binding WriteParametersCommand}" />

                <Button
                    Text="Retry failed"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Command="{Binding RetryFailedCommand}" />

                <Button 
                    Text="Refresh parameters"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Command="{Binding RefreshParametersCommand}" />

                <Button 
                    Text="Clear parameters"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Command="{Binding ClearParametersCommand}" />

                <Button 
                    Text="Compare parameters"
                    FontSize="14"
                    Padding="8,4"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Command="{Binding CompareParametersCommand}" />

                <Button 
                Text="Cancel"
                FontSize="14"
                Padding="8,4"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                Command="{Binding CancelLoadCommand}" />

                <Button 
                Text="Parameter profiles"
                FontSize="14"
                Padding="8,4"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                Command="{Binding LoadPreSavedCommand}" />


                <Button 
                Text="Revert changes"
                FontSize="14"
                Padding="8,4"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                Command="{Binding RevertChangesCommand}" />


            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Row="1" Padding="18,4" Spacing="12" Margin="0,10,0,10">
                <Label TextColor="OrangeRed" Text="{Binding ErrorMessage}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                <Label Text="{Binding StatusMessage}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                <Label Text="Reboot required after confirmed changes"
                       IsVisible="{Binding RebootRequired}"
                       TextColor="OrangeRed"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid Grid.Row="2" VerticalOptions="Fill" HorizontalOptions="Fill" Padding="18,4"  Margin="0,10,0,10">

                <virtualized:VirtualizedDataGrid
                    ItemsSource="{Binding Parameters}"
                    UseAutoColumns="False"
                    AutoColumnWidth= "180"
                    MinimumStarColumnWidth= "120"
                    ItemSizingStrategy= "MeasureFirstItem"
                    ShowRowSeparators="True"
                    FilterMemberPaths="Name,DisplayName,Description"
                    ShowSearchBar="True"
                    >
                    <virtualized:VirtualizedDataGrid.EmptyView>
                        <VerticalStackLayout
                            Padding="40"
                            Spacing="8"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image
                                WidthRequest="40"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static m:MaterialOutlined.Backup_table}, 
                                    Color={AppThemeBinding Light={StaticResource OnSurface}, 
                                    Dark={StaticResource OnSurfaceDark}}}"/>
                            <Label
                                Text="No parameters match the current filter."
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Refresh parameters or clear the search text to display parameters."
                                FontSize="13"
                                Opacity="0.75"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </virtualized:VirtualizedDataGrid.EmptyView>

                    <virtualized:VirtualizedDataGrid.Columns>
                        <material:DataGridColumn Title="Param" Width="160">
                            <material:DataGridColumn.CellItemTemplate >
                                <DataTemplate x:DataType="configTuning:ParameterItemViewModel" >

                                    <Label FontSize="12" VerticalOptions="Center" VerticalTextAlignment="Center" 
                                               HorizontalOptions="Start" HorizontalTextAlignment="Start" 
                                                   Text="{Binding Name}"/>

                                </DataTemplate>
                            </material:DataGridColumn.CellItemTemplate>
                        </material:DataGridColumn>

                        <material:DataGridColumn Title="Value" >
                            <material:DataGridColumn.CellItemTemplate >
                                <DataTemplate  x:DataType="configTuning:ParameterItemViewModel" >
                                    <controls:AlignedEditorField
                                        FontSize="12"  IsReadOnly="{Binding IsReadOnly}"
                                        Keyboard="Numeric"
                                        BorderColor="Aqua"
                                        HorizontalOptions="Fill" VerticalOptions="Center"  
                                        Text="{Binding ValueText, Mode=TwoWay}"
                                        HorizontalTextAlignment="End"
                                        VerticalTextAlignment="Center" />
                                </DataTemplate>
                            </material:DataGridColumn.CellItemTemplate>
                        </material:DataGridColumn>

                        <material:DataGridColumn  Width="200"  Title="Selections">
                            <material:DataGridColumn.CellItemTemplate>
                                <DataTemplate  x:DataType="configTuning:ParameterItemViewModel">
                                    <VerticalStackLayout HorizontalOptions="Fill" VerticalOptions="Center" Margin="5,0,5,0" >
                                        <material:PickerField IsVisible="{Binding HasValuesData}"
                                              FontSize="12" 
                                              BorderColor="Aqua"
                                              Title="Pick an option"
                                              TitleFontSize="10"
                                              WidthRequest="200" VerticalOptions="Center" HorizontalOptions="Fill"
                                              ItemsSource="{Binding ValuesData}"
                                              SelectedItem="{Binding SelectedValue}" />


                                        <material:MultiplePickerField  IsVisible="{Binding HasBitmask}"
                                                       Title="Multiple options"
                                                       BorderColor="Aqua"
                                                       TitleFontSize="10"
                                                       FontSize="14" 
                                                       WidthRequest="200" VerticalOptions="Center" HorizontalOptions="Fill"
                                                       ItemsSource="{Binding BitmaskOptions}" 
                                                       SelectedValuesChangedCommand="{Binding SelectedValuesChanged}"
                                                       SelectedItems="{Binding SelectedBitmaskItems}" />

                                        <controls:NumericUpDownField IsVisible="{Binding HasNumericRangeData}" 
                                                                       Title="Number" 
                                                                       BorderColor="Aqua"
                                                                       TitleFontSize="10"
                                                                       FontSize="14" 
                                                                       WidthRequest="200" 
                                                                       ButtonOrientation="Vertical"
                                                                       Value="{Binding Value, Mode=TwoWay}"
                                                                       Min="{Binding Min}"
                                                                       Max="{Binding Max}"
                                                                       StepSize="{Binding StepSize}"
                                                                       VerticalOptions="Center" HorizontalOptions="Fill"
                                                                       HorizontalTextAlignment="End"
                                                                       VerticalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </material:DataGridColumn.CellItemTemplate>
                        </material:DataGridColumn>

                        <material:DataGridColumn x:DataType="configTuning:ParameterItemViewModel" Width="100"  ValueBinding="{Binding Range}" Title="Range"  />
                        <!--<material:DataGridColumn Width="100"  ValueBinding="{Binding StepSize}" Title="Step Size"  />-->
                        <material:DataGridColumn x:DataType="configTuning:ParameterItemViewModel" Width="100"  ValueBinding="{Binding OriginalValueText}" Title="Default"  />
                        <material:DataGridColumn Width="125" Title="Units">
                            <material:DataGridColumn.CellItemTemplate>
                                <DataTemplate x:DataType="configTuning:ParameterItemViewModel">
                                    <Label FontSize="14" Text="{Binding Units}" Margin="10,0" VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                </DataTemplate>
                            </material:DataGridColumn.CellItemTemplate>
                        </material:DataGridColumn>


                        <material:DataGridColumn Width="150" Title="Write status">
                            <material:DataGridColumn.CellItemTemplate>
                                <DataTemplate x:DataType="configTuning:ParameterItemViewModel">
                                    <VerticalStackLayout Margin="10,0" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Label FontSize="12" Text="{Binding WriteStatus}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                        <Label FontSize="10" Text="{Binding WriteMessage}"  LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </material:DataGridColumn.CellItemTemplate>
                        </material:DataGridColumn>

                        <material:DataGridColumn Title="Description" Width="*">
                            <material:DataGridColumn.CellItemTemplate>
                                <DataTemplate  x:DataType="configTuning:ParameterItemViewModel">

                                    <VerticalStackLayout HorizontalOptions="Fill" VerticalOptions="Center" Margin="10,10,0,10">
                                        <Label FontSize="12" VerticalOptions="Center" VerticalTextAlignment="Center" LineBreakMode="WordWrap"  HorizontalOptions="Start" HorizontalTextAlignment="Start" Text="{Binding DisplayName}"/>
                                        <Label FontSize="12" VerticalOptions="Fill" HorizontalOptions="Fill"  Text=" "/>
                                        <Label FontSize="12" VerticalOptions="Center" VerticalTextAlignment="Center" LineBreakMode="WordWrap"  HorizontalOptions="Start" HorizontalTextAlignment="Start" Text="{Binding Description}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </material:DataGridColumn.CellItemTemplate>
                        </material:DataGridColumn>

                    </virtualized:VirtualizedDataGrid.Columns>
                </virtualized:VirtualizedDataGrid>

                <Grid
                    IsVisible="{Binding ShowComparison}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1B1F}"
                    RowDefinitions="Auto,*"
                    Padding="12">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Select all safe differences" Command="{Binding SelectAllSafeDifferencesCommand}" />
                        <Button Grid.Column="1" Text="Stage selected" Command="{Binding StageSelectedDifferencesCommand}" />
                        <Button Grid.Column="2" Text="Export JSON" Command="{Binding ExportComparisonJsonCommand}" />
                        <Button Grid.Column="3" Text="Export CSV" Command="{Binding ExportComparisonCsvCommand}" />
                        <Picker
                            Grid.Column="4"
                            WidthRequest="140"
                            ItemsSource="{Binding ComparisonFilters}"
                            SelectedItem="{Binding ComparisonFilter}" />
                        <Button Grid.Column="6" Text="Close" Command="{Binding CloseComparisonCommand}" />
                    </Grid>

                    <virtualized:VirtualizedDataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding ComparisonRows}"
                        UseAutoColumns="False"
                        ItemSizingStrategy="MeasureFirstItem"
                        ShowRowSeparators="True"
                        ShowSearchBar="True"
                        FilterMemberPaths="Name,DisplayName,Status,Message">
                        <virtualized:VirtualizedDataGrid.Columns>
                            <material:DataGridColumn Title="Stage" Width="70">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="configTuning:ParameterComparisonItemViewModel">
                                        <CheckBox
                                            IsChecked="{Binding IsSelected}"
                                            IsEnabled="{Binding CanStage}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn x:DataType="configTuning:ParameterComparisonItemViewModel" Width="180" ValueBinding="{Binding Name}" Title="Parameter" />
                            <material:DataGridColumn x:DataType="configTuning:ParameterComparisonItemViewModel" Width="180" ValueBinding="{Binding LeftValue}" Title="Live" />
                            <material:DataGridColumn x:DataType="configTuning:ParameterComparisonItemViewModel" Width="180" ValueBinding="{Binding RightValue}" Title="Right" />
                            <material:DataGridColumn x:DataType="configTuning:ParameterComparisonItemViewModel" Width="140" ValueBinding="{Binding Difference}" Title="Difference" />
                            <material:DataGridColumn x:DataType="configTuning:ParameterComparisonItemViewModel" Width="160" ValueBinding="{Binding Status}" Title="Status" />
                            <material:DataGridColumn x:DataType="configTuning:ParameterComparisonItemViewModel" Width="*" ValueBinding="{Binding Message}" Title="Message" />
                        </virtualized:VirtualizedDataGrid.Columns>
                    </virtualized:VirtualizedDataGrid>
                </Grid>

            </Grid>
        </Grid>
    </navigation:ContentPageView.Content>
</navigation:ContentPageView>      
