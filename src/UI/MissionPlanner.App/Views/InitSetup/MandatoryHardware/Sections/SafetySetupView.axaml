<utilities:UserControlViewBase x:TypeArguments="sections:SafetySetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mandatoryHardware="clr-namespace:MissionPlanner.Core.Setup.MandatoryHardware;assembly=MissionPlanner.Core"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.SafetySetupView"
                               x:DataType="sections:SafetySetupViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>

        <Border HorizontalAlignment="Stretch" Padding="12"  >
            <StackPanel Spacing="10">
                <TextBlock Text="Safety and arming" Classes="H2" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <ItemsControl IsVisible="{Binding HasWarnings}" ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding .}" Classes="Warning" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="12">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                <Button Classes="ToolbarIconButton" ToolTip.Tip="Re-assess safety" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Re-assess safety">
                    <mdi:MaterialIcon Kind="ShieldCheckOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                        ToolTip.Tip="Open Parameters Editor" AutomationProperties.Name="Open Parameters Editor">
                    <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                </Button>
            </WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" Margin="16" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="SectionCard" Padding="12" >
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mandatoryHardware:SafetyCheckItem">
                                <Grid ColumnDefinitions="220,120,*" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</utilities:UserControlViewBase>
