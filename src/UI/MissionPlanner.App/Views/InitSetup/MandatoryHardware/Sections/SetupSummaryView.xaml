<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:SetupSummaryViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:mandatoryHardware="clr-namespace:MissionPlanner.Core.Setup.MandatoryHardware;assembly=MissionPlanner.Core"
                                  xmlns:models1="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Models"
                                  x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.SetupSummaryView"
                                  x:DataType="sections:SetupSummaryViewModel"
                                  >
    <ScrollView VerticalScrollBarVisibility="Always">
        <VerticalStackLayout Padding="16"  Spacing="25" HorizontalOptions="Center">
            <Label Text="Setup summary" FontSize="18" FontAttributes="Bold" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}"/>
            <Label Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}"/>
            <Label Text="{Binding Heading}" FontAttributes="Bold" LineBreakMode="WordWrap" />
            <Label Text="This report describes configuration evidence only and is not a safe-to-fly certification."
               Opacity="0.75"
               LineBreakMode="WordWrap" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models1:SetupSummarySectionViewModel">
                        <Border Padding="10"  StyleClass="SurfaceContainer,Rounded,Elevation1">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="mandatoryHardware:SetupSummaryEntry">
                                            <Grid ColumnDefinitions="200,*,120" ColumnSpacing="8">
                                                <Label Text="{Binding Label}" />
                                                <Label Grid.Column="1" Text="{Binding Value}" LineBreakMode="WordWrap" Opacity="0.8" />
                                                <Label Grid.Column="2" Text="{Binding Status}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding HasWarnings}" BindableLayout.ItemsSource="{Binding Warnings}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" TextColor="{DynamicResource Warning}" LineBreakMode="WordWrap" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Button Text="Rebuild summary" Command="{Binding RefreshCommand}" />
                <Button Text="Export JSON" Command="{Binding ExportJsonCommand}" />
                <Button Text="Export Markdown" Command="{Binding ExportMarkdownCommand}" />
            </HorizontalStackLayout>
            <Editor Text="{Binding ExportedText}"
                IsReadOnly="True"
                HeightRequest="180"
                IsVisible="{Binding HasExport}" />
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
