<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Output"
                               x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Output.MirrorPage"
                               x:TypeArguments="local:MirrorViewModel" 
                               x:DataType="local:MirrorViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa">

    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner  Classes="Bordered" Header="MAVLink mirror" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />

                <WrapPanel >
                    <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" IsEnabled="{Binding !Running}" MinWidth="150" Margin="0,0,12,8" AutomationProperties.Name="Mirror direction" />
                    <Button Classes="EmbeddedIconButton" ToolTip.Tip="Start mirror" Command="{Binding StartCommand}" IsEnabled="{Binding !Running}" Margin="0,0,12,8" AutomationProperties.Name="Start mirror">
                        <mdi:MaterialIcon Kind="PlayOutline" Classes="ActionIcon" />
                    </Button>
                    <Button Classes="EmbeddedIconButton" ToolTip.Tip="Stop mirror" Command="{Binding StopCommand}" IsEnabled="{Binding Running}" Margin="0,0,12,8" AutomationProperties.Name="Stop mirror">
                        <mdi:MaterialIcon Kind="StopCircleOutline" Classes="ActionIcon" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </u:Banner>

        <TabControl Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Output endpoint"><local:OutputEndpointView DataContext="{Binding Endpoint}" /></TabItem>
            <TabItem Header="Output status"><local:OutputStatusView DataContext="{Binding Status}" /></TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
