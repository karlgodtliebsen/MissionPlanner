<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="clr-namespace:MissionPlanner.App.Utilities.Dialogs"
             xmlns:subViews="clr-namespace:MissionPlanner.App.Utilities.Dialogs.SubViews"
             x:Class="MissionPlanner.App.Utilities.Dialogs.SubViews.ProgressDialogView"
             x:DataType="subViews:ProgressDialogViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             MinHeight="400"
             MinWidth="600"
             Margin="25"
             Padding="25"
             >
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
        <StackPanel Orientation="Vertical" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap" Classes="H3" />

            <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"/>

        </StackPanel>
    </Grid>
</UserControl>
