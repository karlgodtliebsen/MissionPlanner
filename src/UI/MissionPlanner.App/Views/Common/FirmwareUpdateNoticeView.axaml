<utilities:UserControlViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="MissionPlanner.App.Views.Common.FirmwareUpdateNoticeView"
    x:TypeArguments="common:FirmwareUpdateNoticeViewModel"
    x:DataType="common:FirmwareUpdateNoticeViewModel">
    <Border IsVisible="{Binding IsVisible}" Padding="12" Margin="8" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="6">
            <TextBlock Text="Firmware update available" FontWeight="Bold" />
            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="IsToolbarButton" Command="{Binding ViewUpgradeCommand}" ToolTip.Tip="View Upgrade" AutomationProperties.Name="View Upgrade">
                    <mdi:MaterialIcon Kind="Upload" />
                </Button>
                <Button Classes="IsToolbarButton" Command="{Binding ReleaseNotesCommand}" ToolTip.Tip="Release Notes" AutomationProperties.Name="Release Notes">
                    <mdi:MaterialIcon Kind="FileDocumentOutline" />
                </Button>
                <Button Classes="IsToolbarButton" Command="{Binding LaterCommand}" ToolTip.Tip="Later" AutomationProperties.Name="Later">
                    <mdi:MaterialIcon Kind="Close" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</utilities:UserControlViewBase>
