<UserControl
    x:Class="MissionPlanner.AvaloniaUI.App.Utilities.Dialogs.OverlayViewDialog"
    xmlns="https://github.com/avaloniaui"   
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MissionPlanner.AvaloniaUI.App.Utilities.Dialogs"
    xmlns:dialogs="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities.Dialogs"
    x:DataType="dialogs:OverlayViewDialogViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <TextBlock
            Grid.Row="0"
            Margin="16,12"
            Text="{Binding Title}"
            FontSize="18"
            FontWeight="SemiBold"/>

        <ContentControl
            Grid.Row="1"
            Margin="16"
            Content="{Binding Content}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"/>

        <Border
            Grid.Row="2"
            Padding="16,10">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">

                <Button
                    MinWidth="90"
                    Content="{Binding CloseText}"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding ShowCloseButton}"/>

                <Button
                    MinWidth="90"
                    Content="{Binding OkText}"
                    Command="{Binding OkCommand}"
                    IsVisible="{Binding ShowOkButton}"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>