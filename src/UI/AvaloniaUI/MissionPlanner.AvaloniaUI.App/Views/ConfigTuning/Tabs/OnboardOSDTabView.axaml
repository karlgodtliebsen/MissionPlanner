<utilities:TabItemViewBase x:TypeArguments="tabs:OnboardOsdTabViewModel" 
                           xmlns="https://github.com/avaloniaui"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" 
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                           xmlns:common="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.Common"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs"
                           xmlns:navigation="clr-namespace:MissionPlanner.AvaloniaUI.App.Navigation"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs.OnboardOSDTabView"
                           x:DataType="tabs:OnboardOsdTabViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,220,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Screen" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" />
            <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="8">
                <Button  Content="Apply selected screen" Command="{Binding ApplyScreenCommand}" />
                <Button  Content="Reset to live" Command="{Binding ResetScreenCommand}" />
                <Button  Content="Import layout" Command="{Binding ImportCommand}" />
                <Button  Content="Export layout" Command="{Binding ExportCommand}" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Grid.Column="3" IsVisible="{Binding IsBusy}" />
        </Grid>

        <Border Grid.Row="1" Padding="10">
            <StackPanel Orientation="Vertical" Spacing="3">
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource Warning}"
                       IsVisible="{Binding HasValidationIssues}"
                       TextWrapping="Wrap" />
                <TextBlock Text="Font upload is not offered because no font-transfer service is registered."
                       FontSize="12"
                       Opacity="0.75"
                       IsVisible="{Binding HasOsdConfiguration}" />
                <TextBlock Text="The connected firmware exposes no discoverable OSD screens/items."
                       Foreground="{DynamicResource Warning}"
                       IsVisible="{Binding IsUnsupported}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="12" IsVisible="{Binding HasOsdConfiguration}">
            <ScrollViewer>
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Border Padding="8">
                        <StackPanel Orientation="Vertical" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Visual character-grid preview" FontWeight="Bold" FontSize="18" />
                                <TextBlock Text="{Binding SelectedScreen.GridSizeText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <tabs:OnboardOsdPreviewView />
                        </StackPanel>
                    </Border>

                    <Border Padding="8">
                        <StackPanel Orientation="Vertical" Spacing="6">
                            <TextBlock Text="Screen enable and options" FontWeight="Bold" FontSize="18" />
                            <ItemsControl ItemsSource="{Binding SelectedScreen.Parameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="common:ParameterItemViewModel">
                                        <Grid ColumnDefinitions="2*,Auto,130" ColumnSpacing="8">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LiveValue, StringFormat='Live {0:G}'}" VerticalAlignment="Center" />
                                            <NumericUpDown
                                                IsReadOnly="{Binding IsReadOnly}" 
                                                Grid.Column="2" 
                                                Value="{Binding Value, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch"
                                                 />

                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="8" IsVisible="{Binding HasGlobalParameters}">
                        <StackPanel Orientation="Vertical" Spacing="6">
                            <TextBlock Text="Global OSD options" FontWeight="Bold" FontSize="18" />
                            <ItemsControl ItemsSource="{Binding GlobalParameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="common:ParameterItemViewModel">
                                        <Grid ColumnDefinitions="*,130" ColumnSpacing="8">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <NumericUpDown
                                                IsReadOnly="{Binding IsReadOnly}" 
                                                Grid.Column="1" 
                                                Value="{Binding Value, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch"
                                                 />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="2*,Auto" RowSpacing="10">
               
                <ListBox ItemsSource="{Binding SelectedScreen.Items}"
                                SelectedItem="{Binding SelectedItem}"
                                SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="tabs:OsdItemViewModel">
                            <Border Padding="8" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Key}" FontSize="11" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    <TextBlock Grid.Row="1" Text="{Binding Column, StringFormat='Column {0}'}" FontSize="12" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Row, StringFormat='Row {0}'}" FontSize="12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" Padding="10">
                    <StackPanel Orientation="Vertical" Spacing="6">
                        <TextBlock Text="Selected item placement" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding SelectedItem.Title}" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedItem.Description}" FontSize="12" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,90,Auto,90" ColumnSpacing="6">
                            <TextBlock Text="Column" VerticalAlignment="Center" />
                            <NumericUpDown
                                Grid.Column="1" 
                                Value="{Binding SelectedItem.Column, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                 />

                            <TextBlock Grid.Column="2" Text="Row" VerticalAlignment="Center" />
                            <NumericUpDown
                                Grid.Column="3" 
                                Value="{Binding SelectedItem.Row, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                 />


                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <Button  Content="← Left" Command="{Binding MoveLeftCommand}" />
                            <Button  Grid.Column="1" Content="↑ Up" Command="{Binding MoveUpCommand}" />
                            <Button  Grid.Column="2" Content="↓ Down" Command="{Binding MoveDownCommand}" />
                            <Button  Grid.Column="3" Content="Right →" Command="{Binding MoveRightCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedItem.ValidationError}" Foreground="{DynamicResource Warning}" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding SelectedItem.AdditionalParameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="common:ParameterItemViewModel">
                                    <Grid ColumnDefinitions="*,110" ColumnSpacing="6">
                                        <TextBlock Text="{Binding DisplayName}" />
                                      <NumericUpDown
                                            IsReadOnly="{Binding IsReadOnly}" 
                                            Grid.Column="1" 
                                            Value="{Binding Value, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                             />

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</utilities:TabItemViewBase>
