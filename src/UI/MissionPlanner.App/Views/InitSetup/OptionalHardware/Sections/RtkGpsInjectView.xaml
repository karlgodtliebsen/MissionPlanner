<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:RtkGpsInjectViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:optionalHardware="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware"
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                                  x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.RtkGpsInjectView"
                                  x:DataType="sections:RtkGpsInjectViewModel"
                                  >
    <VerticalStackLayout>
        <ProgressBar IsVisible="{Binding IsBusy}" Progress="{Binding Progress}" />
        <Label 
            Text="Welcome to RTK GPS Inject!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</tabViews:TabViewLifecycleContent>
