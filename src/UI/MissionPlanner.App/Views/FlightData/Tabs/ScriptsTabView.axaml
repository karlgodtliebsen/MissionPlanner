<utilities:TabItemViewBase x:TypeArguments="tabs:ScriptsTabViewModel" xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                           xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.App.Views.FlightData.Tabs.ScriptsTabItemView"
                           x:DataType="tabs:ScriptsTabViewModel"
                            xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        <TextBlock Text="Scripts" FontSize="18" FontWeight="Bold"/>
        <TextBox Grid.Row="1" Text="{Binding ScriptJson}" AcceptsReturn="True" MinHeight="100"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button ToolTip.Tip="Validate" Command="{Binding ValidateCommand}" AutomationProperties.Name="Validate">
                <mdi:MaterialIcon Kind="FileCheckOutline" Classes="ActionIcon" />
            </Button>
            <Button ToolTip.Tip="Dry run" Command="{Binding DryRunCommand}" AutomationProperties.Name="Dry run">
                <mdi:MaterialIcon Kind="FlaskOutline" Classes="ActionIcon" />
            </Button>
            <Button ToolTip.Tip="Run" Command="{Binding RunCommand}" AutomationProperties.Name="Run">
                <mdi:MaterialIcon Kind="PlayOutline" Classes="ActionIcon" />
            </Button>
            <Button ToolTip.Tip="Cancel" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel">
                <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
            </Button>
            <TextBlock Text="{Binding Status}"/>
        </StackPanel>
        <ListBox Grid.Row="3" ItemsSource="{Binding Output}"/>
    </Grid>
</utilities:TabItemViewBase>
