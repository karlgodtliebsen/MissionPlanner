<utilities:NavigationViewBase x:TypeArguments="local:InstallFirmwareViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.InstallFirmwarePage"
                              x:DataType="local:InstallFirmwareViewModel">

    <ContentPage Header="Install Firmware" >
        <Grid RowDefinitions="*,32" HorizontalAlignment="Stretch">
            <ScrollViewer Grid.Row="0"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Margin="25" Spacing="20" HorizontalAlignment="Stretch">
                    <Border IsVisible="{Binding IsConnectedMode}" Padding="24" Classes="SectionCard">
                        <StackPanel Orientation="Vertical" Spacing="14">
                            <TextBlock Text="A vehicle is connected" Classes="Title"  />
                            <TextBlock Text="Application firmware cannot be installed while Mission Planner owns the active connection. Disconnect the vehicle first to browse or install firmware." />
                            <TextBlock Text="Embedded bootloader update is available only for a supported, disarmed ArduPilot vehicle. Keep power connected and reboot after an accepted update." />
                            <Button Content="Update Bootloader" Command="{Binding UpdateBootloaderCommand}" IsEnabled="{Binding CanUpdateBootloader}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsUnsupportedMode}" Padding="24" Classes="SectionCard">
                        <TextBlock Text="Direct firmware installation is not available on this platform." Classes="Title"  />
                    </Border>
                    <Border Padding="14" Classes="SectionCard">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="{Binding ContextHelp.Title}" Classes="H4" />
                            <TextBlock Text="{Binding ContextHelp.Content}" Classes="H5 Warning"/>
                        </StackPanel>
                    </Border>

                    <TabControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TabIndex="0" SelectedIndex="{Binding SelectedIndex,Mode=TwoWay}">
                        <TabItem Header="Select Firmware from Catalogue" IsEnabled="{Binding IsDisconnectedMode}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                            <local:FirmwareCatalogueView />
                        </TabItem>

                        <TabItem Header="Custom Firmware" IsEnabled="{Binding IsDisconnectedMode}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                            <local:CustomFirmwareView />
                        </TabItem>
                        <TabItem Header="STM32 Bootloader" IsEnabled="{Binding HasDfuBootLoader}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                            <local:STM32BootloaderView/>
                        </TabItem>
                        <TabItem Header="Help &amp; Support" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                            <local:HelpView />
                        </TabItem>
                    </TabControl>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12,6"
                        Spacing="10" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsVisible="{Binding IsCancellationDeferred}">
                    <TextBlock Text="Firmware Operation Status:" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="  •  " FontSize="16"  VerticalAlignment="Center" />
                    <TextBlock Text="Cancellation is deferred until verification and vehicle reboot reach a safe boundary. Keep power connected." Classes="Warning"
                               IsVisible="{Binding IsCancellationDeferred}" />
                </StackPanel>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsVisible="{Binding IsPowerCritical}">
                    <TextBlock Text="Firmware Operation Status:" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="  •  " FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Do not disconnect power while flash memory is being changed." Classes="Warning"
                               IsVisible="{Binding IsPowerCritical}" />
                </StackPanel>
            </StackPanel>

        </Grid>

    </ContentPage>
</utilities:NavigationViewBase>
