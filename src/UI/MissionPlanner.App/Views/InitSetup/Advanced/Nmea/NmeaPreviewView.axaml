<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Nmea"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Nmea.NmeaPreviewView"
    x:TypeArguments="local:NmeaPreviewViewModel" x:DataType="local:NmeaPreviewViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <TextBlock Text="{Binding Batch.Status}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="{Binding Counters}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding Batch.Text}" FontFamily="monospace" AutomationProperties.Name="Latest complete NMEA sentences" />
        </ScrollViewer>
    </Grid>
</utilities:UserControlViewBase>
