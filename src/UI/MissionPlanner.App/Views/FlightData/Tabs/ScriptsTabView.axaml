<utilities:TabItemViewBase x:TypeArguments="tabs:ScriptsTabViewModel" xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                           xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.App.Views.FlightData.Tabs.ScriptsTabItemView"
                           x:DataType="tabs:ScriptsTabViewModel"
                           xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <ScrollViewer >

        <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
            <TextBlock Text="Scripts" Classes="H3"/>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8">
                <Button Classes="EmbeddedIconButton" ToolTip.Tip="Validate" Command="{Binding ValidateCommand}" AutomationProperties.Name="Validate">
                    <mdi:MaterialIcon Kind="FileCheckOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="EmbeddedIconButton" ToolTip.Tip="Dry run" Command="{Binding DryRunCommand}" AutomationProperties.Name="Dry run">
                    <mdi:MaterialIcon Kind="FlaskOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="EmbeddedIconButton" ToolTip.Tip="Run" Command="{Binding RunCommand}" AutomationProperties.Name="Run">
                    <mdi:MaterialIcon Kind="PlayOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="EmbeddedIconButton" ToolTip.Tip="Cancel" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel">
                    <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                </Button>
            </WrapPanel>
            <TextBox Grid.Row="2" Text="{Binding ScriptJson}" AcceptsReturn="True" MinHeight="100"/>
            <TextBlock Grid.Row="3" Text="{Binding Status}"/>

            <ListBox Grid.Row="4" ItemsSource="{Binding Output}"/>
        </Grid>
    </ScrollViewer>

</utilities:TabItemViewBase>
