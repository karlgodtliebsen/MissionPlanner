<utilities:UserControlViewBase x:TypeArguments="sections:InitTuneParametersViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.Themes.Controls;assembly=MissionPlanner.Themes"
                               xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:appSetup="clr-namespace:MissionPlanner.App.Views.Common"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.InitTuneParametersView"
                               x:DataType="sections:InitTuneParametersViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner ShowIcon="False"  Classes="Bordered" Header="Initial Tune Parameters" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Guidance}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding .}" Classes="Warning" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                        </WrapPanel>
                    </Border>
                    <appSetup:SetupInformationView Grid.Row="1"  Topic="InitialTune"
                                                   WorkflowStatus="{Binding StatusMessage}"
                                                   WorkflowError="{Binding ErrorMessage}" />
                </Grid>
            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="1" Margin="16,0" HorizontalAlignment="Stretch"  HorizontalScrollBarVisibility="Disabled">
                        <Border  Padding="12">
                            <StackPanel Spacing="10">
                                <Expander Header="Initial tune calculator" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Starting estimates from the original calculator. Verify against current firmware guidance. Recommendations are not selected or written automatically." TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                            <StackPanel><TextBlock Text="Propeller (inches)" /><NumericUpDown Value="{Binding PropellerInches}" Minimum="1" Maximum="100" Increment="0.1" /></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Battery cells" /><NumericUpDown Value="{Binding BatteryCells}" Minimum="1" Maximum="32" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Maximum cell V" /><NumericUpDown Value="{Binding CellMaximumVoltage}" Minimum="1" Maximum="5" Increment="0.05" /></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock Text="Minimum cell V" /><NumericUpDown Value="{Binding CellMinimumVoltage}" Minimum="1" Maximum="5" Increment="0.05" /></StackPanel>
                                        </Grid>
                                        <CheckBox Content="T-Motor ESC low-expo estimate" IsChecked="{Binding TMotorEsc}" />
                                        <WrapPanel ItemSpacing="10">
                                            <Button Command="{Binding CalculateCommand}" ToolTip.Tip="Calculate without writing" AutomationProperties.Name="Calculate initial tune">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><mdi:MaterialIcon Kind="Calculator" /><TextBlock Text="Calculate" /></StackPanel>
                                            </Button>
                                            <Button Command="{Binding StageSelectedCommand}" ToolTip.Tip="Stage selected recommendations" AutomationProperties.Name="Stage selected recommendations">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><mdi:MaterialIcon Kind="CheckCircleOutline" /><TextBlock Text="Stage selected" /></StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyModifiedCommand}" ToolTip.Tip="Write pending values and verify readback" AutomationProperties.Name="Apply modified initial tune values">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><mdi:MaterialIcon Kind="UploadOutline" /><TextBlock Text="Apply modified" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding Proposals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sections:InitialTuneProposalViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,*,*" ColumnSpacing="10" Margin="0,4">
                                                        <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Before, StringFormat='Current: {0}'}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding After, StringFormat='Proposed: {0}'}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sections:PeripheralSettingViewModel">
                                            <Border Classes="SectionCard" Padding="12">
                                                <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="10">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.7" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1"
                                                              HorizontalContentAlignment="Right"
                                                              HorizontalAlignment="Stretch"
                                                              ToolTip.Tip="Value" 
                                                              IsVisible="{Binding HasOptions}"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding SelectedOption}"
                                                              DisplayMemberBinding="{Binding Name}" />
                                                    <NumericUpDown Grid.Column="1"
                                                                   HorizontalContentAlignment="Right"
                                                                   PlaceholderText="Value" 
                                                                   IsVisible="{Binding IsNumeric}"
                                                                   Value="{Binding NumericValue, Mode=TwoWay}" FormatString="F1"
                                                                   HorizontalAlignment="Stretch" />
                                                    <Button Classes="EmbeddedIconButton" Grid.Column="2" ToolTip.Tip="Apply" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply">
                                                        <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
