<utilities:UserControlViewBase x:TypeArguments="sections:AdsbViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.AdsbView"
                               x:DataType="sections:AdsbViewModel"
                            xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
            <TextBlock Text="ADSB" Classes="H2" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"  Theme="{DynamicResource ProgressRing}" />
            <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" 
                                 IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
            <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                 IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
            <ItemsControl ItemsSource="{Binding Guidance}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
<TextBlock Text="{Binding .}" Classes="Warning" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sections:PeripheralSettingViewModel">
                        <Border Classes="SectionCard" Padding="12">
                            <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="10">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ToolTip.Tip="Value" IsVisible="{Binding HasOptions}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberBinding="{Binding Name}" />
                                <TextBox Grid.Column="1" PlaceholderText="Value" IsVisible="{Binding IsNumeric}" Text="{Binding NumericValue}" />
                                <Button Grid.Column="2" ToolTip.Tip="Apply" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply">
                                    <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel HorizontalAlignment="Right">
            <Button ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Refresh">
                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
            </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>
