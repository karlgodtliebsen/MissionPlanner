<utilities:NavigationViewBase x:TypeArguments="preferences:PreferencesViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                              xmlns:preferences="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.Preferences"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="MissionPlanner.AvaloniaUI.App.Views.Preferences.PreferencesPage">
    <ContentPage Header="Preferences">
        <TextBlock Text="Welcome to Preferences using Avalonia!"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </ContentPage>
</utilities:NavigationViewBase >
