<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MissionPlanner.AvaloniaUI.App.App"
             xmlns:local="using:AvaloniaApplication2"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:ui="clr-namespace:MissionPlanner.Avalonia.UI"
             xmlns:app="clr-namespace:MissionPlanner.AvaloniaUI.App"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="clr-namespace:MissionPlanner.AvaloniaUI.App.Converters;assembly=MissionPlanner.AvaloniaUI.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <app:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Geometries/Geometry.axaml" />
                <ResourceInclude Source="/Resources/Styles/VirtualizedItemsGrid.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BoolToObjectConverter x:Key="BoolToYesNoConverter" TrueObject="Yes" FalseObject="No" />
            <converters:IntegerDoubleConverter x:Key="IntegerDoubleConverter" />
            <converters:ByteDoubleConverter x:Key="ByteDoubleConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="us-US" />
        <semi:UrsaSemiTheme Locale="us-US" />
        <semi:SemiPopupAnimations />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="/Resources/Styles/SharedStyles.axaml" />
        <StyleInclude Source="/Resources/Styles/VirtualizedItemsGridStyles.axaml" />
    </Application.Styles>
</Application>