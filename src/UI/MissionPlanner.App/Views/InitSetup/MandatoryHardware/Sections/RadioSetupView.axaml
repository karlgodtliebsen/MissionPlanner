<utilities:UserControlViewBase x:TypeArguments="sections:RadioSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.RadioSetupView"
                               x:DataType="sections:RadioSetupViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch" RowSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <Border HorizontalAlignment="Stretch" Padding="12" >
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="Radio Calibration" Classes="H2" />
                        <TextBlock Text="Live receiver input and verified ArduPilot endpoint calibration" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CalibrationState}" Padding="12,6"
                               VerticalAlignment="Center" FontWeight="Bold" Background="{DynamicResource PrimaryContainer}" />
                </Grid>
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsWriting}" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Full Parameters" AutomationProperties.Name="Open Full Parameters">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <controls:SetupInformationView Topic="Radio" WorkflowError="{Binding ErrorMessage}" >
                        <controls:SetupInformationView.WorkflowStatus>
                            <MultiBinding StringFormat="{}{0}&#10;{1}&#10;{2}">
                                <Binding Path="StatusMessage" />
                                <Binding Path="Instruction" />
                                <Binding Path="SignalStatus" />
                            </MultiBinding>
                        </controls:SetupInformationView.WorkflowStatus>
                    </controls:SetupInformationView>  
                </Grid>
            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Full Parameters" AutomationProperties.Name="Open Full Parameters">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1"  Classes="SectionCard" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Text="!" FontSize="22" Classes="H4"  VerticalAlignment="Top" />
                            <StackPanel Orientation="Vertical" Grid.Column="1" Spacing="2">
                                <TextBlock Text="Calibration safety" Classes="H4"  />
                                <TextBlock Text="Remove propellers and keep the vehicle disarmed. Turn on the transmitter before calibrating." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Stretch"  HorizontalScrollBarVisibility="Disabled">
                        <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowSpacing="10">

                            <Border Grid.Row="0" Padding="12" Classes="SectionCard">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <TextBlock Text="Next step" Classes="H4"  />
                                    <TextBlock Text="{Binding Instruction}" Classes="H4" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CaptureSummary}"  Classes="H4" Opacity="0.75" />
                                    <WrapPanel LineSpacing="8" Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Left">
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Start calibration"
                                                Command="{Binding StartCommand}" AutomationProperties.Name="Start calibration">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="Play" Classes="ActionIcon" Width="20" Height="20" />
                                                <TextBlock Text="Start calibration" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Finish endpoint capture"
                                                Command="{Binding FinishCaptureCommand}"  AutomationProperties.Name="Finish endpoint capture">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Finish endpoint capture" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Confirm and write"
                                                Command="{Binding ConfirmAndWriteCommand}" AutomationProperties.Name="Confirm and write">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="UploadOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Confirm and write" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Reset / retry"
                                                Command="{Binding ResetCommand}"  AutomationProperties.Name="Reset / retry">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                                                <TextBlock Text="Reset / retry" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Cancel"
                                                Command="{Binding CancelCalibrationCommand}"  AutomationProperties.Name="Cancel">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Margin="10" Padding="10" HorizontalAlignment="Stretch" Classes="SectionCard"
                                    >
                                <StackPanel Orientation="Vertical" Spacing="10">
                                    <TextBlock Text="Receiver:" Classes="H4"  />
                                    <TextBlock Text="{Binding SignalStatus}" Classes="H4"  />
                                    <TextBlock Text="{Binding ChannelCount, StringFormat='{}{0} channels'}" Classes="H4"  />
                                    <TextBlock Text="{Binding RssiText}" Classes="H4" />
                                    <TextBlock Text="{Binding VehicleSafetyStatus}" Classes="H4"  />

                                    <TextBlock Text=" " Classes="H4" />
                                    <TextBlock Text="{Binding ChannelMapSummary, StringFormat='Pilot map: {0}'}" Classes="H4"/>

                                    <TextBlock Text=" " Classes="H4" />
                                    <TextBlock Text="Arming switch configuration:" Classes="H4" />
                                    <TextBlock Text="{Binding ArmingConfigurationSummary}" TextWrapping="Wrap" Classes="H4"/>

                                    <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Stretch">
                                        <TextBlock Text="RC channel for Arming" VerticalAlignment="Center" Classes="H4"/>
                                        <ComboBox ItemsSource="{Binding ArmingChannels}" Classes="H4"
                                                  SelectedItem="{Binding SelectedArmingChannel}"
                                                  HorizontalContentAlignment="Right" MinWidth="150"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ArmingSwitchDiagnostic}" TextWrapping="Wrap" Classes="H4"/>
                                    <TextBlock Text="{Binding BindAvailability}" TextWrapping="Wrap" Classes="H4"/>
                                    <TextBlock Text="{Binding BindState, StringFormat='Bind state: {0}'}" Classes="H4"/>
                                    <TextBlock Text="{Binding BindMessage}" TextWrapping="Wrap" Classes="H4"/>
                                    <TextBlock IsVisible="{Binding IsStale}"
                                               Text="RC telemetry is stale. The last values remain visible, but calibration cannot start or write until fresh input returns."
                                               Classes="H4"  />

                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="EmbeddedTextButton" Command="{Binding BindReceiverCommand}"
                                                ToolTip.Tip="Request receiver binding through the flight controller"
                                                AutomationProperties.Name="Bind receiver" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="LinkVariant" Classes="ActionIcon" />
                                                <TextBlock Text="Bind receiver" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Select RC channel for Arming"
                                                Command="{Binding AssignArmSwitchCommand}" AutomationProperties.Name="Assign Arm/Disarm" >
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="ShieldCheck" Classes="ActionIcon" />
                                                <TextBlock Text="Assign Arm/Disarm" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Padding="0" Classes="SectionCard">
                                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                    <ItemsControl IsVisible="{Binding HasIssues}" ItemsSource="{Binding Issues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding .}" Classes="H4" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Channels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sections:RadioChannelDisplayViewModel">
                                                <Border Margin="5,5"
                                                        Padding="5,5" Classes="SectionCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                >
                                                        <StackPanel Orientation="Horizontal"  Spacing="8">
                                                            <TextBlock Text="{Binding Number, StringFormat='CH {0}'}" Classes="H4"  />
                                                            <TextBlock Text="{Binding RoleLabel}" Classes="H4"  />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="REV" IsVisible="{Binding IsReversed}" Classes="H4"  />
                                                            <TextBlock Text="{Binding AuxiliaryState}" Opacity="0.7" Classes="H4"/>
                                                            <TextBlock Text="{Binding Pwm, StringFormat='{}{0} µs'}" Classes="H4" />
                                                        </StackPanel>

                                                        <sections:RadioChannelMeterView
                                                                                        ChannelNumber="{Binding Number}"
                                                                                        FunctionName="{Binding FunctionName}"
                                                                                        Pwm="{Binding Pwm}"
                                                                                        ConfiguredMinimum="{Binding Minimum}"
                                                                                        ConfiguredMaximum="{Binding Maximum}"
                                                                                        Trim="{Binding Trim}"
                                                                                        DeadZone="{Binding DeadZone}"
                                                                                        CapturedMinimum="{Binding CapturedMinimum}"
                                                                                        CapturedMaximum="{Binding CapturedMaximum}"
                                                                                        CandidateTrim="{Binding CandidateTrim}"
                                                                                        IsCapturing="{Binding ShowCapturedRange}"
                                                                                        IsStale="{Binding IsStale}"
                                                                                        HasSignal="{Binding HasSignal}"
                                                                                        PresentationKind="{Binding PresentationKind}"
                                                                                        IsReversed="{Binding IsReversed}" />
                                                        <TextBlock Text="{Binding Range, StringFormat='Stored MIN / TRIM / MAX {0}'}"  Opacity="0.72" Classes="H4"/>
                                                        <TextBlock Text="{Binding CalibrationIssue}" TextWrapping="Wrap" Classes="Danger H4" />
                                                        <TextBlock Text="{Binding ObservedValues}" TextWrapping="Wrap" Classes="H4"/>
                                                        <TextBlock Text="{Binding DeadZone, StringFormat='Configured dead-zone: {0} µs'}" Classes="H4"/>
                                                        <TextBlock Text="{Binding Classification}" TextWrapping="Wrap" Classes="H4"/>
                                                        <TextBlock Text="{Binding ValidationStatus}" TextWrapping="Wrap" Classes="H4"/>
                                                        <TextBlock Text="{Binding NeutralDiagnosticText}" Classes="H4"
                                                                   Classes.Warning="{Binding HasNeutralWarning}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</utilities:UserControlViewBase>
