<utilities:UserControlViewBase x:TypeArguments="sections:CameraGimbalViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.CameraGimbalView"
                               x:Name="Root" x:DataType="sections:CameraGimbalViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Grid.Row="0" HorizontalAlignment="Center" Padding="12" Classes="SourceBorder" x:Name="SourceBorder"  >
            <StackPanel Spacing="10">
                <TextBlock Text="Camera / Gimbal Configuration" Classes="H2" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <TextBlock Text="Changes are explicit and confirmed by parameter readback. Live movement and capture commands remain in Payload Control." Opacity="0.75" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                <Button Classes="IsToolbarButton" ToolTip.Tip="Open Payload Control" Command="{Binding OpenPayloadControlCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Open Payload Control">
                    <mdi:MaterialIcon Kind="OpenInNew" Classes="ActionIcon" />
                </Button>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" Margin="16,0" HorizontalAlignment="Center" >
            <Border Classes="SectionCard" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <TextBlock Text="Vehicle Reboot required after confirmed changes." IsVisible="{Binding RebootRequired}" Classes="Warning" FontWeight="Bold" />
                    <ItemsControl ItemsSource="{Binding Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sections:ParameterSettingViewModel">
                                <Grid ColumnDefinitions="250,150,90" ColumnSpacing="25">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding PendingValue}" Minimum="0" />
                                    <Button Classes="IsToolbarButton" Grid.Column="2" ToolTip.Tip="Apply" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply">
                                        <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</utilities:UserControlViewBase>
