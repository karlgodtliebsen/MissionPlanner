<utilities:UserControlViewBase x:TypeArguments="sections:CompassSetupViewModel"
                               xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:models="clr-namespace:MissionPlanner.Core.Setup.MandatoryHardware;assembly=MissionPlanner.Core"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa"
                               xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.CompassSetupView"
                               x:DataType="sections:CompassSetupViewModel">
    <Grid RowDefinitions="Auto,*"  HorizontalAlignment="Center" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        
        <Border Padding="12"  >
            <StackPanel Spacing="8">
                <TextBlock Text="Compass" Classes="H2" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Theme="{DynamicResource ProgressRing}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"  >
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border  Padding="12" >
                        <WrapPanel Orientation="Horizontal" ItemSpacing="5"  HorizontalAlignment="Center" >
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh values" AutomationProperties.Name="Refresh values" Command="{Binding RefreshInventoryCommand}">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8"  >
                            <controls:InformationDocumentView Document="{Binding StatusDocument}" />
                            <controls:InformationDocumentView Document="{Binding DiagnosticDocument}"  />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="12"  >
                        <WrapPanel Orientation="Horizontal" ItemSpacing="5"  HorizontalAlignment="Center" >
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh values" AutomationProperties.Name="Refresh values" 
                                    Command="{Binding RefreshInventoryCommand}">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>

                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Open Full Parameters" AutomationProperties.Name="Open Full Parameters"
                                    Command="{Binding OpenFullParametersCommand}">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <Border Classes="SectionCard" Padding="12" HorizontalAlignment="Stretch" >
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Calibration / Actions" Classes="H3" />
                                    <TextBlock Text="{Binding CalibrationState, StringFormat='Calibration: {0}'}" />
                                    <TextBlock Text="{Binding CalibrationAvailability}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding CanCancel}" />
                                    <TextBlock Text="{Binding ProgressSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QualitySummary}" TextWrapping="Wrap" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Start calibration" AutomationProperties.Name="Start calibration" Command="{Binding StartCalibrationCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="CompassOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Start Calibration" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Cancel calibration" AutomationProperties.Name="Cancel calibration" Command="{Binding CancelCalibrationCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Reset / retry" AutomationProperties.Name="Reset / retry" Command="{Binding ResetCommand}" IsEnabled="{Binding CanStart}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                                                <TextBlock Text="Retry" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Accept results" AutomationProperties.Name="Accept results" Command="{Binding AcceptCalibrationCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Accept Results" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="Changes applied. Reboot required." Classes="Warning" TextWrapping="Wrap"  IsVisible="{Binding RequiresReboot}" />
                                    <Button Classes="EmbeddedTextButton" ToolTip.Tip="Reboot vehicle" AutomationProperties.Name="Reboot vehicle"
                                            HorizontalAlignment="Left" IsVisible="{Binding RequiresReboot}" Command="{Binding RebootCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mdi:MaterialIcon Kind="Restart" Classes="ActionIcon" />
                                            <TextBlock Text="Reboot Vehicle" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Classes="SectionCard"  IsVisible="{Binding HasPendingChanges}" HorizontalAlignment="Stretch" >
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding PendingSummary}" Classes="H3" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding PendingChanges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding .}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Discard" AutomationProperties.Name="Discard" Command="{Binding DiscardCommand}" IsEnabled="{Binding !IsBusy}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="FileUndoOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Discard" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="EmbeddedTextButton" ToolTip.Tip="Apply" AutomationProperties.Name="Apply" Command="{Binding ApplyCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                                <TextBlock Text="Apply" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Padding="12" HorizontalAlignment="Stretch" Classes="SectionCard SourceBorder" >
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Configuration" Classes="H3" />
                                    <TextBlock Text="Edits remain pending until you review and apply them." TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Settings}" IsEnabled="{Binding CanEdit}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sections:CompassSettingViewModel">
                                                <Border Classes="SectionCard SourceBorder"  IsVisible="{Binding IsVisible}" 
                                                        Margin="10" Padding="12" 
                                                        HorizontalAlignment="Stretch" 
                                                       >
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                        <CheckBox IsVisible="{Binding IsToggle}" IsChecked="{Binding IsChecked}"
                                                                  HorizontalContentAlignment="Right"
                                                                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Label}" />

                                                        <ComboBox IsVisible="{Binding !IsToggle}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                                                                  IsEnabled="{Binding CanEdit}"
                                                                  HorizontalContentAlignment="Right"
                                                                  MinWidth="220" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Label}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:CompassChoice">
                                                                    <TextBlock Text="{Binding Label}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <TextBlock Text="{Binding UnavailableReason}" Opacity="0.75" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ChangeText}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ParameterText}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding DefaultText}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                            <Button Classes="EmbeddedIconButton" ToolTip.Tip="Reset to default" AutomationProperties.Name="Reset to default" Command="{Binding ResetDefaultCommand}"
                                                                    IsEnabled="{Binding CanReset}">
                                                                <mdi:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                                                            </Button>
                                                        </WrapPanel>

                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
