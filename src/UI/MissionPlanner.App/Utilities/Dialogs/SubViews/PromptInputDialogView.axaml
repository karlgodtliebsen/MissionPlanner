<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prompts="clr-namespace:MissionPlanner.App.Utilities.Dialogs.Prompts"
             xmlns:subViews="clr-namespace:MissionPlanner.App.Utilities.Dialogs.SubViews"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="550"
             x:DataType="subViews:PromptInputDialogViewModel"
             x:Class="MissionPlanner.App.Utilities.Dialogs.SubViews.PromptInputDialogView"
             HorizontalContentAlignment="Stretch"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Margin="50,50,50,25"
             >

    <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          RowSpacing="25">
        <Border Classes="SectionCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  >
            <StackPanel   HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25">
                <TextBlock Text="{Binding Title}" TextAlignment="Center" Classes="H1"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="H4"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBox Text="{Binding PromptText, Mode=TwoWay}"
                         HorizontalContentAlignment="Right"
                         HorizontalAlignment="Center"
                         Classes="H4" PlaceholderText="Enter your response here" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button
                Width="100"
                Classes="Primary"
                Padding="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding CancelCommand}"
                >
                <avalonia:MaterialIcon Kind="Close" Width="30" Height="30" />
            </Button>
            <Button
                Width="100"
                Classes="Primary"
                Padding="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding OKCommand}"
                >
                <avalonia:MaterialIcon Kind="Check" Width="30" Height="30" />
            </Button>
        </StackPanel>


    </Grid>


</UserControl>
