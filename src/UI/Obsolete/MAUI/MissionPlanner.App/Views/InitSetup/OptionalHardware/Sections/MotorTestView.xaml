<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:MotorTestViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                                  xmlns:motor="clr-namespace:MissionPlanner.Core.Setup.OptionalHardware.Motor;assembly=MissionPlanner.Core"
                                  xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                                  x:DataType="sections:MotorTestViewModel"
                                  x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.MotorTestView"
                                  x:Name="Root">


    <Border Padding="10" StyleClass="SurfaceContainer,Rounded,Elevation1">

        <ScrollView VerticalScrollBarVisibility="Always" >

            <VerticalStackLayout Padding="16" Spacing="10"  HorizontalOptions="Center" >


                <HorizontalStackLayout  Padding="0,4" Spacing="12" Margin="0,10,0,10">
                    <ActivityIndicator
                    IsRunning="{Binding IsBackgroundParameterLoadInProgress}"
                    IsVisible="{Binding IsBackgroundParameterLoadInProgress}"
                    WidthRequest="20"
                    HeightRequest="20" />

                    <Label Text="{Binding ProgressMessage}" IsVisible="{Binding IsBackgroundParameterLoadInProgress}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                    <uranium:SelectableLabel Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}"/>
                    <Label Text="{Binding StatusMessage}" IsVisible="{Binding IsBackgroundParameterLoadInProgress, Converter={StaticResource InvertedBoolConverter}}" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label  Text="Motor Test" FontSize="20" FontAttributes="Bold" />

                    <Label
                            Text="Remove ALL propellers. Motors will spin."
                            TextColor="{DynamicResource Warning}"
                            FontAttributes="Bold" />
                </VerticalStackLayout>

                <Label Text="{Binding FrameDisplay}" FontAttributes="Bold" />

                <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,Auto" ColumnSpacing="50" >
                    <Label Grid.Column="1" Text="{Binding SpinMessage}" FontAttributes="Bold" TextColor="{DynamicResource Warning}"/>
                    <Border Grid.Column="0" Grid.Row="1" Padding="10" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                      VerticalOptions="Fill" HorizontalOptions="Fill"
                                      RowSpacing="10">
                            <HorizontalStackLayout 
                                    Grid.Row="0"
                                    HorizontalOptions="Fill" 
                                    VerticalOptions="Fill" 
                                    Spacing="10" 
                                    Margin="0,20,0,20">

                                <controls:NumericUpDownField
                                    Title="Throttle Percent"
                                    Value="{Binding ThrottlePercent, Mode=TwoWay}"
                                    NumberFormat="F0"
                                    StepSize="5"
                                    Min ="5"
                                    Max="25"
                                    NumericType="UInt32"
                                    VerticalOptions="Center"
                                    MinimumWidthRequest="200"
                                    HorizontalOptions="Fill"
                                    ButtonOrientation="Vertical"
                                    HorizontalTextAlignment="End" />

                                <controls:NumericUpDownField
                                        Title="Duration (seconds)"
                                        Value="{Binding DurationSeconds, Mode=TwoWay}"
                                        NumberFormat="F0"
                                        StepSize="1"
                                        NumericType="UInt32"
                                        Min ="1"
                                        Max="10"
                                        VerticalOptions="Center"
                                        MinimumWidthRequest="200"
                                        HorizontalOptions="Fill"
                                        ButtonOrientation="Vertical"
                                        HorizontalTextAlignment="End" />

                            </HorizontalStackLayout>
                            <VerticalStackLayout
                                    Grid.Row="1"
                                    BindableLayout.ItemsSource="{Binding Motors}"
                                    Spacing="6">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="motor:MotorLayoutMotor">
                                        <Button
                                                HorizontalOptions="Center"
                                                WidthRequest="250"
                                                Text="{Binding Label}"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.TestMotorCommand}"
                                                CommandParameter="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="25" Margin="0,35,0,0" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Fill">
                                    <Button
                                        Text="Test all Motors" HorizontalOptions="Fill"
                                        Command="{Binding TestAllCommand}" />
                                    <Button
                                        Text="Test all in sequence" HorizontalOptions="Fill"
                                        Command="{Binding TestSequenceCommand}" />
                                </HorizontalStackLayout>
                                <Button
                                    Text="STOP All Motors" HorizontalOptions="Fill"
                                    TextColor="{DynamicResource Warning}"
                                    Command="{Binding StopCommand}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="1"  Padding="10" StyleClass="SurfaceContainer,Rounded,Elevation1" >
                        <VerticalStackLayout Spacing="10" VerticalOptions="Fill" HorizontalOptions="Fill">

                            <Label VerticalOptions="Fill" HorizontalOptions="Fill" Text="Set the minimum output at which motors reliably spin while armed:" Margin="0,10" FontSize="20" FontFamily="Bold" />

                            <Label Text="{Binding SpinArmDisplay}" FontAttributes="Bold" TextColor="{DynamicResource Warning}"/>
                            <Label Text="Calculation:" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <Label Text="[Motor test throttle]% + [x]% = [MOT_SPIN_ARM]%" VerticalOptions="Center" HorizontalOptions="Center" FontSize="16"/>

                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalOptions="Center" HorizontalOptions="Center">

                                <Label Grid.Column="0" Text="[" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ThrottlePercent}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="]% + " VerticalOptions="Center" />
                                <controls:NumericField
                                    Grid.Column="3" Title=""
                                    Value="{Binding SpinArm, Mode=TwoWay}"
                                    NumberFormat="F0"
                                    Min ="1"
                                    Max="{Binding SpinArmMaximum}"
                                    NumericType="Int32"
                                    VerticalOptions="Center"
                                    MinimumWidthRequest="20"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                                <Label Grid.Column="4" Text="% = " VerticalOptions="Center" />
                                <Label Grid.Column="5" Text="{Binding SpinArmSum}" VerticalOptions="Center" />
                                <Label Grid.Column="6" Text="%" VerticalOptions="Center" />

                            </Grid>
                            <Button  VerticalOptions="Fill" HorizontalOptions="Fill" 
                                     Text="Set Motor Spin Arm"
                                     Command="{Binding SetMotorSpinArmCommand}" />
   
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Separator}"  HorizontalOptions="Fill"/>

                            <Label Text="Set the minimum motor output while flying:" Margin="0,10" FontSize="20" FontFamily="Bold" />
                            <Label Text="{Binding SpinMinDisplay}" FontAttributes="Bold" TextColor="{DynamicResource Warning}"/>
                            <Label Text="Calculation:" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <Label Text="[MOT_SPIN_ARM]% + [x]% = [MOT_SPIN_MIN]%" VerticalOptions="Center" HorizontalOptions="Center" FontSize="16"/>

                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"  VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Grid.Column="0"  Text=" [" VerticalOptions="Center" />
                                <Label Grid.Column="1"  Text="{Binding SpinArmSum}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="2"  Text="]% +  " VerticalOptions="Center" />
                                <controls:NumericField
                                    Grid.Column="3" Title=""
                                    Value="{Binding SpinMin, Mode=TwoWay}"
                                    NumberFormat="F0"
                                    Min ="1"
                                    Max="{Binding SpinMinMaximum}"
                                    NumericType="Int32"
                                    VerticalOptions="Center"
                                    MinimumWidthRequest="20"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End" />
                                <Label Grid.Column="4"  Text="% = " VerticalOptions="Center" />
                                <Label Grid.Column="5"  Text="{Binding SpinMinSum}" VerticalOptions="Center" />
                                <Label Grid.Column="6"  Text="%" VerticalOptions="Center" />

                            </Grid>

                            <Button VerticalOptions="Center"
                                    Grid.Row="7"
                                    HorizontalOptions="Fill"
                                    Text="Set Motor Spin Min"
                                    Command="{Binding SetMotorSpinMinCommand}" />

                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Border>
</tabViews:TabViewLifecycleContent>
