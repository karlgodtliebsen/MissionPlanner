<utilities:UserControlViewBase x:TypeArguments="sections:AirspeedViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.AirspeedView"
                               x:DataType="sections:AirspeedViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" HorizontalAlignment="Stretch" Padding="12"  >
            <StackPanel Spacing="10">
                <TextBlock Text="Airspeed" Classes="H2" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="Vehicle Reboot required" Classes="Warning" IsVisible="{Binding RebootRequired}" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">

                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Parameters Editor" AutomationProperties.Name="Open Parameters Editor">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <controls:SetupInformationView Grid.Row="1" Topic="Airspeed" WorkflowStatus="{Binding StatusMessage}" WorkflowError="{Binding ErrorMessage}" />
                </Grid>

            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Parameters Editor" AutomationProperties.Name="Open Parameters Editor">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"
                                  Margin="16,0" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="12">
                            <StackPanel Spacing="10">

                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sections:ParameterSettingViewModel">
                                            <Grid ColumnDefinitions="220,*,90">
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding PendingValue, Mode=TwoWay}" FormatString="F1" HorizontalAlignment="Stretch" />
                                                <Button Classes="ToolbarIconButton" Grid.Column="2" ToolTip.Tip="Apply" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply">
                                                    <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</utilities:UserControlViewBase>
