<utilities:NavigationViewBase
    x:TypeArguments="advanced:AdvancedViewModel" xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:advanced="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.AdvancedPage"
    Header="Advanced"
    Background="{DynamicResource Surface}">
    <TextBlock Text="Advanced setup"
               FontSize="26"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
</utilities:NavigationViewBase>
