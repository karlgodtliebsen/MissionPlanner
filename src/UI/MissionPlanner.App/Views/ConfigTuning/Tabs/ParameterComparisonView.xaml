<?xml version="1.0" encoding="utf-8" ?>
<m:UraniumContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
    xmlns:virtualized="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
    xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.ParameterComparisonView"
    x:DataType="tabs:ParameterComparisonViewModel"
    >
    <Grid
       
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        RowDefinitions="Auto,*"
        RowSpacing="10"
        Padding="12">

        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Select all safe differences" Command="{Binding SelectAllSafeDifferencesCommand}" />
            <Button Grid.Column="1" Text="Stage selected" Command="{Binding StageSelectedDifferencesCommand}" />
            <Button Grid.Column="2" Text="Export JSON" Command="{Binding ExportJsonCommand}" />
            <Button Grid.Column="3" Text="Export CSV" Command="{Binding ExportCsvCommand}" />
            <Picker
                Grid.Column="4"
                WidthRequest="140"
                ItemsSource="{Binding Filters}"
                SelectedItem="{Binding Filter}" />
            <Button HorizontalOptions="End"
                Grid.Column="5" Text="Close" WidthRequest="100" Command="{Binding CloseCommand}">
              
            </Button>
        </Grid>

        <virtualized:VirtualizedDataGrid
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            SelectedItems="{Binding SelectedItems}" 
            UseAutoColumns="False"
            ItemSizingStrategy="MeasureFirstItem"
            ShowRowSeparators="True"
            ShowSearchBar="True"
            FilterMemberPaths="Name,DisplayName,Status,Message">

            <virtualized:VirtualizedDataGrid.EmptyView>
                <VerticalStackLayout
                    Padding="40"
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Image
                        WidthRequest="40"
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static m:MaterialOutlined.Backup_table}, 
                                    Color={AppThemeBinding Light={StaticResource OnSurface}, 
                                    Dark={StaticResource OnSurfaceDark}}}"/>
                    <Label
                        Text="No parameters found."
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </virtualized:VirtualizedDataGrid.EmptyView>

            <virtualized:VirtualizedDataGrid.Columns>
                <virtualized:ExtendedSelectableDataGridColumn Title="Stage"
                    SelectionMemberPath="IsSelected"
                    SelectionCommandMemberPath="SelectionChangedCommand"
                    SelectionChanged="ExtendedSelectableDataGridColumn_OnSelectionChanged"/>
                <material:DataGridColumn Width="2*" Title="Parameter">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:ParameterComparisonItemViewModel">
                            <Label Text="{Binding Name}" VerticalOptions="Center" HorizontalOptions="Start" />
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>

                <material:DataGridColumn Width="2*" Title="Live">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:ParameterComparisonItemViewModel">
                            <Label Text="{Binding LeftValueText}" VerticalOptions="Center" HorizontalOptions="End"/>
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
                <material:DataGridColumn Width="2*" Title="Right">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:ParameterComparisonItemViewModel">
                            <Label Text="{Binding RightValueText}" VerticalOptions="Center"  HorizontalOptions="End"/>
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
                <material:DataGridColumn Width="2*" Title="Difference">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:ParameterComparisonItemViewModel">
                            <Label Text="{Binding DifferenceText}" VerticalOptions="Center"  HorizontalOptions="End"/>
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
                <material:DataGridColumn Width="2*" Title="Status">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:ParameterComparisonItemViewModel">
                            <Label Text="{Binding Status}" VerticalOptions="Center"  HorizontalOptions="Center" />
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
                <material:DataGridColumn Width="4*" Title="Message">
                    <material:DataGridColumn.CellItemTemplate>
                        <DataTemplate x:DataType="tabs:ParameterComparisonItemViewModel">
                            <Label Text="{Binding Message}" VerticalOptions="Center" />
                        </DataTemplate>
                    </material:DataGridColumn.CellItemTemplate>
                </material:DataGridColumn>
            </virtualized:VirtualizedDataGrid.Columns>
        </virtualized:VirtualizedDataGrid>
    </Grid>
</m:UraniumContentPage>
