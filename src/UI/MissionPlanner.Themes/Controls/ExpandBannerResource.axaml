<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal" Margin="20">
            <Button Theme="{DynamicResource ExpandButton}" />
            <Button Theme="{DynamicResource OverlayExpandButton}" />
            <Button Theme="{DynamicResource ShrinkButton}" />
            <Button Theme="{DynamicResource OverlayShrinkButton}" />
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme
        x:Key="OverlayExpandButton"
        BasedOn="{StaticResource CaptionButton}"
        TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Content" Value="{StaticResource SemiIconTriangleArrowVertical}" />
        <Setter Property="ToolTip.Tip" Value="Expand editor to full width" />
        <Setter Property="AutomationProperties.Name" Value="Expand editor to full width" />
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <PathIcon Data="{StaticResource SemiIconTriangleArrowVertical}"
                          Width="16" Height="16"
                          RenderTransformOrigin="50%,50%"
                          RenderTransform="rotate(180deg)" />
            </DataTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme
        x:Key="ExpandButton"
        BasedOn="{StaticResource OverlayExpandButton}"
        TargetType="Button">
        
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
            <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePointeroverBackground}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
            <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePressedBackground}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="OverlayShrinkButton"
        BasedOn="{StaticResource CaptionButton}"
        TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Content" Value="{StaticResource SemiIconTriangleArrowVertical}" />
        <Setter Property="ToolTip.Tip" Value="Restore compact editor width" />
        <Setter Property="AutomationProperties.Name" Value="Restore compact editor width" />
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <PathIcon Data="{StaticResource SemiIconTriangleArrowVertical}"
                          Width="16" Height="16"
                          RenderTransformOrigin="50%,50%"
                          RenderTransform="rotate(0deg)" />
            </DataTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme
        x:Key="ShrinkButton"
        BasedOn="{StaticResource OverlayShrinkButton}"
        TargetType="Button">
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
            <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePointeroverBackground}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
            <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePressedBackground}" />
        </Style>
    </ControlTheme>


</ResourceDictionary>