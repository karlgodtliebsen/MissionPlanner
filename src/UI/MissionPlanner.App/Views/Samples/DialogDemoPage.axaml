<utilities:NavigationViewBase x:TypeArguments="samples:DialogDemoViewModel" xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              xmlns:dialogTest="clr-namespace:MissionPlanner.App.Views.DialogTest"
                              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              xmlns:simulation="clr-namespace:MissionPlanner.App.Views.DialogTest"
                              xmlns:samples="clr-namespace:MissionPlanner.App.Views.Samples"
                              mc:Ignorable="d"
                              d:DesignWidth="800"
                              d:DesignHeight="450"
                              x:Class="MissionPlanner.App.Views.Samples.DialogDemoPage"
                              x:DataType="samples:DialogDemoViewModel"
                              >
    <ContentPage Header="Welcome">
        <Border Classes="SectionCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Padding="50">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Test Dialog Services!"
                           Classes="Title"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">

                </TextBlock>

                <Border Classes="SectionCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Padding="20">
                    <StackPanel Orientation="Vertical"
                                MinWidth="200"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                >
                        <TextBlock Text="Result:"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top" />

                        <TextBlock Margin="10"
                                   MinWidth="200"
                                   MinHeight="100"
                                   Background="Silver"
                                   Foreground="DarkRed"
                                   FontSize="20"
                                   Text="{Binding StatusMessage}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                </Border>
                                
                <Border Classes="SectionCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Padding="20">
                    <StackPanel Orientation="Vertical"
                                MinWidth="200"
                                Spacing="10"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                >
                        <Button
                                    Width="200" ToolTip.Tip="Connect"
                                    Classes="Secondary"
                                    Padding="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding ShowConnectCommand}" AutomationProperties.Name="Connect">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="PowerPlug" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="Connect" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="200" ToolTip.Tip="Error"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowErrorCommand}" AutomationProperties.Name="Error">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="AlertCircleOutline" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="Error" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="200" ToolTip.Tip="Confirm"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowConfirmCommand}" AutomationProperties.Name="Confirm">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="Confirm" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="200" ToolTip.Tip="ShowConfirm1"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowConfirm1Command}" AutomationProperties.Name="ShowConfirm1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowConfirm1" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>


                        <Button
                            Width="200" ToolTip.Tip="ShowStringPrompt"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowStringPromptCommand}" AutomationProperties.Name="ShowStringPrompt">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="FormTextbox" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowStringPrompt" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="200" ToolTip.Tip="ShowStringPrompt2"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowStringPrompt2Command}" AutomationProperties.Name="ShowStringPrompt2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="FormTextbox" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowStringPrompt2" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>


                        <Button
                            Width="200" ToolTip.Tip="ShowIntPrompt"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowIntPromptCommand}" AutomationProperties.Name="ShowIntPrompt">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="Numeric" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowIntPrompt" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="200" ToolTip.Tip="ShowIntPrompt2"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowIntPrompt2Command}" AutomationProperties.Name="ShowIntPrompt2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="Numeric" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowIntPrompt2" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="200" ToolTip.Tip="ShowDoublePrompt"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowDoublePromptCommand}" AutomationProperties.Name="ShowDoublePrompt">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="Numeric" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowDoublePrompt" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="200" ToolTip.Tip="ShowDoublePrompt2"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowDoublePrompt2Command}" AutomationProperties.Name="ShowDoublePrompt2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="Numeric" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowDoublePrompt2" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="200" ToolTip.Tip="ShowChoosePrompt"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowChoosePromptCommand}" AutomationProperties.Name="ShowChoosePrompt">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowChoosePrompt" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="200" ToolTip.Tip="ShowPhrasePrompt"
                            Classes="Secondary"
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ShowPhrasePromptCommand}" AutomationProperties.Name="ShowPhrasePrompt">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="TextBoxOutline" Classes="ActionIcon" Width="20" Height="20" />
                                <TextBlock Text="ShowPhrasePrompt" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </ContentPage>
</utilities:NavigationViewBase>
