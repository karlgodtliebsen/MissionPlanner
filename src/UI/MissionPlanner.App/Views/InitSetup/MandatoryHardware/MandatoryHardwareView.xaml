<?xml version="1.0" encoding="utf-8" ?>
<navigation:ContentPageView x:TypeArguments="mandatoryHardware:MandatoryHardwareViewModel"
                            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                            xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                            xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                            xmlns:mandatoryHardware="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware"
                            xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                            xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                            xmlns:tabsUtils="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.TabsUtils"
                            x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.MandatoryHardwareView"
                            x:DataType="mandatoryHardware:MandatoryHardwareViewModel"
                            Title="Initial Setup">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="Initial Setup" FontSize="26" FontAttributes="Bold" />
            <Label Text="{Binding VehicleHeading}" FontSize="16" />
            <Label Text="{Binding SummaryReport}" Opacity="0.75" />
            <Label Text="{Binding Error}" TextColor="Red" />
        </VerticalStackLayout>

        <Button Grid.Row="1" Text="Re-evaluate vehicle" Command="{Binding RefreshCommand}" HorizontalOptions="Start" />
                                  <!--HeaderItemsSource="{Binding Workflows}"
                                  SelectedHeaderItem="{Binding SelectedWorkflow, Mode=TwoWay}"-->

        <tabViews:ExtendedTabView Grid.Row="2"
                                  HeaderItemsSource="{Binding Workflows}"
                                  TabHeaderItemColumnWidth="290"
                                  CachingStrategy="CacheOnLayout"
                                  UseAnimation="False">
            <material:TabView.TabHeaderItemTemplate>
                <DataTemplate>
                    <tabsUtils:TabHeaderView />
                </DataTemplate>
            </material:TabView.TabHeaderItemTemplate>

