<utilities:UserControlViewBase x:TypeArguments="local:FirmwareLandingViewModel" xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
                               xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               x:DataType="local:FirmwareLandingViewModel"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.STM32DfuDeviceView"
                               Margin="25,0,25,0"
                               >

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,16">
            <TextBlock Text="Controller status" Classes="H3" />
            <TextBlock Text="Review the connection and detected devicesModel before choosing a firmware workflow." Classes="Warning" TextWrapping="Wrap" />
            <Border Padding="20" Classes="SectionCard">
                <StackPanel Spacing="10">
                    <TextBlock Text="Vehicle connection" Classes="H4" FontWeight="Bold" />
                    <TextBlock Text="{Binding ConnectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="20" Classes="SectionCard">
                <StackPanel Spacing="10">
                    <TextBlock Text="Serial devices" Classes="H4" FontWeight="Bold" />
                    <TextBlock Text="{Binding SerialSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SerialDetail}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SourceIdentitySummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="20" Classes="SectionCard">
                <StackPanel Spacing="10">
                    <TextBlock Text="STM32 DFU devices" Classes="H4" FontWeight="Bold" />
                    <TextBlock Text="{Binding DfuSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DfuDetail}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Dfu.DfuDevices}" SelectedItem="{Binding Dfu.SelectedDfuDevice}"
                              MinWidth="250" HorizontalAlignment="Left" PlaceholderText="Select STM32 ROM DFU endpoint"
                              IsEnabled="{Binding !Dfu.InstallationRunning}" />
                    <TextBlock Text="{Binding DfuIdentitySummary}" TextWrapping="Wrap" Classes="Warning" />
                    <TextBlock Text="{Binding Dfu.ToolReadiness}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DfuRebootGuidance}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                               Classes="Danger" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="25">
                        <ComboBox ItemsSource="{Binding Devices.DetectedDevices}"
                                  SelectedItem="{Binding Devices.SelectedDevice}"
                                  MinWidth="250" HorizontalAlignment="Left"
                                  IsEnabled="{Binding !Devices.InstallationRunning}"
                                  PlaceholderText="Select controller to reboot" />
<!--                        <Button ToolTip.Tip="Reboot to DFU" Command="{Binding RebootToDfuCommand}"  HorizontalAlignment="Left">
                            <avalonia:MaterialIcon Kind="Bootstrap" Width="30" Height="30" />
                        </Button>-->
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Padding="20" Classes="SectionCard">
                <StackPanel Spacing="10">
                    <TextBlock Text="What to do next" Classes="H4" FontWeight="Bold" />
                    <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>

