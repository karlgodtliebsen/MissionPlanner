        <Setter Property="BackgroundColor" Value="Red" />
    </Style>

    <Style BaseResourceKey="UraniumUI.Styles.View.SurfaceContainer" TargetType="View" Class="SurfaceContainer" ApplyToDerivedTypes="True" CanCascade="True" />
    <Style BaseResourceKey="UraniumUI.Styles.View.SurfaceContainer" TargetType="View" Class="Rounded" ApplyToDerivedTypes="True" CanCascade="True" />-->

 

</ResourceDictionary>
