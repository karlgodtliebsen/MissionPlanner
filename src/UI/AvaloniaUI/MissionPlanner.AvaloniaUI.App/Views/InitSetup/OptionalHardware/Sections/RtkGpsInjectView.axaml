<utilities:UserControlViewBase x:TypeArguments="sections:RtkGpsInjectViewModel" xmlns="https://github.com/avaloniaui" xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections" xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions" xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material" xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui" x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections.RtkGpsInjectView" x:DataType="sections:RtkGpsInjectViewModel">
<ScrollViewer>
<StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
<TextBlock Text="RTK / GPS Correction Injection" FontSize="20" FontWeight="Bold" />
<TextBlock Text="RTCM3 source → active vehicle via MAVLink GPS_RTCM_DATA" Opacity="0.75" />
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
<TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
<TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
<ComboBox ToolTip.Tip="Source" ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" />
<TextBox Watermark="Serial port or caster host" Text="{Binding Endpoint}" />
<NumericUpDown Watermark="Baud or caster port" Value="{Binding PortOrBaud}" Minimum="0" FormatString="F0" />
<TextBox Watermark="NTRIP mount point" Text="{Binding MountPoint}" />
<TextBox Watermark="NTRIP username" Text="{Binding Username}" />
<TextBox Watermark="NTRIP password" Text="{Binding Password}" PasswordChar="●" />
<StackPanel Orientation="Horizontal">
<CheckBox IsChecked="{Binding UseTls}" Content="Use TLS" />
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="8">
<Button Content="Refresh serial devices" Command="{Binding RefreshPortsCommand}" />
<Button Content="Connect source" Command="{Binding ConnectCommand}" />
<Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
</StackPanel>
<TextBlock Text="{Binding SourceStatus}" FontWeight="Bold" />
<TextBlock Text="{Binding TargetStatus}" />
<TextBlock Text="{Binding Statistics}" />
</StackPanel>
</ScrollViewer>
</utilities:UserControlViewBase>