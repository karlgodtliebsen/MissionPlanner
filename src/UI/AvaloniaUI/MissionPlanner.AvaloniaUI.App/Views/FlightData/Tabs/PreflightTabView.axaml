<tabs:TabItemViewBase x:TypeArguments="tabs:PreflightTabViewModel" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs" x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.PreflightTabItemView" x:DataType="tabs:PreflightTabViewModel"><Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8"><TextBlock Text="{Binding OverallStatus}" FontSize="18" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="{Binding Disclaimer}" TextWrapping="Wrap"/><ListBox Grid.Row="2" ItemsSource="{Binding Checks}"/><StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Run pre-arm" Command="{Binding RunPrearmCommand}" IsEnabled="{Binding CanRunPrearm}"/><TextBlock Text="{Binding CommandResult}"/></StackPanel></Grid></tabs:TabItemViewBase>
