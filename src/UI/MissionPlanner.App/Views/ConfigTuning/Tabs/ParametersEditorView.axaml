<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
             x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.ParametersEditorView"
             x:DataType="tabs:ParametersEditorViewModel"
             Margin="50"
             >
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="10"
        Margin="12">

        <TextBlock Grid.Row="0"
                   Classes="H2" Text="Add a List of Parameters and Values"
                   HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button HorizontalAlignment="Right"
                    Content="Add Parameters" Width="200" Command="{Binding UseCommand}">
            </Button>
            <Button HorizontalAlignment="Right"
                    Content="Clear" Width="150" Command="{Binding ClearCommand}">
            </Button>
            <Button HorizontalAlignment="Right"
                    Content="Cancel" Width="100" Command="{Binding CancelCommand}">
            </Button>
        </StackPanel>


        <Border Grid.Row="2" Margin="25" HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Classes="SectionCard">

            <Grid
                RowDefinitions="Auto,Auto,*"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowSpacing="20" Margin="30">

                <TextBlock Grid.Row="0"
                           Classes="H4"
                           TextWrapping="Wrap"
                           Text="Add a List of Parameters and Values in the Editor below"
                           HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <TextBlock  Grid.Row="1" Classes="H5" Text="Format: (name=value) or (name=value//comment)"
                            HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

                <TextBox AcceptsReturn="True"  Grid.Row="2"
                         Background="WhiteSmoke"
                         VerticalContentAlignment="Top"
                         Text="{Binding Text}" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         Margin="10"></TextBox>

            </Grid>
        </Border>
    </Grid>
</UserControl>
