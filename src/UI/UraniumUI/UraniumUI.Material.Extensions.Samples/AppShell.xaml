<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UraniumUI.Material.Extensions.Samples.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UraniumUI.Material.Extensions.Samples"
    xmlns:controls="clr-namespace:Plainer.Maui.Controls;assembly=Plainer.Maui"
    xmlns:appViewModels="clr-namespace:UraniumUI.Material.Extensions.Samples.AppViewModels"
    xmlns:controls1="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:dataGrids="clr-namespace:UraniumUI.Material.Extensions.Samples.DataGrids"
    xmlns:dialogSamples="using:UraniumUI.Material.Extensions.Samples.DialogSamples"
    xmlns:controlsSamples="using:UraniumUI.Material.Extensions.Samples.ControlsSamples"
    xmlns:arduPilotSample="clr-namespace:UraniumUI.Material.Extensions.Samples.DataGrids.ArduPilotSample"
    xmlns:virtualizedDataGridSample="clr-namespace:UraniumUI.Material.Extensions.Samples.DataGridSamples.VirtualizedDataGridSample"
    xmlns:paginationSamples="using:UraniumUI.Material.Extensions.Samples.DataGridSamples.PaginationSamples"
    xmlns:selectable="using:UraniumUI.Material.Extensions.Samples.DataGridSamples.Selectable"
    x:Name="thisShell"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
    Shell.FlyoutBehavior="Flyout"
    FlyoutIsPresented="True"
    >

    <Shell.Resources>
        <Style TargetType="HorizontalStackLayout" ApplyToDerivedTypes="True" CanCascade="True">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                     Value="{AppThemeBinding Light=#30000000, Dark=#30ffffff}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </Shell.Resources>


    <Shell.FlyoutHeader>
        <VerticalStackLayout StyleClass="PrimaryContainer" Padding="20">
            <Label Text="UraniumUI Control Extension" FontSize="Large" HorizontalTextAlignment="Center" Margin="10" />

            <VerticalStackLayout BindingContext="{uranium:Inject Type={Type appViewModels:ThemeChangeViewModel}}" x:DataType="appViewModels:ThemeChangeViewModel">
                <Label Text="App Theme" HorizontalOptions="Center"/>
                <controls1:SelectionView HorizontalOptions="Center"
                 ItemsSource="{Binding AppThemeList}" SelectedItem="{Binding SelectedTheme}" 
                 ColumnNumber="2" ColumnSpacing="-2" Color="{StaticResource Tertiary}" >
                </controls1:SelectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutContent>
        <Grid RowDefinitions="Auto,*">
            <Grid.BindingContext>
                <appViewModels:AppShellContentViewModel CurrentShell="{x:Reference thisShell}"/>
            </Grid.BindingContext>
            <VerticalStackLayout>
                <VerticalStackLayout Margin="8,8,8,0" BackgroundColor="{AppThemeBinding Light={StaticResource OnSurfaceDark}, 
                    Dark={StaticResource OnSurface}}" StyleClass="Elevation1">
                    <controls:EntryView Margin="{OnPlatform Default=0, Android='8,0', iOS='8', MacCatalyst='8'}" Placeholder="Search" Text="{Binding SearchText}" PlaceholderColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" ClearButtonVisibility="WhileEditing"/>
                </VerticalStackLayout>
                <BoxView StyleClass="Divider" />
            </VerticalStackLayout>
            <CollectionView Grid.Row="1" SelectedItem="{Binding SelectedItem}" SelectionMode="Single" ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Padding="20,12" Spacing="12">
                            <Image Source="{Binding Icon}" WidthRequest="20" />
                            <Label Text="{Binding Title}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Shell.FlyoutContent>
    <FlyoutItem Title="Extended Controls" >
        <ShellContent Title="Extended Controls" ContentTemplate="{DataTemplate controlsSamples:ControlsView}" Route="Controls" />
    </FlyoutItem>
    <FlyoutItem Title="Extended Dialogs" >
        <ShellContent Title="Extended Dialogs" ContentTemplate="{DataTemplate dialogSamples:DialogSampleView}" Route="Dialogs" />
    </FlyoutItem>
    <FlyoutItem Title="Compare Data Grids" >
        <ShellContent Title="Compare Data Grids" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    </FlyoutItem>
    <FlyoutItem Title="Simple Data Grid" >
        <ShellContent Title="Simple Data Grid with AutoColumns" ContentTemplate="{DataTemplate dataGrids:SimpleDataGridPage}" Route="SimpleDataGridPage" />
    </FlyoutItem>
    <FlyoutItem Title="Data Grid with Search" >
        <ShellContent Title="Data Grid with Search" ContentTemplate="{DataTemplate dataGrids:SearchDataGridPage}" Route="SearchDataGridPage" />
    </FlyoutItem>
    <FlyoutItem Title="Data Grid with Custom Title" >
        <ShellContent Title="Data Grid with Custom Title" ContentTemplate="{DataTemplate dataGrids:SimpleCustomTitleDataGridPage}" Route="SimpleCustomTitleDataGridPage" />
    </FlyoutItem>
    <FlyoutItem Title="Custom Data Grid" >
        <ShellContent Title="Custom Data Grid" ContentTemplate="{DataTemplate dataGrids:CustomDataGridPage}" Route="CustomDataGridPage" />
    </FlyoutItem>
    <FlyoutItem Title="Editor Data Grid" >
        <ShellContent Title="Editor Data Grid" ContentTemplate="{DataTemplate dataGrids:EditorDataGridPage}" Route="EditorDataGridPage" />
    </FlyoutItem>
    <FlyoutItem Title="Pagination Data Grid" >
        <ShellContent Title="Pagination Data Grid 1" ContentTemplate="{DataTemplate paginationSamples:PaginationSamplePage}" Route="PaginationSamplePage1" />
        <ShellContent Title="Pagination Data Grid 2" ContentTemplate="{DataTemplate paginationSamples:PaginationSampleExtended1Page}" Route="PaginationSamplePage2" />
        <ShellContent Title="Pagination Data Grid 3" ContentTemplate="{DataTemplate paginationSamples:PaginationSampleExtended2Page}" Route="PaginationSamplePage3" />
    </FlyoutItem>
    <FlyoutItem Title="Selectable Data Grid" >
        <ShellContent Title="Selectable Data Grid 1" ContentTemplate="{DataTemplate selectable:SelectableDataGridPage1}" Route="SelectableDataGridPage1" />
        <ShellContent Title="Selectable Data Grid 2" ContentTemplate="{DataTemplate selectable:SelectableDataGridPage2}" Route="SelectableDataGridPage2" />
    </FlyoutItem>
    <FlyoutItem Title="Extended Data Grid Samples" >
        <ShellContent Title="Sample 1" ContentTemplate="{DataTemplate virtualizedDataGridSample:VirtualizedDataGridSampleView1}" Route="VirtualizedDataGridView1" />
        <ShellContent Title="Sample 2" ContentTemplate="{DataTemplate virtualizedDataGridSample:VirtualizedDataGridSampleView2}" Route="VirtualizedDataGridView2" />
        <ShellContent Title="Sample 3" ContentTemplate="{DataTemplate virtualizedDataGridSample:VirtualizedDataGridSampleView3}" Route="VirtualizedDataGridView3" />
        <ShellContent Title="Sample 4" ContentTemplate="{DataTemplate virtualizedDataGridSample:VirtualizedDataGridSampleView4}" Route="VirtualizedDataGridView4" />
    </FlyoutItem>
    <FlyoutItem Title="Data Grid with Complex Data" >
        <ShellContent Title="Data Grid with Complex Data" ContentTemplate="{DataTemplate arduPilotSample:VirtualizedDataGridView}" Route="VirtualizedDataGridView" />
    </FlyoutItem>

</Shell>
