<utilities:TabItemViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
    xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:logs="clr-namespace:MissionPlanner.Library.Logging;assembly=MissionPlanner.Library"
    xmlns:replay="clr-namespace:MissionPlanner.Core.Replay;assembly=MissionPlanner.Core"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:TypeArguments="tabs:TelemetryLogsTabViewModel"
    x:Class="MissionPlanner.App.Views.FlightData.Tabs.TelemetryLogsTabItemView"
    x:DataType="tabs:TelemetryLogsTabViewModel"
    x:CompileBindings="True">
    <Grid RowDefinitions="Auto,Auto,140,Auto,Auto,Auto,*,Auto" RowSpacing="8" Margin="8">
        <StackPanel>
            <TextBlock Text="{Binding RecordingState, StringFormat='PC telemetry: {0}'}" FontWeight="Bold" />
            <TextBlock Text="{Binding RecordingPath}" />
            <TextBlock Text="{Binding RecordingError}" Classes="Warning" />
            <TextBlock Text="{Binding OnboardLoggingState, StringFormat='Onboard DataFlash: {0}'}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" ItemSpacing="8">
            <Button Command="{Binding RefreshLogsCommand}" ToolTip.Tip="Refresh recordings" AutomationProperties.Name="Refresh recordings" ><mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" /></Button>
            <Button Command="{Binding OpenStoredCommand}" ToolTip.Tip="View packets" AutomationProperties.Name="View packets" ><mdi:MaterialIcon Kind="FileDocumentOutline" Classes="ActionIcon" /></Button>
            <Button Command="{Binding ReplayStoredCommand}" ToolTip.Tip="Load selected recording for replay" AutomationProperties.Name="Load selected recording for replay" ><mdi:MaterialIcon Kind="Play" Classes="ActionIcon" /></Button>
            <Button Command="{Binding LoadCommand}" ToolTip.Tip="Import .tlog" AutomationProperties.Name="Import .tlog" ><mdi:MaterialIcon Kind="FileImportOutline" Classes="ActionIcon" /></Button>
            <Button Command="{Binding ExportLogCommand}" ToolTip.Tip="Export selected recording" AutomationProperties.Name="Export selected recording" ><mdi:MaterialIcon Kind="FileExportOutline" Classes="ActionIcon" /></Button>
            <Button Command="{Binding DeleteLogCommand}" ToolTip.Tip="Delete selected recording" AutomationProperties.Name="Delete selected recording" ><mdi:MaterialIcon Kind="DeleteOutline" Classes="ActionIcon" /></Button>
            <Button Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="Open telemetry folder" AutomationProperties.Name="Open telemetry folder" IsVisible="{Binding CanOpenLogFolder}"><mdi:MaterialIcon Kind="FolderOpenOutline" Classes="ActionIcon" /></Button>
            <Button Command="{Binding ClearPacketSelectionCommand}" ToolTip.Tip="Clear selection" AutomationProperties.Name="Clear selection" ><mdi:MaterialIcon Kind="Close" Classes="ActionIcon" /></Button>
            <Button Command="{Binding CancelLogOperationCommand}" ToolTip.Tip="Cancel loading" AutomationProperties.Name="Cancel loading" IsVisible="{Binding IsBusy}"><mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon" /></Button>
        </WrapPanel>
        <controls:VirtualizedItemsGrid Grid.Row="2" ItemsSource="{Binding Logs}"
            SelectedItem="{Binding SelectedLog, Mode=OneWayToSource}" SelectionMode="Single"
            ColumnWidths="*,180,100,100,140,140" ShowSearchBar="False" ShowPagination="False">
            <controls:VirtualizedItemsGrid.HeaderTemplate>
                <DataTemplate>
                    <controls:VirtualizedItemsGridRow>
                        <TextBlock Grid.Column="0" Text="Recording" />
                        <TextBlock Grid.Column="1" Text="Created (UTC)" />
                        <TextBlock Grid.Column="2" Text="Bytes" />
                        <TextBlock Grid.Column="3" Text="Duration" />
                        <TextBlock Grid.Column="4" Text="Vehicle" />
                        <TextBlock Grid.Column="5" Text="Firmware" />
                    </controls:VirtualizedItemsGridRow>
                </DataTemplate>
            </controls:VirtualizedItemsGrid.HeaderTemplate>
            <controls:VirtualizedItemsGrid.RowTemplate>
                <DataTemplate x:DataType="replay:TelemetryStoredLog">
                    <controls:VirtualizedItemsGridRow>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding Created, StringFormat='{}{0:u}'}" />
                        <TextBlock Grid.Column="2" Text="{Binding Size}" />
                        <TextBlock Grid.Column="3" Text="{Binding Duration}" />
                        <TextBlock Grid.Column="4" Text="{Binding Vehicle}" />
                        <TextBlock Grid.Column="5" Text="{Binding Firmware}" />
                    </controls:VirtualizedItemsGridRow>
                </DataTemplate>
            </controls:VirtualizedItemsGrid.RowTemplate>
        </controls:VirtualizedItemsGrid>
        <WrapPanel Grid.Row="3" ItemSpacing="8">
            <TextBox Width="180" PlaceholderText="Search text / hex" Text="{Binding PacketSearch}" />
            <TextBox Width="160" PlaceholderText="Message ID / name" Text="{Binding MessageFilter}" />
            <TextBox Width="75" PlaceholderText="System" Text="{Binding SystemFilter}" />
            <TextBox Width="95" PlaceholderText="Component" Text="{Binding ComponentFilter}" />
            <TextBox Width="120" PlaceholderText="Severity ≤ (0–7)" Text="{Binding SeverityFilter}" />
            <Button Command="{Binding FilterPacketsCommand}" ToolTip.Tip="Apply packet filters" AutomationProperties.Name="Apply packet filters" ><mdi:MaterialIcon Kind="FilterOutline" Classes="ActionIcon" /></Button>
        </WrapPanel>
        <WrapPanel Grid.Row="4" ItemSpacing="8">
            <TextBox Width="260" PlaceholderText="Jump to UTC timestamp" Text="{Binding JumpTimestamp}" />
            <Button Command="{Binding JumpPacketsCommand}" ToolTip.Tip="Jump to timestamp" AutomationProperties.Name="Jump to timestamp" ><mdi:MaterialIcon Kind="TimelineClockOutline" Classes="ActionIcon" /></Button>
            <Button Command="{Binding PreviousPacketsCommand}" ToolTip.Tip="Previous packet page" AutomationProperties.Name="Previous packet page" ><mdi:MaterialIcon Kind="ChevronLeft" Classes="ActionIcon" /></Button>
            <Button Command="{Binding NextPacketsCommand}" ToolTip.Tip="Next packet page" AutomationProperties.Name="Next packet page" ><mdi:MaterialIcon Kind="ChevronRight" Classes="ActionIcon" /></Button>
            <CheckBox Content="Follow replay" IsChecked="{Binding FollowReplay}" />
        </WrapPanel>
        <TextBlock Grid.Row="5" Text="{Binding PacketStatus}" />
        <controls:VirtualizedItemsGrid Grid.Row="6" ItemsSource="{Binding Packets}"
            ColumnWidths="180,100,60,60,80,180,*" ShowSearchBar="False" ShowPagination="False" SelectionMode="Single">
            <controls:VirtualizedItemsGrid.HeaderTemplate>
                <DataTemplate>
                    <controls:VirtualizedItemsGridRow>
                        <TextBlock Grid.Column="0" Text="Time (UTC)" />
                        <TextBlock Grid.Column="1" Text="Delta" />
                        <TextBlock Grid.Column="2" Text="System" />
                        <TextBlock Grid.Column="3" Text="Comp" />
                        <TextBlock Grid.Column="4" Text="Msg ID" />
                        <TextBlock Grid.Column="5" Text="Name" />
                        <TextBlock Grid.Column="6" Text="Summary" />
                    </controls:VirtualizedItemsGridRow>
                </DataTemplate>
            </controls:VirtualizedItemsGrid.HeaderTemplate>
            <controls:VirtualizedItemsGrid.RowTemplate>
                <DataTemplate x:DataType="replay:TelemetryPacketRow">
                    <controls:VirtualizedItemsGridRow>
                        <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat='{}{0:HH:mm:ss.ffffff}'}" />
                        <TextBlock Grid.Column="1" Text="{Binding Delta}" />
                        <TextBlock Grid.Column="2" Text="{Binding SystemId}" />
                        <TextBlock Grid.Column="3" Text="{Binding ComponentId}" />
                        <TextBlock Grid.Column="4" Text="{Binding MessageId}" />
                        <TextBlock Grid.Column="5" Text="{Binding Name}" />
                        <TextBlock Grid.Column="6" Text="{Binding Summary}" ToolTip.Tip="{Binding RawHex}" TextTrimming="CharacterEllipsis" />
                    </controls:VirtualizedItemsGridRow>
                </DataTemplate>
            </controls:VirtualizedItemsGrid.RowTemplate>
        </controls:VirtualizedItemsGrid>
        <StackPanel Grid.Row="7" Spacing="6">
            <TextBlock Text="{Binding SourceModeLabel}" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" Classes="Warning" />
            <WrapPanel ItemSpacing="8">
                <Button Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play / pause replay" AutomationProperties.Name="Play / pause replay" ><mdi:MaterialIcon Kind="PlayPause" Classes="ActionIcon" /></Button>
                <Button Command="{Binding StopReplayCommand}" ToolTip.Tip="Stop replay at beginning" AutomationProperties.Name="Stop replay at beginning" ><mdi:MaterialIcon Kind="Stop" Classes="ActionIcon" /></Button>
                <Button Command="{Binding CloseReplayCommand}" ToolTip.Tip="Close replay" AutomationProperties.Name="Close replay" ><mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" /></Button>
                <Slider Width="260" Maximum="{Binding DurationSeconds}" Value="{Binding SeekSeconds}" />
                <Button Command="{Binding SeekCommand}" ToolTip.Tip="Seek replay" AutomationProperties.Name="Seek replay" ><mdi:MaterialIcon Kind="TimelineClockOutline" Classes="ActionIcon" /></Button>
                <NumericUpDown Width="110" Minimum="0.1" Maximum="50" Increment="0.1" Value="{Binding PlaybackSpeed}" />
                <Button Command="{Binding ApplySpeedCommand}" ToolTip.Tip="Apply replay speed" AutomationProperties.Name="Apply replay speed" ><mdi:MaterialIcon Kind="Speedometer" Classes="ActionIcon" /></Button>
                <TextBlock Text="{Binding ReplayTimeText}" VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</utilities:TabItemViewBase>
