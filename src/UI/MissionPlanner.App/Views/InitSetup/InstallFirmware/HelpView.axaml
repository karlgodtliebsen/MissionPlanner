<view:UserControlViewBase
    xmlns:view="clr-namespace:MissionPlanner.App.Utilities"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:models="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware.SubViews.Models"
    xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
    xmlns:documents="clr-namespace:MissionPlanner.App.Presentation.Documents"
    x:TypeArguments="models:FirmwareHelpViewModel"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.HelpView"
    x:DataType="models:FirmwareHelpViewModel">
    <UserControl.Styles>
        <Style Selector="controls|InformationDocumentView Border.SectionCard">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900"/>
        </Grid.ColumnDefinitions>
        <Border Padding="20" Margin="25,0,25,0" Classes="SectionCard" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Vertical" Spacing="25" HorizontalAlignment="Stretch">
                <controls:InformationDocumentView>
                    <controls:InformationDocumentView.Document>
                        <MultiBinding
                            Converter="{x:Static documents:FirmwareDocumentConverter.Instance}"
                            ConverterParameter="Firmware Help &amp; Support">
                            <Binding Source="These essential instructions are embedded and remain available offline. External links provide additional official detail."/>
                        </MultiBinding>
                    </controls:InformationDocumentView.Document>
                </controls:InformationDocumentView>
                <ItemsControl ItemsSource="{Binding SupportSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FirmwareSupportSection">
                            <StackPanel Orientation="Vertical" Spacing="4" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                <controls:InformationDocumentView>
                                    <controls:InformationDocumentView.Document>
                                        <MultiBinding Converter="{x:Static documents:FirmwareDocumentConverter.SectionInstance}">
                                            <Binding Path="Title" StringFormat="{}{0}"/>
                                            <Binding Path="Content" StringFormat="{}{0}"/>
                                        </MultiBinding>
                                    </controls:InformationDocumentView.Document>
                                </controls:InformationDocumentView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:InformationDocumentView>
                    <controls:InformationDocumentView.Document>
                        <MultiBinding
                            Converter="{x:Static documents:FirmwareDocumentConverter.Instance}"
                            ConverterParameter="Official documentation and tools">
                            <Binding Source=""/>
                        </MultiBinding>
                    </controls:InformationDocumentView.Document>
                </controls:InformationDocumentView>
                <ItemsControl ItemsSource="{Binding SupportLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FirmwareSupportLink">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="25"
                                HorizontalAlignment="Stretch">
                                <controls:InformationDocumentView Grid.RowSpan="2">
                                    <controls:InformationDocumentView.Document>
                                        <MultiBinding Converter="{x:Static documents:FirmwareDocumentConverter.SectionInstance}">
                                            <Binding Path="Title" StringFormat="{}{0}"/>
                                            <Binding Path="Description" StringFormat="{}{0}"/>
                                        </MultiBinding>
                                    </controls:InformationDocumentView.Document>
                                </controls:InformationDocumentView>
                                <Button
                                    Classes="EmbeddedIconButton"
                                    Grid.Column="1"
                                    Grid.RowSpan="2"
                                    ToolTip.Tip="Open firmware help resource"
                                    Command="{Binding $parent[ItemsControl].((models:FirmwareHelpViewModel)DataContext).OpenSupportLinkCommand}"
                                    CommandParameter="{Binding .}"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Open firmware help resource">
                                    <avalonia:MaterialIcon Kind="OpenInNew" Width="30" Height="30" Classes="ActionIcon"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                    Classes="EmbeddedIconButton"
                    ToolTip.Tip="Open Windows Device Manager"
                    Command="{Binding OpenDeviceManagerCommand}"
                    IsVisible="{Binding CanOpenDeviceManager}"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Open Windows Device Manager">
                    <avalonia:MaterialIcon Kind="OpenInNew" Width="30" Height="30" Classes="ActionIcon"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</view:UserControlViewBase>
