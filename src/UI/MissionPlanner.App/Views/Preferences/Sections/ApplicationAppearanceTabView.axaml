<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.ApplicationAppearanceTabView"
             x:DataType="preferences:PreferencesViewModel"

             >

    <Grid
          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinHeight="400" MinWidth="400"
                    >
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button Classes="EmbeddedIconButton" ToolTip.Tip="Reset appearance"
                                AutomationProperties.Name="Reset appearance"
                                Command="{Binding ResetApplicationCommand}"
                                CommandParameter="Appearance" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8" Grid.ColumnSpan="2" 
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <u:Form LabelPosition="Left" LabelWidth="220" MinWidth="400" HorizontalAlignment="Center">
                            <CheckBox  HorizontalAlignment="Right" HorizontalContentAlignment="Right" u:FormItem.Label="Show Tutorial at Startup" 
                                       IsChecked="{Binding IsTutorialVisibleAtStartup,Mode=TwoWay}" />
                            <DropDownButton HorizontalAlignment="Right" u:FormItem.Label="Theme (live preview)"
                                            ToolTip.Tip="Select theme" AutomationProperties.Name="Select theme">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" />
                                    <TextBlock Text="{Binding SelectedTheme.Name}" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <common:ThemeMenuFlyout SelectedTheme="{Binding SelectedTheme, Mode=TwoWay}" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <ComboBox HorizontalAlignment="Right" HorizontalContentAlignment="Right"  ItemsSource="{Binding LayoutModes}" 
                                      SelectedItem="{Binding LayoutMode}" u:FormItem.Label="Layout" />
                        </u:Form>
                        <TextBlock Text="Customize theme colors" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="Changes preview immediately. Save preferences to keep them; leaving this page discards unsaved color changes. Colors are stored separately for each theme."
                                   TextWrapping="Wrap" MaxWidth="620" />
                        <Button Command="{Binding ResetThemeColorsCommand}" HorizontalAlignment="Left"
                                ToolTip.Tip="Restore every color in the selected theme" AutomationProperties.Name="Reset selected theme colors">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="Restore" Width="20" Height="20" />
                                <TextBlock Text="Reset theme colors" />
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding ColorSearch, Mode=TwoWay}" PlaceholderText="Search colors, e.g. button, input, hover"
                                 AutomationProperties.Name="Search theme colors" />
                        <ItemsControl ItemsSource="{Binding FilteredThemeColors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="preferences:ThemeColorViewModel">
                                    <Grid ColumnDefinitions="*,Auto,150,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" Margin="0,5">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <ColorPicker Grid.Column="1" Color="{Binding Color, Mode=TwoWay}"
                                                     ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                        <TextBox Grid.Column="2" Text="{Binding Hex, Mode=TwoWay}"
                                                 PlaceholderText="#AARRGGBB" AutomationProperties.Name="{Binding Name}" />
                                        <Button Grid.Column="3" Command="{Binding ResetCommand}"
                                                ToolTip.Tip="Restore this color to the theme default" AutomationProperties.Name="Reset color to theme default"
                                                Classes="EmbeddedIconButton">
                                            <avalonia:MaterialIcon Kind="Restore" Width="20" Height="20" />
                                        </Button>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Error}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Error, Converter={StaticResource StringNotNullEmptyConverter}}"
                                                   Foreground="{DynamicResource SemiColorDanger}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
