<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
             x:Class="MissionPlanner.App.Views.Common.StatusBarView"
             x:DataType="common:StatusBarViewModel"
             BackgroundColor="{DynamicResource Surface}"
             HeightRequest="32">

    <Border StrokeThickness="1" Padding="2" VerticalOptions="Fill" Height="50"
    >
        <Grid ColumnDefinitions="*,Auto,Auto" 
          HorizontalOptions="Fill"
          VerticalOptions="Center"  
         >

            <!-- Status Message (Left) -->
            <Label Grid.Column="0"
               Text="{Binding StatusMessage}"
               VerticalOptions="Center"
               FontSize="12"
               TextColor="{DynamicResource OnSurfaceVariant}"/>

            <!-- Connection Info (Center-Right) -->
            <HorizontalStackLayout Grid.Column="1" 
                               Spacing="8"
                               VerticalOptions="Center"
                               Margin="0,0,16,0">
                <Label Text="●"
                       TextColor="{DynamicResource DisabledText}"
                       FontSize="14">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsConnectedStatus}"
                                     Value="True">
                            <Setter Property="TextColor"
                                    Value="{DynamicResource Success}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Text="{Binding ConnectionStatus}"
                   FontSize="12"
                   TextColor="{DynamicResource OnSurfaceVariant}"/>
            </HorizontalStackLayout>

            <!-- Clock (Right) -->
            <Label Grid.Column="2"
               Text="{Binding CurrentTime}"
               VerticalOptions="Center"
               FontSize="12"
               TextColor="{DynamicResource OnSurfaceVariant}"/>
        </Grid>
    </Border>

</ContentView>
