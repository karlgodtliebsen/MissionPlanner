<utilities:NavigationViewBase x:TypeArguments="sections:BasicTuningTabViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                              xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              xmlns:sections="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections"
                              xmlns:u="https://irihi.tech/ursa"
                              xmlns:themeControls="clr-namespace:MissionPlanner.Themes.Controls;assembly=MissionPlanner.Themes"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.BasicTuningTabView"
                              x:DataType="sections:BasicTuningTabViewModel">

    <ContentPage Header="Basic Tuning"  >

        <Grid x:Name="BasicTuningTabViewLayout" RowDefinitions="Auto,Auto,*" Margin="12"
              RowSpacing="10" Classes.expanded="{Binding IsEditorExpanded}">
            <Grid.Styles>
                <Style Selector="Grid#BasicTuningTabViewLayout">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style Selector="Grid#BasicTuningTabViewLayout.expanded">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="900" MaxWidth="{Binding EditorColumnMaxWidth}" />
            </Grid.ColumnDefinitions>

            <themeControls:ExpandBanner CanExpand="True"
                                        IsExpanded="{Binding IsEditorExpanded, Mode=TwoWay}" Grid.Column="0" Classes="Bordered" Header="Basic Tuning" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Grid.Row="0"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="10" >

                    <TextBlock Classes="SectionTitle" Text="{Binding FirmwareFamilyText, StringFormat='Firmware profile: {0}'}" />
                    <TextBlock Text="Basic Tuning intentionally hides expert control-loop fields. Use Extended Tuning or Parameters Editor only when you understand the stability risks."
                               Classes="Warning"
                               IsVisible="{Binding HasSupportedProfile}" />
                    <TextBlock Text="This connected firmware has no supported Basic Tuning profile."
                               Classes="Warning"
                               IsVisible="{Binding IsUnsupported}" />
                    <SelectableTextBlock Text="{Binding ErrorMessage}"
                                         IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"
                                         Classes="Danger" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </themeControls:ExpandBanner>

            <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="ToolbarButton" ToolTip.Tip="Import presented fields" Command="{Binding ImportCommand}" Margin="4" >
                        <avalonia:MaterialIcon Kind="FileImportOutline" Width="30" Height="30" />
                    </Button>
                    <Button Classes="ToolbarButton" ToolTip.Tip="Export presented fields" Command="{Binding ExportCommand}" Margin="4" >
                        <avalonia:MaterialIcon Kind="FileExportOutline" Width="30" Height="30" />
                    </Button>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
            <ScrollViewer Grid.Column="0" Grid.Row="2" IsVisible="{Binding HasSupportedProfile}">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sections:BasicTuningGroupViewModel">
                            <Border Padding="12" Classes="SectionCard">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Orientation="Vertical" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="20" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="6">
                                            <Button Classes="EmbeddedIconButton"  ToolTip.Tip="Refresh"
                                                    Command="{Binding RefreshCommand}" >
                                                <avalonia:MaterialIcon Kind="Refresh" Width="30" Height="30" />
                                            </Button>
                                            <Button Classes="EmbeddedIconButton"  ToolTip.Tip="Revert group"
                                                    Command="{Binding RevertCommand}" >
                                                <avalonia:MaterialIcon Kind="FileUndoOutline" Width="30" Height="30" />
                                            </Button>
                                            <Button Classes="EmbeddedIconButton"  ToolTip.Tip="Apply group" Command="{Binding ApplyCommand}" >
                                                <avalonia:MaterialIcon Kind="CheckCircleOutline" Width="30" Height="30" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Warning}"
                                               FontWeight="Bold"
                                               Classes="Warning"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasWarning}" />
                                    <TextBlock Text="{Binding ValidationMessage}"
                                               Classes="Warning"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasValidationError}" />
                                    <TextBlock Text="This group has pending changes."
                                               Classes="Warning"
                                               IsVisible="{Binding IsModified}" />

                                    <ItemsControl ItemsSource="{Binding Parameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sections:BasicTuningParameterViewModel">
                                                <Border Padding="10" BorderThickness="1">
                                                    <Grid ColumnDefinitions="2*,Auto,180" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding ParameterName}" FontSize="11" Opacity="0.7" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Editor.LiveValue, StringFormat='Live: {0:G}'}"
                                                                   VerticalAlignment="Center" />

                                                        <Grid Grid.Column="2">
                                                            <NumericUpDown
                                                                IsReadOnly="{Binding Editor.IsReadOnly}"
                                                                IsVisible="{Binding !Editor.HasValuesData}"
                                                                Value="{Binding Editor.Value, Mode=TwoWay}"
                                                                HorizontalAlignment="Stretch"
                                                                />

                                                            <ComboBox ItemsSource="{Binding Editor.ValuesData}"
                                                                      SelectedItem="{Binding Editor.SelectedValue, Mode=TwoWay}"
                                                                      IsVisible="{Binding Editor.HasValuesData}" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                                   Text="{Binding Units, StringFormat='Units: {0}'}"
                                                                   FontSize="12" />

                                                        <Slider Grid.Row="2" Grid.ColumnSpan="3"
                                                                Minimum="{Binding Editor.Min}"
                                                                Maximum="{Binding Editor.Max}"
                                                                Value="{Binding Editor.Value, Mode=TwoWay}"
                                                                IsVisible="{Binding Editor.HasNumericRangeData}" />

                                                        <StackPanel Orientation="Vertical" Grid.Row="3" Grid.ColumnSpan="3" Spacing="2">
                                                            <TextBlock Text="{Binding RecommendationText}"
                                                                       IsVisible="{Binding HasRecommendation}"
                                                                       Foreground="ForestGreen"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding Warning}"
                                                                       IsVisible="{Binding HasWarning}"
                                                                       Classes="Warning"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding Editor.ValidationError}"
                                                                       Classes="Warning"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding Editor.WriteMessage}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
