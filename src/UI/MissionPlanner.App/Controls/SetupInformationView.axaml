<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              xmlns:documents="clr-namespace:MissionPlanner.App.Presentation.Documents"
                              xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                              xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              x:TypeArguments="documents:SetupInformationViewModel"
                              x:Class="MissionPlanner.App.Controls.SetupInformationView"
                              x:DataType="documents:SetupInformationViewModel">
    <Grid x:Name="ReportContent" RowDefinitions="Auto,*">
        <Button Classes="ToolbarIconButton" HorizontalAlignment="Center" Margin="0,12"
                Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh information"
                AutomationProperties.Name="Refresh information">
            <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
        </Button>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <controls:InformationDocumentView Document="{Binding Overview}" />
                <controls:InformationDocumentView Document="{Binding AdditionalDocument}" IsVisible="{Binding HasAdditionalDocument}" />
                <controls:InformationDocumentView Document="{Binding Parameters}" IsVisible="{Binding HasParameters}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</utilities:UserControlViewBase>
