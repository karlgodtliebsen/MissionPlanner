<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MissionPlanner.Themes"
        x:Class="MissionPlanner.Themes.MissionPlannerTheme">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkOrange}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Orange/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightOrange}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Orange/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkPurple}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Purple/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightPurple}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Purple/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkRed}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Red/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightRed}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Red/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkPink}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Pink/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightPink}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Pink/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkViolet}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Violet/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightViolet}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Violet/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkIndigo}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Indigo/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightIndigo}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Indigo/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkYellow}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Yellow/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightYellow}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Yellow/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkLime}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Lime/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightLime}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Lime/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkLightGreen}"
                                 Source="avares://MissionPlanner.Themes/Palettes/LightGreen/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightLightGreen}"
                                 Source="avares://MissionPlanner.Themes/Palettes/LightGreen/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkLightBlue}"
                                 Source="avares://MissionPlanner.Themes/Palettes/LightBlue/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightLightBlue}"
                                 Source="avares://MissionPlanner.Themes/Palettes/LightBlue/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkTeal}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Teal/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightTeal}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Teal/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkCyan}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Cyan/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightCyan}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Cyan/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkGreen}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Green/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightGreen}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Green/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkGrey}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Grey/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightGrey}"
                                 Source="avares://MissionPlanner.Themes/Palettes/Grey/Light.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.DarkAIPurple}"
                                 Source="avares://MissionPlanner.Themes/Palettes/AIPurple/Dark.axaml" />
                <ResourceInclude x:Key="{x:Static local:MissionPlannerThemeVariants.LightAIPurple}"
                                 Source="avares://MissionPlanner.Themes/Palettes/AIPurple/Light.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <!-- Keep implicit control-theme lookup live when a window changes named variants.
         Original variants resolve their original provider themes through these same keys. -->
    <Style Selector="ToggleButton">
        <Setter Property="Theme" Value="{DynamicResource {x:Type ToggleButton}}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Theme" Value="{DynamicResource {x:Type CheckBox}}" />
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Theme" Value="{DynamicResource {x:Type RadioButton}}" />
    </Style>
</Styles>
