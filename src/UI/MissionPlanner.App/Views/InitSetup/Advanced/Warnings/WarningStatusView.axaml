<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Warnings"
    xmlns:model="clr-namespace:MissionPlanner.Core.Setup.Advanced.Warnings;assembly=MissionPlanner.Core"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Warnings.WarningStatusView"
    x:TypeArguments="local:WarningStatusViewModel" x:DataType="local:WarningStatusViewModel"
                            xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Button Classes="IsToolbarButton" ToolTip.Tip="Acknowledge selected warning" Command="{Binding AcknowledgeCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Acknowledge selected warning">
            <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
        </Button>
        <ListBox Grid.Row="1" ItemsSource="{Binding Warnings}" SelectedItem="{Binding Selected}"
                 AutomationProperties.Name="Current warning states">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="model:WarningSnapshot">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding State}" Classes="H4" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ChangedAt}" />
                        <TextBlock Text="{Binding Value, StringFormat='Current value: {0}'}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</utilities:UserControlViewBase>
