<utilities:TabItemViewBase x:TypeArguments="tabs:ServoRelayTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                           xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                           xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                           xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.App.Views.FlightData.Tabs.ServoRelayTabItemView"
                           x:DataType="tabs:ServoRelayTabViewModel">
    <ScrollViewer  >
        <Grid  Margin="12" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
            <TextBlock Text="Observed servo outputs" Classes="H3"/>
            <controls:VirtualizedItemsGrid
                Grid.Row="1"
                ItemsSource="{Binding ServoOutputs}"
                ColumnWidths="*"
                RowMinHeight="34"
                ShowHeader="False"
                ShowSearchBar="False"
                ShowPagination="False"
                SelectionMode="None">
                <controls:VirtualizedItemsGrid.EmptyView>
                    <TextBlock Text="No rows could be found."
                               FontSize="12"
                               Opacity="0.6"
                               Margin="0,20"
                               HorizontalAlignment="Center" />
                </controls:VirtualizedItemsGrid.EmptyView>
                <controls:VirtualizedItemsGrid.RowTemplate>
                    <DataTemplate x:DataType="x:String">
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Classes="DataGridRow" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.RowTemplate>
            </controls:VirtualizedItemsGrid>
            <StackPanel Grid.Row="2" Spacing="8" Orientation="Vertical">
                <NumericUpDown Value="{Binding Channel}" Minimum="1"/>
                <NumericUpDown  Value="{Binding Pwm}"/>
                <CheckBox  Content="Confirm disarmed test" IsChecked="{Binding IsConfirmed}"/>
                <Button Classes="EmbeddedIconButton"  ToolTip.Tip="Set servo" Command="{Binding SetServoCommand}" AutomationProperties.Name="Set servo">
                    <mdi:MaterialIcon Kind="Tune" Classes="ActionIcon" Width="20" Height="20" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{Binding Result}"/>
        </Grid>
    </ScrollViewer>
</utilities:TabItemViewBase>
