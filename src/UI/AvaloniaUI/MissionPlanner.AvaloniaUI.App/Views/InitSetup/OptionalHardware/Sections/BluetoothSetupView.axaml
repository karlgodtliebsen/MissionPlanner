<utilities:UserControlViewBase x:TypeArguments="sections:BluetoothSetupViewModel" xmlns="https://github.com/avaloniaui" xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions" xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material" xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui" x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections.BluetoothSetupView" x:DataType="sections:BluetoothSetupViewModel">
<ScrollViewer>
<StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
<TextBlock Text="Classic Serial Bluetooth Setup" FontSize="20" FontWeight="Bold" />
<TextBlock Text="For HC-05/HC-06 style AT modules; this is not Bluetooth LE configuration." Opacity="0.75" />
<TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
<TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
<StackPanel Orientation="Horizontal" Spacing="25" VerticalAlignment="Center">
<ComboBox ToolTip.Tip="Serial device" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Width="180" />
<Button Content="Refresh ports" Command="{Binding RefreshPortsCommand}" />
<Button Content="Probe module" Command="{Binding ProbeCommand}" />
</StackPanel>
<TextBlock Text="{Binding ModuleIdentity}" FontWeight="Bold" />
<TextBox Watermark="Module name" Text="{Binding Name}" />
<TextBox Watermark="PIN" Text="{Binding Pin}" PasswordChar="●" />
<NumericUpDown Watermark="Baud" Value="{Binding BaudRate}" Minimum="0" FormatString="F0" />
<Button Content="Apply supported settings" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" />
</StackPanel>
</ScrollViewer>
</utilities:UserControlViewBase>