<UserControl
                xmlns="https://github.com/avaloniaui"
                xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" 
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs.ParameterComparisonView"
                x:DataType="tabs:ParameterComparisonViewModel"
                >
    <Grid
       
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowDefinitions="Auto,*"
        RowSpacing="10"
        Margin="12">

        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Content="Select all safe differences" Command="{Binding SelectAllSafeDifferencesCommand}" />
            <Button Grid.Column="1" Content="Stage selected" Command="{Binding StageSelectedDifferencesCommand}" />
            <Button Grid.Column="2" Content="Apply modified" Command="{Binding ApplyModifiedCommand}" />
            <Button Grid.Column="3" Content="Export JSON" Command="{Binding ExportJsonCommand}" />
            <Button Grid.Column="4" Content="Export CSV" Command="{Binding ExportCsvCommand}" />
            <ComboBox 
                Grid.Column="5"
                Width="140"
                ItemsSource="{Binding Filters}"
                SelectedItem="{Binding Filter}" />
            <Button HorizontalAlignment="Right"
                    Grid.Column="7" Content="Close" Width="100" Command="{Binding CloseCommand}">
             
            </Button>
        </Grid>

        <!-- TODO: Replace auto-generated columns with native Avalonia column templates after the FullParametersList virtualization test establishes the final grid strategy. -->
        <DataGrid AutoGenerateColumns="True"
            Grid.Row="1"
            ItemsSource="{Binding Items}">

            

            
        </DataGrid>
    </Grid>
</UserControl>
