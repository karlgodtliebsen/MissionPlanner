<utilities:TabItemViewBase x:TypeArguments="tabs:TelemetryLogsTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                           xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                           xmlns:vehicles="clr-namespace:MissionPlanner.Core.Vehicles.Models;assembly=MissionPlanner.Core"
                           xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Class="MissionPlanner.App.Views.FlightData.Tabs.TelemetryLogsTabItemView"
                           x:DataType="tabs:TelemetryLogsTabViewModel"
                           xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <ScrollViewer>

        <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="25" HorizontalAlignment="Stretch">

            <StackPanel Grid.Row="0" Orientation="Vertical">
                <ProgressBar Width="40" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                             Theme="{DynamicResource ProgressRing}" />
                <TextBlock Text="{Binding RecordingState, StringFormat='PC Telemetry Recording: {0}'}" FontWeight="Bold" />
            </StackPanel>
            <Border Grid.Row="1" Padding="12" Classes="SectionCard" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10">
                    <SelectableTextBlock Text="{Binding RecordingPath}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RecordingError}" Classes="Warning" TextWrapping="Wrap" />
                    <TextBlock Text="Directory: Preferences → Logging → Log directory (applies to the next connection)." TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OnboardLoggingState, StringFormat='Vehicle Onboard Logging: {0}'}" FontWeight="Bold" />
                    <TextBlock Text="{Binding OnboardLoggingDetail}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SourceModeLabel}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Replay is read-only and cannot send vehicle commands." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <WrapPanel Grid.Row="2" ItemSpacing="10" Margin="0,10" Orientation="Horizontal"  
                       HorizontalAlignment="Stretch">
                <Button ToolTip.Tip="Load .tlog" Command="{Binding LoadCommand}" AutomationProperties.Name="Load .tlog">
                    <mdi:MaterialIcon Kind="FolderOpenOutline" Classes="ActionIcon" />
                </Button>
                <Button ToolTip.Tip="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" AutomationProperties.Name="{Binding PlayPauseText}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mdi:MaterialIcon Kind="PlayPause" Classes="ActionIcon" Width="20" Height="20" />
                        <TextBlock Text="{Binding PlayPauseText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button  ToolTip.Tip="Close replay" Command="{Binding CloseReplayCommand}" AutomationProperties.Name="Close replay">
                    <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                </Button>
                <StackPanel Margin="0,10" Spacing="10">
                    <TextBlock Text="{Binding SourceName}" Classes="H4"/>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StackPanel>
            </WrapPanel>

            <StackPanel Grid.Row="3" Spacing="10" Orientation="Vertical"  HorizontalAlignment="Stretch">
                <Slider Maximum="{Binding DurationSeconds}"
                        HorizontalAlignment="Stretch"
                        Value="{Binding SeekSeconds}"/>
                <Button ToolTip.Tip="Seek" Command="{Binding SeekCommand}" 
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Seek">
                    <mdi:MaterialIcon Kind="TimelineClockOutline" Classes="ActionIcon" />
                </Button>
                <NumericUpDown  Value="{Binding PlaybackSpeed}" Increment="0.1"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"/>
                <Button ToolTip.Tip="Apply speed ×" Command="{Binding ApplySpeedCommand}" 
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Apply speed ×">
                    <mdi:MaterialIcon Kind="Speedometer" Classes="ActionIcon" />
                </Button>
            </StackPanel>

            <WrapPanel Grid.Row="4" ItemSpacing="10" Orientation="Horizontal"  HorizontalAlignment="Stretch">
                <ProgressBar Maximum="1" HorizontalAlignment="Stretch"
                             Value="{Binding Progress}" Theme="{DynamicResource ProgressRing}" />
                <TextBlock  Text="{Binding ReplayTimeText}"  HorizontalAlignment="Stretch"/>
            </WrapPanel>

            <Grid Grid.Row="5" RowDefinitions="Auto,*" RowSpacing="10"  HorizontalAlignment="Stretch">
                <TextBlock Text="Replay vehicles:" Classes="H4" />
                <controls:VirtualizedItemsGrid
                    Grid.Row="1"
                    ItemsSource="{Binding ReplayVehicles}"
                    ColumnWidths="120,100"
                    ColumnSpacing="5"
                    RowMinHeight="34"
                    ShowHeader="True"
                    ShowSearchBar="False"
                    ShowPagination="False"
                    SelectionMode="None">
                    <controls:VirtualizedItemsGrid.EmptyView>
                        <TextBlock Text="No vehicle heartbeat has been decoded at this replay position."
                                   FontSize="12"
                                   Opacity="0.6"
                                   Margin="0,20"
                                   HorizontalAlignment="Center" />
                    </controls:VirtualizedItemsGrid.EmptyView>
                    <controls:VirtualizedItemsGrid.HeaderTemplate>
                        <DataTemplate>
                            <controls:VirtualizedItemsGridRow>
                                <TextBlock Grid.Column="0" Text="Display name" Classes="DataGridColumn" />
                                <TextBlock Grid.Column="1" Text="Vehicle ID" Classes="DataGridColumn" />
                            </controls:VirtualizedItemsGridRow>
                        </DataTemplate>
                    </controls:VirtualizedItemsGrid.HeaderTemplate>
                    <controls:VirtualizedItemsGrid.RowTemplate>
                        <DataTemplate x:DataType="vehicles:VehicleState">
                            <controls:VirtualizedItemsGridRow>
                                <TextBlock Grid.Column="0" ToolTip.Tip="{Binding DisplayName}" Text="{Binding DisplayName}" TextWrapping="Wrap" Classes="DataGridRow" />
                                <TextBlock Grid.Column="1" ToolTip.Tip="{Binding VehicleId}" Text="{Binding VehicleId}" TextWrapping="Wrap" Classes="DataGridRow" />
                            </controls:VirtualizedItemsGridRow>
                        </DataTemplate>
                    </controls:VirtualizedItemsGrid.RowTemplate>
                </controls:VirtualizedItemsGrid>
            </Grid>
        </Grid>
    </ScrollViewer>
</utilities:TabItemViewBase>
