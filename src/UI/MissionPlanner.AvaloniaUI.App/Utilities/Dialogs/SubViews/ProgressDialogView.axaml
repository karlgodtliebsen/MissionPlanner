<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities.Dialogs"
             xmlns:subViews="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities.Dialogs.SubViews"
             x:Class="MissionPlanner.AvaloniaUI.App.Utilities.Dialogs.SubViews.ProgressDialogView"
             x:DataType="subViews:ProgressDialogViewModel"
             mc:Ignorable="d">
    <StackPanel Spacing="14">
        <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
