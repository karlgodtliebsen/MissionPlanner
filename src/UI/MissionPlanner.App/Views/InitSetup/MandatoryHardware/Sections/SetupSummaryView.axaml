<utilities:UserControlViewBase x:TypeArguments="sections:SetupSummaryViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mandatoryHardware="clr-namespace:MissionPlanner.Core.Setup.MandatoryHardware;assembly=MissionPlanner.Core"
                               xmlns:models1="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Models"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.SetupSummaryView"
                               x:DataType="sections:SetupSummaryViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <Border HorizontalAlignment="Stretch" Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Text="Setup summary" Classes="H2" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <TextBlock Text="{Binding Heading}" Classes="H4" />
                <TextBlock Text="This report describes configuration evidence only and is not a safe-to-fly certification." Opacity="0.75" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Classes="ToolbarIconButton" ToolTip.Tip="Rebuild summary" Command="{Binding RefreshCommand}" AutomationProperties.Name="Rebuild summary">
                    <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
                <Button Classes="ToolbarIconButton" ToolTip.Tip="Export JSON" Command="{Binding ExportJsonCommand}" AutomationProperties.Name="Export JSON">
                    <mdi:MaterialIcon Kind="FileExportOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="ToolbarIconButton" ToolTip.Tip="Export Markdown" Command="{Binding ExportMarkdownCommand}" AutomationProperties.Name="Export Markdown">
                    <mdi:MaterialIcon Kind="FileExportOutline" Classes="ActionIcon" />
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="2" Margin="16,0" HorizontalAlignment="Stretch"  HorizontalScrollBarVisibility="Disabled">
            <Border Padding="12" >
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models1:SetupSummarySectionViewModel">
                                <Border Padding="10" Classes="SectionCard">
                                    <StackPanel Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" />
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="mandatoryHardware:SetupSummaryEntry">
                                                    <Grid ColumnDefinitions="200,*,120" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Opacity="0.8" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl IsVisible="{Binding HasWarnings}" ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}" Classes="Warning" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox AcceptsReturn="True" Text="{Binding ExportedText}" IsReadOnly="True"
                             Height="180" IsVisible="{Binding HasExport}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</utilities:UserControlViewBase>
