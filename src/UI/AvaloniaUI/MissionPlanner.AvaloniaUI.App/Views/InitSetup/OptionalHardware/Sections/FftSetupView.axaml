<utilities:UserControlViewBase x:TypeArguments="sections:FftSetupViewModel" xmlns="https://github.com/avaloniaui" xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" xmlns:controls="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material.Controls.Extensions" xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui" x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections.FftSetupView" x:DataType="sections:FftSetupViewModel">
<ScrollViewer>
<StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
<TextBlock Text="FFT Setup and Analysis" FontSize="24" FontWeight="Bold" />
<TextBlock Text="FFT/log settings are available only when INS_LOG_BAT or FFT parameters are reported. Log acquisition remains owned by DataFlash Logs." />
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
<TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
<TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
<NumericUpDown Watermark="Sample rate Hz" Value="{Binding SampleRateHz}" Minimum="0" FormatString="F0" />
<TextBox AcceptsReturn="True" Watermark="Paste comma/newline-separated samples from an existing log artifact" Text="{Binding SamplesText}" Height="180" />
<Button Content="Analyze samples" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Left" />
</StackPanel>
</ScrollViewer>
</utilities:UserControlViewBase>