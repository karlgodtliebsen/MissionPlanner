<utilities:UserControlViewBase x:TypeArguments="sections:CubeIdUpdateViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.Themes.Controls;assembly=MissionPlanner.Themes"
                               xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:appSetup="clr-namespace:MissionPlanner.App.Views.Common"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.CubeIdUpdateView"
                               x:DataType="sections:CubeIdUpdateViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa">

    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner ShowIcon="False"  Classes="Bordered" Header="CubeID Firmware Update" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="The target component identity is retained; an autopilot component cannot consume CubeID acknowledgements." />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                        </WrapPanel>
                    </Border>
                    <appSetup:SetupInformationView Grid.Row="1" Topic="CubeId" WorkflowError="{Binding ErrorMessage}" >
                        <appSetup:SetupInformationView.WorkflowStatus>
                            <MultiBinding StringFormat="{}{0}&#10;{1}">
                                <Binding Path="StatusMessage" />
                                <Binding Path="FirmwareSummary" />
                            </MultiBinding>
                        </appSetup:SetupInformationView.WorkflowStatus>
                    </appSetup:SetupInformationView>
                </Grid>
            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">

                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>

                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Inspect firmware" Command="{Binding InspectCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Inspect firmware">
                                <mdi:MaterialIcon Kind="FileSearchOutline" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Select local firmware" Command="{Binding BrowseCommand}" AutomationProperties.Name="Select local firmware">
                                <mdi:MaterialIcon Kind="FolderOpen" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Update CubeID" Command="{Binding UpdateCommand}" AutomationProperties.Name="Update CubeID">
                                <mdi:MaterialIcon Kind="Upload" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Cancel update" Command="{Binding UpdateCancelCommand}" AutomationProperties.Name="Cancel update">
                                <mdi:MaterialIcon Kind="Cancel" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" HorizontalAlignment="Stretch" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding FirmwareSummary}" />
                            <TextBox PlaceholderText="Local firmware .bin path" Text="{Binding FirmwarePath}" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding TransferProgress}" />
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
