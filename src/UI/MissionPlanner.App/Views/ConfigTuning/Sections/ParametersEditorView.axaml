<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="450"
             xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sections="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Sections"
             x:Class="MissionPlanner.App.Views.ConfigTuning.Sections.ParametersEditorView"
             x:DataType="sections:ParametersEditorViewModel"
             >
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="10"
        Margin="25">

        <TextBlock Grid.Row="0"
                   Classes="H2" Text="Edit Parameters and Values"
                   HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Center" >
            <Button Classes="ToolbarButton" 
                    ToolTip.Tip="Clear" 
                    Command="{Binding ClearCommand}">
                <avalonia:MaterialIcon Kind="ClearCircleOutline" Classes="ActionIcon" />
            </Button>
        </StackPanel>

        <Border Grid.Row="2" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="SectionCard">
            
            <Grid RowDefinitions="Auto,*" >
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="5">

                    <TextBlock  Classes="H6"
                                Text="Accepted Formats: name[separator]value"
                                ToolTip.Tip="Accepted Formats: name,value or name,value //comment or name=value or name=value //comment or name:value or name:value //comment"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock  Classes="H6" Text="Separator: = , : ;"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock  Classes="H6" Text="Line Separator: &lt;CR&gt;&lt;LF&gt; or &lt;LF&gt;"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Viewbox Grid.Row="1" Stretch="Uniform"  
                         StretchDirection="Both" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBox AcceptsReturn="True"
                             FontSize="11"
                             Height="400"
                             Width="600"
                             VerticalContentAlignment="Top"
                             Text="{Binding Text}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" /> 
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
