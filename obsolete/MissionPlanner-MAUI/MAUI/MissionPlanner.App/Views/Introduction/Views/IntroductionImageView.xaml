<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MissionPlanner.App.Views.Introduction.Models"
             x:Class="MissionPlanner.App.Views.Introduction.Views.IntroductionImageView"
             x:DataType="models:IntroductionImage">
    <VerticalStackLayout Spacing="5">
        <Border Padding="0"
                StyleClass="SurfaceContainer,Rounded,Elevation1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid>
                <Image x:Name="ScreenshotImage"
                       Aspect="AspectFit"
                       HeightRequest="{Binding Height}"
                       HorizontalOptions="Fill" />
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>
        </Border>

        <Label Text="{Binding Caption}"
               FontSize="12"
               Opacity="0.72"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentView>