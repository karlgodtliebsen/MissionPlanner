<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Signing"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Signing.SigningKeyView"
    x:TypeArguments="local:SigningKeyViewModel" x:DataType="local:SigningKeyViewModel">
    <Border Classes="SectionCard">
        <StackPanel Spacing="12" IsEnabled="{Binding !Locked}">
            <TextBlock Text="Key selection" Classes="H4" />
            <SelectableTextBlock Text="{Binding Fingerprint, StringFormat='Fingerprint: {0}'}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            <WrapPanel IsEnabled="{Binding !IsBusy}">
                <Button Content="Generate key…" Command="{Binding GenerateCommand}" Margin="0,0,10,8" />
                <Button Content="Import key…" Command="{Binding ImportCommand}" Margin="0,0,10,8" />
                <Button Content="Export secret key…" Command="{Binding ExportCommand}" Margin="0,0,10,8" />
                <Button Content="Load saved key" Command="{Binding LoadCommand}" Margin="0,0,10,8" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Outbound link ID (0–255)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding LinkId}" Minimum="0" Maximum="255" Increment="1" Width="140" AutomationProperties.Name="Signing link identifier" />
            </StackPanel>
        </StackPanel>
    </Border>
</utilities:UserControlViewBase>
