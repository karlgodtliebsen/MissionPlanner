<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.TelemetryDisplayTabView"
             x:DataType="preferences:PreferencesViewModel">
    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button Classes="EmbeddedIconButton" Grid.Column="1" ToolTip.Tip="Reset section" Command="{Binding ResetSectionCommand}" CommandParameter="Telemetry" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8" Grid.ColumnSpan="2" 
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock Text="Maximum display rate (Hz)" VerticalAlignment="Center" />
                            <NumericUpDown
                                Grid.Column="1"
                                HorizontalContentAlignment="Right"
                                MinWidth="150"
                                Value="{Binding TelemetryDisplayRateHz, Mode=TwoWay}"
                                FormatString="F0"
                                HorizontalAlignment="Stretch"
                                />

                            <TextBlock Grid.Row="1" Text="Chart history (seconds)" VerticalAlignment="Center" />
                            <NumericUpDown
                                Grid.Row="1"
                                Grid.Column="1"
                                MinWidth="150"
                                Value="{Binding ChartHistorySeconds, Mode=TwoWay}"
                                FormatString="F0"
                                HorizontalContentAlignment="Right"
                                HorizontalAlignment="Stretch"
                                />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
