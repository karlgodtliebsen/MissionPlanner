<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:DroneCanUavCanViewModel" 
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections" 
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                  xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                                  x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.DroneCanUavCanView" 
                                  x:DataType="sections:DroneCanUavCanViewModel">

    <VerticalStackLayout Padding="16" Spacing="25" HorizontalOptions="Center">
        <Label Text="DroneCAN / UAVCAN v0" FontSize="24" FontAttributes="Bold"/>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
        <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" LineBreakMode="TailTruncation"/>
        <uranium:SelectableLabel Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}"/>
        <material:SelectField 
            Title="Transport" ItemsSource="{Binding TransportKinds}" SelectedItem="{Binding TransportKind}"/>

        <HorizontalStackLayout HorizontalOptions="Fill" Spacing="50">
            <Button Text="Connect" Command="{Binding ConnectCommand}" HorizontalOptions="Start"/>
            <Button Text="Refresh nodes" Command="{Binding RefreshCommand}" HorizontalOptions="End"/>
        </HorizontalStackLayout>
        <CollectionView ItemsSource="{Binding Nodes}" SelectionMode="Single" SelectedItem="{Binding SelectedNode}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="50,*,100,100" Padding="4">
                        <Label Text="{Binding NodeId}"/>
                        <Label Grid.Column="1" Text="{Binding Name}"/>
                        <Label Grid.Column="2" Text="{Binding Health}"/>
                        <Label Grid.Column="3" Text="{Binding Version}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</tabViews:TabViewLifecycleContent>
