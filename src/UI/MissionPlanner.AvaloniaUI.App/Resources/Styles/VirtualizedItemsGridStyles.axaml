<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="https://irihi.tech/ursa">

 
    <Style Selector="TextBlock.DataGridColumn">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>

    <Style Selector="TextBlock.DataGridRow">
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="Margin" Value="10,0"></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>

    <Style Selector="NumericUpDown.DataGridRow">
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="Margin" Value="10,0"></Setter>
        <Setter Property="TextAlignment" Value="Right"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
        <Setter Property="FormatString" Value="G7"></Setter>
    </Style>

    <Style Selector="SelectableTextBlock.DataGridRow">
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="Margin" Value="4,0"></Setter>
        <Setter Property="TextAlignment" Value="Right"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="ComboBox.DataGridRow">
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="Margin" Value="10,0"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>
    <Style Selector="u|MultiComboBox.DataGridRow">
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="Margin" Value="10,0"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>

    <Style Selector="Button.DataGridRow">
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="Margin" Value="10,0"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>


</Styles>