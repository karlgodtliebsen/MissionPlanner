<?xml version="1.0" encoding="utf-8" ?>
<navigation:ExtendedContentView x:TypeArguments="missions:MissionMapViewModel" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                xmlns:missions="clr-namespace:MissionPlanner.App.Views.Missions"
                                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                                xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                                xmlns:controls="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
                                xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                                x:Class="MissionPlanner.App.Views.Missions.MissionItemListView"
                                x:DataType="missions:MissionMapViewModel"
                                x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="6" BackgroundColor="#252526" Padding="6"  Margin="0" HorizontalOptions="Fill"   VerticalOptions="Fill">

        <!-- Title + mode switch BackgroundColor="#252526" -->
        <Label Grid.Column="0" Text="Mission" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />

        <Label Grid.Row="1" Text="{Binding HomePosition, StringFormat='Home: {0}'}" FontSize="12" Opacity="0.8" />

        <!-- Complete-mode header: info + editor settings -->
        <Label Grid.Row="2" Text="{Binding MissionSummary}" FontSize="12" FontAttributes="Bold" />

        <Grid Grid.Row="3" HorizontalOptions="Start"  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalOptions="Center" ColumnSpacing="6"  >
            <Label Grid.Column="0" Text="WP Radius (m):" FontSize="11" VerticalOptions="Center"  />
            <Entry Grid.Column="1" Text="{Binding WaypointRadiusMeters}" Keyboard="Numeric" HorizontalTextAlignment="End"  FontSize="11" WidthRequest="25"   />

            <Label Grid.Column="2" Text="Loiter Radius (m):" FontSize="11" VerticalOptions="Center"  />
            <Entry Grid.Column="3" Text="{Binding LoiterRadiusMeters}" Keyboard="Numeric" HorizontalTextAlignment="End" FontSize="11" WidthRequest="25"  />

            <Label Grid.Column="4" Text="Default Alt (m):" FontSize="11" VerticalOptions="Center" />
            <Entry Grid.Column="5" Text="{Binding DefaultAltitudeMeters}" Keyboard="Numeric" HorizontalTextAlignment="End"  FontSize="11" WidthRequest="25"  />

            <Label Grid.Column="6" Text="Alt Warn (m):" FontSize="11" VerticalOptions="Center"  />
            <Entry Grid.Column="7" Text="{Binding AltWarnMeters}" Keyboard="Numeric" HorizontalTextAlignment="End"  FontSize="11" WidthRequest="25"  />
        </Grid>
        
        <Grid Grid.Row="4" HorizontalOptions="Fill"   VerticalOptions="Fill">

            <controls:VirtualizedDataGrid 
                    ItemsSource="{Binding MissionItems}" 
                    ItemSizingStrategy= "MeasureFirstItem"
                    ShowSearchBar="False"
                    HorizontalOptions="Fill" 
                    VerticalOptions="Fill" 
                    BackgroundColor="Transparent"
                >
                <controls:VirtualizedDataGrid.EmptyView>
                    <Label HorizontalOptions="Center" Text="No mission items. Right-click the map to add waypoints."
                       FontSize="12" Opacity="0.6" Margin="0,20" />
                </controls:VirtualizedDataGrid.EmptyView>

                <controls:VirtualizedDataGrid.Columns>
                    
                    <material:DataGridColumn Width="*" Title="#">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label Text="{Binding Number}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
 
                    <material:DataGridColumn Width="2*" Title="Selected">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label Text="{Binding SelectedCommand}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>

                    <material:DataGridColumn Width="3*" Title="Latitude">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label Text="{Binding Latitude}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>

                    <material:DataGridColumn Width="3*" Title="Longitude">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label Text="{Binding Longitude}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="Alt (m)">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <Label Text="{Binding Altitude}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Width="100" Title="">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate x:DataType="missions:MissionItemRow">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Button Text="▲" FontSize="10" Padding="4,2" HeightRequest="26" WidthRequest="26"
                                      Command="{Binding MoveItemUpCommand, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                      CommandParameter="{Binding .}" />
                                    <Button Text="▼" FontSize="10" Padding="4,2" HeightRequest="26" WidthRequest="26"
                                      Command="{Binding MoveItemDownCommand, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                      CommandParameter="{Binding .}" />
                                    <Button Text="✕" FontSize="10" Padding="4,2" HeightRequest="26" WidthRequest="26"
                                      Command="{Binding RemoveItemCommand, Source={RelativeSource AncestorType={x:Type missions:MissionMapViewModel}}}"
                                      CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                </controls:VirtualizedDataGrid.Columns>
            </controls:VirtualizedDataGrid>
        </Grid>

