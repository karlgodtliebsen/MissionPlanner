<?xml version="1.0" encoding="UTF-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="local:InstallFirmwareViewModel"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.InstallFirmwareView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
    xmlns:virtualized="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    x:DataType="local:InstallFirmwareViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
    Title="Install Firmware">

    <Grid RowDefinitions="*,32">
        <ScrollView Grid.Row="0" HorizontalOptions="Fill" VerticalOptions="Fill">
            <VerticalStackLayout Padding="32" Spacing="20" MaximumWidthRequest="1200" HorizontalOptions="Center">
                <Label Text="Firmware"  FontSize="24" FontAttributes="Bold" />

                <Border IsVisible="{Binding IsConnectedMode}" Padding="24" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="A vehicle is connected" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Application firmware cannot be installed while Mission Planner owns the active connection. Disconnect the vehicle first to browse or install firmware." />
                        <Label Text="Embedded bootloader update is available only for a supported, disarmed ArduPilot vehicle. Keep power connected and reboot after an accepted update." />
                        <Button Text="Update Bootloader" Command="{Binding UpdateBootloaderCommand}" IsEnabled="{Binding CanUpdateBootloader}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsUnsupportedMode}" Padding="24" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <Label Text="Direct firmware installation is not available on this platform." FontAttributes="Bold"  FontSize="18"/>
                </Border>
                <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ContextHelp.Title}" FontAttributes="Bold"  FontSize="18"/>
                        <Label Text="{Binding ContextHelp.Content}" />
                    </VerticalStackLayout>
                </Border>

                <Grid  IsVisible="{Binding IsDisconnectedMode}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                    <FlexLayout Grid.Row="0" Wrap="Wrap" Direction="Column">
                        <Button Text="Refresh catalogue" Command="{Binding RefreshCatalogCommand}" />
                        <Button Text="All Options" Command="{Binding ShowAllOptionsCommand}" />
                        <!--<Button Text="Load Local / Custom Firmware" Command="{Binding LoadCustomFirmwareCommand}" />-->
                    </FlexLayout>

                    <ActivityIndicator  Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <FlexLayout Grid.Row="2" Wrap="Wrap" Direction="Column">
                        <material:SelectField 
                            WidthRequest="250" 
                            Title="Release"
                            ItemsSource="{Binding Channels}" 
                            SelectedItem="{Binding SelectedChannel}" 
                        />
                        <material:SelectField ItemsSource="{Binding Versions}"
                                              AllowClear="True"
                                              
                                              Title="Version"
                                              SelectedItem="{Binding SelectedVersion}" WidthRequest="250" 
                        />

                        <material:SelectField ItemsSource="{Binding FrameTypes}"
                                                  AllowClear="True"
                                                  Title="Frame"
                                                  SelectedItem="{Binding SelectedFrameType}" WidthRequest="250" 
                            />

                        <material:SelectField ItemsSource="{Binding Manufacturers}"
                                                  AllowClear="True"
                                                  Title="Manufacturer"
                                                  SelectedItem="{Binding SelectedManufacturer}" WidthRequest="250" 
                            />


                    </FlexLayout>

                    <virtualized:VirtualizedDataGrid  Grid.Row="3" 
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                                        MaximumHeightRequest="600"
                                                        SearchDelayMilliseconds="1000"
                                                        ItemsSource="{Binding FilteredFirmwareChoices}" 
                                                        ItemSizingStrategy= "MeasureFirstItem"
                                                        HorizontalOptions="Fill"
                                                        FilterMemberPaths="VehicleType,Version,Manufacturer,BoardId,"
                                                        ShowSearchBar="True"
                                                        VerticalOptions="Fill" 
                                                        BackgroundColor="Transparent"

                                                        EnablePaging="True"
                                                        PageSize="50"
                                                        CurrentPage="1"
                                                        ShowPager="True"
                                                        SelectionTrigger="SelectionColumnAndRowClick"
                                                        SelectionMode="Single"
                                                        SelectedItem="{Binding SelectedFirmware, Mode=TwoWay}"
                                                      


                    >
                        <virtualized:VirtualizedDataGrid.EmptyView>
                            <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image
                                             WidthRequest="40"
                                             HeightRequest="40"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static uranium:MaterialOutlined.Backup_table}, 
                                    Color={AppThemeBinding Light={StaticResource OnSurface}, 
                                    Dark={StaticResource OnSurfaceDark}}}"/>
                                <Label HorizontalOptions="Center" Text="No releases are available for this channel." FontSize="12" Opacity="0.6" Margin="0,20" />
                            </VerticalStackLayout>
                        </virtualized:VirtualizedDataGrid.EmptyView>
                        <virtualized:VirtualizedDataGrid.Columns>
                            <virtualized:ExtendedSelectableDataGridColumn Width="50"
                                SelectionMemberPath="IsSelected" />

                            <material:DataGridColumn Width="*" Title="VehicleType">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding VehicleType}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>

                            <material:DataGridColumn Width="200" Title="Version Information">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">

                                        <VerticalStackLayout>
                                            <Label Text="{Binding FirmwareVersion.Value, StringFormat='Version: {0}'}" HorizontalOptions="Start" VerticalOptions="Center"  />
                                            <Label Text="{Binding FirmwareVersion.SemanticVersion, StringFormat='SemanticVersion: {0}'}"  HorizontalOptions="Start" VerticalOptions="Center"  />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="Platform">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding Platform}"  HorizontalOptions="Start" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="Manufacturer">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding Manufacturer}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="BoardId">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding BoardId}"  HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="MatchReason">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding MatchReason}"  HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                        </virtualized:VirtualizedDataGrid.Columns>
                    </virtualized:VirtualizedDataGrid>

                    <Border Grid.Row="4" IsVisible="{Binding HasSelectedFirmware}" Padding="16" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <Label Text="Selected firmware" FontAttributes="Bold" FontSize="18" />

                            <Label Grid.Row="1" Text="Platform" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFirmware.Platform,FallbackValue='', TargetNullValue=''}" />
                            <Label Grid.Row="1" Text="Platform" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFirmware.Platform,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="2" Text="Firmware board ID" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFirmware.BoardId,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="3" Text="Version" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFirmware.Version,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="4" Text="Channel" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFirmware.Channel,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="5" Text="Vehicle" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding SelectedFirmware.VehicleType,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="6" Text="Manufacturer" />
                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding SelectedFirmware.Manufacturer,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="7" Text="Git SHA" />
                            <Label Grid.Row="7" Grid.Column="1" Text="{Binding SelectedFirmware.GitSha,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="8" Text="Format" />
                            <Label Grid.Row="8" Grid.Column="1" Text="{Binding SelectedFirmware.Format,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="9" Text="Source" />
                            <Label Grid.Row="9" Grid.Column="1" Text="{Binding SelectedFirmware.ArtifactUrl,FallbackValue='', TargetNullValue=''}" LineBreakMode="CharacterWrap" />

                            <Label Grid.Row="10" Text="USB IDs" />
                            <Label Grid.Row="10" Grid.Column="1" Text="{Binding SelectedFirmware.UsbIdentifiers,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="11" Text="Bootloader aliases" />
                            <Label Grid.Row="11" Grid.Column="1" Text="{Binding SelectedFirmware.BootloaderAliases,FallbackValue='', TargetNullValue=''}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="5" IsVisible="{Binding HasCustomFirmware}" Padding="16" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Local / custom firmware" FontAttributes="Bold" FontSize="18"/>
                                <Label Text="{Binding CustomFirmwareName}" />
                                <Label Text="{Binding CustomFirmwareDescription}" />
                                <Label Text="{Binding CustomFirmwarePlatform, StringFormat='Platforuranium: {0}'}" />
                                <Label Text="{Binding CustomFirmwareBoardId, StringFormat='Board ID: {0}'}" />
                                <Label Text="{Binding CustomFirmwareImageSize, StringFormat='Image size: {0:N0} bytes'}" />
                                <Label Text="{Binding CustomFirmwareBuild, StringFormat='Build: {0}'}" />
                                <Label Margin="0,8,0,0"
                                   Text="Custom builds are not matched against the catalogue. Confirm that the package board ID is correct for the flight controller before installing."
                                   LineBreakMode="WordWrap" />
                                <CheckBox IsChecked="{Binding RequireExactBoardIdMatch, Mode=TwoWay}" />
                                <Label Text="Require exact board ID match" />
                                <Border StyleClass="SurfaceContainer,Rounded,Elevation1" IsVisible="{Binding RequireExactBoardIdMatch, Converter={StaticResource InvertedBoolConverter}}"
                                        Margin="0,8,0,0" Padding="12" Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}">
                                    <Label Text="Advanced override: board-ID mismatch will be allowed for this local firmware only. Use this only when you know the firmware target is electrically and bootloader compatible with this controller. Flash-size, revision, bootloader and secure-boot checks still apply."
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Row="6" IsVisible="{Binding HasPreparedFirmware}" Padding="12" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <VerticalStackLayout>
                            <Label Text="Validated package" FontAttributes="Bold"  FontSize="18" />

                            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <Label Grid.Row="0" Text="Package board ID" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding PreparedFirmware.PackageBoardId,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="1" Text="Description" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PreparedFirmware.Package.Description,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="2" Text="Platform summary" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding PreparedFirmware.Package.Summary,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="3" Text="Package version" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding PreparedFirmware.Package.Version,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="4" Text="Package build" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding PreparedFirmware.Package.GitIdentity,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="5" Text="Internal image" />
                                <Label Grid.Row="5" Grid.Column="1" Text="{Binding PreparedFirmware.InternalImageSize,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="6" Text="External image" />
                                <Label Grid.Row="6" Grid.Column="1" Text="{Binding PreparedFirmware.ExternalImageSize,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="7" Text="SHA-256" />
                                <Label Grid.Row="7" Grid.Column="1" Text="{Binding PreparedFirmware.Sha256,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="8" Text="Downloaded bytes" />
                                <Label Grid.Row="8" Grid.Column="1" Text="{Binding PreparedFirmware.ArtifactMetadata.Size,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="9" Text="Downloaded at" />
                                <Label Grid.Row="9" Grid.Column="1" Text="{Binding PreparedFirmware.ArtifactMetadata.DownloadedAt,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="10" Text="Source" />
                                <Label Grid.Row="10" Grid.Column="1" Text="{Binding PreparedFirmware.ArtifactMetadata.SourceUri,FallbackValue='', TargetNullValue=''}" LineBreakMode="CharacterWrap" />

                                <Label Grid.Row="11" Text="Cache ID" />
                                <Label Grid.Row="11" Grid.Column="1" Text="{Binding PreparedFirmware.CacheIdentity,FallbackValue='', TargetNullValue=''}" LineBreakMode="CharacterWrap" />

                                <Label Grid.Row="12" Text="Cache hit" />
                                <Label Grid.Row="12" Grid.Column="1" Text="{Binding PreparedFirmware.WasCacheHit,FallbackValue='', TargetNullValue=''}" />
                            </Grid>
                            <Grid  MaximumHeightRequest="250">
                                <virtualized:VirtualizedDataGrid 
                                            ItemsSource="{Binding PreparedFirmware.Warnings}" 
                                            ItemSizingStrategy= "MeasureFirstItem"
                                            ShowSearchBar="False"
                                            Margin="0,10,0,10"
                                            MaximumHeightRequest="250"
                                            HorizontalOptions="Fill" 
                                            VerticalOptions="Fill" 
                                            BackgroundColor="Transparent"
                        >
                                    <virtualized:VirtualizedDataGrid.EmptyView>
                                        <Label HorizontalOptions="Center" Text="No validation warnings." FontSize="12" Opacity="0.6" Margin="0,20" />
                                    </virtualized:VirtualizedDataGrid.EmptyView>
                                    <virtualized:VirtualizedDataGrid.Columns>
                                        <material:DataGridColumn Width="*" Title="VehicleType">
                                            <material:DataGridColumn.CellItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Label Text="{Binding ., StringFormat='Warning: {0}'}" />
                                                </DataTemplate>
                                            </material:DataGridColumn.CellItemTemplate>
                                        </material:DataGridColumn>
                                    </virtualized:VirtualizedDataGrid.Columns>
                                </virtualized:VirtualizedDataGrid>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <uranium:ExpanderView Grid.Row="7" HorizontalOptions="Fill" VerticalOptions="Fill"
                                    IsExpanded="{Binding HasDevice}">
                        <uranium:ExpanderView.Header>
                            <Label Text="Flash Firmware" Padding="10" />
                        </uranium:ExpanderView.Header>
                        <Grid  HorizontalOptions="Fill" VerticalOptions="Fill" RowDefinitions="*" RowSpacing="10">

                            <Border Grid.Row="0" Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                                <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="10" Grid.Column="0" >
                                        <Label Text="Detected device" FontAttributes="Bold"  FontSize="18"/>
                                        <material:SelectField  
                                            ItemsSource="{Binding DetectedDevices}" 
                                            SelectedItem="{Binding SelectedDevice}" 
                                                   Title="Select flight controller" />
                                        <Label Text="{Binding DeviceStatus}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                        <Button Text="Download &amp; Validate" Command="{Binding DownloadAndValidateCommand}" />
                                        <Button Text="Copy Download URL" Command="{Binding CopyDownloadUrlCommand}" />
                                        <Button Text="Load Local / Custom Firmware" Command="{Binding LoadCustomFirmwareCommand}" />
                                        <Button Text="Clear" Command="{Binding ClearCustomFirmwareCommand}" />
                                        <Button Text="Install Validated Firmware" Command="{Binding InstallCommand}" />
                                        <!--<Button Text="Install Custom Firmware" Command="{Binding InstallCommand}" 
                                                IsEnabled="{Binding CanInstall}" />-->
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </uranium:ExpanderView>

                    <uranium:ExpanderView Grid.Row="8" HorizontalOptions="Fill" VerticalOptions="Fill" IsExpanded="{Binding HasDfuBootLoader}">
                        <uranium:ExpanderView.Header>
                            <Label Text="STM32 Bootloader" Padding="10" />
                        </uranium:ExpanderView.Header>
                        <Grid  HorizontalOptions="Fill" VerticalOptions="Fill" RowDefinitions="*" RowSpacing="10">
                            <Border Grid.Row="0" Padding="16" StyleClass="SurfaceContainer,Rounded,Elevation1">

                                <Grid ColumnDefinitions="2*,*" RowDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="10" Grid.Column="0">
                                        <Label Text="Initial installation for (STM32 DFU)" FontAttributes="Bold" FontSize="18" />
                                        <Label Text="Use this only when the controller does not yet contain the ArduPilot serial bootloader. Select an official target or load a local *_with_bl.hex file." />
                                        <Label Text="1. Disconnect the controller. Hold its BOOT/DFU button (or bridge its documented BOOT pads) while reconnecting USB. Some boards require BOOT plus RESET." />
                                        <Label Text="2. Release BOOT after Windows shows STM32 Bootloader. It is a USB DFU device, not a COM port." />
                                        <Label Text="3. Install STM32CubeProgrammer and its bundled driver if the device is not ready, then refresh the catalogue." />
                                        <Label Text="4. Confirm the exact platform and board ID. Mission Planner will download the matching official *_with_bl.hex, validate it, program it, and verify it." />
                                        <VerticalStackLayout IsVisible="{Binding HasLocalDfuFirmware}" Spacing="6">
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding LocalDfuFirmwareName, StringFormat='Selected local image: {0}'}" FontAttributes="Bold" VerticalOptions="Center" />
                                                <Button Text="Cancel Local HEX Selection"
                                                        Command="{Binding ClearLocalDfuFirmwareCommand}" />
                                            </HorizontalStackLayout>
                                            <Label Text="Local HEX mode is active. This file takes precedence over any firmware row selected in the catalogue. Clear the local HEX selection to return to catalogue installation."
                                                 LineBreakMode="WordWrap" FontAttributes="Bold" />
                                            <material:TextField Title="Exact ArduPilot platform (for example omnibusf4)" 
                                                                Text="{Binding LocalDfuPlatform, Mode=TwoWay}" />
                                            <Label Text="Intel HEX does not contain the APJ board metadata used for catalogue matching. Enter the exact platform that was used to produce this custom build."
                                                 LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Spacing="10">
                                            <material:SelectField WidthRequest="600"
                                                   Title="Select STM32 DFU device"
                                                   ItemsSource="{Binding DfuDevices}"
                                                   SelectedItem="{Binding SelectedDfuDevice}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DfuStatus}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,10" Text="Warning: this erases the current firmware. Keep USB power connected until programming and verification complete." TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                        <Button Text="Refresh devices" Command="{Binding RefreshCatalogCommand}" />
                                        <Button Text="Download &amp; Validate" Command="{Binding DownloadAndValidateCommand}" />
                                        <!--<Button Text="Install Validated Firmware" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />-->
                                        <Button Text="Copy Download URL" Command="{Binding CopyDownloadUrlCommand}" />

                                        <!--<Button Text="Load Local file *_with_bl.hex" Command="{Binding LoadCustomBootloaderAndFirmwareCommand}" />-->
                                        <Button Text="Load Local / Custom Firmware" Command="{Binding LoadCustomBlWithFirmwareCommand}" />

                                        <!--<Button Text="Install Custom Firmware"
                                                Command="{Binding InstallCommand}"
                                                IsEnabled="{Binding CanInstall}" />-->
                                        <Button HorizontalOptions="Start"  Text="Install ArduPilot + Bootloader through STM32 DFU" 
                                                Command="{Binding InstallDfuFirmwareCommand}" 
                                                />
                                        <Button Text="Clear" Command="{Binding ClearCustomFirmwareCommand}" />


                                    </VerticalStackLayout>
                                </Grid>

                            </Border>
                        </Grid>
                    </uranium:ExpanderView>

                    <uranium:ExpanderView Grid.Row="9" HorizontalOptions="Fill" VerticalOptions="Fill" 
                                    IsVisible="{Binding HasDiagnosticReport}"
                                    IsExpanded="{Binding HasDiagnosticReport}">
                        <uranium:ExpanderView.Header>
                            <Label Text="Diagnostics" Padding="10" />
                        </uranium:ExpanderView.Header>
                        <Grid  HorizontalOptions="Fill" VerticalOptions="Fill">
                            <VerticalStackLayout IsVisible="{Binding HasDiagnosticReport}" Spacing="6">
                                <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Diagnostic report" FontAttributes="Bold" FontSize="18"/>
                                        <Label Text="{Binding LastDiagnosticReport}"  />
                                    </VerticalStackLayout>
                                </Border>
                                <Button Text="Copy diagnostic report" Command="{Binding CopyDiagnosticReportCommand}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </Grid>
                    </uranium:ExpanderView>


                    <uranium:ExpanderView Grid.Row="10" HorizontalOptions="Fill" VerticalOptions="Fill"  SemanticProperties.Hint="Show offline firmware selection, installation, DFU, driver, and recovery guidance">
                        <uranium:ExpanderView.Header>
                            <Label Text="Help &amp; Support" Padding="10" />
                        </uranium:ExpanderView.Header>
                        <Border  Padding="20" StyleClass="SurfaceContainer,Rounded,Elevation1">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Firmware Help &amp; Support" FontSize="18" FontAttributes="Bold" />
                                <Label Text="These essential instructions are embedded and remain available offline. External links provide additional official detail." />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupportSections}" Spacing="12">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:FirmwareSupportSection">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                                <Label Text="{Binding Content}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="Official documentation and tools" FontSize="18" FontAttributes="Bold" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupportLinks}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:FirmwareSupportLink">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                                <Label Grid.Row="1" Text="{Binding Description}" />
                                                <Button Grid.Column="1" Grid.RowSpan="2" Text="Open"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:InstallFirmwareViewModel}}, Path=OpenSupportLinkCommand}"
                                          CommandParameter="{Binding .}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Button Text="Open Windows Device Manager" Command="{Binding OpenDeviceManagerCommand}"
                          IsVisible="{Binding CanOpenDeviceManager}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </Border>
                    </uranium:ExpanderView>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout  Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="Fill"
                                Padding="12,6"
                                Spacing="10"
                                BackgroundColor="#2d2d30" >
            <Label 
                   Text="{Binding StatusMessage}"
                   VerticalOptions="Center"
                   />

            <Label Text="•" FontSize="16" IsVisible="{Binding IsCancellationDeferred}" VerticalOptions="Center"/>
            <Label Text="Cancellation is deferred until verification and reboot reach a safe boundary. Keep power connected."
                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" IsVisible="{Binding IsCancellationDeferred}" />

            <Label Text="•"  FontSize="16" IsVisible="{Binding OperationProgress.HasStage}" VerticalOptions="Center"/>
            <Label Text="{Binding OperationProgress.Stage}"  />

            <Label Text="•"  FontSize="16" IsVisible="{Binding OperationProgress.HasTechnicalDetail}" VerticalOptions="Center"/>
            <Label Text="{Binding OperationProgress.TechnicalDetail}" />

            <Label Text="•"  FontSize="16" IsVisible="{Binding OperationProgress.IsPowerCritical}" VerticalOptions="Center"/>
            <Label Text="Do not disconnect power while flash memory is being changed." 
                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" 
                   IsVisible="{Binding OperationProgress.IsPowerCritical}" />


        </HorizontalStackLayout>


    </Grid>
</navigation:ExtendedContentPage>
