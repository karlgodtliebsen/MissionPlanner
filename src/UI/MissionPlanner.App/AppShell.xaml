<?xml version="1.0" encoding="UTF-8" ?>
<Shell  

    x:Class="MissionPlanner.App.AppShell"
    x:DataType="appViewModels:AppShellContentViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:controls="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
    xmlns:appViewModels="clr-namespace:MissionPlanner.App.AppViewModels"
    xmlns:flightData="clr-namespace:MissionPlanner.App.Views.FlightData"
    xmlns:flightPlanner="clr-namespace:MissionPlanner.App.Views.FlightPlanner"
    xmlns:simulation="clr-namespace:MissionPlanner.App.Views.Simulation"
    xmlns:help="clr-namespace:MissionPlanner.App.Views.Help"
    xmlns:exit="clr-namespace:MissionPlanner.App.Views.Exit"
    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
    xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
    xmlns:mandatoryHardware="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware"
    xmlns:installFirmware="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    xmlns:optionalHardware="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware"
    xmlns:advanced="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced"
    xmlns:introduction="clr-namespace:MissionPlanner.App.Views.Introduction"
    xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    Title="MissionPlanner Next Gen"
    FlyoutBackgroundColor="{DynamicResource Background}"
    FlyoutBehavior="{Binding FlyoutBehavior,Mode=TwoWay}"
    FlyoutIsPresented="{Binding IsFlyoutPresented,Mode=TwoWay}"
    >

    <!-- Persistent Top Bar (visible on all pages) -->
    <Shell.TitleView>
        <common:TopBarView />
    </Shell.TitleView>

    <Shell.Resources>
        <Style TargetType="HorizontalStackLayout" ApplyToDerivedTypes="True" CanCascade="True">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                     Value="{DynamicResource SurfaceContainerHigh}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </Shell.Resources>
    <Shell.FlyoutHeader>

        <Grid ColumnDefinitions="*,1">

            <VerticalStackLayout
                Padding="0"
                Spacing="20"
                BackgroundColor="{DynamicResource PrimaryContainer}">
                <HorizontalStackLayout HorizontalOptions="Start" 
                                   MinimumHeightRequest="50"
                                   IsVisible="{Binding IsFlyoutExpandButtonVisible}">
                    <Button 
                        BorderColor="Transparent"
                        BorderWidth="0"
                        BackgroundColor="Transparent"
                        FontSize="8" 
                        MinimumHeightRequest="50"
                        ImageSource="{FontImageSource Glyph={x:Static uranium:MaterialSharp.Arrow_circle_right}, FontFamily=MaterialSharp}"
                        Command="{Binding ExpandFlyoutCommand}">

                    </Button>
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="End" 
                                   MinimumHeightRequest="50"
                                   IsVisible="{Binding IsFlyoutCollapseButtonVisible}">
                    <Button
                        BorderColor="Transparent"
                        BorderWidth="0"
                        BackgroundColor="Transparent"
                        FontSize="8"
                        MinimumHeightRequest="50"
                        ImageSource="{FontImageSource Glyph={x:Static uranium:MaterialSharp.Arrow_circle_left}, FontFamily=MaterialSharp}"
                        Command="{Binding CloseFlyoutCommand}"></Button>
                </HorizontalStackLayout>

                <Label Text="MissionPlanner Next Gen" 
                       FontSize="Large"
                       HorizontalTextAlignment="Center"
                       Padding="20"
                       Margin="10"
                       TextColor="{DynamicResource OnPrimaryContainer}"/>
  
               <VerticalStackLayout   Padding="20" >

                    <Label
                        Margin="10"
                        HorizontalOptions="Center"
                        Text="App Theme"
                        TextColor="{DynamicResource OnPrimaryContainer}" />

                    <controls:SelectionView HorizontalOptions="Center"
                                        ItemsSource="{Binding ThemeOptions}"
                                        SelectedItem="{Binding SelectedThemeOption,Mode=TwoWay}"
                                        ColumnNumber="2" ColumnSpacing="-2" Color="{DynamicResource Tertiary}" >
                    </controls:SelectionView>
              <!--      
                   <material:CheckBox Text="Lock Flyout (Requires Restart)" Type="Regular" 
                                   IsVisible="{Binding IsFlyoutPresented}"
                                   IsChecked="{Binding IsFlyoutLocked,Mode=TwoWay}" />
                    <material:CheckBox Text="Show Flyout at Startup" Type="Regular" 
                                   IsVisible="{Binding IsFlyoutPresented}"
                                   IsChecked="{Binding IsFlyoutVisibleAtStartup,Mode=TwoWay}" />
                    <material:CheckBox Text="Show Tutorial at Startup" Type="Regular" 
                                   IsVisible="{Binding IsFlyoutPresented}"
                                   IsChecked="{Binding IsTutorialVisibleAtStartup,Mode=TwoWay}" />
                   -->
                </VerticalStackLayout>
            </VerticalStackLayout>

            <BoxView Grid.Column="1" Width="1" ></BoxView>

        </Grid>

    </Shell.FlyoutHeader>

    <Shell.FlyoutContent >
        <Grid RowDefinitions="Auto,*"  ColumnDefinitions="*,1">
            <CollectionView Grid.Row="1" SelectedItem="{Binding SelectedItem}" SelectionMode="Single" 
                            ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Padding="20,12" Spacing="12">
                            <Image Source="{Binding Icon}" WidthRequest="20" />
                            <Label Text="{Binding Title}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <BoxView Grid.Row="1" Grid.Column="1" Width="1"></BoxView>

        </Grid>
    </Shell.FlyoutContent>

    <!--<FlyoutItem 
        x:Name="Landing"
        Title="MissionPlanner Next Gen" Icon="Resources/Images/x_light_help_icon_x.png">
        <ShellContent
            Title=""
            ContentTemplate="{DataTemplate landing:LandingPage}" Route="LandingPage" />
    </FlyoutItem>-->

    <FlyoutItem Title="Flight Data"  Icon="Resources/Images/x_light_flightdata_icon_x.png">
        <ShellContent
            Title=""
            ContentTemplate="{DataTemplate flightData:FlightDataPage}" Route="FlightData" />
    </FlyoutItem>

    <FlyoutItem Title="Flight Plan" Icon="Resources/Images/x_light_flightplan_icon_x.png">
        <ShellContent
            Title=""
            ContentTemplate="{DataTemplate flightPlanner:FlightPlannerPage}" Route="FlightPlanner" />
    </FlyoutItem>
    <FlyoutItem Title="Setup" Icon="Resources/Images/x_light_initialsetup_icon_x.png">
        <ShellContent
            Title="Install Firmware"
            ContentTemplate="{DataTemplate installFirmware:InstallFirmwareView}" Route="SetupInstallFirmware" />

        <ShellContent
            Title="Mandatory Hardware"
            ContentTemplate="{DataTemplate mandatoryHardware:MandatoryHardwareView}" Route="SetupMandatoryHardware" />
        <ShellContent
            Title="Optional Hardware"
            ContentTemplate="{DataTemplate optionalHardware:OptionalHardwareView}" Route="SetupOptionalHardware" />

        <ShellContent
            Title="Advanced"
            ContentTemplate="{DataTemplate advanced:AdvancedView}" Route="SetupAdvanced" />

    </FlyoutItem>
    <FlyoutItem Title="Config" Icon="Resources/Images/x_light_tuningconfig_icon_x.png">
        <ShellContent Title="Geo Fence" Route="ConfigGeoFence" ContentTemplate="{DataTemplate tabs:GeoFenceTabView}"/>
        <ShellContent Title="Basic Tuning" Route="ConfigBasicTuning" ContentTemplate="{DataTemplate tabs:BasicTuningTabView}"/>
        <ShellContent Title="Extended Tuning" Route="ConfigExtendedTuning" ContentTemplate="{DataTemplate tabs:ExtendedTuningTabView}"/>
        <ShellContent Title="Onboard OSD" Route="ConfigOnboardOSD" ContentTemplate="{DataTemplate tabs:OnboardOSDTabView}"/>
        <ShellContent Title="MAV Ftp" Route="ConfigMavFtp" ContentTemplate="{DataTemplate tabs:MAVFtpTabView}"/>
        <ShellContent Title="Full Parameters List" Route="ConfigFullParameters" ContentTemplate="{DataTemplate tabs:FullParametersListTabView}"/>
        <ShellContent Title="CubeLan 8 Port Switch" Route="ConfigCubeLan8PortSwitch" ContentTemplate="{DataTemplate tabs:CubeLan8PortSwitchTabView}"/>
    </FlyoutItem>
    <FlyoutItem Title="Preferences" Icon="Resources/Images/x_light_simulation_icon_x.png" >
        <ShellContent Title="" ContentTemplate="{DataTemplate preferences:PreferencesPage}" Route="Preferences"/>
    </FlyoutItem>
    <FlyoutItem
        Title="Simulation" Icon="Resources/Images/x_light_simulation_icon_x.png" >
        <ShellContent
            Title=""
            ContentTemplate="{DataTemplate simulation:SimulationPage}" Route="Simulation" />
    </FlyoutItem>

    <FlyoutItem 
                Title="Tutorial" Icon="Resources/Images/x_light_help_icon_x.png">
        <ShellContent
            Title=""
            ContentTemplate="{DataTemplate introduction:IntroductionPage}" Route="IntroductionPage" />
    </FlyoutItem>

    <FlyoutItem Title="Help" Icon="Resources/Images/x_light_help_icon_x.png">
        <ShellContent
            Title=""
            ContentTemplate="{DataTemplate help:HelpPage}" Route="Help" />
    </FlyoutItem>
    <FlyoutItem Title="Exit" >
        <ShellContent
            Title=""
            ContentTemplate="{DataTemplate exit:ExitView}" Route="Exit" />
    </FlyoutItem>
</Shell>
