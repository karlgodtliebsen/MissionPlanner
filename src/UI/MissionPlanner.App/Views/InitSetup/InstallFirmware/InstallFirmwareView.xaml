<?xml version="1.0" encoding="UTF-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="local:InstallFirmwareViewModel"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.InstallFirmwareView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
    xmlns:virtualized="clr-namespace:UraniumUI.Material.VirtualizedDataGrid.Controls;assembly=UraniumUI.Material.VirtualizedDataGrid"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    x:DataType="local:InstallFirmwareViewModel"
    Title="Install Firmware">

    <Grid RowDefinitions="*,32">


        <ScrollView Grid.Row="0" HorizontalOptions="Fill" VerticalOptions="Fill">
            <VerticalStackLayout Padding="32" Spacing="20" MaximumWidthRequest="1200" HorizontalOptions="Center">
                <Label Text="Firmware" FontSize="30" FontAttributes="Bold" />

                <Border IsVisible="{Binding IsConnectedMode}" Padding="24" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="A vehicle is connected" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Application firmware cannot be installed while Mission Planner owns the active connection. Disconnect the vehicle first to browse or install firmware." />
                        <Label Text="Embedded bootloader update is available only for a supported, disarmed ArduPilot vehicle. Keep power connected and reboot after an accepted update." />
                        <Button Text="Update Bootloader" Command="{Binding UpdateBootloaderCommand}" IsEnabled="{Binding CanUpdateBootloader}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Grid  IsVisible="{Binding IsDisconnectedMode}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                    <HorizontalStackLayout Spacing="10" Grid.Row="0" >
                        <material:SelectField 
                            WidthRequest="250" 
                            Title="Release"
                            ItemsSource="{Binding Channels}" 
                            SelectedItem="{Binding SelectedChannel}" 
                            />
                        <Button Text="Refresh catalogue" Command="{Binding RefreshCatalogCommand}" />
                        <Button Text="All Options" Command="{Binding ShowAllOptionsCommand}" />
                        <Button Text="Load Custom Firmware" Command="{Binding LoadCustomFirmwareCommand}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" Grid.Row="1" >
                        <material:SelectField ItemsSource="{Binding Versions}"
                                              AllowClear="True"
                                              
                                              Title="Version"
                                              SelectedItem="{Binding SelectedVersion}" WidthRequest="250" 
                        />

                        <material:SelectField ItemsSource="{Binding FrameTypes}"
                                                  AllowClear="True"
                                                  Title="Frame"
                                                  SelectedItem="{Binding SelectedFrameType}" WidthRequest="250" 
                            />

                        <material:SelectField ItemsSource="{Binding Manufacturers}"
                                                  AllowClear="True"
                                                  Title="Manufacturer"
                                                  SelectedItem="{Binding SelectedManufacturer}" WidthRequest="250" 
                            />


                    </HorizontalStackLayout>
                    <ActivityIndicator  Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />


                    <virtualized:VirtualizedDataGrid  
                                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                                      MaximumHeightRequest="600"
                                                      Grid.Row="3" 
                                                      ItemsSource="{Binding FilteredFirmwareChoices}" 
                                                      ItemSizingStrategy= "MeasureFirstItem"
                                                      HorizontalOptions="Fill"
                                                      FilterMemberPaths="VehicleType,Version,Manufacturer,BoardId,"
                                                      ShowSearchBar="True"
                                                      VerticalOptions="Fill" 
                                                      BackgroundColor="Transparent"

                                                      EnablePaging="True"
                                                      PageSize="50"
                                                      CurrentPage="1"
                                                      ShowPager="True"
                                                      SelectionTrigger="SelectionColumnAndRowClick"
                                                      SelectionMode="Single"
                                                      SelectedItem="{Binding SelectedFirmware, Mode=TwoWay}"
                                                      SelectionChangedCommand="{Binding SelectionChangedCommand}"


                    >
                        <virtualized:VirtualizedDataGrid.EmptyView>


                            <VerticalStackLayout
                                Padding="40"
                                Spacing="8"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static m:MaterialOutlined.Backup_table}, 
                                    Color={AppThemeBinding Light={StaticResource OnSurface}, 
                                    Dark={StaticResource OnSurfaceDark}}}"/>
                                <Label HorizontalOptions="Center" Text="No releases are available for this channel."
                                       FontSize="12" Opacity="0.6" Margin="0,20" />
                            </VerticalStackLayout>
                        </virtualized:VirtualizedDataGrid.EmptyView>
                        <virtualized:VirtualizedDataGrid.Columns>
                            <virtualized:ExtendedSelectableDataGridColumn Width="50"
                                SelectionMemberPath="IsSelected"
                                SelectionCommandMemberPath="SelectionChangedCommand" />

                            <material:DataGridColumn Width="*" Title="VehicleType">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding VehicleType}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>

                            <material:DataGridColumn Width="200" Title="Version Information">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">

                                        <VerticalStackLayout>
                                            <Label Text="{Binding FirmwareVersion.Value, StringFormat='Version: {0}'}" HorizontalOptions="Start" VerticalOptions="Center"  />
                                            <Label Text="{Binding FirmwareVersion.SemanticVersion, StringFormat='SemanticVersion: {0}'}"  HorizontalOptions="Start" VerticalOptions="Center"  />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="Platform">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding Platform}"  HorizontalOptions="Start" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="Manufacturer">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding Manufacturer}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="BoardId">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding BoardId}"  HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                            <material:DataGridColumn Width="*" Title="MatchReason">
                                <material:DataGridColumn.CellItemTemplate>
                                    <DataTemplate x:DataType="local:FirmwareCatalogItemViewModel">
                                        <Label Text="{Binding MatchReason}"  HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                    </DataTemplate>
                                </material:DataGridColumn.CellItemTemplate>
                            </material:DataGridColumn>
                        </virtualized:VirtualizedDataGrid.Columns>
                    </virtualized:VirtualizedDataGrid>

                    <Border Grid.Row="4" IsVisible="{Binding HasCustomFirmware}" Padding="16" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Custom firmware" FontAttributes="Bold" />
                            <Label Text="{Binding CustomFirmwareName}" />
                            <Label Text="{Binding CustomFirmwareDescription}" />
                            <Label Text="{Binding CustomFirmwarePlatform, StringFormat='Platform: {0}'}" />
                            <Label Text="{Binding CustomFirmwareBoardId, StringFormat='Board ID: {0}'}" />
                            <Label Text="{Binding CustomFirmwareImageSize, StringFormat='Image size: {0:N0} bytes'}" />
                            <Label Text="{Binding CustomFirmwareBuild, StringFormat='Build: {0}'}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="5" Padding="16" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <Label Text="Selected firmware" FontAttributes="Bold" FontSize="22" />


                            <Label Grid.Row="1" Text="Platform" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFirmware.Platform,FallbackValue='', TargetNullValue=''}" />
                            <Label Grid.Row="1" Text="Platform" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFirmware.Platform,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="2" Text="Firmware board ID" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFirmware.BoardId,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="3" Text="Version" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFirmware.Version,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="4" Text="Channel" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFirmware.Channel,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="5" Text="Vehicle" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding SelectedFirmware.VehicleType,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="6" Text="Manufacturer" />
                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding SelectedFirmware.Manufacturer,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="7" Text="Git SHA" />
                            <Label Grid.Row="7" Grid.Column="1" Text="{Binding SelectedFirmware.GitSha,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="8" Text="Format" />
                            <Label Grid.Row="8" Grid.Column="1" Text="{Binding SelectedFirmware.Format,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="9" Text="Source" />
                            <Label Grid.Row="9" Grid.Column="1" Text="{Binding SelectedFirmware.ArtifactUrl,FallbackValue='', TargetNullValue=''}" LineBreakMode="CharacterWrap" />

                            <Label Grid.Row="10" Text="USB IDs" />
                            <Label Grid.Row="10" Grid.Column="1" Text="{Binding SelectedFirmware.UsbIdentifiers,FallbackValue='', TargetNullValue=''}" />

                            <Label Grid.Row="11" Text="Bootloader aliases" />
                            <Label Grid.Row="11" Grid.Column="1" Text="{Binding SelectedFirmware.BootloaderAliases,FallbackValue='', TargetNullValue=''}" />
                            <VerticalStackLayout Grid.Column="2" Grid.RowSpan="12" VerticalOptions="Center" Spacing="6">
                                <Button Text="Download &amp; Validate" Command="{Binding DownloadAndValidateCommand}" />
                                <Button Text="Install Validated Firmware" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
                                <Button Text="Copy Download URL" Command="{Binding CopyDownloadUrlCommand}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Row="6" IsVisible="{Binding HasPreparedFirmware}" 
                            Padding="12" StyleClass="SurfaceContainer,Rounded,Elevation1">
                        <VerticalStackLayout>
                            <Label Text="Validated package" FontAttributes="Bold" FontSize="22" />

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <Label Grid.Row="0" Text="Package board ID" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding PreparedFirmware.PackageBoardId,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="1" Text="Description" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PreparedFirmware.Package.Description,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="2" Text="Platform summary" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding PreparedFirmware.Package.Summary,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="3" Text="Package version" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding PreparedFirmware.Package.Version,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="4" Text="Package build" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding PreparedFirmware.Package.GitIdentity,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="5" Text="Internal image" />
                                <Label Grid.Row="5" Grid.Column="1" Text="{Binding PreparedFirmware.InternalImageSize,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="6" Text="External image" />
                                <Label Grid.Row="6" Grid.Column="1" Text="{Binding PreparedFirmware.ExternalImageSize,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="7" Text="SHA-256" />
                                <Label Grid.Row="7" Grid.Column="1" Text="{Binding PreparedFirmware.Sha256,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="8" Text="Downloaded bytes" />
                                <Label Grid.Row="8" Grid.Column="1" Text="{Binding PreparedFirmware.ArtifactMetadata.Size,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="9" Text="Downloaded at" />
                                <Label Grid.Row="9" Grid.Column="1" Text="{Binding PreparedFirmware.ArtifactMetadata.DownloadedAt,FallbackValue='', TargetNullValue=''}" />

                                <Label Grid.Row="10" Text="Source" />
                                <Label Grid.Row="10" Grid.Column="1" Text="{Binding PreparedFirmware.ArtifactMetadata.SourceUri,FallbackValue='', TargetNullValue=''}" LineBreakMode="CharacterWrap" />

                                <Label Grid.Row="11" Text="Cache ID" />
                                <Label Grid.Row="11" Grid.Column="1" Text="{Binding PreparedFirmware.CacheIdentity,FallbackValue='', TargetNullValue=''}" LineBreakMode="CharacterWrap" />

                                <Label Grid.Row="12" Text="Cache hit" />
                                <Label Grid.Row="12" Grid.Column="1" Text="{Binding PreparedFirmware.WasCacheHit,FallbackValue='', TargetNullValue=''}" />
                            </Grid>
                            <Grid  MaximumHeightRequest="250">
                            <virtualized:VirtualizedDataGrid 
                                ItemsSource="{Binding PreparedFirmware.Warnings}" 
                                ItemSizingStrategy= "MeasureFirstItem"
                                ShowSearchBar="False"
                                Margin="0,10,0,10"
                                MaximumHeightRequest="250"
                                HorizontalOptions="Fill" 
                                VerticalOptions="Fill" 
                                BackgroundColor="Transparent"
            >
                                <virtualized:VirtualizedDataGrid.EmptyView>
                                    <Label HorizontalOptions="Center" Text="No validation warnings."
                                           FontSize="12" Opacity="0.6" Margin="0,20" />
                                </virtualized:VirtualizedDataGrid.EmptyView>
                                <virtualized:VirtualizedDataGrid.Columns>
                                    <material:DataGridColumn Width="*" Title="VehicleType">
                                        <material:DataGridColumn.CellItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding ., StringFormat='Warning: {0}'}" />
                                            </DataTemplate>
                                        </material:DataGridColumn.CellItemTemplate>
                                    </material:DataGridColumn>
                                </virtualized:VirtualizedDataGrid.Columns>
                            </virtualized:VirtualizedDataGrid>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                    <Label Grid.Row="7" Text="Detected device" FontAttributes="Bold" />
                    <material:SelectField Grid.Row="8" ItemsSource="{Binding DetectedDevices}" SelectedItem="{Binding SelectedDevice}" Title="Select flight controller" />
                    <Label Grid.Row="98" Text="{Binding DeviceStatus}" />
                </Grid>

                <Border IsVisible="{Binding IsUnsupportedMode}" Padding="24" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <Label Text="Direct firmware installation is not available on this platform." />
                </Border>

                <Border IsVisible="{Binding IsOperationInProgress}" Padding="20" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <VerticalStackLayout Spacing="10">
                        <ProgressBar Progress="{Binding OperationProgress.Progress}" IsVisible="{Binding OperationProgress.HasPercentage}" />
                        <Button Text="Cancel" Command="{Binding CancelCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsCatalogRefreshRunning}" HorizontalOptions="Start" />
                <Border Padding="14" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ContextHelp.Title}" FontAttributes="Bold" />
                        <Label Text="{Binding ContextHelp.Content}" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout IsVisible="{Binding HasDiagnosticReport}" Spacing="6">
                    <Label Text="Diagnostic report" FontAttributes="Bold" />
                    <Editor Text="{Binding LastDiagnosticReport}" IsReadOnly="True" AutoSize="TextChanges" />
                    <Button Text="Copy diagnostic report" Command="{Binding CopyDiagnosticReportCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <Button Text="Help &amp; Support" Command="{Binding ToggleHelpCommand}" HorizontalOptions="Start"
                    SemanticProperties.Hint="Show offline firmware selection, installation, DFU, driver, and recovery guidance" />
                <Border IsVisible="{Binding IsHelpVisible}" Padding="20" StyleClass="SurfaceContainer,Rounded,Elevation1">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Firmware Help &amp; Support" FontSize="24" FontAttributes="Bold" />
                        <Label Text="These essential instructions are embedded and remain available offline. External links provide additional official detail." />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupportSections}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:FirmwareSupportSection">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                        <Label Text="{Binding Content}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Official documentation and tools" FontSize="20" FontAttributes="Bold" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupportLinks}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:FirmwareSupportLink">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Grid.Row="1" Text="{Binding Description}" />
                                        <Button Grid.Column="1" Grid.RowSpan="2" Text="Open"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:InstallFirmwareViewModel}}, Path=OpenSupportLinkCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Text="Open Windows Device Manager" Command="{Binding OpenDeviceManagerCommand}"
                            IsVisible="{Binding CanOpenDeviceManager}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>


        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" 
              HorizontalOptions="Fill" VerticalOptions="Fill"
              Padding="12,6"
              BackgroundColor="#2d2d30">

            <Label Grid.Column="0"
               Text="{Binding StatusMessage}"
               VerticalOptions="Center"
               FontSize="12"
               TextColor="LightGray"/>

            <Label Grid.Column="1" Text="Cancellation is deferred until verification and reboot reach a safe boundary. Keep power connected."
                   TextColor="OrangeRed" IsVisible="{Binding IsCancellationDeferred}" />

            <Label Grid.Column="2" Text="{Binding OperationProgress.Stage}" FontSize="20" FontAttributes="Bold" />
            <Label Grid.Column="3" Text="{Binding OperationProgress.TechnicalDetail}" />
            <Label Grid.Column="4" Text="Do not disconnect power while flash memory is being changed." TextColor="OrangeRed" IsVisible="{Binding OperationProgress.IsPowerCritical}" />
        </Grid>

    </Grid>
</navigation:ExtendedContentPage>
