<utilities:UserControlViewBase x:TypeArguments="sections:FailSafeViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FailSafeView"
                               x:DataType="sections:FailSafeViewModel"
                            xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">

            <Border HorizontalAlignment="Center" x:Name="SourceBorder">
                <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
                    <TextBlock Text="Failsafe" Classes="H2" />
                    <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                    <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" 
                                         IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                    <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                         IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                    <TextBlock Text="{Binding Description}" />
                    <ItemsControl ItemsSource="{Binding Guidance}">
                        <ItemsControl.ItemTemplate>
                            <!--x:DataType="x:String"-->
                            <DataTemplate>
                                <TextBlock Text="{Binding .}" Classes="Warning" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Classes="SectionCard" HorizontalAlignment="Center" Width="{Binding #SourceBorder.Bounds.Width}">
                <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Right">
                        <Button ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Refresh">
                            <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                        </Button>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Settings}">
                        <ItemsControl.ItemTemplate>
                            <!--x:DataType="sections:PeripheralSettingViewModel"-->
                            <DataTemplate>
                                <Border Classes="SectionCard" Padding="12" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="220,300,Auto" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  HorizontalContentAlignment="Right"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Value"
                                                  IsVisible="{Binding HasOptions}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberBinding="{Binding Name}" />
                                        <NumericUpDown Grid.Column="1" PlaceholderText="Value" 
                                                       HorizontalContentAlignment="Right"
                                                       IsVisible="{Binding IsNumeric}" 
                                                       Value="{Binding NumericValue, Mode=TwoWay}" FormatString="F1" 
                                                       HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="2" ToolTip.Tip="Apply" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply">
                                            <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>
