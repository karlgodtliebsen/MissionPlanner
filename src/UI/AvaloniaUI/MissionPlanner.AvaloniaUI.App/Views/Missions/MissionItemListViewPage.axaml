<utilities:UserControlViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:missions="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.Missions"
    xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
    x:Class="MissionPlanner.AvaloniaUI.App.Views.Missions.MissionItemListViewPage"
    x:DataType="missions:MissionMapViewModel"
    Padding="25"
    >

    <Border Classes="SurfaceContainer Rounded Elevation1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="6" HorizontalAlignment="Stretch"   VerticalAlignment="Stretch">

            <Button HorizontalAlignment="Right" Margin="0,10,10,10"
                    Content="Close" MinWidth="100" Command="{Binding CloseCommand}">
            </Button>

            <missions:MissionItemListView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="25,10,25,10"
                                          ShowAllRows="True"></missions:MissionItemListView>

        </Grid>
    </Border>
</utilities:UserControlViewBase>
