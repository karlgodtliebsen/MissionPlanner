<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent x:TypeArguments="sections:FrameSetupViewModel"  
                                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                  xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                                  xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                  xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                  x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FrameSetupView"
                                  x:DataType="sections:FrameSetupViewModel" 
                                 >
    <ScrollView VerticalScrollBarVisibility="Always">
        <VerticalStackLayout Padding="16"  Spacing="25" HorizontalOptions="Center">
            <ProgressBar IsVisible="{Binding IsBusy}" Progress="{Binding Progress}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource Error}" />
            <Label Text="Supported frame configuration" FontSize="18" FontAttributes="Bold" />
            <Label Text="{Binding FirmwareFamily, StringFormat='Firmware family: {0}'}" />
            <Label Text="Only values advertised by the connected firmware metadata are shown. Current values remain unchanged until Write and verify is confirmed."
               LineBreakMode="WordWrap" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Settings}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sections:FrameParameterSettingViewModel">
                        <Border Padding="10"  StyleClass="SurfaceContainer,Rounded,Elevation1">
                            <Grid ColumnDefinitions="180,*,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding CurrentDisplay, StringFormat='Current: {0}'}" />
                                <material:SelectField Grid.Column="2"
                                    Title="Pending value"
                                    ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedOption}"
                                    ItemDisplayBinding="{Binding Label}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="3"
                                   Text="{Binding PendingDisplay, StringFormat='Pending: {0}'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label IsVisible="{Binding HasRecommendations}"
               Text="Optional initial recommendations"
               FontSize="18"
               FontAttributes="Bold" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recommendations}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sections:FrameRecommendationViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <material:CheckBox Text="{Binding Description}" LineBreakMode="WordWrap" IsChecked="{Binding IsSelected}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Button Text="Refresh vehicle values" Command="{Binding RefreshCommand}" />
                <Button Text="Write and verify" Command="{Binding ApplyCommand}" />
            </HorizontalStackLayout>
            <Label Text="{Binding StatusMessage}" FontAttributes="Italic" LineBreakMode="WordWrap" />
            <Label IsVisible="{Binding RebootRequired}"
               Text="Vehicle Reboot required. Reconnect, then use Refresh vehicle values to confirm the persisted configuration."
               TextColor="{DynamicResource Warning}"
               FontAttributes="Bold"
               LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</tabViews:TabViewLifecycleContent>
