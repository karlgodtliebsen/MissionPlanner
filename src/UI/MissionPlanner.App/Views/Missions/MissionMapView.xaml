<?xml version="1.0" encoding="utf-8" ?>
<navigation:ExtendedContentView x:TypeArguments="missions:MissionMapViewModel" 
                                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
                                xmlns:missions="clr-namespace:MissionPlanner.App.Views.Missions"
                                xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                                xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                x:Class="MissionPlanner.App.Views.Missions.MissionMapView"
                                x:DataType="missions:MissionMapViewModel"
                                BackgroundColor="#1e1e1e">

    <Grid RowDefinitions="*,Auto">

        <mapsui:MapView x:Name="MissionMap">
            <FlyoutBase.ContextFlyout>
                <MenuFlyout>

                    <MenuFlyoutSubItem Text="Mission Items">
                    <MenuFlyoutItem Text="Delete WP" Command="{Binding DeleteWaypointCommand}" IsEnabled="{Binding HasMissionItems}" />
                    <MenuFlyoutSubItem Text="Insert WP">
                        <MenuFlyoutItem Text="Here" Command="{Binding InsertWaypointCommand}" />
                        <MenuFlyoutItem Text="At Current Position" Command="{Binding InsertWaypointAtVehicleCommand}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="Insert Spline WP" Command="{Binding InsertSplineWaypointCommand}" />

                    <MenuFlyoutSubItem Text="Loiter">
                        <MenuFlyoutItem Text="Forever" Command="{Binding LoiterForeverCommand}" />
                        <MenuFlyoutItem Text="Time" Command="{Binding LoiterTimeCommand}" />
                        <MenuFlyoutItem Text="Circles" Command="{Binding LoiterCirclesCommand}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="Jump">
                        <MenuFlyoutItem Text="Start" Command="{Binding JumpToStartCommand}" />
                        <MenuFlyoutItem Text="WP #" Command="{Binding JumpToWaypointCommand}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutItem Text="RTL" Command="{Binding AddReturnToLaunchCommand}" />
                    <MenuFlyoutItem Text="Land" Command="{Binding AddLandCommand}" />
                    <MenuFlyoutItem Text="Takeoff" Command="{Binding AddTakeoffCommand}" />
                    <MenuFlyoutItem Text="Set ROI Here" Command="{Binding SetRoiHereCommand}" />
                    <MenuFlyoutItem Text="Clear Mission" Command="{Binding ClearMissionCommand}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutSubItem Text="Polygon">
                        <MenuFlyoutItem Text="Draw a Polygon" Command="{Binding DrawPolygonCommand}" />
                        <MenuFlyoutItem Text="Finish Polygon" Command="{Binding FinishPolygonCommand}" />
                        <MenuFlyoutItem Text="Cancel Drawing" Command="{Binding CancelPolygonCommand}" />
                        <MenuFlyoutItem Text="Clear Polygon" Command="{Binding ClearPolygonCommand}" />
                        <MenuFlyoutItem Text="Save Polygon" Command="{Binding SavePolygonCommand}" IsEnabled="{Binding HasPlanningPolygon}" />
                        <MenuFlyoutItem Text="Load Polygon" Command="{Binding LoadPolygonCommand}" />
                        <MenuFlyoutItem Text="From SHP" Command="{Binding PolygonFromShapefileCommand}" />
                        <MenuFlyoutItem Text="From Current Waypoints" Command="{Binding PolygonFromWaypointsCommand}" />
                        <MenuFlyoutItem Text="Offset Polygon" Command="{Binding OffsetPolygonCommand}" IsEnabled="{Binding HasPlanningPolygon}" />
                        <MenuFlyoutItem Text="Area" Command="{Binding ShowPolygonAreaCommand}" IsEnabled="{Binding HasPlanningPolygon}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="Geo-Fence">
                        <MenuFlyoutItem Text="Upload" Command="{Binding UploadFenceCommand}" IsEnabled="{Binding CanUseVehicleCommands}" />
                        <MenuFlyoutItem Text="Download" Command="{Binding DownloadFenceCommand}" IsEnabled="{Binding CanUseVehicleCommands}" />
                        <MenuFlyoutItem Text="Set Return Location" Command="{Binding SetFenceReturnLocationCommand}" />
                        <MenuFlyoutItem Text="Load from File" Command="{Binding LoadFenceCommand}" />
                        <MenuFlyoutItem Text="Save to File" Command="{Binding SaveFenceCommand}" />
                        <MenuFlyoutItem Text="Clear Local or Vehicle…" Command="{Binding ClearFenceCommand}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="Rally Points">
                        <MenuFlyoutItem Text="Set Rally Point" Command="{Binding SetRallyPointCommand}" />
                        <MenuFlyoutItem Text="Download" Command="{Binding DownloadRallyCommand}" IsEnabled="{Binding CanUseVehicleCommands}" />
                        <MenuFlyoutItem Text="Upload" Command="{Binding UploadRallyCommand}" IsEnabled="{Binding CanUseVehicleCommands}" />
                        <MenuFlyoutItem Text="Clear Local or Vehicle…" Command="{Binding ClearRallyCommand}" />
                        <MenuFlyoutItem Text="Save Rally to File" Command="{Binding SaveRallyCommand}" />
                        <MenuFlyoutItem Text="Load Rally from File" Command="{Binding LoadRallyCommand}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="Auto WP / Survey">
                        <MenuFlyoutItem Text="Create WP Circle" Command="{Binding CreateWaypointCircleCommand}" />
                        <MenuFlyoutItem Text="Create Spline Circle" Command="{Binding CreateSplineCircleCommand}" />
                        <MenuFlyoutItem Text="Area" Command="{Binding AutoWaypointAreaCommand}" />
                        <MenuFlyoutItem Text="Text" Command="{Binding AutoWaypointTextCommand}" />
                        <MenuFlyoutItem Text="Create Circle Survey" Command="{Binding CreateCircleSurveyCommand}" />
                        <MenuFlyoutItem Text="Survey (Grid)" Command="{Binding CreateGridSurveyCommand}" IsEnabled="{Binding HasPlanningPolygon}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="Map Tools">
                        <MenuFlyoutItem Text="Zoom In" Clicked="OnZoomInClicked" />
                        <MenuFlyoutItem Text="Zoom Out" Clicked="OnZoomOutClicked" />
                        <MenuFlyoutItem Text="Zoom To Vehicle" Clicked="OnZoomToVehicleClicked" />
                        <MenuFlyoutItem Text="Center on My Location" Clicked="OnCenterOnMyLocationClicked" />
                        <MenuFlyoutItem Text="Follow Vehicle (on/off)" Clicked="OnToggleFollowVehicleClicked" />
                        <MenuFlyoutItem Text="Reverse WPs" Command="{Binding ReverseWaypointsCommand}" IsEnabled="{Binding HasMissionItems}" />
                        <MenuFlyoutItem Text="Measure Distance" Command="{Binding MeasureDistanceCommand}" />
                        <MenuFlyoutItem Text="Rotate Map" Command="{Binding RotateMapCommand}" />
                        <MenuFlyoutItem Text="Prefetch" Command="{Binding PrefetchVisibleCommand}" />
                        <MenuFlyoutItem Text="Prefetch WP Path" Command="{Binding PrefetchWaypointPathCommand}" IsEnabled="{Binding HasMissionItems}" />
                        <MenuFlyoutItem Text="Elevation Graph" Command="{Binding ShowElevationGraphCommand}" IsEnabled="{Binding HasMissionRoute}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="Import / Overlay">
                        <MenuFlyoutItem Text="Load WP File" Command="{Binding LoadWpFileCommand}" />
                        <MenuFlyoutItem Text="Load and Append" Command="{Binding LoadAndAppendCommand}" />
                        <MenuFlyoutItem Text="Save WP File" Command="{Binding SaveWpFileCommand}" />
                        <MenuFlyoutItem Text="Import Mission from KML" Command="{Binding LoadKmlFileCommand}" />
                        <MenuFlyoutItem Text="Import Mission from SHP" Command="{Binding LoadShapefileCommand}" />
                        <MenuFlyoutItem Text="Add KML Overlay" Command="{Binding KmlOverlayCommand}" />
                        <MenuFlyoutItem Text="Clear Imported Overlay" Command="{Binding ClearImportedOverlayCommand}" IsEnabled="{Binding HasImportedOverlay}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="POI">
                        <MenuFlyoutItem Text="Add" Command="{Binding AddPoiCommand}" />
                        <MenuFlyoutItem Text="Delete Nearest" Command="{Binding DeletePoiCommand}" />
                        <MenuFlyoutItem Text="Edit Nearest" Command="{Binding EditPoiCommand}" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSubItem Text="Location">
                    <MenuFlyoutItem Text="Set Tracker Home Here" Command="{Binding SetTrackerHomeCommand}" />
                    <MenuFlyoutItem Text="Modify Altitude" Command="{Binding ModifyAltitudeCommand}" />
                    <MenuFlyoutItem Text="Enter UTM Coordinate" Command="{Binding EnterUtmCoordinateCommand}" />
                    <MenuFlyoutItem Text="Set Home Here" Command="{Binding SetHomeHereCommand}" />
                    </MenuFlyoutSubItem>

                </MenuFlyout>
            </FlyoutBase.ContextFlyout>
        </mapsui:MapView>

        <Border Grid.Row="0" IsVisible="{Binding IsElevationProfileVisible}" HeightRequest="190"
                VerticalOptions="End" Margin="12" Padding="6" BackgroundColor="#E6202024">
            <Grid RowDefinitions="Auto,*">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="Elevation profile — terrain / planned MSL" TextColor="White" />
                    <Button Text="Close" Command="{Binding CloseElevationGraphCommand}" Padding="8,2" />
                </HorizontalStackLayout>
                <missions:MissionElevationProfileView Grid.Row="1" Profile="{Binding ElevationProfile}" />
            </Grid>
        </Border>

        <Button Grid.Row="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="8"
            Padding="8,4"
            MaximumWidthRequest="520"
            FontSize="11"
            Text="{Binding AttributionText}"
            IsVisible="{Binding IsAttributionVisible}"
            BackgroundColor="{AppThemeBinding Light=#DFFFFFFF, Dark=#D9222222}"
            TextColor="{AppThemeBinding Light=#202020, Dark=#F5F5F5}"
            Clicked="OnAttributionClicked"
            SemanticProperties.Hint="Map attribution. Activate to toggle expanded details." />

        <!-- Bottom status bar (mirrors Controls.Status) -->
        <HorizontalStackLayout Grid.Row="1"  VerticalOptions="Center" HorizontalOptions="Start" Spacing="10"
                                Margin="10,5,0,5" >

            <material:SelectField 
            ItemsSource="{Binding MapStyles}"
            SelectedItem="{Binding SelectedMapStyle}" />

            <Label 
                Text="{Binding VehicleDisplayName}"
                VerticalOptions="Center" />
            <Label Text="•" FontSize="16"  VerticalOptions="Center"/>

            <Label 
            Text="{Binding ConnectionStatus}"
            VerticalOptions="Center" />

            <Label Text="•" FontSize="16"  VerticalOptions="Center"/>
            <Label
                Text="{Binding TelemetryFreshness}"
                VerticalOptions="Center" />

            <Label Text="•" FontSize="16"  VerticalOptions="Center"/>
            <Label
                Text="{Binding MapFreshness}"
                VerticalOptions="Center" />
            <Label Text="•" FontSize="16"  VerticalOptions="Center"/>

            <Label
                Text="{Binding PointerCoordinateText}"
                VerticalOptions="Center" />
            <Label
                IsVisible="{Binding HasAltitueMessage}"
            Text="{Binding PointerAltitude, StringFormat='Alt: {0:F1} m'}"
            VerticalOptions="Center" />
            <Label
                IsVisible="{Binding HasPointerAltitudeStatus}"
                Text="{Binding PointerAltitudeStatusText}"
                VerticalOptions="Center" />

            <Label Text="•" FontSize="16"  VerticalOptions="Center" IsVisible="{Binding HasStatusMessage}"/>

            <Label
                IsVisible="{Binding HasStatusMessage}"
                Text="{Binding StatusMessage}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Grid>


</navigation:ExtendedContentView>
