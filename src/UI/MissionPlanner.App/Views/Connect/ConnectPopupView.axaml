<utilities:UserControlViewBase x:TypeArguments="connect:ConnectPopupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:connect="clr-namespace:MissionPlanner.App.Views.Connect"
                               xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.Connect.ConnectPopupView"
                               x:DataType="connect:ConnectPopupViewModel"
                               Width="400" Height="400"
                               Margin="50"

                               >


    <Border Classes="SectionCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Padding="25">
        <Grid RowDefinitions="Auto,*,Auto"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowSpacing="25">
            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" Classes="H3" />

            <StackPanel Grid.Row="1" Orientation="Vertical"  Spacing="25"  HorizontalAlignment="Center"  VerticalAlignment="Center"
                        IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertedBoolConverter}}"
                        IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}"

                        >
                <Grid  ColumnDefinitions="150,150" HorizontalAlignment="Stretch">
                    <Label Content="Channel" HorizontalAlignment="Stretch"
                           FontSize="16" FontWeight="Bold" />

                    <ComboBox Grid.Column="1" 
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right"
                              ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding SelectedChannel}"
                              DisplayMemberBinding="{Binding .}"
                              />
                </Grid >
                <Grid  ColumnDefinitions="150,150" HorizontalAlignment="Stretch" IsVisible="{Binding ShowSelectedHost, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Content="Baud rate" HorizontalAlignment="Stretch"
                           FontSize="16" FontWeight="Bold" />

                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right"
                              ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaudRate}"
                              DisplayMemberBinding="{Binding .}"
                              />
                </Grid >
                <Grid  ColumnDefinitions="150,150" HorizontalAlignment="Stretch" >

                    <Label Content="Host" IsVisible="{Binding ShowSelectedHost}"
                           FontSize="16" HorizontalAlignment="Stretch" FontWeight="Bold" />
                    <u:IPv4Box Grid.Column="1" Width="150" IsVisible="{Binding ShowSelectedHost}"  IPAddress="{Binding Address}" />

                </Grid >
                <Grid  ColumnDefinitions="150,150" HorizontalAlignment="Stretch" >
                    <Label Content="Port" IsVisible="{Binding ShowSelectedHost}"
                           FontSize="16" HorizontalAlignment="Stretch" FontWeight="Bold">

                    </Label>

                    <NumericUpDown Grid.Column="1" Width="150" PlaceholderText="Port" 
                                   AllowSpin="False"
                                   ShowButtonSpinner="False" IsVisible="{Binding ShowSelectedHost}"
                                   Value="{Binding SelectedIntPort, Mode=TwoWay}" FormatString="F0" 
                                   VerticalAlignment="Center"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
                </Grid >
                <Label Content="{Binding StatusMessage}" 
                       Margin="0,10,0,0"
                       FontSize="16" HorizontalAlignment="Center"  />
            </StackPanel>

            <StackPanel  Grid.Row="1" Orientation="Vertical"
                         Spacing="50" Margin="0" IsVisible="{Binding IsConnected}"
                         VerticalAlignment="Center" HorizontalAlignment="Stretch"
                         >
                <Label Content="{Binding StatusMessage}" FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"  />
            </StackPanel>

            <StackPanel Grid.Row="2"  Orientation="Horizontal" Spacing="10"  HorizontalAlignment="Center"
                        IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertedBoolConverter}}"
                        IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}">

                <Button
                    Width="100"
                    ToolTip.Tip="Refresh"
                    Classes="Secondary"
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" >
                    <avalonia:MaterialIcon Kind="Refresh" Width="30" Height="30" />
                </Button>

                <Button
                    Width="100"
                    ToolTip.Tip="Connect"
                    Classes="Primary"
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Command="{Binding ConnectCommand}" >
                    <Image Source="{Binding ConnectionImage}"
                           Width="30"
                           Height="30"
                           Stretch="Uniform"/>
                </Button>

                <Button
                    Width="100"
                    Classes="Primary"
                    ToolTip.Tip="Close"
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Command="{Binding OKCommand}"
                    >
                    <avalonia:MaterialIcon Kind="Check" Width="30" Height="30" />
                </Button>

            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"  HorizontalAlignment="Center"  IsVisible="{Binding IsConnected}">

                <Button
                    Classes="Primary"
                    ToolTip.Tip="Disconnect"
                    Width="100"
                    Padding="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Command="{Binding ConnectCommand}" >
                    <Image Source="{Binding ConnectionImage}"
                           Width="30"
                           Height="30"
                           Stretch="Uniform"/>
                </Button>

                <Button
                    Width="100"
                    ToolTip.Tip="Close"
                    Classes="Primary"
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Command="{Binding OKCommand}"
                    >
                    <avalonia:MaterialIcon Kind="Check" Width="30" Height="30" />
                </Button>
            </StackPanel>

        </Grid>
    </Border>

</utilities:UserControlViewBase>
        