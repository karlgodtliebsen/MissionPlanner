<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compile-time merging gives every static control alias this palette scope. -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="../../Tokens/Base/Light.axaml" />
        <MergeResourceInclude Source="../../Tokens/Accent.axaml" />
        <MergeResourceInclude Source="../../Themes/Light/_index.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <StaticResource x:Key="PaletteNormalColor" ResourceKey="SemiLime8Color" />
    <StaticResource x:Key="PaletteHoverColor" ResourceKey="SemiLime9Color" />
    <StaticResource x:Key="PalettePressedColor" ResourceKey="SemiLime6Color" />
    <StaticResource x:Key="PaletteDisabledColor" ResourceKey="SemiLime2Color" />
    <StaticResource x:Key="PaletteSubtleColor" ResourceKey="SemiLime0Color" />
    <StaticResource x:Key="PaletteSubtleHoverColor" ResourceKey="SemiLime1Color" />
    <StaticResource x:Key="PaletteSubtlePressedColor" ResourceKey="SemiLime1Color" />
    <StaticResource x:Key="PaletteTextColor" ResourceKey="SemiLime8Color" />
    <Color x:Key="PaletteOnAccentColor">#FFFFFF</Color>
    <Color x:Key="PaletteOnAccentHoverColor">#FFFFFF</Color>
    <Color x:Key="PaletteOnAccentPressedColor">#16161A</Color>
    <Color x:Key="PaletteSelectionTextColor">#16161A</Color>
</ResourceDictionary>
