<?xml version="1.0" encoding="utf-8" ?>
<navigation:ContentPageView x:TypeArguments="mandatoryHardware:MandatoryHardwareViewModel"
                            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                            xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                            xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                            xmlns:mandatoryHardware="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware"
                            xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                            xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                            xmlns:tabsUtils="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.TabsUtils"
                            x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.MandatoryHardwareView"
                            x:DataType="mandatoryHardware:MandatoryHardwareViewModel"
                            Title="Initial Setup">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="Initial Setup" FontSize="26" FontAttributes="Bold" />
            <Label Text="{Binding VehicleHeading}" FontSize="16" />
            <Label Text="{Binding SummaryReport}" Opacity="0.75" />
            <Label Text="{Binding Error}" TextColor="Red" />
        </VerticalStackLayout>

        <Button Grid.Row="1" Text="Re-evaluate vehicle" Command="{Binding RefreshCommand}" HorizontalOptions="Start" />
                                  <!--
                                    HeaderItemsSource="{Binding Workflows}"
                                   SelectedHeaderItem="{Binding SelectedWorkflow, Mode=TwoWay}"-->

        <tabViews:ExtendedTabView Grid.Row="2"
                                  HeaderItemsSource="{Binding Workflows}"
                                  TabHeaderItemColumnWidth="290"
                                  CachingStrategy="CacheOnLayout"
                                  UseAnimation="False">
            <material:TabView.TabHeaderItemTemplate>
                <DataTemplate>
                    <tabsUtils:TabHeaderView />
                </DataTemplate>
            </material:TabView.TabHeaderItemTemplate>
            <material:TabItem Title="Firmware"><sections:FirmwareSetupView /></material:TabItem>
            <material:TabItem Title="Frame"><sections:FrameSetupView /></material:TabItem>
            <material:TabItem Title="Accelerometer"><sections:AccelerometerSetupView /></material:TabItem>
            <material:TabItem Title="Compass"><sections:CompassSetupView /></material:TabItem>
            <material:TabItem Title="Radio"><sections:RadioSetupView /></material:TabItem>
            <material:TabItem Title="Flight Modes"><sections:FlightModesSetupView /></material:TabItem>
            <material:TabItem Title="Battery"><sections:BatterySetupView /></material:TabItem>
            <material:TabItem Title="ESC / Motors"><sections:EscMotorSetupView /></material:TabItem>
            <material:TabItem Title="Servo Output"><sections:ServoOutputSetupView /></material:TabItem>
            <material:TabItem Title="Optional Hardware"><sections:OptionalHardwareSetupView /></material:TabItem>
            <material:TabItem Title="Safety"><sections:SafetySetupView /></material:TabItem>
            <material:TabItem Title="Summary"><sections:SetupSummaryView /></material:TabItem>
        </tabViews:ExtendedTabView>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <HorizontalStackLayout Spacing="10">
                <Button Text="Record reviewed"
                        IsEnabled="{Binding SelectedWorkflow.CanOpen}"
                        IsVisible="{Binding CanRecordSelectedWorkflowManually}"
                        Command="{Binding MarkCompleteCommand}" />
                <Button Text="Open related Config page"
                        IsVisible="{Binding HasConfigDestination}"
                        Command="{Binding OpenConfigCommand}" />
            </HorizontalStackLayout>
            <Label Text="Completion is stored locally and automatically requires review when firmware or parameters change. Prerequisites are guidance, not a rigid wizard."
                   LineBreakMode="WordWrap" Opacity="0.7" />
        </VerticalStackLayout>
    </Grid>
</navigation:ContentPageView>
