<utilities:UserControlViewBase x:TypeArguments="sections:EscMotorSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.Themes.Controls;assembly=MissionPlanner.Themes"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:appSetup="clr-namespace:MissionPlanner.App.Views.Common"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:u="https://irihi.tech/ursa"
                               xmlns:optional="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.EscMotorSetupView"
                               x:DataType="sections:EscMotorSetupViewModel">

    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner Grid.Row="0" ShowIcon="False"  Classes="Bordered" Header="ESC calibration" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"  Theme="{DynamicResource ProgressRing}" />
                <TextBlock Text="Remove ALL propellers before any actuator test. Motors will spin." Classes="Warning" FontWeight="Bold" />
                <TextBlock Text="{Binding EscExplanation}" />
                <ItemsControl IsVisible="{Binding EscCalibrationApplicable}" ItemsSource="{Binding EscSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">

                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshSetupCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                        </WrapPanel>
                    </Border>
                    <appSetup:SetupInformationView Grid.Row="1" Topic="EscMotor" WorkflowStatus="{Binding StatusMessage}" WorkflowError="{Binding ErrorMessage}" />
                </Grid>
            </TabItem>

            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12"  HorizontalAlignment="Stretch">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshSetupCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Open Motor Test" Click="OpenMotorTest" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Open Motor Test">
                                <mdi:MaterialIcon Kind="Fan" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="1" Margin="16" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                        <Border Classes="SectionCard" Padding="12" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="15">
                                <TextBlock Text="ESC calibration preparation" Classes="H3" />
                                <TextBlock Text="For reported analog Copter outputs only. Remove all propellers. Preparation schedules calibration on the next power cycle; it does not reboot or calibrate automatically here." TextWrapping="Wrap" />
                                <WrapPanel ItemSpacing="8">
                                    <Button Command="{Binding PrepareEscCalibrationCommand}" ToolTip.Tip="Prepare calibration for next power cycle" AutomationProperties.Name="Prepare ESC calibration">
                                        <mdi:MaterialIcon Kind="CogOutline" Classes="ActionIcon" />
                                    </Button>
                                    <Button Command="{Binding ClearEscCalibrationCommand}" ToolTip.Tip="Clear pending ESC calibration" AutomationProperties.Name="Restore normal ESC startup">
                                        <mdi:MaterialIcon Kind="Undo" Classes="ActionIcon" />
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger" />
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="optional:ParameterSettingViewModel">
                                            <optional:ParameterSettingEditor />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,10" Text="Operation log:" Classes="H3" />
                                <Border MinHeight="100">
                                    <ItemsControl ItemsSource="{Binding Log}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding .}" FontSize="12" Opacity="0.8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
