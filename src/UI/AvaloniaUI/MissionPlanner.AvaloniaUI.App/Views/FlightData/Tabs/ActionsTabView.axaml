<tabs:TabItemViewBase x:TypeArguments="tabs:ActionsTabViewModel"
                            xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                            x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.ActionsTabItemView"
                            x:DataType="tabs:ActionsTabViewModel">
    <ScrollViewer>
        <StackPanel Margin="12" Spacing="8">
            <TextBlock Text="Vehicle Actions" FontSize="18" FontWeight="Bold"/>
            <Border Padding="8">
                <TextBlock Text="{Binding DataSourceMode}" FontWeight="Bold"/>
            </Border><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Content="Arm" Command="{Binding ArmCommand}" IsEnabled="{Binding CanArm}"/>
                <Button Grid.Column="1" Content="Disarm" Command="{Binding DisarmCommand}" IsEnabled="{Binding CanDisarm}"/>
                <Button Grid.Row="1" Content="RTL" Command="{Binding ReturnToLaunchCommand}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="Loiter / Hold" Command="{Binding HoldCommand}"/>
                <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Land" Command="{Binding LandCommand}"/>
            </Grid><TextBlock Text="Flight mode" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberBinding="{Binding Name}"/><Button Grid.Column="1" Content="Set Mode" Command="{Binding SetModeCommand}"/>
            </Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <NumericUpDown Value="{Binding TakeoffAltitudeMeters}" Increment="1"/>
                <Button Grid.Column="1" Content="Takeoff" Command="{Binding TakeoffCommand}"/>
            </Grid><Button Content="Set Home Here" Command="{Binding SetHomeHereCommand}"/>
            <Button Content="Reboot Autopilot" Command="{Binding RebootCommand}"/>
            <TextBlock Text="{Binding OperationState.Message}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</tabs:TabItemViewBase>
