<view:UserControlViewBase x:TypeArguments="local:FirmwareCatalogViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
                          xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                          xmlns:view="clr-namespace:MissionPlanner.App.Utilities"
                          xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                          xmlns:subViews="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware.SubViews"
                          mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                          x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.FirmwareCatalogueView"
                          x:DataType="local:FirmwareCatalogViewModel" Margin="25,0,25,0">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*"
          IsEnabled="{Binding !InstallationRunning}" RowSpacing="25">

        <subViews:DetectedDeviceView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                     IsVisible="{Binding IsDetectedDeviceVisible,
                                     RelativeSource={RelativeSource AncestorType=local:FirmwareCatalogueView}}"
                                     DataContext="{Binding Devices}" />

        <subViews:FirmwareCatalogueSelectorView  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  />
        <subViews:SelectedFirmwareView Grid.Row="2" Grid.Column="0" DataContext="{Binding Selected}"
                                       IsEnabled="{Binding HasSelectedFirmware}" />
        <subViews:ValidatedPackageView Grid.Row="2" Grid.Column="1" DataContext="{Binding Validated}" />

        <subViews:DetectedDeviceView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                     IsVisible="{Binding IsDetectedDeviceVisible,
                                     RelativeSource={RelativeSource AncestorType=local:FirmwareCatalogueView}}"
                                     DataContext="{Binding Devices}" />

    </Grid>
</view:UserControlViewBase>
