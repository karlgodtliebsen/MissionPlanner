<utilities:NavigationViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.Logs"
    xmlns:analysis="clr-namespace:MissionPlanner.App.Views.Analysis"
    xmlns:u="https://irihi.tech/ursa"
    x:TypeArguments="local:LogsViewModel"
    x:Class="MissionPlanner.App.Views.Logs.LogsView"
    x:DataType="local:LogsViewModel"
    x:CompileBindings="True">
    <ContentPage Header="Logs">
        <Grid Margin="16" RowDefinitions="Auto,*" HorizontalAlignment="Stretch">
            <u:Banner  Classes="Bordered" Header="Logs" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                </StackPanel>
            </u:Banner>
            <TabControl Grid.Row="1" TabStripPlacement="Left">
                <TabItem Header="Telemetry Logs">
                    <local:TelemetryLogsTabItemView></local:TelemetryLogsTabItemView>
                </TabItem>
                <TabItem Header="Application Logs">
                    <local:ApplicationLogsView></local:ApplicationLogsView>
                </TabItem>
                <TabItem Header="FFT / Vibration">
                    <analysis:FftAnalysisView />
                </TabItem>
            </TabControl>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
