{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ApplicationInformation": {
    "AppName": "MissionPlanner Application"
  },

  "ApplicationSettings": {
    "Channels": [
      "AUTO",
      "TCP",
      "UDP",
      "UDPCI",
      "WS"
    ],
    "BaudRates": [
      "4800",
      "9600",
      "19200",
      "38400",
      "57600",
      "115200",
      "230400",
      "460800",
      "921600"
    ],
    "Channel": "AUTO",
    "BaudRate": "115200",
    "Port": "14550",
    "Host": "127.0.0.1"

  },
  "TransportEndpoint": {
    "protocol": "udp",
    "remotePort": 14551,
    "remoteHost": "127.0.0.1",
    "localPort": 14550,
    "localHost": "0.0.0.0",
    "receiveBufferSize": 512
  },
  "Firmware": {
    "ManifestUrl": null,
    "Releases": []
  },

  "Simulation": {
    "HeartbeatTimeoutSeconds": 20,
    "StopTimeoutSeconds": 10,
    "RecentOutputCapacity": 500
  },

  "SimulationControls": {
    "DiscoveryWaitMilliseconds": 500,
    "ReadbackTimeoutSeconds": 3,
    "EventCapacity": 500
  },
  "SimulationScenarios": {
    "PollIntervalMilliseconds": 100,
    "MaximumDocumentBytes": 1048576,
    "MaximumSteps": 1000
  },

  "Sitl": {
    "ManifestUrl": null,
    "Releases": [],
    "ExternalInstallations": []
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/MissionPlanner.NextGen.Application..log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({ThreadId}) {Message:lj}{NewLine}{Exception}",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
    "Properties": {
      "Application": "MissionPlanner NextGen Application"
    }
  }
}
