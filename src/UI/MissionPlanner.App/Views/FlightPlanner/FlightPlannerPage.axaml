<utilities:NavigationViewBase
    x:TypeArguments="flightPlanner:FlightPlannerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:flightPlanner="clr-namespace:MissionPlanner.App.Views.FlightPlanner"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d"
    d:DesignWidth="1200"
    d:DesignHeight="720"
    x:Class="MissionPlanner.App.Views.FlightPlanner.FlightPlannerPage"
    x:DataType="flightPlanner:FlightPlannerViewModel">
    <ContentPage Header="Flight Planner">
        <Grid ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource Surface}">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto"  RowSpacing="4" Margin="5">
               
                <WrapPanel Grid.Row="0" Grid.Column="0" Margin="10,5,0,5" HorizontalAlignment="Center" ItemSpacing="5">
                    <Button ToolTip.Tip="Load File" Padding="8,2" Command="{Binding Map.LoadWpFileCommand}" >
                        <avalonia:MaterialIcon Kind="FolderOpenOutline" Width="30" Height="30" />
                    </Button>
                    <Button ToolTip.Tip="Save File" Padding="8,2" Command="{Binding Map.SaveWpFileCommand}" >
                        <avalonia:MaterialIcon Kind="ContentSaveEditOutline" Width="30" Height="30" />
                    </Button>

                    <Button
                        ToolTip.Tip="Clear Mission"
                        Padding="8,2"
                        Command="{Binding Map.ClearMissionCommand}" >
                        <avalonia:MaterialIcon Kind="ClearCircleOutline" Width="30" Height="30" />
                    </Button>

                    <Button  ToolTip.Tip="Apply" Command="{Binding Map.ApplyRowEditsCommand}" >
                        <avalonia:MaterialIcon Kind="PlusBoxMultipleOutline" Width="30" Height="30" />
                    </Button>
                    <Button  ToolTip.Tip="Revert" Command="{Binding Map.CancelRowEditsCommand}" >
                        <avalonia:MaterialIcon Kind="FileUndoOutline" Width="30" Height="30" />
                    </Button>
                    <Button  ToolTip.Tip="Read" Command="{Binding ReadFromVehicleCommand}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                             >
                        <avalonia:MaterialIcon Kind="ReadMoreOutline" Width="30" Height="30" />
                    </Button>

                    <Button  ToolTip.Tip="Write" Command="{Binding WriteToVehicleCommand}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                             >
                        <avalonia:MaterialIcon Kind="ContentSaveOutline" Width="30" Height="30" />
                    </Button>

                    <Button  ToolTip.Tip="Write Fast" Command="{Binding WriteToVehicleFastCommand}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" 
                    >
                        <avalonia:MaterialIcon Kind="ContentSaveAddOutline" Width="30" Height="30" />
                    </Button>
                
                    <Button  ToolTip.Tip="Edit" Command="{Binding EditCommand}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" 
                    >
                        <avalonia:MaterialIcon Kind="EditOutline" Width="30" Height="30" />
                    </Button>
                    <TextBlock Text="Map:" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <ComboBox Width="170" ItemsSource="{Binding Map.AvailableSourceIds}"
                              SelectedItem="{Binding Map.SelectedSourceId, Mode=TwoWay}" Margin="0,0,8,4" />
                    <TextBlock Text="Default Altitude (m):" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <NumericUpDown Width="80" Value="{Binding Map.DefaultAltitudeMeters, Mode=TwoWay}"
                                   FormatString="F1" HorizontalContentAlignment="Right" Margin="0,0,8,4" />
                    <CheckBox Content="Click map to add WP" IsChecked="{Binding Map.AddWaypointOnMapClick, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBlock Text="{Binding TransferStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,4,4" />
                   

                </WrapPanel>
                <WrapPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                    <Button ToolTip.Tip="Use Quick Editor" Command="{Binding QuickEditCommand}" HorizontalAlignment="Right">
                        <avalonia:MaterialIcon Kind="EditCircleOutline" Width="30" Height="30" />
                    </Button>
                </WrapPanel>

                <flightPlanner:FlightPlannerMissionMapView x:Name="MapView" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                
                <ProgressBar x:Name="MapLoadingIndicator" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Width="160" IsIndeterminate="True" Theme="{DynamicResource ProgressRing}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
