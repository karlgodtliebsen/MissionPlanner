<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.ConnectionAndVehicleBehaviorTabView"
             x:DataType="preferences:PreferencesViewModel">

    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="500" MinHeight="400">
                <StackPanel  Orientation="Vertical" Spacing="8"  Grid.ColumnSpan="2" 
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid ColumnDefinitions="250,150" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10"  ColumnSpacing="15">
                        <TextBlock Text="Reset flight controller on USB connect (toggle DTR)" />
                        <ToggleSwitch Grid.Column="1" 
                                      MinWidth="140"
                                      HorizontalAlignment="Right"
                                      HorizontalContentAlignment="Right"
                                      IsChecked="{Binding ResetOnUsbConnect}" />
                        <TextBlock Grid.Row="1" Text="Disable RTS reset for ESP32 Serial/JTAG" />
                        <ToggleSwitch Grid.Row="1" Grid.Column="1" 
                                      MinWidth="140"
                                      HorizontalAlignment="Right"
                                      HorizontalContentAlignment="Right"
                                      IsChecked="{Binding DisableEsp32RtsReset}" />
                       
                        <TextBlock Grid.Row="2" Text="Load waypoints on connect" />
                        <ToggleSwitch Grid.Row="2" Grid.Column="1" 
                                      MinWidth="140"
                                      HorizontalAlignment="Right"
                                      HorizontalContentAlignment="Right"
                                      IsChecked="{Binding LoadWaypointsOnConnect}" />
                       
                        <TextBlock Grid.Row="3" Text="Download parameters in background" />
                        <ToggleSwitch Grid.Row="3" Grid.Column="1" 
                                      MinWidth="140"
                                      HorizontalAlignment="Right"
                                      HorizontalContentAlignment="Right"
                                      IsChecked="{Binding DownloadParametersInBackground}" />
                       
                        <TextBlock Grid.Row="4" Text="No RC receiver" />
                        <ToggleSwitch Grid.Row="4" Grid.Column="1" 
                                      MinWidth="140"
                                      HorizontalAlignment="Right"
                                      HorizontalContentAlignment="Right"
                                      IsChecked="{Binding NoRcReceiver}" />
                      
                        <TextBlock Grid.Row="5" Text="Slow computer mode" />
                        <ToggleSwitch Grid.Row="5" Grid.Column="1" 
                                      MinWidth="140"
                                      HorizontalAlignment="Right"
                                      HorizontalContentAlignment="Right"
                                      IsChecked="{Binding SlowComputerMode}" />
                      
                        <TextBlock Grid.Row="6" Text="GCS system ID (0–255)" />
                        <NumericUpDown
                            Grid.Row="6" Grid.Column="1"
                            Value="{Binding GcsSystemId, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}"
                            FormatString="F0"
                            MinWidth="140"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Right"
                            />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
