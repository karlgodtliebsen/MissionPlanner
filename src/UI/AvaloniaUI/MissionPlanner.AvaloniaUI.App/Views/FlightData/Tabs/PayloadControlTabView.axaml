<utilities:TabItemViewBase x:TypeArguments="tabs:PayloadControlTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.PayloadControlTabItemView"
                           x:DataType="tabs:PayloadControlTabViewModel">
    <ScrollViewer><StackPanel Margin="12" Spacing="8">
        <TextBlock Text="Payload control" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        <ComboBox ItemsSource="{Binding Payloads}" SelectedItem="{Binding SelectedPayload}"/>
        <Button Content="Capture image" Command="{Binding CaptureCommand}"/>
        <Button Content="Start video" Command="{Binding StartVideoCommand}"/>
        <Button Content="Stop video" Command="{Binding StopVideoCommand}"/>
        <NumericUpDown Value="{Binding Pitch}"/>
        <NumericUpDown Value="{Binding Yaw}"/>
        <CheckBox Content="Earth-frame yaw lock" IsChecked="{Binding YawLock}"/>
        <Button Content="Move gimbal" Command="{Binding MoveGimbalCommand}"/>
    </StackPanel></ScrollViewer>
</utilities:TabItemViewBase>
