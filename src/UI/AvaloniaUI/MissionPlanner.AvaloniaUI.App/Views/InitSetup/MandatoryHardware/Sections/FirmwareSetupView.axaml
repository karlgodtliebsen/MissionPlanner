<utilities:UserControlViewBase x:TypeArguments="sections:FirmwareSetupViewModel" xmlns="https://github.com/avaloniaui" xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.MandatoryHardware.Sections" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material" xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui" x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.MandatoryHardware.Sections.FirmwareSetupView" x:DataType="sections:FirmwareSetupViewModel">
<ScrollViewer VerticalScrollBarVisibility="Visible">
<StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
<TextBlock Text="Connected identity" FontSize="18" FontWeight="Bold" />
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
<TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
<TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
<Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
<TextBlock Text="Vehicle" FontWeight="Bold" />
<TextBlock Grid.Column="1" Text="{Binding VehicleLabel}" />
<TextBlock Grid.Row="1" Text="Firmware" FontWeight="Bold" />
<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirmwareVersion}" />
<TextBlock Grid.Row="2" Text="Release type / Git" FontWeight="Bold" />
<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReleaseType, StringFormat='{}{0}'}" />
<TextBlock Grid.Row="3" Text="Git hash" FontWeight="Bold" />
<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GitHash}" />
<TextBlock Grid.Row="4" Text="Board version" FontWeight="Bold" />
<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BoardVersion}" />
<TextBlock Grid.Row="5" Text="Vendor / product" FontWeight="Bold" />
<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VendorProduct}" />
<TextBlock Grid.Row="6" Text="UID / UID2" FontWeight="Bold" />
<StackPanel Orientation="Vertical" Grid.Row="6" Grid.Column="1">
<TextBlock Text="{Binding HardwareUid}" />
<TextBlock Text="{Binding HardwareUid2}" />
</StackPanel>
<TextBlock Grid.Row="7" Text="MAVLink version" FontWeight="Bold" />
<TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MavLinkVersion}" />
<TextBlock Grid.Row="8" Text="Capabilities" FontWeight="Bold" />
<TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Capabilities}" />
</Grid>
<TextBlock Text="Firmware discovery" FontSize="18" FontWeight="Bold" />
<StackPanel Orientation="Horizontal" Spacing="10">
<ComboBox ToolTip.Tip="Channel" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" />
<Button Content="Discover compatible releases" Command="{Binding DiscoverCommand}" />
</StackPanel>
<ComboBox ToolTip.Tip="Compatible release (exact board IDs)" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" DisplayMemberBinding="{Binding Version}" />
<TextBlock Text="{Binding SelectedBoardTarget, StringFormat='Technical board target: {0}'}" FontWeight="Bold" />
<TextBlock Text="{Binding SelectedReleaseNotes}" />
<StackPanel Orientation="Horizontal" Spacing="10">
<Button Content="Download and verify" Command="{Binding DownloadCommand}" />
<Button Content="Flash verified package" Command="{Binding FlashCommand}" />
</StackPanel>
<!-- TODO: Restore the firmware operation status line when FirmwareSetupViewModel exposes the source Status property. -->
<TextBlock Text="{Binding FlashingAvailability}" />
<TextBlock Text="After flashing: reconnect, confirm the reported firmware identity, then restore only reviewed parameters from your backup." FontWeight="Bold" />
</StackPanel>
</ScrollViewer>
</utilities:UserControlViewBase>