<view:UserControlViewBase x:TypeArguments="subViews:FirmwareHelpViewModel"
                          xmlns:view="clr-namespace:MissionPlanner.App.Utilities"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
                          xmlns:subViews="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware.SubViews"
                          xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                          mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                          x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.HelpView"
                          x:DataType="subViews:FirmwareHelpViewModel"
                          Margin="25,0,25,0"
                          >
    <Border Padding="20" Classes="SectionCard">
        <StackPanel Orientation="Vertical" Spacing="25">
            <TextBlock Text="Firmware Help &amp; Support" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="These essential instructions are embedded and remain available offline. External links provide additional official detail." />

            <ItemsControl ItemsSource="{Binding SupportSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="subViews:FirmwareSupportSection">
                        <StackPanel Orientation="Vertical" Spacing="4" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding Content}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Official documentation and tools" FontSize="18" FontWeight="Bold" />

            <ItemsControl ItemsSource="{Binding SupportLinks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="subViews:FirmwareSupportLink">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"  RowSpacing="25">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Text="{Binding Description}" />

                            <Button
                                Grid.Column="1" Grid.RowSpan="2"
                                ToolTip.Tip="Open"
                                Command="{Binding $parent[ItemsControl].((subViews:FirmwareHelpViewModel)DataContext).OpenSupportLinkCommand}"
                                CommandParameter="{Binding .}"
                                Padding="8,2"
                                VerticalAlignment="Center" >
                                <avalonia:MaterialIcon Kind="OpenInBrowser" Width="30" Height="30" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                ToolTip.Tip="Open Windows Device Manager"
                Command="{Binding OpenDeviceManagerCommand}"
                IsVisible="{Binding CanOpenDeviceManager}" 
                Padding="8,2"
                VerticalAlignment="Center"  HorizontalAlignment="Left"> 
                <avalonia:MaterialIcon Kind="OpenInNew" Width="30" Height="30" />
            </Button>

        </StackPanel>
    </Border>

</view:UserControlViewBase>
