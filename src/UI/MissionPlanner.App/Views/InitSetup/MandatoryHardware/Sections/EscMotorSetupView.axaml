<utilities:UserControlViewBase x:TypeArguments="sections:EscMotorSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.EscMotorSetupView"
                               x:DataType="sections:EscMotorSetupViewModel">

    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Padding="12"  >
            <StackPanel Spacing="10">
                <TextBlock Text="ESC calibration and motor test" Classes="H2" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"  Theme="{DynamicResource ProgressRing}" />
                 <TextBlock Text="Remove ALL propellers before any actuator test. Motors will spin." Classes="Warning" FontWeight="Bold" />
                <TextBlock Text="{Binding EscExplanation}" />
                <ItemsControl IsVisible="{Binding EscCalibrationApplicable}" ItemsSource="{Binding EscSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Full Parameters" AutomationProperties.Name="Open Full Parameters">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <controls:SetupInformationView Topic="EscMotor" WorkflowStatus="{Binding StatusMessage}" WorkflowError="{Binding ErrorMessage}" />
                </Grid>
            </TabItem>

            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0" Padding="12"  HorizontalAlignment="Stretch">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Full Parameters" AutomationProperties.Name="Open Full Parameters">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Test motor" Command="{Binding TestMotorCommand}" AutomationProperties.Name="Test motor">
                                <mdi:MaterialIcon Kind="Fan" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Test sequence" Command="{Binding TestSequenceCommand}" AutomationProperties.Name="Test sequence">
                                <mdi:MaterialIcon Kind="PlaylistPlay" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Foreground="{DynamicResource Warning}" FontWeight="Bold" ToolTip.Tip="STOP" Command="{Binding StopCommand}" AutomationProperties.Name="STOP">
                                <mdi:MaterialIcon Kind="Stop" Classes="ActionIcon"  />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="SectionCard" Padding="12" HorizontalAlignment="Stretch" >
                        <StackPanel Spacing="15">
                            <TextBlock Text="Motor test" Classes="H3" />

                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="200,Auto" HorizontalAlignment="Center" RowSpacing="15">
                                <TextBlock Grid.Column="0" Text="Motor / count" Classes="H4" />
                                <NumericUpDown Grid.Column="1" Grid.Row="0" Margin="10,0" PlaceholderText="Motor / count" Value="{Binding MotorIndex, Mode=TwoWay, Converter={StaticResource IntegerDoubleConverter}}" FormatString="F0" HorizontalAlignment="Stretch" />
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Throttle %" Classes="H4" />
                                <NumericUpDown Grid.Column="1" Grid.Row="1" Margin="10,0" PlaceholderText="Throttle %" Value="{Binding ThrottlePercent, Mode=TwoWay}" FormatString="F1" HorizontalAlignment="Stretch" />
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Duration (s)" Classes="H4" />
                                <NumericUpDown Grid.Column="1" Grid.Row="2" Margin="10,0" PlaceholderText="Duration (s)" Value="{Binding DurationSeconds, Mode=TwoWay}" FormatString="F1" HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Margin="0,10" Text="{Binding Instruction}" Classes="H4" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="2" Margin="16" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                        <Border Classes="SectionCard" Padding="12" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="15">
                                <TextBlock Margin="0,10" Text="Operation log:" Classes="H3" />
                                <Border MinHeight="100">
                                    <ItemsControl ItemsSource="{Binding Log}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding .}" FontSize="12" Opacity="0.8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
