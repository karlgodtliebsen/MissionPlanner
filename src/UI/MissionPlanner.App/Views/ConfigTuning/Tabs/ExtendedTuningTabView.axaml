<utilities:NavigationViewBase x:TypeArguments="tabs:ExtendedTuningTabViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                              xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                              xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.ExtendedTuningTabView"
                              x:DataType="tabs:ExtendedTuningTabViewModel">
    <ContentPage Header="Extended Tuning" Background="{DynamicResource Surface}">

        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12" RowSpacing="10" HorizontalAlignment="Center">

            <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Stretch">
                <TextBox HorizontalAlignment="Right" PlaceholderText="Search curated advanced parameters"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         IsVisible="{Binding IsConnected}"/>
                <ProgressBar IsIndeterminate="True"  Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            </StackPanel>

            <Border Grid.Row="1" Padding="10" Classes="SectionCard">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <TextBlock Text="{Binding FirmwareFamilyText, StringFormat='Advanced firmware profile: {0}'}" />
                    <TextBlock Text="Expert page: changes to controllers, estimators, and filters can destabilize a vehicle. Autotune execution is intentionally not available here."
                               Classes="Warning"
                               FontWeight="Bold"
                               IsVisible="{Binding HasSupportedProfile}" />
                    <TextBlock Text="This connected firmware has no supported advanced profile."
                               Classes="Warning"
                               IsVisible="{Binding IsUnsupported}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="10" IsVisible="{Binding HasSupportedProfile}">
                <Border Padding="10" Classes="SectionCard">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <TextBlock Text="{Binding ModifiedCount, StringFormat='Pending advanced changes: {0}'}" FontWeight="Bold" />
                        <TextBlock Text="{Binding ChangeSummary}"
                                   MaxLines="5"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="10" Classes="SectionCard">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <TextBlock Text="Live controller response (read-only PID_TUNING context)" FontWeight="Bold" />
                        <controls:VirtualizedItemsGrid
                            ItemsSource="{Binding ResponseMetrics}"
                            ColumnWidths="*,*,*,*"
                            ColumnSpacing="6"
                            RowMinHeight="28"
                            ShowHeader="True"
                            ShowSearchBar="False"
                            ShowPagination="False"
                            SelectionMode="None"
                            Height="54"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <controls:VirtualizedItemsGrid.EmptyView>
                                <TextBlock Text="No PID response telemetry received."
                                           FontSize="12"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </controls:VirtualizedItemsGrid.EmptyView>
                            <controls:VirtualizedItemsGrid.HeaderTemplate>
                                <DataTemplate>
                                    <controls:VirtualizedItemsGridRow>
                                        <TextBlock Grid.Column="0" Text="Axis" Classes="DataGridColumn" />
                                        <TextBlock Grid.Column="1" Text="Desired" Classes="DataGridColumn" />
                                        <TextBlock Grid.Column="2" Text="Achieved" Classes="DataGridColumn" />
                                        <TextBlock Grid.Column="3" Text="Error" Classes="DataGridColumn Danger" />
                                    </controls:VirtualizedItemsGridRow>
                                </DataTemplate>
                            </controls:VirtualizedItemsGrid.HeaderTemplate>
                            <controls:VirtualizedItemsGrid.RowTemplate>
                                <DataTemplate x:DataType="tabs:ControlResponseMetricViewModel">
                                    <controls:VirtualizedItemsGridRow>
                                        <TextBlock Grid.Column="0" Text="{Binding Axis}" Classes="DataGridRow" />
                                        <TextBlock Grid.Column="1" Text="{Binding Desired}" Classes="DataGridRow" />
                                        <TextBlock Grid.Column="2" Text="{Binding Achieved}" Classes="DataGridRow" />
                                        <TextBlock Grid.Column="3" Text="{Binding Error}" Classes="DataGridRow Danger" />
                                    </controls:VirtualizedItemsGridRow>
                                </DataTemplate>
                            </controls:VirtualizedItemsGrid.RowTemplate>
                        </controls:VirtualizedItemsGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <ListBox Grid.Row="3"
                     ItemsSource="{Binding VisibleGroups}"
                     IsVisible="{Binding HasSupportedProfile}">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="tabs:ExtendedTuningGroupViewModel">
                        <Border Padding="12" Margin="0,0,0,10">
                            <Expander
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Vertical" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="20" />
                                            <TextBlock Text="{Binding Category}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SupportedFieldCount, StringFormat='{}{0} supported fields'}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ExpertWarning}"
                                                   Classes="Warning"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ValidationMessage}"
                                                   Classes="Warning"
                                                   IsVisible="{Binding HasValidationError}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="This group has pending changes."
                                                   Classes="Warning"
                                                   IsVisible="{Binding IsModified}" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button  Content="Refresh" Command="{Binding RefreshCommand}" />
                                            <Button  Content="Revert group" Command="{Binding RevertCommand}" />
                                            <Button  Content="Review &amp; apply group" Command="{Binding ApplyCommand}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="6" IsVisible="{Binding SupportsAxisCopy}">
                                            <ComboBox ToolTip.Tip="Source axis" Width="110" ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedSourceAxis}" />
                                            <ComboBox ToolTip.Tip="Target axis" Width="110" ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedTargetAxis}" />
                                            <Button  Content="Preview axis copy" Command="{Binding PreviewCopyCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Padding="10" IsVisible="{Binding HasCopyPreview}" Classes="SectionCard">
                                        <StackPanel Orientation="Vertical" Spacing="4">
                                            <TextBlock Text="Axis copy preview — no pending values have changed" FontWeight="Bold" />
                                            <ItemsControl ItemsSource="{Binding CopyPreview}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="tabs:AxisCopyChangeViewModel">
                                                        <Grid ColumnDefinitions="90,*,*,Auto,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding Component}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SourceParameter}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding TargetParameter}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding BeforeValue, StringFormat='{}{0:G} →'}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding AfterValue, StringFormat='{}{0:G}'}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button  Content="Confirm preview into pending values" Command="{Binding ApplyCopyCommand}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tabs:AdvancedTuningFieldViewModel">
                                                <Border Padding="10" BorderThickness="1" Classes="SectionCard">
                                                    <Grid ColumnDefinitions="120,2*,Auto,180" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock Text="{Binding AxisText}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding InstanceText}" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Vertical" Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding ParameterName}" FontSize="11" Opacity="0.7" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Editor.LiveValue, StringFormat='Live {0:G}'}" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="3">
                                                            <NumericUpDown
                                                                IsReadOnly="{Binding Editor.IsReadOnly}"
                                                                IsVisible="{Binding !Editor.HasValuesData}"
                                                                Value="{Binding Editor.Value, Mode=TwoWay}"
                                                                HorizontalAlignment="Stretch"
                                                                />
                                                            <ComboBox ItemsSource="{Binding Editor.ValuesData}"
                                                                      SelectedItem="{Binding Editor.SelectedValue, Mode=TwoWay}"
                                                                      IsVisible="{Binding Editor.HasValuesData}" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12" />
                                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Units, StringFormat='Units: {0}'}" FontSize="12" />

                                                        <ProgressBar Grid.Row="2" Grid.Column="0"
                                                                     Value="{Binding NormalizedMagnitude}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Normalized magnitude across axes" FontSize="11" />
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                                                   Text="{Binding Editor.ValidationError}"
                                                                   Classes="Warning"
                                                                   FontSize="12" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
