<utilities:UserControlViewBase
    x:TypeArguments="sections:JoystickViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
    x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.JoystickView"
    x:DataType="sections:JoystickViewModel"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <StackPanel Orientation="Vertical" Margin="20" Spacing="25" HorizontalAlignment="Center">
        <TextBlock Text="Joystick Setup" Classes="H2"/>
        <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
        <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                             IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
        <TextBlock Text="{Binding PlatformStatus}" />
        <Grid ColumnDefinitions="Auto,Auto" VerticalAlignment="Stretch" ColumnSpacing="25" HorizontalAlignment="Stretch">
            <ComboBox ToolTip.Tip="Local device" ItemsSource="{Binding Devices}" VerticalAlignment="Bottom" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedDevice}" Width="300" />
            <Button Classes="IsToolbarButton" Grid.Column="1" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="Refresh">
                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
            </Button>
        </Grid>
        <TextBlock Text="Local calibration is separate from vehicle RC calibration." />
        <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding VehicleOutputEnabled}" IsEnabled="False" Content="Vehicle MANUAL_CONTROL output (disabled by default)" />
        </StackPanel>
        <Button Classes="IsToolbarButton" ToolTip.Tip="Disable and release vehicle control" Command="{Binding DisableCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="Disable and release vehicle control">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mdi:MaterialIcon Kind="Stop" Classes="ActionIcon" Width="20" Height="20" />
                <TextBlock Text="Disable and release vehicle control" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</utilities:UserControlViewBase>
