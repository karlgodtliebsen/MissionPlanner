<utilities:UserControlViewBase x:TypeArguments="sections:CompassMotorCalibrationViewModel" xmlns="https://github.com/avaloniaui" xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections" xmlns:optionalHardware="clr-namespace:MissionPlanner.Core.Setup.OptionalHardware;assembly=MissionPlanner.Core" xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui" x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections.CompassMotorCalibrationView" x:DataType="sections:CompassMotorCalibrationViewModel">
<ScrollViewer VerticalScrollBarVisibility="Visible">
<StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
<TextBlock Text="Compass / Motor Calibration" FontSize="20" FontWeight="Bold" />
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
<TextBlock Text="Remove ALL propellers. CompassMot may spin motors." Foreground="{DynamicResource Warning}" FontWeight="Bold" />
<TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
<TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
<TextBlock Text="{Binding Instruction}" />
<TextBlock Text="{Binding Compensation}" />
<StackPanel Orientation="Horizontal" Spacing="8">
<Button Content="Start CompassMot" Command="{Binding StartCommand}" />
<Button Content="Stop" Foreground="{DynamicResource Warning}" Command="{Binding StopCommand}" />
</StackPanel>
<ItemsControl ItemsSource="{Binding Samples}">
<ItemsControl.ItemTemplate>
<DataTemplate x:DataType="optionalHardware:CompassMotorCalibrationSample">
<TextBlock Text="{Binding ThrottlePercent, StringFormat='Throttle {0:0.0}%'}" />
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</ScrollViewer>
</utilities:UserControlViewBase>