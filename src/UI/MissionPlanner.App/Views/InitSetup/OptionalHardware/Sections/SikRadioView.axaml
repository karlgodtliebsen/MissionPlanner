<utilities:UserControlViewBase x:TypeArguments="sections:SikRadioViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.Themes.Controls;assembly=MissionPlanner.Themes"
                               xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:appSetup="clr-namespace:MissionPlanner.App.Views.Common"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.SikRadioView"
                               x:DataType="sections:SikRadioViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner ShowIcon="False"  Classes="Bordered" Header="SiK / RFD Radio" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="Direct serial configuration. Disconnect any vehicle using the selected port." Classes="Warning" />
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                        </WrapPanel>
                    </Border>
                    <appSetup:SetupInformationView Grid.Row="1" Topic="SikRadio" WorkflowError="{Binding ErrorMessage}" >
                        <appSetup:SetupInformationView.WorkflowStatus>
                            <MultiBinding StringFormat="{}{0}&#10;{1}&#10;{2}">
                                <Binding Path="StatusMessage" />
                                <Binding Path="Status" />
                                <Binding Path="Identity" />
                            </MultiBinding>
                        </appSetup:SetupInformationView.WorkflowStatus>
                    </appSetup:SetupInformationView>
                </Grid>

            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh ports" Command="{Binding RefreshPortsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Refresh ports">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Connect / Read" Command="{Binding ConnectCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Connect / Read">
                                <mdi:MaterialIcon Kind="DownloadOutline" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Apply, save and reboot" Command="{Binding ApplyCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Apply, save and reboot">
                                <mdi:MaterialIcon Kind="ContentSaveCheckOutline" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="SectionCard" HorizontalAlignment="Stretch" Padding="12">
                        <StackPanel Spacing="10">

                            <StackPanel Orientation="Horizontal" Spacing="50" HorizontalAlignment="Stretch" Height="75" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Vertical" Spacing="10">
                                    <TextBlock Text="Serial device" />

                                    <ComboBox ToolTip.Tip="Serial device"
                                              VerticalAlignment="Bottom"
                                              HorizontalContentAlignment="Right"
                                              ItemsSource="{Binding Ports}"
                                              SelectedItem="{Binding SelectedPort}"
                                              Width="180" />
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Spacing="10">
                                    <TextBlock Text="BaudRate" />
                                    <NumericUpDown PlaceholderText="BaudRate"
                                                   FormatString="F0"
                                                   VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Right"
                                                   HorizontalContentAlignment="Right"
                                                   Minimum="0"
                                                   Value="{Binding BaudRate, Mode=TwoWay}"
                                                   Width="110" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Identity}" FontWeight="Bold" />

                            <Grid ColumnDefinitions="80,*,140,140" ColumnSpacing="8">
                                <TextBlock Text="Register" /><TextBlock Grid.Column="1" Text="Setting" />
                                <TextBlock Grid.Column="2" Text="Local" /><TextBlock Grid.Column="3" Text="Remote" />
                            </Grid>
                            <ScrollViewer MaxHeight="400">
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sections:SikSettingViewModel">
                                            <Grid ColumnDefinitions="80,*,140,140" ColumnSpacing="8" Margin="0,3">
                                                <TextBlock Text="{Binding Register}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                <TextBox Grid.Column="2" Text="{Binding Local}" IsReadOnly="{Binding !HasLocal}" PlaceholderText="Not reported" />
                                                <TextBox Grid.Column="3" Text="{Binding Remote}" IsReadOnly="{Binding !HasRemote}" PlaceholderText="Not reported" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <WrapPanel ItemSpacing="12">
                                <Button Classes="ToolbarIconButton" Command="{Binding CopyLocalToRemoteCommand}" ToolTip.Tip="Copy local values into remote draft" AutomationProperties.Name="Copy local to remote draft"><mdi:MaterialIcon Kind="ContentCopy" Classes="ActionIcon" /></Button>
                                <CheckBox Content="Restore remote radio" IsChecked="{Binding RestoreRemote}" />
                                <Button Classes="ToolbarIconButton" Command="{Binding RestoreDefaultsCommand}" ToolTip.Tip="Restore radio defaults" AutomationProperties.Name="Restore radio defaults"><mdi:MaterialIcon Kind="Restore" Classes="ActionIcon" /></Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Firmware"><sections:SikFirmwareView /></TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
