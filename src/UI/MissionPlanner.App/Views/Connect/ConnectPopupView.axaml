<utilities:UserControlViewBase x:TypeArguments="connect:ConnectPopupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:connect="clr-namespace:MissionPlanner.App.Views.Connect"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa"
                               x:Class="MissionPlanner.App.Views.Connect.ConnectPopupView"
                               x:DataType="connect:ConnectPopupViewModel"
                               MinHeight="250"
                               MinWidth="350"
                               Margin="50">
    <UserControl.Resources>
        <connect:ConnectionChannelLabelConverter x:Key="ChannelLabel" />
    </UserControl.Resources>
    <Grid RowDefinitions="*,Auto" RowSpacing="25">
        <u:UrsaGroupBox HeaderSpacing="12"
                        BorderBrush="{DynamicResource SemiColorSecondary}"
                        BorderThickness="2"
                        CornerRadius="12"
                        Margin="10" Padding="12"
                        HorizontalAlignment="Stretch">
            <u:UrsaGroupBox.Header >
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SemiColorSecondary}"
                    Text="{Binding Title}" />
            </u:UrsaGroupBox.Header>

            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350">
                <StackPanel Spacing="12" IsVisible="{Binding !IsConnected}" IsEnabled="{Binding !IsConnecting}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Connection type" />
                        <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Connection type">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding ., Converter={StaticResource ChannelLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{Binding TransportHelp}" TextWrapping="Wrap" />
                    <StackPanel Spacing="4" IsVisible="{Binding ShowBaudRate}">
                        <TextBlock Text="Baud rate" />
                        <ComboBox ItemsSource="{Binding BaudRates}" 
                                  SelectedItem="{Binding SelectedBaudRate}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Baud rate" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowRemoteEndpoint}">
                        <TextBlock Text="Remote host" />
                        <TextBox Text="{Binding SelectedHost}" PlaceholderText="Hostname or IP address"
                                 AutomationProperties.Name="Remote host" />
                        <TextBlock Text="Remote port" />
                        <TextBox Text="{Binding SelectedPort}" PlaceholderText="1–65535"
                                 AutomationProperties.Name="Remote port" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowUdpListen}">
                        <TextBlock Text="Local listening port" />
                        <TextBox Text="{Binding SelectedPort}" PlaceholderText="14550"
                                 AutomationProperties.Name="Local listening port" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowUdpSettings}">
                        <TextBlock Text="Local bind address (optional)" />
                        <TextBox Text="{Binding LocalBindAddress}" PlaceholderText="All interfaces"
                                 AutomationProperties.Name="Local bind address" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowUdpClient}">
                        <TextBlock Text="Local port (0 chooses a free port)" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ClientLocalPort}" PlaceholderText="0"
                                 AutomationProperties.Name="UDP client local port" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowWebSocket}">
                        <TextBlock Text="WebSocket URL" />
                        <TextBox Text="{Binding WebSocketUrl}" PlaceholderText="ws://127.0.0.1:8765/"
                                 AutomationProperties.Name="WebSocket URL" />
                    </StackPanel>
                    <TextBlock Text="{Binding NetworkValidationMessage}" Classes="Danger" TextWrapping="Wrap"
                               IsVisible="{Binding NetworkValidationMessage, Converter={StaticResource StringNotNullEmptyConverter}}" />
                </StackPanel>
                <StackPanel  Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                         IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}" />
                    <SelectableTextBlock Text="{Binding ErrorMessage}" Classes="Danger" TextWrapping="Wrap"
                                         IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}" />
                </StackPanel>
            </StackPanel>
        </u:UrsaGroupBox>
        <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right"
                   IsEnabled="{Binding !IsConnecting}">
            <Button Classes="EmbeddedIconButton" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsConnected}"
                    ToolTip.Tip="Refresh available ports" AutomationProperties.Name="Refresh available ports">
                <mdi:MaterialIcon Kind="Refresh" Width="30" Height="30" />
            </Button>
            <Button Classes="EmbeddedIconButton" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}"
                    ToolTip.Tip="Connect to vehicle" AutomationProperties.Name="Connect to vehicle">
                <Image Source="{Binding ConnectionImage}" Width="30" Height="30" Stretch="Uniform" />
            </Button>
            <Button Classes="EmbeddedIconButton" Command="{Binding ConnectCommand}" IsVisible="{Binding IsConnected}"
                    ToolTip.Tip="Disconnect vehicle" AutomationProperties.Name="Disconnect vehicle">
                <Image Source="{Binding ConnectionImage}" Width="30" Height="30" Stretch="Uniform" />
            </Button>
            <Button Classes="EmbeddedIconButton" Command="{Binding OKCommand}"
                    ToolTip.Tip="Close connection dialog" AutomationProperties.Name="Close connection dialog">
                <mdi:MaterialIcon Kind="Check" Width="30" Height="30" />
            </Button>
        </WrapPanel>
    </Grid>
</utilities:UserControlViewBase>
