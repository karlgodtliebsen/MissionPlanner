<utilities:TabItemViewBase
                x:TypeArguments="tabs:PreflightTabViewModel"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                x:Class="MissionPlanner.App.Views.FlightData.Tabs.PreflightTabItemView"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:DataType="tabs:PreflightTabViewModel">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Text="{Binding OverallStatus}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="{Binding Disclaimer}" TextWrapping="Wrap"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding Checks}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            <Button Content="Run pre-arm" Command="{Binding RunPrearmCommand}" IsEnabled="{Binding CanRunPrearm}"/>
            <TextBlock Text="{Binding CommandResult}"/>
        </StackPanel>
    </Grid>
</utilities:TabItemViewBase>
