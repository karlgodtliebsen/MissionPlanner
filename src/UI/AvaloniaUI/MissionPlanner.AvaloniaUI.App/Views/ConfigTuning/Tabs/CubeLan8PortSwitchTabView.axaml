<utilities:NavigationViewBase x:TypeArguments="tabs:CubeLan8PortSwitchTabViewModel"

                              xmlns="https://github.com/avaloniaui"
                              xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs"
                              xmlns:controls="clr-namespace:MissionPlanner.AvaloniaUI.App.Controls"
                              xmlns:navigation="clr-namespace:MissionPlanner.AvaloniaUI.App.Navigation"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs.CubeLan8PortSwitchTabView"
                              x:DataType="tabs:CubeLan8PortSwitchTabViewModel"
                              >
    <ContentPage Header="CubeLAN 8 Port Switch" Background="{DynamicResource Surface}">

        <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="{Binding VehicleHeading}" FontWeight="Bold" />
                <TextBlock Text="Discovery uses only the repository-documented MAVLink DEVICE_OP I²C path at address 0x50. The editor exposes COS, COS priority, EEE, VLAN tagging, and the 8×8 VLAN membership matrix. PoE, port enablement, VLAN IDs, modes, authentication, and editable labels are not exposed because no verified protocol definition exists for them." />
            </StackPanel>

            <Border Grid.Row="1" Padding="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <ProgressBar IsIndeterminate="True"  Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Vertical" Grid.Column="1">
                        <TextBlock Text="{Binding Status}" FontWeight="Bold" />
                        <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}"/>
                    </StackPanel>
                    <Button  Grid.Column="2" Content="Discover / read" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <controls:VirtualizedItemsGrid
                Grid.Row="2"
                ItemsSource="{Binding Ports}"
                ColumnWidths="*,*,*,*,2*"
                ColumnSpacing="6"
                RowMinHeight="40"
                ShowHeader="True"
                ShowSearchBar="False"
                ShowPagination="False"
                SelectionMode="None"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <controls:VirtualizedItemsGrid.EmptyView>
                    <StackPanel Margin="20" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="No editable CubeLAN device is available."
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Unsupported, not discovered, authentication-required, and disconnected states remain explicit and send no undocumented commands."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:VirtualizedItemsGrid.EmptyView>
                <controls:VirtualizedItemsGrid.HeaderTemplate>
                    <DataTemplate>
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Grid.Column="0" Text="Class of service" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="1" Text="COS high priority" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="2" Text="Energy Efficient Ethernet" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="3" Text="VLAN tagged" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="4" Text="VLAN memberships" Classes="DataGridColumn" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.HeaderTemplate>
                <controls:VirtualizedItemsGrid.RowTemplate>
                    <DataTemplate x:DataType="tabs:CubeLanPortViewModel">
                        <controls:VirtualizedItemsGridRow>
                            <CheckBox Grid.Column="0" IsChecked="{Binding ClassOfServiceEnabled, Mode=TwoWay}" Classes="DataGridRow" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding ClassOfServiceHighPriority, Mode=TwoWay}" Classes="DataGridRow" />
                            <CheckBox Grid.Column="2" IsChecked="{Binding EnergyEfficientEthernetEnabled, Mode=TwoWay}" Classes="DataGridRow" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding VlanTagged, Mode=TwoWay}" Classes="DataGridRow" />
                            <ItemsControl Grid.Column="4" ItemsSource="{Binding Memberships}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tabs:CubeLanMembershipViewModel">
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsMember, Mode=TwoWay}"
                                                  Margin="0,0,12,4"
                                                  Classes="DataGridRow" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.RowTemplate>
            </controls:VirtualizedItemsGrid>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding IsDirty, StringFormat='Pending local changes: {0}'}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button  Content="Export" Command="{Binding ExportCommand}" />
                    <Button  Content="Revert" Command="{Binding RevertCommand}" IsEnabled="{Binding CanEdit}" />
                    <Button  Content="Apply and verify" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanEdit}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
