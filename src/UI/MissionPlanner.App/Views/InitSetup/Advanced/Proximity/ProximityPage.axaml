<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Proximity"
                               xmlns:u="https://irihi.tech/ursa"
                               x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Proximity.ProximityPage"
                               x:TypeArguments="local:ProximityViewModel"
                               x:DataType="local:ProximityViewModel">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="600" MaxWidth="900" RowSpacing="20">
        <u:Banner ShowIcon="False"  Classes="Bordered" Header="Proximity observations" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Text="Display only. Unknown, stale and unsupported readings never indicate clear space. Uses existing telemetry streams." TextWrapping="Wrap" Classes="Warning" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Radar" Margin="0,20"><local:ProximityRadarView DataContext="{Binding Radar}" /></TabItem>
            <TabItem Header="Sensor diagnostics" Margin="0,20"><local:ProximityDiagnosticsView DataContext="{Binding Diagnostics}" /></TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
