<utilities:UserControlViewBase x:TypeArguments="sections:FlightModesSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FlightModesSetupView"
                               x:DataType="sections:FlightModesSetupViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                               xmlns:u="https://irihi.tech/ursa">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner  Classes="Bordered" Header="Flight-mode assignment" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding ModeChannelDescription}" FontWeight="Bold" />
                <TextBlock Text="{Binding SwitchEvidence}" TextWrapping="Wrap" />
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh flight modes"
                                    Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh flight modes">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Parameters Editor" AutomationProperties.Name="Open Parameters Editor">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <controls:SetupInformationView Grid.Row="1" Topic="FlightModes"
                                                   WorkflowStatus="{Binding StatusMessage}"
                                                   WorkflowError="{Binding ErrorMessage}" />
                </Grid>
            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" HorizontalAlignment="Stretch" Padding="12">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh flight modes"
                                    Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh flight modes">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" Command="{Binding OpenFullParametersCommand}"
                                    ToolTip.Tip="Open Parameters Editor" AutomationProperties.Name="Open Parameters Editor">
                                <mdi:MaterialIcon Kind="FormatListBulleted" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" Margin="16,0" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                        <Border Classes="SectionCard" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="A three-position switch commonly selects slots 1, 4 and 6, depending on its PWM values. An assigned mode can differ from the active mode: the FC may reject or override the request; check telemetry and Messages."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Choose a mode, then Apply that slot. Listed modes do not guarantee support in this firmware build. The highlighted slot shows the RC switch position, not the active flight mode."
                                           TextWrapping="Wrap" />
                                <ItemsControl IsVisible="{Binding IsSupported}" ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sections:FlightModeSlotViewModel">
                                            <Border Padding="10" Classes="SectionCard" HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="Auto,200,*,Auto" ColumnSpacing="8"  HorizontalAlignment="Stretch">
                                                    <TextBlock Text="●" Foreground="{DynamicResource Info}"
                                                               IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding BandDescription}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="2" ToolTip.Tip="Mode"
                                                              HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Right"
                                                              ItemsSource="{Binding Options}"
                                                              IsEnabled="{Binding IsLoaded}"
                                                              SelectedItem="{Binding SelectedMode}"
                                                              DisplayMemberBinding="{Binding Name}" />
                                                    <Button Grid.Column="3" Content="Apply" Command="{Binding ApplyCommand}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
