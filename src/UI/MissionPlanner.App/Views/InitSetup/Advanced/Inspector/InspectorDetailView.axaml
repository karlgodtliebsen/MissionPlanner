<utilities:UserControlViewBase xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.Advanced.Inspector"
    x:Class="MissionPlanner.App.Views.InitSetup.Advanced.Inspector.InspectorDetailView"
    x:TypeArguments="local:InspectorDetailViewModel" x:DataType="local:InspectorDetailViewModel"
                            xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Button Classes="IsToolbarButton" ToolTip.Tip="Copy selected row and details" Command="{Binding CopyCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Copy selected row and details">
            <mdi:MaterialIcon Kind="ContentCopy" Classes="ActionIcon" />
        </Button>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="SectionCard" Padding="16">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="monospace" />
            </Border>
        </ScrollViewer>
    </Grid>
</utilities:UserControlViewBase>
