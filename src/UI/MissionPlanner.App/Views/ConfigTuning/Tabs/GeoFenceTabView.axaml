<utilities:NavigationViewBase
                    x:TypeArguments="tabs:GeoFenceTabViewModel"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                    xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:models="clr-namespace:MissionPlanner.App.Models"
                    xmlns:controls="clr-namespace:MissionPlanner.App.Controls"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.GeoFenceTabView"
                    x:DataType="tabs:GeoFenceTabViewModel"
                    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <ContentPage Header="GeoFence Configuration"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="IsToolbarButton" ToolTip.Tip="Download" Command="{Binding DownloadCommand}" AutomationProperties.Name="Download">
                    <mdi:MaterialIcon Kind="DownloadOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Validate &amp; upload" Command="{Binding UploadCommand}" AutomationProperties.Name="Validate &amp; upload">
                    <mdi:MaterialIcon Kind="UploadOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Clear vehicle" Command="{Binding ClearVehicleCommand}" AutomationProperties.Name="Clear vehicle">
                    <mdi:MaterialIcon Kind="DeleteOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Restore backup" Command="{Binding RestoreBackupCommand}" AutomationProperties.Name="Restore backup">
                    <mdi:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Refresh parameters" Command="{Binding RefreshParametersCommand}" AutomationProperties.Name="Refresh parameters">
                    <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Revert parameters" Command="{Binding RevertParametersCommand}" AutomationProperties.Name="Revert parameters">
                    <mdi:MaterialIcon Kind="FileUndoOutline" Classes="ActionIcon" />
                </Button>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"  Theme="{DynamicResource ProgressRing}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <ProgressBar IsIndeterminate="True" Grid.Column="1" IsVisible="{Binding IsBusy}"  Theme="{DynamicResource ProgressRing}" />
                <ProgressBar Grid.Column="2" Width="180" Value="{Binding TransferPercent}" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="380,*" ColumnSpacing="12">
                <ScrollViewer>
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <Border Padding="10">
                            <StackPanel Orientation="Vertical" Spacing="4">
                                <TextBlock Text="Fence synchronization" FontWeight="Bold" FontSize="18" />
                                <TextBlock Text="{Binding LocalRevisionText}" />
                                <TextBlock Text="{Binding VehicleRevisionText}" />
                                <TextBlock Text="{Binding ReturnPointText}" />
                                <TextBlock Text="Local geometry has unapplied changes"
                                           Classes="Warning"
                                           IsVisible="{Binding IsGeometryDirty}" />
                                <TextBlock Text="Typed geometry is not advertised by this firmware."
                                           Classes="Warning"
                                           IsVisible="{Binding IsTypedGeometryUnsupported}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="10">
                            <StackPanel Orientation="Vertical" Spacing="8">
                                <TextBlock Text="Fence parameters" FontWeight="Bold" FontSize="18" />
                                <ItemsControl ItemsSource="{Binding Parameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ParameterItemViewModel">
                                            <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                <NumericUpDown  Grid.Row="0"
                                                                Grid.Column="1"
                                                                IsReadOnly="{Binding IsReadOnly}"
                                                                Value="{Binding Value, Mode=TwoWay}"
                                                                HorizontalAlignment="Stretch"
                                                                />
                                                <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                                           Text="{Binding ValidationError}"
                                                           Classes="Warning"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Padding="10">
                            <StackPanel Orientation="Vertical" Spacing="8">
                                <TextBlock Text="Fence map edit mode" FontWeight="Bold" FontSize="18" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">

                                    <Button Classes="IsToolbarButton" ToolTip.Tip="Inclusion polygon" Command="{Binding BeginPolygonInclusionCommand}" AutomationProperties.Name="Inclusion polygon">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mdi:MaterialIcon Kind="VectorPolygon" Classes="ActionIcon" Width="20" Height="20" />
                                            <TextBlock Text="Inclusion polygon" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="IsToolbarButton" Grid.Row="0" Grid.Column="1" ToolTip.Tip="Exclusion polygon" Command="{Binding BeginPolygonExclusionCommand}" AutomationProperties.Name="Exclusion polygon">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mdi:MaterialIcon Kind="VectorPolygon" Classes="ActionIcon" Width="20" Height="20" />
                                            <TextBlock Text="Exclusion polygon" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="IsToolbarButton" Grid.Column="0" Grid.Row="1" ToolTip.Tip="Inclusion circle" Command="{Binding BeginCircleInclusionCommand}" AutomationProperties.Name="Inclusion circle">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mdi:MaterialIcon Kind="CircleOutline" Classes="ActionIcon" Width="20" Height="20" />
                                            <TextBlock Text="Inclusion circle" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="IsToolbarButton" Grid.Row="1" Grid.Column="1" ToolTip.Tip="Exclusion circle" Command="{Binding BeginCircleExclusionCommand}" AutomationProperties.Name="Exclusion circle">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mdi:MaterialIcon Kind="CircleOutline" Classes="ActionIcon" Width="20" Height="20" />
                                            <TextBlock Text="Exclusion circle" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="IsToolbarButton" Grid.Column="0" Grid.Row="2" ToolTip.Tip="Set return point" Command="{Binding BeginReturnPointCommand}" AutomationProperties.Name="Set return point">
                                        <mdi:MaterialIcon Kind="MapMarkerPlusOutline" Classes="ActionIcon" />
                                    </Button>
                                    <!--
                                    <TextBox Grid.Row="2" Grid.Column="1" PlaceHolderText="Circle radius (m)"
                                    Text="{Binding CircleRadiusMeters, Mode=TwoWay}" />-->

                                    <NumericUpDown
                                        Grid.Row="2" Grid.Column="1"
                                        Value="{Binding CircleRadiusMeters, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch"
                                        />

                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsFenceEditMode}">
                                    <Button Classes="IsToolbarButton" ToolTip.Tip="Finish polygon" Command="{Binding FinishPolygonCommand}" AutomationProperties.Name="Finish polygon">
                                        <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                                    </Button>
                                    <Button Classes="IsToolbarButton" ToolTip.Tip="Cancel edit" Command="{Binding CancelEditCommand}" AutomationProperties.Name="Cancel edit">
                                        <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="10">
                            <StackPanel Orientation="Vertical" Spacing="8">
                                <TextBlock Text="Local geometry" FontWeight="Bold" FontSize="18" />


                                <controls:VirtualizedItemsGrid
                                    ItemsSource="{Binding Areas}"
                                    SelectedItem="{Binding SelectedArea, Mode=OneWayToSource}"
                                    SelectionMode="Single"
                                    SelectionColumnWidth="25"
                                    ColumnWidths="*,*"
                                    ColumnSpacing="6"
                                    RowMinHeight="34"
                                    ShowHeader="True"
                                    ShowSearchBar="False"
                                    ShowPagination="False"
                                    Height="180"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <controls:VirtualizedItemsGrid.EmptyView>
                                        <TextBlock Text="No items."
                                                   FontSize="12"
                                                   Opacity="0.6"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </controls:VirtualizedItemsGrid.EmptyView>
                                    <controls:VirtualizedItemsGrid.HeaderTemplate>
                                        <DataTemplate>
                                            <controls:VirtualizedItemsGridRow>
                                                <TextBlock Grid.Column="0" Text="Kind" Classes="DataGridColumn" />
                                                <TextBlock Grid.Column="1" Text="Summary" Classes="DataGridColumn" />
                                            </controls:VirtualizedItemsGridRow>
                                        </DataTemplate>
                                    </controls:VirtualizedItemsGrid.HeaderTemplate>
                                    <controls:VirtualizedItemsGrid.RowTemplate>
                                        <DataTemplate x:DataType="tabs:FenceAreaListItem">
                                            <controls:VirtualizedItemsGridRow>
                                                <TextBlock Grid.Column="0" Text="{Binding Kind}" Classes="DataGridRow" />
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="DataGridRow" />
                                            </controls:VirtualizedItemsGridRow>
                                        </DataTemplate>
                                    </controls:VirtualizedItemsGrid.RowTemplate>
                                </controls:VirtualizedItemsGrid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="IsToolbarButton" ToolTip.Tip="Remove selected" Command="{Binding RemoveAreaCommand}" CommandParameter="{Binding SelectedArea}" AutomationProperties.Name="Remove selected">
                                        <mdi:MaterialIcon Kind="DeleteOutline" Classes="ActionIcon" />
                                    </Button>
                                    <Button Classes="IsToolbarButton" ToolTip.Tip="Remove return" Command="{Binding RemoveReturnPointCommand}" AutomationProperties.Name="Remove return">
                                        <mdi:MaterialIcon Kind="MapMarkerRemoveOutline" Classes="ActionIcon" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <tabs:GeoFenceMapView x:Name="FenceMapView" Grid.Column="1" />
            </Grid>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
