<utilities:UserControlViewBase x:TypeArguments="sections:DroneCanUavCanViewModel" xmlns="https://github.com/avaloniaui" xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections" xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions" xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material" xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui" x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections.DroneCanUavCanView" x:DataType="sections:DroneCanUavCanViewModel">
<StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
<TextBlock Text="DroneCAN / UAVCAN v0" FontSize="24" FontWeight="Bold" />
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
<TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
<TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
<ComboBox ToolTip.Tip="Transport" ItemsSource="{Binding TransportKinds}" SelectedItem="{Binding TransportKind}" />
<StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="50">
<Button Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Left" />
<Button Content="Refresh nodes" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
</StackPanel>
<ListBox ItemsSource="{Binding Nodes}" SelectionMode="Single" SelectedItem="{Binding SelectedNode}">
<ListBox.ItemTemplate>
<DataTemplate>
<Grid ColumnDefinitions="50,*,100,100" Margin="4">
<TextBlock Text="{Binding NodeId}" />
<TextBlock Grid.Column="1" Text="{Binding Name}" />
<TextBlock Grid.Column="2" Text="{Binding Health}" />
<TextBlock Grid.Column="3" Text="{Binding Version}" />
</Grid>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</StackPanel>
</utilities:UserControlViewBase>