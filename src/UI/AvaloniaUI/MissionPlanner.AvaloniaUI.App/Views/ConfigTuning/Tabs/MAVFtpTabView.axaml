<utilities:TabItemViewBase x:TypeArguments="tabs:MavFtpTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs"
                           xmlns:controls="clr-namespace:MissionPlanner.AvaloniaUI.App.Controls"
                           xmlns:models="clr-namespace:MissionPlanner.AvaloniaUI.App.Models"
                           xmlns:navigation="clr-namespace:MissionPlanner.AvaloniaUI.App.Navigation"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                           x:Name="RootPage"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.ConfigTuning.Tabs.MAVFtpTabView"
                           x:DataType="tabs:MavFtpTabViewModel">

    <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Content="↑" Command="{Binding NavigateUpCommand}" IsEnabled="{Binding CanNavigateUp}" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Refresh"  IsVisible="{Binding HasConnection}" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="3" Content="Open" IsVisible="{Binding HasEntries}" Command="{Binding OpenSelectedCommand}" />
            <Button Grid.Column="4" Content="Reset sessions"  IsVisible="{Binding HasConnection}" Command="{Binding ResetSessionsCommand}" />
        </Grid>
        <Grid Grid.Row="1"  HorizontalAlignment="Stretch" >
            <controls:VirtualizedItemsGrid
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry, Mode=OneWayToSource}"
                SelectionMode="Single"
                SelectionColumnWidth="25"
                ColumnWidths="400,100,100"
                ColumnSpacing="6"
                RowMinHeight="38"
                ShowHeader="True"
                ShowSearchBar="False"
                ShowPagination="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch">
                <controls:VirtualizedItemsGrid.EmptyView>
                    <TextBlock Text="{Binding EmptyText}"
                               FontSize="12"
                               Opacity="0.6"
                               Margin="0,20"
                               HorizontalAlignment="Center" />
                </controls:VirtualizedItemsGrid.EmptyView>
                <controls:VirtualizedItemsGrid.HeaderTemplate>
                    <DataTemplate>
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Grid.Column="0" Text="Name" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="1" Text="Type" Classes="DataGridColumn" />
                            <TextBlock Grid.Column="2" Text="Size" Classes="DataGridColumn" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.HeaderTemplate>
                <controls:VirtualizedItemsGrid.RowTemplate>
                    <DataTemplate x:DataType="models:VehicleFileSystemEntryViewModel">
                        <controls:VirtualizedItemsGridRow>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="DataGridRow" />
                            <TextBlock Grid.Column="1" Text="{Binding TypeText}" Classes="DataGridRow" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="DataGridRow" />
                        </controls:VirtualizedItemsGridRow>
                    </DataTemplate>
                </controls:VirtualizedItemsGrid.RowTemplate>
            </controls:VirtualizedItemsGrid>
        </Grid>
        <StackPanel Orientation="Vertical" Grid.Row="2" Spacing="6">
            <TextBlock Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" Foreground="{DynamicResource Error}" />
            <ProgressBar Value="{Binding TransferProgress}" />
            <TextBlock Text="{Binding TransferDetails}" FontSize="12" />
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Download selected" Command="{Binding DownloadSelectedCommand}"  IsVisible="{Binding HasEntries}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</utilities:TabItemViewBase>
