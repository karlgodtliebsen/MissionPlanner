<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.DetectedDeviceView"
             x:DataType="local:InstallFirmwareViewModel"
             >
    <Border  Padding="20" Classes="SectionCard">

        <StackPanel Orientation="Vertical" Spacing="10" Grid.Row="1">
            <TextBlock Text="Detected device" Classes="H3" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox ItemsSource="{Binding DetectedDevices}"
                          SelectedItem="{Binding SelectedDevice}" ToolTip.Tip="Select flight controller" />
                <Button Content="Install Validated Firmware" Command="{Binding InstallCommand}" />
            </StackPanel>
            <SelectableTextBlock Text="{Binding DeviceStatus}" />
        </StackPanel>
    </Border>
</UserControl>
