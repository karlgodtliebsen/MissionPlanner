<utilities:NavigationViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.Logs"
    x:TypeArguments="local:LogsViewModel"
    x:Class="MissionPlanner.App.Views.Logs.LogsView"
    x:DataType="local:LogsViewModel"
    x:CompileBindings="True">
    <ContentPage Header="Logs">
        <Grid Margin="16" HorizontalAlignment="Stretch">
            <TabControl Grid.Row="0" TabStripPlacement="Left">
                <TabItem Header="Telemetry Logs">
                    <local:TelemetryLogsTabItemView></local:TelemetryLogsTabItemView>
                </TabItem>
                <TabItem Header="Application Logs">
                    <local:ApplicationLogsView></local:ApplicationLogsView>
                </TabItem>
            </TabControl>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
