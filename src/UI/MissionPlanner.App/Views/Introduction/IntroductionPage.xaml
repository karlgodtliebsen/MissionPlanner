<?xml version="1.0" encoding="utf-8" ?>
<navigation:ExtendedContentPage x:TypeArguments="introduction:IntroductionViewModel" 
                                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                xmlns:navigation="clr-namespace:MissionPlanner.App.Navigation"
                                xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
                                xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                                xmlns:introduction="clr-namespace:MissionPlanner.App.Views.Introduction"
                                xmlns:views="clr-namespace:MissionPlanner.App.Views.Introduction.Views"
                                xmlns:models="clr-namespace:MissionPlanner.App.Views.Introduction.Models"
                                x:Class="MissionPlanner.App.Views.Introduction.IntroductionPage"
                                x:DataType="introduction:IntroductionViewModel"
                                >
    <Grid RowDefinitions="Auto,*" HorizontalOptions="Fill" Padding="20,0,20,10" ColumnSpacing="20">
        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,0,0,20" Spacing="20">
            <Label Text="{Binding Title}" FontSize="26" FontAttributes="Bold"  HorizontalOptions="Center"/>
            <Label Text="{Binding Subtitle}" FontSize="13" Opacity="0.7"  HorizontalOptions="Center"/>
            <material:SelectField 
                        x:Name="MobileTopicPicker"
                        WidthRequest="240"
                        Title="Section"
                        ItemsSource="{Binding Topics}"
                        SelectedItem="{Binding SelectedTopic, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding DisplayTitle}"
                        IsVisible="False"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" 
              HorizontalOptions="Fill" VerticalOptions="Fill"
              x:Name="MainGrid"
              ColumnDefinitions="250,*">

            <Border x:Name="ContentsBorder"
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    Padding="0"
                    StyleClass="SurfaceContainer,Rounded,Elevation1">

                <Grid RowDefinitions="Auto,*">
                    <Label Text="QUICK GUIDE" Padding="10,8,10,6" FontSize="11" FontAttributes="Bold" Opacity="0.65" />


                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding Topics}"
                                    SelectedItem="{Binding SelectedTopic, Mode=TwoWay}"
                                    SelectionMode="Single">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:IntroductionTopic">
                                <Grid Padding="10,9">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor"
                                                            Value="{DynamicResource PrimaryContainer}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding DisplayTitle}" FontSize="14" LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>
            </Border>
            <Border x:Name="TopicHost" 
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    Padding="0"
                    StyleClass="SurfaceContainer,Rounded,Elevation1">
                <Grid Grid.Column="1" >

                    <views:IntroductionTopicView x:Name="TopicView"
                                                 ActionRequested="OnActionRequested" />

                </Grid>
            </Border>
        </Grid>
    </Grid>
</navigation:ExtendedContentPage>
