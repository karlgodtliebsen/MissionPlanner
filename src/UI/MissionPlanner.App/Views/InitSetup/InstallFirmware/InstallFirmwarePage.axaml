<utilities:NavigationViewBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    x:TypeArguments="local:InstallFirmwareViewModel"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.InstallFirmwarePage"
    x:DataType="local:InstallFirmwareViewModel">
    <ContentPage Header="Install Firmware">
        <TabControl TabStripPlacement="Top">
            <TabItem Header="Information">
                <local:LandingView />
            </TabItem>
            <TabItem Header="Firmware">
                <Grid RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="12" HorizontalAlignment="Stretch">
                    <WrapPanel Grid.Row="0" ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Center">
                        <!--
                        <u:ToolBar Header="Actions">
                        <Button Content="Save" Classes="Small" />
                        <u:ToolBarSeparator />
                        <Button Content="Load" Classes="Small" />
                        <Button Content="Delete" Classes="Small" />
                        </u:ToolBar>
                        -->
                        <!--
                        <u:IconSplitButton Icon="{StaticResource SemiIconCamera}" Content="IconSplitButton" />

                        <u:ToolBar Header="">
                        -->


                        <Button ToolTip.Tip="Refresh physical serial and DFU devices"
                                Command="{Binding RefreshDevicesCommand}"
                                IsEnabled="{Binding CurrentPlan.Capabilities.CanRefreshPhysicalDevices}" >
                            <avalonia:MaterialIcon Kind="RefreshCircle" Width="30" Height="30" />
                        </Button>

                        <Button ToolTip.Tip="Probe Runtime. Identify the selected controller using live protocols"
                                Command="{Binding ProbeRuntimeCommand}" >
                            <avalonia:MaterialIcon Kind="ProgressAuto" Width="30" Height="30" />
                        </Button>

                        <!--Icon="{StaticResource Bootstrap}"-->
                        <!--                            <Button  >
                        <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                        <MenuItem
                        ToolTip.Tip="Enter ArduPilot Bootloader. Enter and identify the ArduPilot serial bootloader"
                        Command="{Binding EnterArduPilotBootloaderCommand}"
                        Header="ArduPilot Bootloader" />
                        <MenuItem ToolTip.Tip="Enter STM32 DFU. Verify Betaflight identity and armed state, then reboot into ROM DFU"
                        Command="{Binding RebootToDfuCommand}"
                        Header="STM32 DFU" />
                        <MenuItem ToolTip.Tip="Manual BOOT / RESET. Follow board instructions and wait for STM32 ROM DFU"
                        Header="Manual BOOT / RESET"

                        Command="{Binding EnterManualDfuCommand}"
                        IsEnabled="{Binding CurrentPlan.Capabilities.CanRefreshPhysicalDevices}"
                        />
                        </MenuFlyout>
                        </Button.Flyout>
                        <avalonia:MaterialIcon Kind="Bootstrap" Width="30" Height="30" />
                        </Button>
                        -->
                        <u:IconSplitButton  >
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem
                                        ToolTip.Tip="Enter ArduPilot Bootloader. Enter and identify the ArduPilot serial bootloader"
                                        Command="{Binding EnterArduPilotBootloaderCommand}"
                                        Header="ArduPilot Bootloader" />
                                    <MenuItem ToolTip.Tip="Enter STM32 DFU. Verify Betaflight identity and armed state, then reboot into ROM DFU"
                                              Command="{Binding RebootToDfuCommand}"
                                              Header="STM32 DFU" />
                                    <MenuItem ToolTip.Tip="Manual BOOT / RESET. Follow board instructions and wait for STM32 ROM DFU"
                                              Header="Manual BOOT / RESET"

                                              Command="{Binding EnterManualDfuCommand}"
                                              IsEnabled="{Binding CurrentPlan.Capabilities.CanRefreshPhysicalDevices}"
                                              />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                            <avalonia:MaterialIcon Kind="Bootstrap" Width="30" Height="30" />
                        </u:IconSplitButton>

                        <!--
                        <Button ToolTip.Tip="Enter ArduPilot Bootloader. Enter and identify the ArduPilot serial bootloader"
                        Command="{Binding EnterArduPilotBootloaderCommand}" >
                        <avalonia:MaterialIcon Kind="Bootstrap" Width="30" Height="30" />
                        </Button>

                        <Button ToolTip.Tip="Enter STM32 DFU. Verify Betaflight identity and armed state, then reboot into ROM DFU"
                        Command="{Binding RebootToDfuCommand}" >
                        <avalonia:MaterialIcon Kind="Gymnastics" Width="30" Height="30" />
                        </Button>
                        <Button ToolTip.Tip="Manual BOOT / RESET. Follow board instructions and wait for STM32 ROM DFU"
                        Command="{Binding EnterManualDfuCommand}"
                        IsEnabled="{Binding CurrentPlan.Capabilities.CanRefreshPhysicalDevices}" >
                        <avalonia:MaterialIcon Kind="Excavator" Width="30" Height="30" />
                        </Button>-->

                        <Button ToolTip.Tip="Online Firmware" Command="{Binding ShowOnlineFirmwareSelectorCommand}"
                                IsEnabled="{Binding CurrentPlan.Capabilities.CanBrowseOnlineFirmware}" >
                            <avalonia:MaterialIcon Kind="OpenInBrowser" Width="30" Height="30" />
                        </Button>

                        <Button ToolTip.Tip="Local Firmware" Command="{Binding ShowLocalFirmwareSelectorCommand}"
                                IsEnabled="{Binding CurrentPlan.Capabilities.CanSelectLocalFirmware}">
                            <avalonia:MaterialIcon Kind="Folder" Width="30" Height="30" />
                        </Button>

                        <Button ToolTip.Tip="Clear Selected Firmware" Command="{Binding ClearFirmwareSelectionCommand}"
                                IsEnabled="{Binding !IsOperationInProgress}" >
                            <avalonia:MaterialIcon Kind="Update" Width="30" Height="30" />
                        </Button>

                        <Button ToolTip.Tip="Install / Reinstall"
                                Command="{Binding ExecuteCurrentPlanCommand}"
                                IsEnabled="{Binding CurrentPlan.CanExecute}" >
                            <avalonia:MaterialIcon Kind="Update" Width="30" Height="30" />
                        </Button>

                        <Button ToolTip.Tip="Copy URL" Command="{Binding CopySelectedUrlCommand}"  >
                            <avalonia:MaterialIcon Kind="Copyright" Width="30" Height="30" />
                        </Button>
                        <Button  ToolTip.Tip="Update Embedded Bootloader. Maintenance operation on a supported, disarmed connected ArduPilot vehicle"
                                 Command="{Binding UpdateBootloaderCommand}" >
                            <avalonia:MaterialIcon Kind="Update" Width="30" Height="30" />
                        </Button>


                        <Button  ToolTip.Tip="Validate combined HEX"
                                 Command="{Binding PrepareSelectedHexCommand}" >
                            <avalonia:MaterialIcon Kind="Update" Width="30" Height="30" />
                        </Button>

                        <Button  ToolTip.Tip="Review DFU target"
                                 Command="{Binding ReviewDfuTargetCommand}"
                                 IsVisible="{Binding HasDetectedDfuDevice}"
                                 IsEnabled="{Binding !IsOperationInProgress}"
                                 >
                            <avalonia:MaterialIcon Kind="Update" Width="30" Height="30" />
                        </Button>

                        <Button  ToolTip.Tip="Cancel operation"
                                 Command="{Binding CancelCommand}"
                                 IsVisible="{Binding IsOperationInProgress}">
                            <avalonia:MaterialIcon Kind="Update" Width="30" Height="30" />
                        </Button>

                        <!--</u:ToolBar>-->
                    </WrapPanel>
                    <Border Grid.Row="1" Classes="SectionCard" Padding="16"  HorizontalAlignment="Center" Width="{Binding #PhysicalCtrl.Bounds.Width}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding CurrentPlan.Description}" Classes="H3" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentPlan.BlockReason}"  Classes="Warning" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding WorkflowProgress}" Classes="H4 Warning"  TextWrapping="Wrap"
                                       IsVisible="{Binding WorkflowProgress, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                            <TextBlock Text="{Binding WorkflowNextStep}" Classes="H4 Warning"  TextWrapping="Wrap"
                                       IsVisible="{Binding WorkflowNextStep, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                            <!--
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            -->
                            <TextBlock Text="{Binding ErrorMessage}" Classes="Warning" TextWrapping="Wrap"
                                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">

                            <Border Classes="SectionCard" Padding="16" IsVisible="{Binding ShowPhysicalController}" x:Name="PhysicalCtrl">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Physical controller" Classes="H3" />
                                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">

                                        <ComboBox Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"  ItemsSource="{Binding DevicesModel.DetectedDevices}" SelectedItem="{Binding DevicesModel.SelectedDevice}"
                                                  PlaceholderText="Select serial controller" HorizontalAlignment="Stretch"
                                                  IsEnabled="{Binding !IsOperationInProgress}" />

                                        <ComboBox  Grid.Column="0" Grid.Row="1"  Grid.ColumnSpan="2" ItemsSource="{Binding DfuModel.DfuDevices}" SelectedItem="{Binding DfuModel.SelectedDfuDevice}"
                                                   PlaceholderText="Select STM32 DFU endpoint" HorizontalAlignment="Stretch"
                                                   IsEnabled="{Binding !IsOperationInProgress}" />


                                        <TextBlock Grid.Column="0" Grid.Row="2"  Text="STM32 ROM DFU:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Grid.Row="2"  Text="{Binding DfuProviderId}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="0" Grid.Row="3"  Text="USB:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Grid.Row="3"  Text="{Binding DfuVendorId}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="0" Grid.Row="4"  Text="Product Id:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Grid.Row="4"  Text="{Binding DfuProductId}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="0" Grid.Row="5"  Text="Correlated Source:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Grid.Row="5"  Text="{Binding DfuCorrelatedSource}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="0" Grid.Row="6"  Text="Message:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Grid.Row="6"  Text="{Binding DfuMessage}" TextWrapping="Wrap" />


                                        <TextBlock Grid.Column="0" Grid.Row="7" Text="Device Status:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Grid.Row="7"  Text="{Binding DevicesModel.DeviceStatus}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="0" Grid.Row="8"  Text="Tool Readiness:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Grid.Row="8"  Text="{Binding DfuModel.ToolReadiness}" TextWrapping="Wrap" />

                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="SectionCard" Padding="16" IsVisible="{Binding IsFirmwareSelected}" Width="{Binding #PhysicalCtrl.Bounds.Width}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Selected Firmware" Classes="H3" />
                                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="15">

                                        <TextBlock Text="Source:" />
                                        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedArtifact.Source}" />

                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Format:" />
                                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedArtifact.Format}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0"  Text="Platform / board ID:" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                            <SelectableTextBlock Text="{Binding SelectedArtifact.Platform}" />
                                            <SelectableTextBlock Text="{Binding SelectedArtifact.BoardId}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="0"  Grid.Row="3" Text="Vehicle / build:" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                            <SelectableTextBlock Text="{Binding SelectedArtifact.VehicleFamily}" />
                                            <SelectableTextBlock Text="{Binding SelectedArtifact.Version}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="0"  Grid.Row="4" Text="Image bytes:" />
                                        <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedArtifact.ImageSize}" />

                                        <TextBlock Grid.Column="0"  Grid.Row="5" Text="SHA-256:" />
                                        <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedArtifact.Sha256}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="0"  Grid.Row="6" Text="Cache identity:" />
                                        <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedArtifact.CacheIdentity}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="0"  Grid.Row="7" Text="Online source:"
                                                   IsVisible="{Binding HasOnlineArtifact}" />
                                        <SelectableTextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedArtifact.OnlineUrl}"
                                                             TextWrapping="Wrap" IsVisible="{Binding HasOnlineArtifact}" />

                                        <TextBlock Grid.Column="0"  Grid.Row="8" Text="Channel / Git SHA:" IsVisible="{Binding HasOnlineArtifact}" />
                                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasOnlineArtifact}">
                                            <TextBlock Text="{Binding SelectedArtifact.Channel}" />
                                            <SelectableTextBlock Text="{Binding SelectedArtifact.GitSha}"  TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="0"  Grid.Row="9" Text="Local source:" IsVisible="{Binding HasLocalArtifact}" />
                                        <SelectableTextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedArtifact.LocalFile}" TextWrapping="Wrap" IsVisible="{Binding HasLocalArtifact}" />

                                        <TextBlock Grid.Column="0"  Grid.Row="10" Text="Imported:" IsVisible="{Binding HasLocalArtifact}" />
                                        <SelectableTextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedArtifact.ImportedAt}" TextWrapping="Wrap"  IsVisible="{Binding HasLocalArtifact}" />

                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Reused cache:" />
                                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedArtifact.CacheHit}" />

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Address Ranges:" />
                                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedArtifact.AddressRanges}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="13" Grid.Column="0"  Text="To validate:"
                                                   IsVisible="{Binding DfuModel.HasLocalDfuFirmware}"
                                                   TextWrapping="Wrap" />
                                        <SelectableTextBlock Grid.Row="13" Grid.Column="1" Text="Enter exact ArduPilot platform for local HEX file:"
                                                             IsVisible="{Binding DfuModel.HasLocalDfuFirmware}"
                                                             TextWrapping="Wrap" />

                                        <TextBox
                                            Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"
                                            IsVisible="{Binding DfuModel.HasLocalDfuFirmware}"
                                            Text="{Binding LocalDfuPlatform}"
                                            PlaceholderText="Type ArduPilot platform"  TextWrapping="Wrap" />

                                    </Grid>

                                    <StackPanel HorizontalAlignment="Stretch" IsVisible="{Binding DfuModel.HasLocalDfuFirmware}" >
                                        <Button
                                            HorizontalAlignment="Center"
                                            Content="Validate combined HEX" Command="{Binding PrepareSelectedHexCommand}"
                                            />
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                            <Border Classes="SectionCard" Padding="16" IsVisible="{Binding ShowValidationAndCompatibility}" Width="{Binding #PhysicalCtrl.Bounds.Width}">
                                <StackPanel Spacing="8">
                                    <TextBlock  Text="Validation and compatibility" Classes="H3" />
                                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="15">

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Artifact valid:" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedArtifact.ArtifactValid}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target compatible:" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedArtifact.TargetCompatible}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Compatibility Status:" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompatibilityStatus}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Install status:" TextWrapping="Wrap" />
                                        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstallStatus}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Warnings:" Classes="Warning" TextWrapping="Wrap"
                                                   IsVisible="{Binding SelectedArtifact.Warnings, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Text="{Binding SelectedArtifact.Warnings}" Classes="Warning" TextWrapping="Wrap"
                                                   IsVisible="{Binding SelectedArtifact.Warnings, Converter={StaticResource StringNotNullEmptyConverter}}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="Cancellation is deferred through verification and reboot. Keep power connected."
                                                   Classes="Warning" TextWrapping="Wrap"
                                                   IsVisible="{Binding IsCancellationDeferred}"
                                                   />
                                    </Grid>
                                    <StackPanel   HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center">
                                            <Button
                                                HorizontalAlignment="Center"
                                                Content="Review DFU target" Command="{Binding ReviewDfuTargetCommand}"
                                                IsVisible="{Binding HasDetectedDfuDevice}"
                                                IsEnabled="{Binding !IsOperationInProgress}" />

                                            <Button
                                                HorizontalAlignment="Center"
                                                Content="Cancel operation" Command="{Binding CancelCommand}"
                                                IsVisible="{Binding IsOperationInProgress}"
                                                />

                                        </StackPanel>
                                    </StackPanel>


                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>
            <TabItem Header="Help &amp; Support">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <local:HelpView />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </ContentPage>
</utilities:NavigationViewBase>
