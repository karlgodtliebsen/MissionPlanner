<utilities:UserControlViewBase x:TypeArguments="sections:CompassSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.CompassSetupView"
                               x:DataType="sections:CompassSetupViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Grid RowDefinitions="Auto,Auto,Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
       
        <Border Grid.Row="0" HorizontalAlignment="Center" Padding="12"  Width="{Binding #SourceBorder.Bounds.Width}" >
            <StackPanel Spacing="10">
                <TextBlock Text="Compass discovery and calibration" Classes="H2" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"  Theme="{DynamicResource ProgressRing}" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <StackPanel Orientation="Vertical" IsVisible="{Binding HasIssues}" Spacing="4">
                    <TextBlock Text="Configuration warnings" FontWeight="Bold" Classes="Warning" />
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}" Classes="Warning" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="12"  Classes="SectionCard SourceBorder" x:Name="SourceBorder" >
            <StackPanel Spacing="15"  HorizontalAlignment="Center">
                <TextBlock Text="Configured versus detected hardware:" Classes="H3" />
                <TextBlock Text="{Binding DiagnosticSummary}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding DiagnosticEvidence}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding .}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                <Button Classes="IsToolbarButton" ToolTip.Tip="Refresh compass values" Command="{Binding RefreshInventoryCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Refresh compass values">
                    <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Start calibration" IsEnabled="{Binding CanStart}" Command="{Binding StartCalibrationCommand}" AutomationProperties.Name="Start calibration">
                    <mdi:MaterialIcon Kind="CompassOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Accept results" IsEnabled="{Binding CanAccept}" Command="{Binding AcceptCalibrationCommand}" AutomationProperties.Name="Accept results">
                    <mdi:MaterialIcon Kind="CheckCircleOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Cancel calibration" IsEnabled="{Binding CanCancel}" Command="{Binding CancelCalibrationCommand}" AutomationProperties.Name="Cancel calibration">
                    <mdi:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                </Button>
                <Button Classes="IsToolbarButton" ToolTip.Tip="Reset / retry" IsEnabled="{Binding CanStart}" Command="{Binding ResetCommand}" AutomationProperties.Name="Reset / retry">
                    <mdi:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Visible" Margin="16">
            <Border Classes="SectionCard" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
                <StackPanel Spacing="10" >
                    <ItemsControl ItemsSource="{Binding Compasses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sections:CompassInstanceViewModel">
                                <Border Padding="10" Classes="SectionCard">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding HealthLabel}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DeviceLabel}" />
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding OffsetsLabel}" Opacity="0.75" />
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding MotorCompensationLabel}" Opacity="0.75" />
                                        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.ColumnSpan="2" Spacing="10">
                                            <TextBlock Text="Use" VerticalAlignment="Center" />
                                            <ToggleSwitch IsChecked="{Binding IsUsed}" />
                                            <TextBlock Text="External" VerticalAlignment="Center" IsVisible="{Binding SupportsExternal}" />
                                            <ToggleSwitch IsChecked="{Binding IsExternal}" IsVisible="{Binding SupportsExternal}" />
                                            <ComboBox ToolTip.Tip="Orientation" ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}" DisplayMemberBinding="{Binding Name}" />
                                            <Button Classes="IsToolbarButton" HorizontalAlignment="Right" ToolTip.Tip="Write and verify" Command="{Binding ApplyCommand}" AutomationProperties.Name="Write and verify">
                                                <mdi:MaterialIcon Kind="UploadOutline" Classes="ActionIcon" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Onboard calibration" Classes="H3" />
                    <TextBlock Text="Move away from metal, vehicles, and magnetic interference before starting calibration." Classes="Warning H4"   TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CalibrationState, StringFormat='State: {0}'}"  Classes="H4"   TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Instruction}" Classes="H4"   TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ProgressSummary}"  Classes="H4" TextWrapping="Wrap"  />
                    <TextBlock Text="{Binding QualitySummary}"  Classes="H4" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>


    </Grid>
</utilities:UserControlViewBase>
