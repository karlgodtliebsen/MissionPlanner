<view:UserControlViewBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:MissionPlanner.App.Utilities" xmlns:local="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware"
    x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.STM32DfuArtifactView"
    x:TypeArguments="local:STM32BootloaderViewModel" x:DataType="local:STM32BootloaderViewModel">
    <Border Padding="20" Classes="SectionCard">
        <StackPanel Spacing="12">
            <TextBlock Text="Combined application + bootloader HEX" Classes="H3" />
            <TextBlock Text="Catalogue resolves a sibling *_with_bl.hex; Custom HEX uses the selected local file. APJ validation is separate. HEX inspection does not prove the exact flight-controller target." Classes="Warning" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding DfuDevices}" SelectedItem="{Binding SelectedDfuDevice}" MinWidth="250" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding DfuStatus}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ToolReadiness}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Classes="Warning" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding PreparedArtifact.FileName, TargetNullValue='Combined HEX not prepared yet'}" />
            <SelectableTextBlock Text="{Binding PreparedArtifact.SourceUri}" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding PreparedArtifact.Platform, StringFormat='Platform: {0}'}" />
            <SelectableTextBlock Text="{Binding PreparedArtifact.Metadata.Sha256, StringFormat='Inspected SHA-256: {0}'}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PreparedArtifact.Metadata.DataBytes, StringFormat='Inspected data bytes: {0}'}" />
            <ItemsControl ItemsSource="{Binding PreparedArtifact.Metadata.Warnings}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="12">
                <Button Content="Prepare combined HEX" Command="{Binding PrepareDfuCommand}" />
                <Button Content="Install combined HEX" Command="{Binding InstallDfuFirmwareCommand}" />
            </WrapPanel>
            <TextBlock Text="This replaces the current firmware and its bootloader. Confirm the exact target and keep USB power connected until programming and verification complete." Classes="Warning" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</view:UserControlViewBase>
