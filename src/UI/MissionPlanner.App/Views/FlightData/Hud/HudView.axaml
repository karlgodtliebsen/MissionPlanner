<utilities:UserControlViewBase
    x:TypeArguments="hud:HudViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:hud="clr-namespace:MissionPlanner.App.Views.FlightData.Hud"
    x:Class="MissionPlanner.App.Views.FlightData.Hud.HudView"
    x:DataType="hud:HudViewModel">
    <Grid RowDefinitions="*,Auto">
        <hud:HudCanvas x:Name="Canvas" />
        <Border Grid.Row="1" Background="{DynamicResource Surface}" Padding="8">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding ArmingLabel}" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PreArmReason}" Classes="Warning" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LastArmFailure}" Classes="Warning" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</utilities:UserControlViewBase>
