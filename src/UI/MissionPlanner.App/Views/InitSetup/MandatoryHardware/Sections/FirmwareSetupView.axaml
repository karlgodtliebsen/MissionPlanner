<utilities:UserControlViewBase x:TypeArguments="sections:FirmwareSetupViewModel"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.App.Views.InitSetup.MandatoryHardware.Sections.FirmwareSetupView"
                               x:DataType="sections:FirmwareSetupViewModel"
                               xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border HorizontalAlignment="Center" Padding="12"  x:Name="SourceBorder"  >
            <StackPanel Spacing="10">
                <TextBlock Text="Connected identity" Classes="H2"/>
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="Danger"
                                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullEmptyConverter}}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="1" Margin="16" >
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <Border  Classes="SectionCard" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
                    <Grid ColumnDefinitions="180,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10">
                        <TextBlock Text="Vehicle" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding VehicleLabel}" />
                        <TextBlock Grid.Row="1" Text="Firmware" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirmwareVersion}" />
                        <TextBlock Grid.Row="2" Text="Release type / Git" FontWeight="Bold" />

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReleaseType, StringFormat='{}{0}'}" />
                        <TextBlock Grid.Row="3" Text="Git hash" FontWeight="Bold" />

                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GitHash}" />
                        <TextBlock Grid.Row="4" Text="Board version" FontWeight="Bold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BoardVersion}" />
                        <TextBlock Grid.Row="5" Text="Vendor / product" FontWeight="Bold" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VendorProduct}" />
                        <TextBlock Grid.Row="6" Text="UID / UID2" FontWeight="Bold" />
                        <StackPanel Orientation="Vertical" Grid.Row="6" Grid.Column="1">
                            <TextBlock Text="{Binding HardwareUid}" />
                            <TextBlock Text="{Binding HardwareUid2}" />
                        </StackPanel>
                        <TextBlock Grid.Row="7" Text="MAVLink version" FontWeight="Bold" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MavLinkVersion}" />
                        <TextBlock Grid.Row="8" Text="Capabilities" FontWeight="Bold" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Capabilities}" />
                    </Grid>
                </Border>
                <Border Classes="SectionCard" Padding="12" Width="{Binding #SourceBorder.Bounds.Width}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="Firmware discovery" FontSize="18" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox ToolTip.Tip="Channel" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" />
                            <Button Classes="ToolbarButton" ToolTip.Tip="Discover compatible releases" Command="{Binding DiscoverCommand}" AutomationProperties.Name="Discover compatible releases">
                                <mdi:MaterialIcon Kind="CloudSearchOutline" Classes="ActionIcon" />
                            </Button>
                        </StackPanel>
                        <ComboBox ToolTip.Tip="Compatible release (exact board IDs)" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" DisplayMemberBinding="{Binding Version}" />
                        <TextBlock Text="{Binding SelectedBoardTarget, StringFormat='Technical board target: {0}'}" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedReleaseNotes}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Classes="ToolbarButton" ToolTip.Tip="Download and verify" Command="{Binding DownloadCommand}" AutomationProperties.Name="Download and verify">
                                <mdi:MaterialIcon Kind="CloudDownloadOutline" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarButton" ToolTip.Tip="Flash verified package" Command="{Binding FlashCommand}" AutomationProperties.Name="Flash verified package">
                                <mdi:MaterialIcon Kind="DownloadBoxOutline" Classes="ActionIcon" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontStyle="Italic" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FlashingAvailability}" />
                        <TextBlock Text="After flashing: reconnect, confirm the reported firmware identity, then restore only reviewed parameters from your backup." FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</utilities:UserControlViewBase>
