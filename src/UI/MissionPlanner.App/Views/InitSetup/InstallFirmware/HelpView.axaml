<view:UserControlViewBase x:TypeArguments="models:FirmwareHelpViewModel"
                          xmlns:view="clr-namespace:MissionPlanner.App.Utilities"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                          xmlns:models="clr-namespace:MissionPlanner.App.Views.InitSetup.InstallFirmware.SubViews.Models"
                          mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                          x:Class="MissionPlanner.App.Views.InitSetup.InstallFirmware.HelpView"
                          x:DataType="models:FirmwareHelpViewModel"
                          
                          >
    <Border Padding="20" Margin="25,0,25,0" Classes="SectionCard" HorizontalAlignment="Center"> 
        <StackPanel Orientation="Vertical" Spacing="25" HorizontalAlignment="Center">
            <TextBlock Text="Firmware Help &amp; Support" Classes="H3" />
            <TextBlock Text="These essential instructions are embedded and remain available offline. External links provide additional official detail." />

            <ItemsControl ItemsSource="{Binding SupportSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FirmwareSupportSection">
                        <StackPanel Orientation="Vertical" Spacing="4" Margin="0,10,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Title}" Classes="H4" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Official documentation and tools" Classes="H3" FontWeight="Bold" />

            <ItemsControl ItemsSource="{Binding SupportLinks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FirmwareSupportLink">
                        <Grid ColumnDefinitions="650,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"  RowSpacing="25" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Classes="H4" />
                            <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" />

                            <Button Classes="ToolbarButton"
                                Grid.Column="1" Grid.RowSpan="2"
                                ToolTip.Tip="Open firmware help resource"
                                Command="{Binding $parent[ItemsControl].((models:FirmwareHelpViewModel)DataContext).OpenSupportLinkCommand}"
                                CommandParameter="{Binding .}"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                >
                                <avalonia:MaterialIcon Kind="OpenInNew" Width="30" Height="30" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="ToolbarButton"
                ToolTip.Tip="Open Windows Device Manager"
                Command="{Binding OpenDeviceManagerCommand}"
                IsVisible="{Binding CanOpenDeviceManager}" 
                Padding="8,2"
                VerticalAlignment="Center"  HorizontalAlignment="Center"
                > 
                <avalonia:MaterialIcon Kind="OpenInNew" Width="30" Height="30" />
            </Button>

        </StackPanel>
    </Border>

</view:UserControlViewBase>
