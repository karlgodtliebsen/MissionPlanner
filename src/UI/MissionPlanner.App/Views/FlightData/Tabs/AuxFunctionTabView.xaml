<?xml version="1.0" encoding="utf-8" ?>
<tabViews:TabViewLifecycleContent   x:TypeArguments="tabs:AuxFunctionTabViewModel" 
                                    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                    xmlns:tabs="clr-namespace:MissionPlanner.App.Views.FlightData.Tabs"
                                    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
                                    xmlns:tabViews="clr-namespace:UraniumUI.Material.TabViews;assembly=UraniumUI.Material.Controls.Extensions"
                                    x:Class="MissionPlanner.App.Views.FlightData.Tabs.AuxFunctionTabView"
                                    x:DataType="tabs:AuxFunctionTabViewModel">


    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,Auto">
        <Label Text="Auxiliary functions" FontSize="20" FontAttributes="Bold" Grid.ColumnSpan="2" />
        <Picker Grid.Row="1" Grid.ColumnSpan="2" Title="Function" ItemsSource="{Binding Functions}"
                ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedFunction}" />
        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SelectedFunction.Description}" />
        <Picker Grid.Row="3" Title="Switch level" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" />
        <HorizontalStackLayout Grid.Row="3" Grid.Column="1">
            <CheckBox IsChecked="{Binding IsConfirmed}" /><Label Text="Confirm warning/high-risk action" VerticalOptions="Center" />
            <Button Text="Execute" Command="{Binding ExecuteCommand}" />
        </HorizontalStackLayout>
        <Label Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Result}" />
    </Grid>
</tabViews:TabViewLifecycleContent>
