<utilities:NavigationViewBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
                xmlns:help="clr-namespace:MissionPlanner.App.Views.Help"
                x:TypeArguments="help:HelpViewModel"
                x:DataType="help:HelpViewModel"
                x:Class="MissionPlanner.App.Views.Help.HelpPage">
    <ContentPage Header="Help">
        <Grid ColumnDefinitions="220,*" ColumnSpacing="16" Margin="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Help topics" Classes="H3" />
                <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="help:HelpArticleViewModel">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <help:HelpArticleView Grid.Column="1" DataContext="{Binding SelectedTopic}" />
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
