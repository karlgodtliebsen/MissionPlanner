<utilities:UserControlViewBase
    x:TypeArguments="local:FftAnalysisViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:local="clr-namespace:MissionPlanner.App.Views.Analysis"
    xmlns:core="clr-namespace:MissionPlanner.Core.Analysis;assembly=MissionPlanner.Core"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    x:Name="FftWorkspaceView"
    x:Class="MissionPlanner.App.Views.Analysis.FftAnalysisView"
    x:DataType="local:FftAnalysisViewModel"
    x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,*" Margin="12">
        <StackPanel Grid.Row="0" Spacing="8">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Command="{Binding OpenLogCommand}"
                        IsVisible="{Binding IsDrawerMode, ElementName=FftWorkspaceView}"
                        ToolTip.Tip="Open log" AutomationProperties.Name="Open log">
                    <mdi:MaterialIcon Kind="FolderOpen"  Classes="ActionIcon" />
                </Button>
                <Button Command="{Binding OpenLogCommand}"
                        IsVisible="{Binding !IsDrawerMode, ElementName=FftWorkspaceView}"
                        IsEnabled="{Binding !IsBusy}" Classes="ToolbarButton"
                        ToolTip.Tip="Open log" AutomationProperties.Name="Open log">
                    <mdi:MaterialIcon Kind="FolderOpen"  Classes="ActionIcon" />
                </Button>
                <Button Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}"
                        Classes="ToolbarButton" IsVisible="{Binding !IsDrawerMode, ElementName=FftWorkspaceView}"
                        ToolTip.Tip="Analyze" AutomationProperties.Name="Analyze">
                    <mdi:MaterialIcon Kind="ChartBellCurve"  Classes="ActionIcon" />
                </Button>
                <Button Command="{Binding CaptureBaselineCommand}" IsEnabled="{Binding !IsBusy}" Classes="ToolbarButton"
                        IsVisible="{Binding !IsDrawerMode, ElementName=FftWorkspaceView}"
                        ToolTip.Tip="Capture baseline" AutomationProperties.Name="Capture baseline">
                    <mdi:MaterialIcon Kind="ContentCopy" Classes="ActionIcon"  />
                </Button>
                <Button Command="{Binding ClearBaselineCommand}" IsEnabled="{Binding !IsBusy}" Classes="ToolbarButton"
                        IsVisible="{Binding !IsDrawerMode, ElementName=FftWorkspaceView}"
                        ToolTip.Tip="Clear baseline" AutomationProperties.Name="Clear baseline">
                    <mdi:MaterialIcon Kind="Close"  Classes="ActionIcon" />
                </Button>
                <Button Command="{Binding ExportEvidenceCommand}" IsEnabled="{Binding !IsBusy}" Classes="ToolbarButton"
                        IsVisible="{Binding !IsDrawerMode, ElementName=FftWorkspaceView}"
                        ToolTip.Tip="Export evidence" AutomationProperties.Name="Export evidence">
                    <mdi:MaterialIcon Kind="Download"  Classes="ActionIcon" />
                </Button>
                <Button Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Classes="ToolbarButton"
                        IsVisible="{Binding !IsDrawerMode, ElementName=FftWorkspaceView}"
                        ToolTip.Tip="Cancel" AutomationProperties.Name="Cancel">
                    <mdi:MaterialIcon Kind="Stop"  Classes="ActionIcon"  />
                </Button>
            </WrapPanel>

        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,8" Spacing="4">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
            <TextBlock Text="{Binding ErrorMessage}" Classes="Warning" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl IsVisible="{Binding !IsDrawerMode, ElementName=FftWorkspaceView}" Grid.Row="2" SelectedIndex="{Binding SelectedTab}" AutomationProperties.Name="DataFlash workspace tabs">
            <TabItem Header="File Information">
                <ScrollViewer>
                    <StackPanel Margin="12" Spacing="12">
                        <u:UrsaGroupBox >
                            <u:UrsaGroupBox.Header >
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SemiColorSecondary}"
                                    Text="{Binding FileName,StringFormat=Filename: {0}}" />
                            </u:UrsaGroupBox.Header>
                            <StackPanel Margin="12" Spacing="12">
                                <TextBlock Text="{Binding SourceDescription}" TextWrapping="Wrap" />
                                <TextBlock Text="Data quality and skipped data" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SourceDiagnostics}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BaselineDescription, StringFormat='Baseline: {0}'}" TextWrapping="Wrap" />
                            </StackPanel>
                        </u:UrsaGroupBox>

                        <Expander Header="Notch configuration and offline simulation" IsExpanded="False">
                            <u:UrsaGroupBox Margin="25">
                                <u:UrsaGroupBox.Header >
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SemiColorSecondary}"
                                        Text="Information" />
                                </u:UrsaGroupBox.Header>
                                <StackPanel Spacing="10" IsEnabled="{Binding !IsBusy}">
                                    <TextBlock Text="Read-only analysis. No parameter writes. Current and proposed simulations use a generic static notch model; they do not reproduce firmware tracking, transients, or exact attenuation." TextWrapping="Wrap" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Command="{Binding ReadConnectedCommand}"
                                                ToolTip.Tip="Capture connected parameter values and existing firmware metadata. Read connected snapshot"
                                                AutomationProperties.Name="Read connected filter parameters">
                                            <mdi:MaterialIcon Kind="Refresh"  Classes="ActionIcon" />
                                        </Button>
                                        <ComboBox ItemsSource="{Binding VehicleFamilies}" SelectedItem="{Binding VehicleFamily}" AutomationProperties.Name="Saved parameter firmware family" />
                                        <Button Command="{Binding OpenParametersCommand}"
                                                ToolTip.Tip="Load a saved name/value parameter file using the selected metadata family. Load saved snapshot"
                                                AutomationProperties.Name="Load saved filter parameters">
                                            <mdi:MaterialIcon Kind="FolderOpen"  Classes="ActionIcon" />
                                        </Button>
                                    </WrapPanel>
                                    <TextBox Text="{Binding ParameterReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="180" AutomationProperties.Name="Filter parameter snapshot and metadata" />
                                    <CheckBox IsChecked="{Binding SimulateProposal}" Content="Include proposed static notch in the next analysis" />
                                    <WrapPanel ItemSpacing="12" LineSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Proposed center Hz" />
                                            <NumericUpDown Value="{Binding ProposedCenterHz}" Width="150" Minimum="1" AutomationProperties.Name="Proposed notch frequency" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Proposed bandwidth Hz" />
                                            <NumericUpDown Value="{Binding ProposedBandwidthHz}" Width="150" Minimum="1" AutomationProperties.Name="Proposed notch bandwidth" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Proposed attenuation dB" />
                                            <NumericUpDown Value="{Binding ProposedAttenuationDb}" Width="150" Minimum="0" Maximum="120"
                                                           AutomationProperties.Name="Proposed notch attenuation" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </u:UrsaGroupBox>

                        </Expander>

                        <u:UrsaGroupBox>
                            <u:UrsaGroupBox.Header >
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SemiColorSecondary}"
                                    Text="Analysis report" />
                            </u:UrsaGroupBox.Header>
                            <TextBox Text="{Binding Report}" 
                                     Padding="25"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300"
                                     AutomationProperties.Name="Structured vibration analysis report" />
                        </u:UrsaGroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Graphs">
                <Grid ColumnDefinitions="*,5,380" Margin="0,8" ColumnSpacing="12">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding SelectedSource.DisplayName,FallbackValue='', TargetNullValue=''}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <local:FrequencyPlot Grid.Row="1" Result="{Binding Result}" ShowSpectrogram="{Binding ShowSpectrogram}" MinHeight="320" MinWidth="300" AutomationProperties.Name="Frequency spectrum and spectrogram plot" />
                        <TextBlock Grid.Row="2" Text="Green: measured · Blue: current filters · Orange: proposed filter. Hover to inspect values." TextWrapping="Wrap" />
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />
                    <ScrollViewer Grid.Column="2">
                        <StackPanel Spacing="12">
                            <u:UrsaGroupBox  IsEnabled="{Binding !IsBusy}">

                                <u:UrsaGroupBox.Header >
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SemiColorSecondary}"
                                        Text="Source · IMU instance / signal / axis / uniform segment" />
                                </u:UrsaGroupBox.Header>

                                <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="8">
                                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" HorizontalAlignment="Stretch" AutomationProperties.Name="IMU signal axis and segment">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:ImuSampleSeries">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <WrapPanel ItemSpacing="12" LineSpacing="8">
                                        <WrapPanel ItemSpacing="12" LineSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="Start (log seconds)" />
                                                <NumericUpDown Value="{Binding StartSeconds}" FormatString="F6" Width="150"
                                                               AutomationProperties.Name="Analysis start seconds" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="End (log seconds)" />
                                                <NumericUpDown Value="{Binding EndSeconds}" FormatString="F6" Width="150"
                                                               AutomationProperties.Name="Analysis end seconds" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <StackPanel>
                                            <TextBlock Text="FFT window samples" />
                                            <ComboBox ItemsSource="{Binding FftSizes}" SelectedItem="{Binding FftSize}"
                                                      Width="150" AutomationProperties.Name="FFT window size" />
                                        </StackPanel>
                                        <WrapPanel ItemSpacing="12" LineSpacing="8">
                                            <StackPanel  ToolTip.Tip="Minimum plot frequency (Hz)">
                                                <TextBlock Text="Minimum frequency (Hz)" />
                                                <NumericUpDown Value="{Binding MinimumHz}" Minimum="0" Width="150"
                                                               AutomationProperties.Name="Minimum plot frequency" />
                                            </StackPanel>
                                            <StackPanel ToolTip.Tip="Maximum plot frequency (Hz) (0 = Nyquist)">
                                                <TextBlock Text="Maximum frequency (Hz)"/>
                                                <NumericUpDown Value="{Binding MaximumHz}"  Minimum="0" Width="150"
                                                               AutomationProperties.Name="Maximum plot frequency" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </u:UrsaGroupBox>
                            <CheckBox IsChecked="{Binding ShowSpectrogram}" Content="Spectrogram (unchecked: Spectrum)" AutomationProperties.Name="Switch spectrum or spectrogram" />
                            <TextBlock Text="Selecting a source refreshes the graph. After changing the interval or FFT settings, click Analyze." TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>