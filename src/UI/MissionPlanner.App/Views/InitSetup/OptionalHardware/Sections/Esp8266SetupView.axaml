<utilities:UserControlViewBase
    x:TypeArguments="sections:Esp8266SetupViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities"
    xmlns:controls="clr-namespace:MissionPlanner.Themes.Controls;assembly=MissionPlanner.Themes"
    xmlns:common="clr-namespace:MissionPlanner.App.Views.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:appSetup="clr-namespace:MissionPlanner.App.Views.Common"
    xmlns:sections="clr-namespace:MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="MissionPlanner.App.Views.InitSetup.OptionalHardware.Sections.Esp8266SetupView"
    x:DataType="sections:Esp8266SetupViewModel"
    xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <u:Banner ShowIcon="False"  Classes="Bordered" Header="ESP8266 MAVLink Bridge" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Target}" />
                <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </u:Banner>
        <TabControl Grid.Row="1">
            <TabItem Header="Information">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                        </WrapPanel>
                    </Border>
                    <appSetup:SetupInformationView Grid.Row="1" Topic="Esp8266" WorkflowStatus="{Binding StatusMessage}" WorkflowError="{Binding ErrorMessage}" />

                </Grid>
            </TabItem>
            <TabItem Header="Configuration">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" HorizontalAlignment="Center">
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"  AutomationProperties.Name="Refresh">
                                <mdi:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                            </Button>
                            <common:OpenParameterEditorsView/>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Validate settings" Command="{Binding ValidateCommand}" HorizontalAlignment="Center" AutomationProperties.Name="Validate settings">
                                <mdi:MaterialIcon Kind="FileCheckOutline" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Apply and save" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply and save">
                                <mdi:MaterialIcon Kind="ContentSave" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Reboot bridge" Command="{Binding RebootCommand}" AutomationProperties.Name="Reboot bridge">
                                <mdi:MaterialIcon Kind="Restart" Classes="ActionIcon" />
                            </Button>
                            <Button Classes="ToolbarIconButton" ToolTip.Tip="Restore bridge defaults" Command="{Binding RestoreDefaultsCommand}" AutomationProperties.Name="Restore bridge defaults">
                                <mdi:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                            </Button>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" HorizontalAlignment="Stretch" Padding="12"
                            Classes="SectionCard"  >
                        <ScrollViewer><StackPanel Spacing="10">
                            <TextBlock Text="Read the bridge before editing. Network names use up to 15 UTF-8 bytes; passwords use 8–15 bytes (empty means an open network). Apply saves; Reboot is separate." TextWrapping="Wrap" />
                            <TextBox PlaceholderText="Access-point SSID" Text="{Binding Ssid}" />
                            <TextBox PlaceholderText="Access-point password" Text="{Binding Password}" PasswordChar="●" />
                            <TextBox PlaceholderText="Station SSID" Text="{Binding StationSsid}" />
                            <TextBox PlaceholderText="Station password" Text="{Binding StationPassword}" PasswordChar="●" />
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sections:EspBridgeField">
                                        <Grid ColumnDefinitions="*,*" Margin="0,4">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</utilities:UserControlViewBase>
