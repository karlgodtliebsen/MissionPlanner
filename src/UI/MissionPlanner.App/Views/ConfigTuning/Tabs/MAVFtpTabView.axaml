<utilities:NavigationViewBase x:TypeArguments="tabs:MavFtpTabViewModel"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:utilities="clr-namespace:MissionPlanner.App.Utilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tabs="clr-namespace:MissionPlanner.App.Views.ConfigTuning.Tabs"
                              xmlns:models="clr-namespace:MissionPlanner.App.Models"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Name="RootPage"
                              x:Class="MissionPlanner.App.Views.ConfigTuning.Tabs.MAVFtpTabView"
                              x:DataType="tabs:MavFtpTabViewModel">
    <ContentPage Header="Mav Ftp" >

        <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                
                <Button ToolTip.Tip="Upload file to vehicle" Command="{Binding NavigateUpCommand}" IsEnabled="{Binding CanNavigateUp}"  >
                    <avalonia:MaterialIcon Kind="UploadOutline" Width="30" Height="30" />
                </Button>

                <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Grid.Column="2" ToolTip.Tip="Refresh"  IsVisible="{Binding HasConnection}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh">
                    <avalonia:MaterialIcon Kind="Refresh" Classes="ActionIcon" />
                </Button>
                <Button Grid.Column="3" ToolTip.Tip="Open selected remote directory" IsVisible="{Binding HasEntries}" Command="{Binding OpenSelectedCommand}" AutomationProperties.Name="Open">
                    <avalonia:MaterialIcon Kind="FolderOpenOutline" Classes="ActionIcon" />
                </Button>
                <Button Grid.Column="4" ToolTip.Tip="Reset sessions"  IsVisible="{Binding HasConnection}" Command="{Binding ResetSessionsCommand}" AutomationProperties.Name="Reset sessions">
                    <avalonia:MaterialIcon Kind="Restore" Classes="ActionIcon" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" RowDefinitions="Auto,*" MinWidth="640">
                <Grid ColumnDefinitions="400,100,100" ColumnSpacing="6" Margin="12,0,12,6">
                    <TextBlock Grid.Column="0" Text="Name" Classes="DataGridColumn" />
                    <TextBlock Grid.Column="1" Text="Type" Classes="DataGridColumn" />
                    <TextBlock Grid.Column="2" Text="Size" Classes="DataGridColumn" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         SelectionMode="Single"
                         DoubleTapped="OnEntriesDoubleTapped"
                         VerticalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VehicleFileSystemEntryViewModel">
                            <Grid ColumnDefinitions="400,100,100" ColumnSpacing="6" MinHeight="38">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="DataGridRow" />
                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" Classes="DataGridRow" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="DataGridRow" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Text="{Binding EmptyText}"
                           IsVisible="{Binding !HasEntries}"
                           FontSize="12"
                           Opacity="0.6"
                           Margin="0,20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False" />
            </Grid>
            <StackPanel Orientation="Vertical" Grid.Row="2" Spacing="6">
                <SelectableTextBlock Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}" Classes="Danger" />
                <ProgressBar Value="{Binding TransferProgress}" />
                <TextBlock Text="{Binding TransferDetails}" FontSize="12" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button ToolTip.Tip="Download selected file from vehicle" Command="{Binding DownloadSelectedCommand}"  IsVisible="{Binding HasEntries}" AutomationProperties.Name="Download selected">
                        <avalonia:MaterialIcon Kind="DownloadOutline" Classes="ActionIcon" />
                    </Button>
                    <Button ToolTip.Tip="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" AutomationProperties.Name="Cancel">
                        <avalonia:MaterialIcon Kind="CloseCircleOutline" Classes="ActionIcon" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ContentPage>
</utilities:NavigationViewBase>
