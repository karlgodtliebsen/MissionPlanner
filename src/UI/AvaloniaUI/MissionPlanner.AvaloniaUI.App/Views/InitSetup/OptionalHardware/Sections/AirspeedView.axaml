<utilities:UserControlViewBase x:TypeArguments="sections:AirspeedViewModel"
                               xmlns="https://github.com/avaloniaui" 
                               xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities" 
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                               xmlns:sections="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections" 
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                               x:Class="MissionPlanner.AvaloniaUI.App.Views.InitSetup.OptionalHardware.Sections.AirspeedView" 
                               x:DataType="sections:AirspeedViewModel">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Margin="16" Spacing="25" HorizontalAlignment="Center">
            <TextBlock Text="Airspeed" FontSize="20" FontWeight="Bold" />
            <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="Danger" />
<TextBlock Text="Vehicle Reboot required" Classes="Warning" IsVisible="{Binding RebootRequired}" />
            <ItemsControl ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sections:ParameterSettingViewModel">
                        <Grid ColumnDefinitions="220,*,90">
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PendingValue, Mode=TwoWay}" FormatString="F1" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyCommand}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</utilities:UserControlViewBase>
