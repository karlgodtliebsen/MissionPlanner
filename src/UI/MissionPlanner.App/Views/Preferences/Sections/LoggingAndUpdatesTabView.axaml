<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.LoggingAndUpdatesTabView"
             x:DataType="preferences:PreferencesViewModel">

    <Grid RowDefinitions="Auto,*"

          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="5">
                        <Button Classes="EmbeddedIconButton" ToolTip.Tip="Reset logging" Command="{Binding ResetSectionCommand}" CommandParameter="Logging" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                        <Button Classes="EmbeddedIconButton" ToolTip.Tip="Reset updates" Command="{Binding ResetSectionCommand}" CommandParameter="Updates" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical" Spacing="8"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">

                        <TextBlock Text="Logging changes and update-channel changes take effect after restart." Classes="H4" HorizontalAlignment="Left" />
                        <u:Form LabelPosition="Left" LabelWidth="220" MinWidth="400" HorizontalAlignment="Center">
                            <ComboBox  HorizontalAlignment="Right" HorizontalContentAlignment="Right" ItemsSource="{Binding LoggingLevels}" SelectedItem="{Binding SelectedLoggingLevel}" 
                                       u:FormItem.Label="Logging level" />
                            <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding LogRetentionDays, Mode=TwoWay}" FormatString="F0" 
                                            u:FormItem.Label="Log retention (days)" />
                            <ToggleSwitch  HorizontalAlignment="Right" HorizontalContentAlignment="Right" IsChecked="{Binding CheckUpdatesAutomatically}" u:FormItem.Label="Automatic update checks" />
                            <NumericUpDown  HorizontalAlignment="Right" HorizontalContentAlignment="Right" Value="{Binding UpdateCheckIntervalDays, Mode=TwoWay}" FormatString="F0"
                                            u:FormItem.Label="Check interval (days)" />
                            <ComboBox  HorizontalAlignment="Right" HorizontalContentAlignment="Right" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" 
                                       u:FormItem.Label="Update channel" />
                            <TextBlock Text="Logs → Open folder. Desktop: Documents/Mission Planner/logs. Browser: session storage." TextWrapping="Wrap" 
                                       u:FormItem.Label="Log storage" />
                        </u:Form>
                    </StackPanel>
                </Grid>

            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
