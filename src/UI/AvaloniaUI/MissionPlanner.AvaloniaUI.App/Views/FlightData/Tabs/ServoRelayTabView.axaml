<utilities:TabItemViewBase x:TypeArguments="tabs:ServoRelayTabViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:tabs="clr-namespace:MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs"
                           xmlns:utilities="clr-namespace:MissionPlanner.AvaloniaUI.App.Utilities"
                           x:Class="MissionPlanner.AvaloniaUI.App.Views.FlightData.Tabs.ServoRelayTabItemView"
                           x:DataType="tabs:ServoRelayTabViewModel">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
        <TextBlock Text="Observed servo outputs" FontSize="18" FontWeight="Bold"/>
        <!-- TODO: Restore the VirtualizedDataGrid after an Avalonia equivalent is selected. -->
        <ListBox Grid.Row="1" ItemsSource="{Binding ServoOutputs}"/>
        <Grid Grid.Row="2" ColumnDefinitions="100,120,Auto,*" ColumnSpacing="8">
            <NumericUpDown Value="{Binding Channel}" Minimum="1"/>
            <NumericUpDown Grid.Column="1" Value="{Binding Pwm}"/>
            <CheckBox Grid.Column="2" Content="Confirm disarmed test" IsChecked="{Binding IsConfirmed}"/>
            <Button Grid.Column="3" Content="Set servo" Command="{Binding SetServoCommand}"/>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Result}"/>
    </Grid>
</utilities:TabItemViewBase>
