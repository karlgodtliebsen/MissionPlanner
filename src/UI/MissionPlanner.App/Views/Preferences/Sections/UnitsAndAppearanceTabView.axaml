<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preferences="clr-namespace:MissionPlanner.App.Views.Preferences"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MissionPlanner.App.Views.Preferences.Sections.UnitsAndAppearanceTabView"
             x:DataType="preferences:PreferencesViewModel">
    <Grid RowDefinitions="Auto,*"
          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="14" Classes="SectionCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MinHeight="400">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="5">
                        <Button Classes="EmbeddedIconButton"  ToolTip.Tip="Reset units" Command="{Binding ResetSectionCommand}" CommandParameter="Units" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                        <Button Classes="EmbeddedIconButton"  ToolTip.Tip="Reset appearance" Command="{Binding ResetSectionCommand}" CommandParameter="Appearance" >
                            <avalonia:MaterialIcon Kind="Restore" Width="30" Height="30" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8" Grid.ColumnSpan="2" 
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <u:Form LabelPosition="Left" LabelWidth="220" MinWidth="400" HorizontalAlignment="Center">
                            <ComboBox HorizontalAlignment="Right" HorizontalContentAlignment="Right"  ItemsSource="{Binding UnitSystems}" SelectedItem="{Binding SelectedUnitSystem}" u:FormItem.Label="Unit system" />
                            <ComboBox HorizontalAlignment="Right" HorizontalContentAlignment="Right"  ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberBinding="{Binding Name}" u:FormItem.Label="Theme (live preview)" />
                            <ComboBox HorizontalAlignment="Right" HorizontalContentAlignment="Right"  ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding LayoutMode}" u:FormItem.Label="Layout" />
                        </u:Form>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
